<?xml version="1.0" encoding="utf-8"?>
<!-- XML mirror of SupernovaStyle.buttonContent(): black on the white focus box, white at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF0B0D12" />
    <item android:state_pressed="true" android:color="#FF0B0D12" />
    <item android:color="#FFFFFFFF" />
</selector>
