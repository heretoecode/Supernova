<com.archos.mediacenter.video.player.PlayerControlsRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/playerControllers" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_weight="1">
    <TextView android:id="@+id/clock" android:fontFamily="sans-serif-light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_alignParentTop="true" android:layout_marginEnd="32dp" android:layout_marginTop="24dp" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/preview_playback_title" android:layout_width="380dp" android:layout_height="64dp" android:gravity="top" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="23sp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_marginStart="28dp" android:visibility="gone" android:shadowColor="#FF000000" android:shadowRadius="3" />
    <TextView android:id="@+id/preview_playback_episode" android:layout_width="560dp" android:layout_height="wrap_content" android:layout_below="@id/preview_playback_title" android:layout_marginStart="28dp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="#CCDFEA" android:textSize="13sp" android:visibility="gone" />
    <FrameLayout android:id="@+id/tv_menu_container" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/my_recycler_view" android:layout_width="wrap_content" android:layout_height="match_parent" android:scrollbars="horizontal">
        </FrameLayout>
    </FrameLayout>
    <include android:layout_width="@dimen/player2014_bar_width" android:layout_height="fill_parent" android:layout_above="@+id/control_bar" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" layout="@layout/player_controller_left" />
    <include android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/control_bar" layout="@layout/player_help_overlay" />
    <include android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/unlock_instructions" layout="@layout/unlock_instructions" />
    <LinearLayout android:id="@+id/control_bar" android:layout_width="match_parent" android:layout_height="104dp" android:layout_alignParentBottom="true" android:background="@drawable/mark_hud_background" android:descendantFocusability="afterDescendants" android:orientation="vertical" android:visibility="gone" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false" android:clipToPadding="false" android:focusable="false" android:addStatesFromChildren="false">
        <LinearLayout android:id="@+id/preview_transport" android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false">
            <LinearLayout android:id="@+id/preview_pause_group" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:addStatesFromChildren="true">
                <ImageButton android:id="@+id/pause" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/video_play_selector" android:background="@android:color/transparent" android:contentDescription="Play/Pause" />
                <TextView android:visibility="gone" android:id="@+id/preview_pause_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="14sp" android:gravity="center_vertical" android:singleLine="true" />
            </LinearLayout>
            <FrameLayout android:id="@+id/preview_seek_container" android:layout_width="0dp" android:layout_weight="1" android:layout_height="88dp" android:clipChildren="false" android:focusable="false" android:addStatesFromChildren="false">
                <TextView android:id="@+id/preview_scrub_time" android:maxLines="2" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="22dp" android:paddingTop="3dp" android:paddingBottom="7dp" android:layout_gravity="top|start" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="13sp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:visibility="visible" />
                <com.archos.mediacenter.utils.seekbar.ArchosProgressSlider android:id="@+id/seek_progress" style="@style/PlayerSliderHorizontal" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical" android:minHeight="4dp" android:maxHeight="4dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:progressDrawable="@drawable/preview_seek_track" android:thumb="@drawable/preview_seek_thumb" android:thumbOffset="5dp" android:background="@android:color/transparent" />
                <com.archos.mediacenter.video.player.ChapterMarkers android:id="@+id/preview_chapter_markers" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textSize="14sp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:gravity="center_vertical" android:singleLine="true" />
            <TextView android:id="@+id/preview_end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="14sp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:gravity="center_vertical" android:singleLine="true" />
            <FrameLayout android:id="@+id/preview_more_group" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:orientation="horizontal" android:gravity="center" android:addStatesFromChildren="true">
                <ImageButton android:id="@+id/preview_more" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingEnd="80dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:scaleType="fitCenter" android:src="@drawable/tv_settings" android:background="@android:color/transparent" android:contentDescription="Playback Settings" />
                <TextView android:id="@+id/preview_more_label" android:layout_gravity="center_vertical|start" android:layout_marginStart="40dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="14sp" android:gravity="center_vertical" android:singleLine="true" />
            </FrameLayout>
            <LinearLayout android:visibility="gone" android:id="@+id/preview_subtitles_group" android:layout_width="112dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:addStatesFromChildren="true">
                <ImageButton android:id="@+id/preview_subtitles" android:layout_width="32dp" android:layout_height="36dp" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/tv_subtitles" android:background="@android:color/transparent" android:contentDescription="Subtitles" />
                <TextView android:id="@+id/preview_subtitle_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subtitles" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="14sp" android:gravity="center_vertical" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:visibility="gone" android:id="@+id/preview_audio_group" android:layout_width="92dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:addStatesFromChildren="true">
                <ImageButton android:id="@+id/preview_audio" android:layout_width="32dp" android:layout_height="36dp" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/tv_languages" android:background="@android:color/transparent" android:contentDescription="Audio" />
                <TextView android:id="@+id/preview_audio_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:textSize="14sp" android:gravity="center_vertical" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/time_current" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/seek_state" style="?android:attr/progressBarStyleSmall" android:layout_width="16dp" android:layout_height="16dp" android:visibility="gone" />
        <ImageButton android:id="@+id/preview_info" android:visibility="gone" android:focusable="false" android:layout_width="1dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/preview_previous" android:visibility="gone" android:focusable="false" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_previous" android:background="@android:color/transparent" android:contentDescription="Previous episode" />
        <ImageButton android:id="@+id/backward" android:visibility="gone" android:focusable="false" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_rewind10" android:background="@android:color/transparent" android:contentDescription="Rewind 10 seconds" />
        <ImageButton android:id="@+id/forward" android:visibility="gone" android:focusable="false" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_forward10" android:background="@android:color/transparent" android:contentDescription="Forward 10 seconds" />
        <ImageButton android:id="@+id/preview_next" android:visibility="gone" android:focusable="false" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_next" android:background="@android:color/transparent" android:contentDescription="Next episode" />
        <ImageButton android:id="@+id/preview_speed" android:visibility="gone" android:focusable="false" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/preview_speed" android:background="@android:color/transparent" android:contentDescription="Playback speed" />
        <ImageButton android:id="@+id/format" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/video_format_0" android:visibility="gone" android:focusable="false" android:contentDescription="Aspect ratio" />
        <ImageButton android:id="@+id/fullscreen_cutouts" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/video_fullscreen_cutout_off" android:visibility="gone" android:focusable="false" android:contentDescription="Fullscreen" />
    </LinearLayout>
    <TextView android:id="@+id/osd_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="84dp" android:drawableStart="@drawable/ic_volume" android:text="15" android:textColor="@color/white" android:textSize="20sp" android:lineSpacingMultiplier="1.1" android:background="@drawable/rounded_rectangle" android:visibility="invisible" android:layout_marginTop="60dp" android:layout_alignParentStart="true" android:layout_marginStart="46dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6sp" android:paddingBottom="6sp" />
    <TextView android:id="@+id/osd_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="84dp" android:drawableStart="@drawable/ic_brightness" android:text="15" android:textColor="@color/white" android:textSize="20sp" android:lineSpacingMultiplier="1.1" android:background="@drawable/rounded_rectangle" android:visibility="invisible" android:layout_marginTop="60dp" android:layout_alignParentEnd="true" android:layout_marginEnd="30dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="6sp" android:paddingBottom="6sp" />
</com.archos.mediacenter.video.player.PlayerControlsRelativeLayout>
