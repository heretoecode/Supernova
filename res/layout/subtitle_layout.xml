<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/subtitle_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

    <!-- Native canvas renders subtitles; this layout tracks insets and the position hint. -->
    <com.archos.mediacenter.video.player.SubtitleSpacerView android:id="@+id/subtitle_spacer"
        android:layout_width="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_height="@dimen/subtitles_paddingBottom"
        android:visibility="visible"
    />

</RelativeLayout>
