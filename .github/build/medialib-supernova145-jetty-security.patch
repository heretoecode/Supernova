+// Copyright 2026 Supernova contributors
+// Licensed under the Apache License, Version 2.0.
+package com.archos.mediacenter.filecoreextension.upnp2;
+
+import java.net.URI;
+import org.eclipse.jetty.client.api.Request;
+import org.jupnp.model.message.StreamRequestMessage;
+import org.jupnp.transport.impl.jetty.JettyStreamClientImpl;
+import org.jupnp.transport.impl.jetty.StreamClientConfigurationImpl;
+import org.jupnp.transport.spi.InitializationException;
+
+/** Validate the JDK URI authority before passing UPnP metadata to legacy Jetty. */
+public final class ValidatingJettyStreamClient extends JettyStreamClientImpl {
+    public ValidatingJettyStreamClient(StreamClientConfigurationImpl configuration) throws InitializationException {
+        super(configuration);
+    }
+    @Override protected Request createRequest(StreamRequestMessage message) {
+        URI uri = message.getOperation().getURI();
+        if (uri == null || !uri.isAbsolute() || uri.getHost() == null || uri.getHost().isEmpty()
+                || !("http".equalsIgnoreCase(uri.getScheme()) || "https".equalsIgnoreCase(uri.getScheme()))) {
+            // Do not log malformed URI text: discovered metadata can contain credentials.
+            return null;
+        }
+        return super.createRequest(message);
+    }
+}
