diff --git a/src/com/archos/mediaprovider/video/LibraryHealthEvidence.java b/src/com/archos/mediaprovider/video/LibraryHealthEvidence.java
new file mode 100644
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/LibraryHealthEvidence.java
@@ -0,0 +1,164 @@
+package com.archos.mediaprovider.video;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+import java.io.EOFException;
+import java.io.File;
+import java.net.SocketTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/** Bounded private evidence, shared with the isolated retriever process. No locator or exception text is stored. */
+public final class LibraryHealthEvidence extends SQLiteOpenHelper
+{
+    public enum Kind
+    {
+        COULD_NOT_READ, NOT_MATCHED
+    }
+
+    public enum Reason
+    {
+        DAMAGED, TIMED_OUT, UNSUPPORTED, UNKNOWN, NO_MATCH, POSSIBLE
+    }
+
+    public record Evidence(String physical, Kind kind, Reason reason, int candidates, boolean more, long checkedUtcMs)
+    {
+    }
+
+    public LibraryHealthEvidence(Context context)
+    {
+        super(context.getApplicationContext(),
+              new File(context.getNoBackupFilesDir(), "library-health-v1.db").getPath(), null, 1);
+    }
+
+    @Override public void onCreate(SQLiteDatabase db)
+    {
+        db.execSQL("CREATE TABLE evidence (physical TEXT NOT NULL,kind TEXT NOT NULL,reason TEXT NOT NULL," +
+                   "candidates INTEGER NOT NULL,more INTEGER NOT NULL,checked INTEGER NOT NULL," +
+                   "PRIMARY KEY(physical,kind))");
+    }
+
+    @Override public void onUpgrade(SQLiteDatabase db, int before, int after)
+    {
+        throw new IllegalStateException("Unsupported health-evidence upgrade");
+    }
+
+    public static String physical(String path) throws Exception
+    {
+        String portable = PersonalVideoActions.fingerprint(path);
+        if (portable != null)
+            return portable;
+        if (path == null)
+            return null;
+        StringBuilder key = new StringBuilder("private:");
+        for (byte part : MessageDigest.getInstance("SHA-256").digest(path.getBytes(StandardCharsets.UTF_8)))
+            key.append(String.format(Locale.ROOT, "%02x", part & 255));
+        return key.toString();
+    }
+
+    public static Reason readReason(Throwable failure)
+    {
+        Throwable current = failure;
+        for (int depth = 0; current != null && depth < 8; depth++, current = current.getCause())
+        {
+            if (current instanceof SocketTimeoutException || current instanceof java.util.concurrent.TimeoutException)
+                return Reason.TIMED_OUT;
+            if (current instanceof UnsupportedOperationException)
+                return Reason.UNSUPPORTED;
+            if (current instanceof EOFException || current instanceof java.util.zip.ZipException)
+                return Reason.DAMAGED;
+            if (current == current.getCause())
+                break;
+        }
+        return Reason.UNKNOWN;
+    }
+
+    public static void readFailure(Context context, String path, Throwable failure)
+    {
+        record(context, path, Kind.COULD_NOT_READ, readReason(failure), 0, false);
+    }
+
+    public static void recordMatches(Context context, String path,
+                                     com.archos.mediascraper.ScrapeSearchResult result, int requestedLimit)
+    {
+        if (result == null || (result.status != com.archos.mediascraper.ScrapeStatus.OKAY &&
+                               result.status != com.archos.mediascraper.ScrapeStatus.NOT_FOUND))
+            return;
+        int count = result.results == null ? 0 : result.results.size();
+        record(context, path, Kind.NOT_MATCHED, count == 0 ? Reason.NO_MATCH : Reason.POSSIBLE,
+               count, requestedLimit > 0 && count >= requestedLimit);
+    }
+
+    public static void record(Context context, String path, Kind kind, Reason reason, int count, boolean more)
+    {
+        try (LibraryHealthEvidence store = new LibraryHealthEvidence(context))
+        {
+            String key = physical(path);
+            if (key == null)
+                return;
+            if (kind == Kind.COULD_NOT_READ && (reason == Reason.NO_MATCH || reason == Reason.POSSIBLE) ||
+                kind == Kind.NOT_MATCHED && reason != Reason.NO_MATCH && reason != Reason.POSSIBLE ||
+                count < 0 || count > 100000)
+                throw new IllegalArgumentException("Invalid health evidence");
+            ContentValues values = new ContentValues();
+            values.put("physical", key);
+            values.put("kind", kind.name());
+            values.put("reason", reason.name());
+            values.put("candidates", count);
+            values.put("more", more ? 1 : 0);
+            values.put("checked", System.currentTimeMillis());
+            SQLiteDatabase db = store.getWritableDatabase();
+            db.beginTransaction();
+            try
+            {
+                db.insertWithOnConflict("evidence", null, values, SQLiteDatabase.CONFLICT_REPLACE);
+                db.execSQL("DELETE FROM evidence WHERE rowid IN (SELECT rowid FROM evidence " +
+                           "ORDER BY checked DESC,rowid DESC LIMIT -1 OFFSET 10000)");
+                db.setTransactionSuccessful();
+            }
+            finally
+            {
+                db.endTransaction();
+            }
+        }
+        catch (Exception unavailable)
+        {
+            // Evidence failure cannot turn successful playback/indexing into a data mutation or a crash.
+        }
+    }
+
+    public static void clear(Context context, String path, Kind kind)
+    {
+        try (LibraryHealthEvidence store = new LibraryHealthEvidence(context))
+        {
+            String key = physical(path);
+            if (key != null)
+                store.getWritableDatabase().delete("evidence", "physical=? AND kind=?",
+                                                   new String[] {key, kind.name()});
+        }
+        catch (Exception unavailable)
+        {
+            // The next successful retry can clear stale evidence.
+        }
+    }
+
+    public List<Evidence> read(Kind kind)
+    {
+        List<Evidence> result = new ArrayList<>();
+        try (Cursor rows = getReadableDatabase().query("evidence",
+            new String[] {"physical", "reason", "candidates", "more", "checked"}, "kind=?",
+            new String[] {kind.name()}, null, null, "checked DESC", "10000"))
+        {
+            while (rows.moveToNext())
+                result.add(new Evidence(rows.getString(0), kind, Reason.valueOf(rows.getString(1)), rows.getInt(2),
+                                        rows.getInt(3) == 1, rows.getLong(4)));
+        }
+        return List.copyOf(result);
+    }
+}
