+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.channels.FileLock;
+
+/** A new ownership format gets its own store. Old APKs retain their original media.db snapshot. Worker only. */
+final class MediaDatabaseUpgrade
+{
+    static synchronized void prepare(Context context, String current, int maximum) throws IOException
+    {
+        File target = context.getDatabasePath(current);
+        File legacy = context.getDatabasePath("media.db");
+        if (target.isFile() || !legacy.isFile())
+            return;
+        File directory = target.getParentFile();
+        if (!directory.isDirectory() && !directory.mkdirs())
+            throw new IOException("Cannot prepare the versioned media database directory");
+        try (RandomAccessFile owner = new RandomAccessFile(new File(directory, current + ".migration.lock"), "rw");
+             FileLock lock = owner.getChannel().lock())
+        {
+            if (target.isFile() || !legacy.isFile())
+                return;
+            // No old process survives an APK replacement. Other new processes use this same migration lease.
+            try (SQLiteDatabase source = SQLiteDatabase.openDatabase(legacy.getPath(), null,
+                                                                     SQLiteDatabase.OPEN_READWRITE))
+            {
+                if (source.getVersion() < 36 || source.getVersion() > maximum)
+                    throw new IOException("Unsupported original media schema; original file retained");
+                try (Cursor checkpoint = source.rawQuery("PRAGMA wal_checkpoint(TRUNCATE)", null))
+                {
+                    if (!checkpoint.moveToFirst() || checkpoint.getInt(0) != 0)
+                        throw new IOException("Original media database is still busy");
+                }
+                check(source);
+            }
+            File staged = new File(directory, current + ".migration-next");
+            try
+            {
+                SQLiteDatabase.deleteDatabase(staged);
+                try (FileInputStream input = new FileInputStream(legacy);
+                     FileOutputStream output = new FileOutputStream(staged))
+                {
+                    byte[] buffer = new byte[65536];
+                    for (int count; (count = input.read(buffer)) != -1;)
+                        output.write(buffer, 0, count);
+                    output.getFD().sync();
+                }
+                try (VideoOpenHelper helper = new VideoOpenHelper(context, staged.getName(), maximum))
+                {
+                    SQLiteDatabase copied = helper.getWritableDatabase();
+                    check(copied);
+                    try (Cursor checkpoint = copied.rawQuery("PRAGMA wal_checkpoint(TRUNCATE)", null))
+                    {
+                        if (!checkpoint.moveToFirst() || checkpoint.getInt(0) != 0)
+                            throw new IOException("Versioned media copy is still busy");
+                    }
+                    copied.disableWriteAheadLogging();
+                    try (Cursor mode = copied.rawQuery("PRAGMA journal_mode", null))
+                    {
+                        if (!mode.moveToFirst() || "wal".equalsIgnoreCase(mode.getString(0)))
+                            throw new IOException("Versioned media copy has an outstanding journal");
+                    }
+                }
+                try (RandomAccessFile synced = new RandomAccessFile(staged, "rw"))
+                {
+                    synced.getFD().sync();
+                }
+                if (!staged.renameTo(target))
+                    throw new IOException("Cannot install the versioned media copy");
+            }
+            finally
+            {
+                if (staged.exists() && !SQLiteDatabase.deleteDatabase(staged))
+                    throw new IOException("Could not remove incomplete media copy; original file retained");
+            }
+        }
+    }
+
+    private static void check(SQLiteDatabase database) throws IOException
+    {
+        try (Cursor check = database.rawQuery("PRAGMA quick_check", null))
+        {
+            if (!check.moveToFirst() || !"ok".equals(check.getString(0)))
+                throw new IOException("Media copy failed integrity verification; original file retained");
+        }
+    }
+
+    private MediaDatabaseUpgrade()
+    {
+    }
+}
