diff --git a/src/com/archos/mediaprovider/video/PersonalVideoActions.java b/src/com/archos/mediaprovider/video/PersonalVideoActions.java
new file mode 100644
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/PersonalVideoActions.java
@@ -0,0 +1,319 @@
+package com.archos.mediaprovider.video;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.net.Uri;
+import androidx.preference.PreferenceManager;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Worker-only personal-file role. Identification, hidden state and playback columns are never overwritten. */
+public final class PersonalVideoActions
+{
+    public static final String COLUMN = "Supernova_personalVideo";
+    public static final String REVISION = "Supernova_personalRevision";
+    public static final String VISIBLE = "ifnull(" + COLUMN + ",0)=0";
+    public static final String PENDING = "supernova_restore_pending_hidden_v2";
+
+    public static final class Change
+    {
+        public final long videoId;
+        private final MissingMediaActions.StoredFile expected;
+        private final boolean before, after;
+        private final long revision;
+        private final String pendingBefore, pendingAfter;
+
+        private Change(MissingMediaActions.StoredFile expected, boolean before, boolean after,
+                       String pendingBefore, String pendingAfter, long revision)
+        {
+            videoId = expected.id();
+            this.expected = expected;
+            this.before = before;
+            this.after = after;
+            this.pendingBefore = pendingBefore;
+            this.pendingAfter = pendingAfter;
+            this.revision = revision;
+        }
+    }
+
+    static boolean hasColumn(SQLiteDatabase database)
+    {
+        try (Cursor columns = database.rawQuery("PRAGMA table_info(files)", null))
+        {
+            while (columns.moveToNext())
+                if (COLUMN.equals(columns.getString(1)))
+                    return true;
+        }
+        return false;
+    }
+
+    /** Unfiltered inventory for backup and Files. Returns empty on historical schemas without the extension. */
+    public static Set<Long> read(SQLiteDatabase database)
+    {
+        if (!hasColumn(database))
+            return Set.of();
+        Set<Long> ids = new HashSet<>();
+        try (Cursor rows = database.query("files", new String[] {"_id"}, COLUMN + "=1", null, null, null, null))
+        {
+            while (rows.moveToNext())
+                ids.add(rows.getLong(0));
+        }
+        return Set.copyOf(ids);
+    }
+
+    public static boolean isPersonal(Context context, long id)
+    {
+        try (VideoOpenHelper helper = new VideoOpenHelper(context);
+             Cursor row = helper.getReadableDatabase().query("files", new String[] {COLUMN}, "_id=?",
+                                                              new String[] {Long.toString(id)}, null, null, null))
+        {
+            return row.moveToFirst() && row.getInt(0) == 1;
+        }
+    }
+
+    public static Change set(Context context, MissingMediaActions.StoredFile expected, boolean personal)
+        throws Exception
+    {
+        try (ScanProcessLock lock = ScanProcessLock.acquire(new File(context.getFilesDir(), "supernova-scan.lock"),
+                                                           () -> Thread.currentThread().isInterrupted());
+             VideoOpenHelper helper = new VideoOpenHelper(context))
+        {
+            SQLiteDatabase db = helper.getWritableDatabase();
+            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+            db.beginTransaction();
+            try
+            {
+                reconcilePending(db, prefs.getString(PENDING, null));
+                boolean before = role(db, expected);
+                String pending = prefs.getString(PENDING, null);
+                String after = withoutPending(pending, fingerprint(expected.path()));
+                write(db, expected, personal);
+                if (!java.util.Objects.equals(pending, after))
+                    savePending(prefs, after);
+                db.setTransactionSuccessful();
+                return new Change(expected, before, personal, pending, after, revision(db, expected.id()));
+            }
+            finally
+            {
+                db.endTransaction();
+                context.getContentResolver().notifyChange(VideoStore.Video.Media.EXTERNAL_CONTENT_URI, null);
+            }
+        }
+    }
+
+    public static boolean undo(Context context, Change change) throws Exception
+    {
+        try (ScanProcessLock lock = ScanProcessLock.acquire(new File(context.getFilesDir(), "supernova-scan.lock"),
+                                                           () -> Thread.currentThread().isInterrupted());
+             VideoOpenHelper helper = new VideoOpenHelper(context))
+        {
+            SQLiteDatabase db = helper.getWritableDatabase();
+            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+            db.beginTransaction();
+            try
+            {
+                if (revision(db, change.videoId) != change.revision || role(db, change.expected) != change.after ||
+                    !java.util.Objects.equals(prefs.getString(PENDING, null), change.pendingAfter))
+                    return false;
+                write(db, change.expected, change.before);
+                if (!java.util.Objects.equals(change.pendingBefore, change.pendingAfter))
+                    savePending(prefs, change.pendingBefore);
+                db.setTransactionSuccessful();
+            }
+            finally
+            {
+                db.endTransaction();
+            }
+        }
+        context.getContentResolver().notifyChange(VideoStore.Video.Media.EXTERNAL_CONTENT_URI, null);
+        return true;
+    }
+
+    private static boolean role(SQLiteDatabase db, MissingMediaActions.StoredFile expected) throws IOException
+    {
+        try (Cursor row = db.query("files", new String[] {COLUMN}, guard(expected), arguments(expected),
+                                   null, null, null))
+        {
+            if (!row.moveToFirst())
+                throw new IOException("Personal-file identity changed");
+            return row.getInt(0) == 1;
+        }
+    }
+
+    private static void write(SQLiteDatabase db, MissingMediaActions.StoredFile expected, boolean personal)
+        throws IOException
+    {
+        ContentValues values = new ContentValues();
+        values.put(COLUMN, personal ? 1 : 0);
+        if (db.update("files", values, guard(expected), arguments(expected)) != 1)
+            throw new IOException("Personal-file identity changed");
+        advanceRevision(db, expected.id());
+    }
+
+    public static void advanceRevision(SQLiteDatabase db, long id)
+    {
+        db.execSQL("UPDATE files SET " + REVISION + "=ifnull(" + REVISION + ",0)+1 WHERE _id=?", new Object[] {id});
+    }
+
+    private static long revision(SQLiteDatabase db, long id) throws IOException
+    {
+        try (Cursor row = db.query("files", new String[] {REVISION}, "_id=?",
+                                   new String[] {Long.toString(id)}, null, null, null))
+        {
+            if (!row.moveToFirst())
+                throw new IOException("Personal-file identity changed");
+            return row.getLong(0);
+        }
+    }
+
+    private static String guard(MissingMediaActions.StoredFile row)
+    {
+        return "_id=? AND _data=? AND " + (row.size() < 0 ? "(_size IS NULL OR _size<0)" : "_size=?");
+    }
+
+    private static String[] arguments(MissingMediaActions.StoredFile row)
+    {
+        return row.size() < 0 ? new String[] {"" + row.id(), row.path()}
+                             : new String[] {"" + row.id(), row.path(), "" + row.size()};
+    }
+
+    private static void savePending(SharedPreferences prefs, String pending) throws IOException
+    {
+        SharedPreferences.Editor edit = prefs.edit();
+        if (pending == null)
+            edit.remove(PENDING);
+        else
+            edit.putString(PENDING, pending);
+        if (!edit.commit())
+            throw new IOException("Personal-file pending state could not be saved");
+    }
+
+    private static String withoutPending(String pending, String fingerprint) throws Exception
+    {
+        if (pending == null || fingerprint == null)
+            return pending;
+        JSONObject payload = new JSONObject(pending);
+        JSONArray personal = payload.optJSONArray("personal");
+        if (payload.optInt("schema") != 2 || personal == null)
+            return pending;
+        JSONArray retained = new JSONArray();
+        for (int i = 0; i < personal.length(); i++)
+            if (!fingerprint.equals(personal.getJSONObject(i).getString("physical")))
+                retained.put(personal.getJSONObject(i));
+        if (retained.length() == personal.length())
+            return pending;
+        return payload.put("personal", retained).toString();
+    }
+
+    /** Restore future-file roles before automatic matching or a library snapshot is admitted. */
+    public static void reconcilePending(Context context) throws Exception
+    {
+        String pending = PreferenceManager.getDefaultSharedPreferences(context).getString(PENDING, null);
+        if (pending == null || !pending.contains("\"personal\""))
+            return;
+        try (VideoOpenHelper helper = new VideoOpenHelper(context))
+        {
+            SQLiteDatabase db = helper.getWritableDatabase();
+            db.beginTransaction();
+            try
+            {
+                reconcilePending(db, pending);
+                db.setTransactionSuccessful();
+            }
+            finally
+            {
+                db.endTransaction();
+            }
+        }
+    }
+
+    private static void reconcilePending(SQLiteDatabase db, String pending) throws Exception
+    {
+        if (pending == null)
+            return;
+        JSONObject payload = new JSONObject(pending);
+        JSONArray personal = payload.optJSONArray("personal");
+        if (payload.optInt("schema") != 2 || personal == null)
+            return;
+        if (personal.length() > 100000)
+            throw new IOException("Personal-file restore exceeds supported limits");
+        Set<String> wanted = new HashSet<>();
+        for (int i = 0; i < personal.length(); i++)
+        {
+            String ref = personal.getJSONObject(i).getString("physical");
+            if (ref.matches("file:[a-f0-9]{64}"))
+                wanted.add(ref);
+        }
+        if (wanted.isEmpty())
+            return;
+        try (Cursor rows = db.query("files", new String[] {"_id", "_data"}, VISIBLE, null, null, null, null))
+        {
+            while (rows.moveToNext())
+            {
+                if (Thread.currentThread().isInterrupted())
+                    throw new java.io.InterruptedIOException("Personal-file restore stopped");
+                if (wanted.contains(fingerprint(rows.getString(1))))
+                {
+                    ContentValues value = new ContentValues();
+                    value.put(COLUMN, 1);
+                    db.update("files", value, "_id=?", new String[] {Long.toString(rows.getLong(0))});
+                }
+            }
+        }
+    }
+
+    /** Exact portable physical reference; credential/query-bearing locators never auto-bind. */
+    public static String fingerprint(String path) throws Exception
+    {
+        if (path == null || path.isEmpty())
+            return null;
+        Uri uri = Uri.parse(path);
+        if (uri.getEncodedQuery() != null || uri.getEncodedFragment() != null ||
+            uri.getAuthority() != null && uri.getAuthority().contains("@"))
+            return null;
+        if (uri.getScheme() == null)
+        {
+            if (!path.startsWith("/"))
+                return null;
+            uri = Uri.fromFile(new File(path));
+        }
+        if ("file".equalsIgnoreCase(uri.getScheme()) && (uri.getHost() == null || uri.getHost().isEmpty()))
+            uri = Uri.fromFile(new File(uri.getPath()));
+        Uri.Builder safe = uri.buildUpon().clearQuery().fragment(null);
+        if (uri.getHost() != null)
+            safe.encodedAuthority(uri.getHost() + (uri.getPort() > 0 ? ":" + uri.getPort() : ""));
+        StringBuilder value = new StringBuilder("file:");
+        for (byte part : MessageDigest.getInstance("SHA-256").digest(
+                 safe.build().toString().getBytes(StandardCharsets.UTF_8)))
+            value.append(String.format(Locale.ROOT, "%02x", part & 255));
+        return value.toString();
+    }
+
+    /** Serialises a scan's final metadata save with role changes; -2 means deliberately personal. */
+    public static long saveIfMatchable(Context context, long id, com.archos.mediascraper.BaseTags tags)
+    {
+        try (ScanProcessLock lock = ScanProcessLock.acquire(new File(context.getFilesDir(), "supernova-scan.lock"),
+                                                           () -> Thread.currentThread().isInterrupted()))
+        {
+            return isPersonal(context, id) ? -2 : tags.save(context, id);
+        }
+        catch (IOException unavailable)
+        {
+            throw new IllegalStateException("Matching ownership unavailable", unavailable);
+        }
+    }
+
+    private PersonalVideoActions()
+    {
+    }
+}
diff --git a/src/com/archos/mediaprovider/video/PhysicalIndexOwnership.java b/src/com/archos/mediaprovider/video/PhysicalIndexOwnership.java
new file mode 100644
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/PhysicalIndexOwnership.java
@@ -0,0 +1,207 @@
+package com.archos.mediaprovider.video;
+
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.DatabaseUtils;
+import android.database.sqlite.SQLiteDatabase;
+import android.net.Uri;
+import android.provider.MediaStore;
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Physical remote_id belongs to an index. Public _id belongs to the user's library row. */
+final class PhysicalIndexOwnership
+{
+    static boolean local(String path)
+    {
+        String scheme = Uri.parse(path).getScheme();
+        return scheme == null || scheme.equals("file") || scheme.equals("content");
+    }
+
+    static ContentValues localDestination(ContentResolver resolver, String replacement, long size) throws IOException
+    {
+        Uri uri = Uri.parse(replacement);
+        if (uri.getScheme() != null && !uri.getScheme().equals("file"))
+            throw new IOException("Replacement needs an indexed local file");
+        String path = uri.getScheme() == null ? replacement : uri.getPath();
+        try (Cursor rows = resolver.query(MediaStore.Files.getContentUri("external"),
+            new String[] {"_id", "_data", "_display_name", "_size", "date_modified"},
+            "_data=? AND media_type=3", new String[] {path}, null))
+        {
+            if (rows == null || rows.getCount() != 1 || !rows.moveToFirst() || rows.isNull(3) || rows.getLong(3) != size)
+                throw new IOException("Replacement has no unique local MediaStore identity");
+            ContentValues values = new ContentValues();
+            DatabaseUtils.cursorRowToContentValues(rows, values);
+            if (values.getAsLong("_id") <= 0 || values.getAsLong("_id") >= VideoOpenHelper.SCANNED_ID_OFFSET)
+                throw new IOException("Local MediaStore identity is outside its index range");
+            return values;
+        }
+        catch (RuntimeException unavailable)
+        {
+            throw new IOException("Local MediaStore identity is unavailable", unavailable);
+        }
+    }
+
+    /** Import replacements use an in-place write so recursive DELETE triggers cannot destroy retained user state. */
+    static long upsertImported(SQLiteDatabase db, ContentValues values)
+    {
+        Long id = values.getAsLong("_id");
+        String path = values.getAsString("_data");
+        if (id == null || path == null)
+            return db.insert("files_import", null, values);
+        db.beginTransaction();
+        try
+        {
+            boolean existing;
+            try (Cursor row = db.rawQuery("SELECT _id,_data FROM files_import WHERE _id=? OR _data=?",
+                                         new String[] {"" + id, path}))
+            {
+                existing = row.moveToFirst();
+                if (existing && (row.getCount() != 1 || row.getLong(0) != id || !path.equals(row.getString(1))))
+                    throw new IllegalStateException("Import identity requires reconciliation before replacement");
+            }
+            long result;
+            if (existing)
+            {
+                db.update("files_import", values, "_id=? AND _data=?", new String[] {"" + id, path});
+                ContentValues physical = compatible(db, "files", values);
+                physical.remove("_id");
+                physical.remove("remote_id");
+                db.update("files", physical, "remote_id=? AND _data=?", new String[] {"" + id, path});
+                result = id;
+            }
+            else
+                result = db.insertOrThrow("files_import", null, values);
+            db.setTransactionSuccessful();
+            return result;
+        }
+        finally
+        {
+            db.endTransaction();
+        }
+    }
+
+    static long publicId(ContentResolver resolver, long remote, String path)
+    {
+        try (Cursor row = resolver.query(VideoStoreInternal.FILES, new String[] {"_id"},
+                                         "remote_id=? AND _data=?", new String[] {"" + remote, path}, null))
+        {
+            return row != null && row.moveToFirst() ? row.getLong(0) : remote;
+        }
+    }
+
+    /** Caller owns the SQLite transaction and scan lock. No identity, metadata or playback row is replaced. */
+    static boolean move(SQLiteDatabase db, MissingMediaActions.StoredFile expected, long oldRemote,
+                        String replacement, ContentValues local) throws IOException
+    {
+        boolean toLocal = local(replacement);
+        if (toLocal && local == null)
+            throw new IOException("Local destination must be resolved through MediaStore");
+        String oldTable = oldRemote >= VideoOpenHelper.SCANNED_ID_OFFSET ? "files_scanned" : "files_import";
+        long oldRaw = oldRemote >= VideoOpenHelper.SCANNED_ID_OFFSET
+            ? oldRemote - VideoOpenHelper.SCANNED_ID_OFFSET : oldRemote;
+        ContentValues previous = new ContentValues();
