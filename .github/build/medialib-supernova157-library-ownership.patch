+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.ArgumentMatchers.isNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import java.io.File;
+import java.nio.file.Files;
+import java.util.Arrays;
+import java.util.Set;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class LocalSourceScanTest
+{
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test public void exactRegisteredFolderIsRequiredAndSqlWildcardsAreLiteral()
+    {
+        Set<String> roots = Set.of("file:///storage/Movies_100%", "file:///storage/Shows");
+        assertTrue(LocalSourceScan.registered(roots, Uri.parse("file:///storage/Movies_100%/")));
+        assertFalse(LocalSourceScan.registered(roots, Uri.parse("file:///storage")));
+        assertFalse(LocalSourceScan.registered(roots, Uri.parse("file:///storage/Movies_100%/Other")));
+        assertEquals("/storage/Movies\\_100\\%/", VideoStoreImportImpl.literalPrefix("/storage/Movies_100%/"));
+    }
+
+    @Test public void sourceSnapshotRejectsRowsOutsideTheChosenFolderEvenIfProviderIgnoresItsSelection()
+    {
+        ContentResolver resolver = mock(ContentResolver.class);
+        String chosen = "/storage/Movies_100%";
+        MatrixCursor imported = new MatrixCursor(new String[] {"_id", "_data"});
+        imported.addRow(new Object[] {10, chosen + "/One.mkv"});
+        imported.addRow(new Object[] {11, "/storage/Shows/Other.mkv"});
+        MatrixCursor media = new MatrixCursor(new String[] {"_id", "_data", "_display_name", "_size",
+            "date_added", "date_modified", "bucket_id", "bucket_display_name", "format", "parent"});
+        media.addRow(new Object[] {10, chosen + "/One.mkv", "One.mkv", 123, 100, 200, "b", "Movies", 0, 1});
+        media.addRow(new Object[] {11, "/storage/Shows/Other.mkv", "Other.mkv", 123, 100, 200, "c", "Shows", 0, 1});
+        when(resolver.query(eq(VideoStoreInternal.FILES_IMPORT), any(String[].class), any(Bundle.class), isNull()))
+            .thenReturn(imported);
+        when(resolver.query(eq(MediaStore.Files.getContentUri("external")), any(String[].class),
+                            any(Bundle.class), isNull())).thenReturn(media);
+        var snapshot = VideoStoreImportImpl.loadMountedStorageSnapshot(resolver,
+            List.of(new VideoStoreImportImpl.StorageLocation(chosen, null, false)));
+        assertTrue(snapshot.complete);
+        assertEquals(Set.of(10L), snapshot.mediaStoreIds);
+        assertEquals(Set.of(10L), snapshot.importedIds);
+    }
+
+    @Test public void unchangedFilesSkipSystemMetadataProbeAndChangedOrNewFilesRemainInTheSelectedScope()
+        throws Exception
+    {
+        File chosen = temporary.newFolder("chosen_100%");
+        File unchanged = new File(chosen, "same.mkv");
+        File changed = new File(chosen, "changed.mkv");
+        File added = new File(chosen, "new.mkv");
+        Files.write(unchanged.toPath(), new byte[] {1});
+        Files.write(changed.toPath(), new byte[] {1, 2});
+        Files.write(added.toPath(), new byte[] {1});
+        android.content.Context context = mock(android.content.Context.class);
+        ContentResolver resolver = mock(ContentResolver.class);
+        when(context.getContentResolver()).thenReturn(resolver);
+        MatrixCursor rows = new MatrixCursor(new String[] {"_data", "_size", "date_modified"});
+        rows.addRow(new Object[] {unchanged.getCanonicalPath(), 1, unchanged.lastModified() / 1000});
+        rows.addRow(new Object[] {changed.getCanonicalPath(), 1, changed.lastModified() / 1000});
+        when(resolver.query(eq(MediaStore.Files.getContentUri("external")), any(String[].class),
+                            any(String.class), any(String[].class), isNull())).thenReturn(rows);
+        assertEquals(Set.of(changed.getCanonicalPath(), added.getCanonicalPath()), Set.copyOf(Arrays.asList(
+            LocalSourceScan.changedFiles(context, Uri.fromFile(chosen),
+                new String[] {unchanged.getCanonicalPath(), changed.getCanonicalPath(), added.getCanonicalPath()},
+                () -> false))));
+    }
+
+    @Test public void recursiveSystemScanInventoryNeverLeavesTheSelectedRoot() throws Exception
+    {
+        File chosen = temporary.newFolder("chosen");
+        File child = new File(chosen, "child");
+        assertTrue(child.mkdir());
+        File video = new File(child, "Movie.mkv");
+        assertTrue(video.createNewFile());
+        File outside = temporary.newFolder("outside");
+        assertTrue(new File(outside, "Other.mkv").createNewFile());
+        Files.createSymbolicLink(new File(chosen, "escape").toPath(), outside.toPath());
+        Files.createSymbolicLink(new File(child, "loop").toPath(), chosen.toPath());
+        assertEquals(Set.of(video.getCanonicalPath()),
+                     Set.copyOf(Arrays.asList(LocalSourceScan.inventory(chosen, () -> false))));
+        assertThrows(java.io.InterruptedIOException.class, () -> LocalSourceScan.inventory(chosen, () -> true));
+    }
+}
