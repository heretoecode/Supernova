diff --git a/src/com/archos/mediaprovider/video/LocalSourceScan.java b/src/com/archos/mediaprovider/video/LocalSourceScan.java
new file mode 100644
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/LocalSourceScan.java
@@ -0,0 +1,295 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.Intent;
+import android.media.MediaScannerConnection;
+import android.net.Uri;
+import androidx.preference.PreferenceManager;
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** One owned local-source request. Android's system scan is not killed; stale callbacks cannot admit an import. */
+public final class LocalSourceScan
+{
+    static final String ACTION = "app.supernova.player.SCAN_ONE_LOCAL_SOURCE";
+    private static final AtomicReference<Job> ACTIVE = new AtomicReference<>();
+    private static final java.util.concurrent.ThreadPoolExecutor WORK = new java.util.concurrent.ThreadPoolExecutor(
+        1, 1, 0, TimeUnit.MILLISECONDS, new java.util.concurrent.ArrayBlockingQueue<>(1), task -> {
+        Thread thread = new Thread(task, "LocalSourceAdmission");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private static final ScheduledExecutorService CLOCK = Executors.newSingleThreadScheduledExecutor(task -> {
+        Thread thread = new Thread(task, "LocalSourceStartDeadline");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private static final class Job
+    {
+        final Context context;
+        final Uri root;
+        final String batch = UUID.randomUUID().toString();
+        final long generation = NetworkScanLedger.generation();
+        volatile boolean stopped;
+        volatile long lastProgress = android.os.SystemClock.elapsedRealtime();
+        boolean running, ended;
+        long checked, total = -1, added, removed, updated;
+        java.util.concurrent.ScheduledFuture<?> deadline;
+
+        Job(Context context, Uri root)
+        {
+            this.context = context;
+            this.root = root;
+        }
+    }
+
+    public static boolean request(Context context, Uri root)
+    {
+        if (root == null || !"file".equals(root.getScheme()) || root.getPath() == null ||
+            root.getPath().isEmpty() || root.getAuthority() != null && !root.getAuthority().isEmpty())
+            return false;
+        Job job = new Job(context.getApplicationContext(), root);
+        if (!ACTIVE.compareAndSet(null, job))
+            return false;
+        event(job, "queued");
+        job.deadline = CLOCK.scheduleWithFixedDelay(() -> checkDeadline(job), 5, 5, TimeUnit.SECONDS);
+        try
+        {
+            WORK.execute(() -> {
+            try
+            {
+                if (stopped(job))
+                    return;
+                Set<String> configured = PreferenceManager.getDefaultSharedPreferences(job.context)
+                    .getStringSet("supernova_library_roots", Set.of());
+                if (!SupernovaLibraryPolicy.configured(job.context) || !registered(configured, root) ||
+                    !new File(root.getPath()).isDirectory())
+                    throw new IllegalArgumentException("Local source is unavailable or not registered");
+                if (stopped(job))
+                {
+                    finish(job, "cancelled");
+                    return;
+                }
+                java.util.function.BooleanSupplier checkpoint = () -> {
+                    job.lastProgress = android.os.SystemClock.elapsedRealtime();
+                    return stopped(job);
+                };
+                String[] paths = inventory(new File(root.getPath()), checkpoint);
+                paths = changedFiles(job.context, root, paths, checkpoint);
+                if (paths.length == 0)
+                    ready(job);
+                else
+                {
+                    AtomicInteger remaining = new AtomicInteger(paths.length);
+                    MediaScannerConnection.scanFile(job.context, paths, null, (path, uri) -> {
+                        job.lastProgress = android.os.SystemClock.elapsedRealtime();
+                        if (remaining.decrementAndGet() == 0)
+                            ready(job);
+                    });
+                }
+            }
+            catch (Exception unavailable)
+            {
+                finish(job, stopped(job) ? "cancelled" : "failed");
+            }
+            });
+            return true;
+        }
+        catch (java.util.concurrent.RejectedExecutionException unavailable)
+        {
+            finish(job, "failed");
+            return false;
+        }
+    }
+
+    /** Probe only new/changed entries. Re-reading metadata for every unchanged file doubles ordinary scan work. */
+    static String[] changedFiles(Context context, Uri root, String[] paths,
+                                 java.util.function.BooleanSupplier stopped) throws IOException
+    {
+        java.util.Map<String, long[]> indexed = new java.util.HashMap<>();
+        String base = new File(root.getPath()).getCanonicalPath();
+        String prefix = base.endsWith("/") ? base : base + "/";
+        try (android.database.Cursor rows = context.getContentResolver().query(
+            android.provider.MediaStore.Files.getContentUri("external"),
+            new String[] {"_data", "_size", "date_modified"}, "_data LIKE ? ESCAPE '\\'",
+            new String[] {VideoStoreImportImpl.literalPrefix(prefix) + "%"}, null))
+        {
+            if (rows == null)
+                throw new IOException("Local source MediaStore snapshot unavailable");
+            while (rows.moveToNext())
+            {
+                if (stopped.getAsBoolean())
+                    throw new java.io.InterruptedIOException("Local source scan stopped");
+                if (!rows.isNull(0) && rows.getString(0).startsWith(prefix))
+                    indexed.put(rows.getString(0), new long[] {rows.isNull(1) ? -1 : rows.getLong(1),
+                                                              rows.isNull(2) ? -1 : rows.getLong(2)});
+            }
+        }
+        ArrayList<String> changed = new ArrayList<>();
+        for (String path : paths)
+        {
+            if (stopped.getAsBoolean())
+                throw new java.io.InterruptedIOException("Local source scan stopped");
+            File file = new File(path);
+            long[] known = indexed.get(path);
+            if (known == null || known[0] != file.length() || known[1] <= 0 ||
+                known[1] != file.lastModified() / 1000)
+                changed.add(path);
+        }
+        return changed.toArray(new String[0]);
+    }
+
+    /** Canonical containment prevents symlinks escaping the selected source; bounds fail before importing. */
+    static String[] inventory(File root, java.util.function.BooleanSupplier stopped) throws IOException
+    {
+        String base = root.getCanonicalPath();
+        String prefix = base.endsWith("/") ? base : base + "/";
+        ArrayDeque<File> pending = new ArrayDeque<>();
+        Set<String> visited = new HashSet<>();
+        ArrayList<String> paths = new ArrayList<>();
+        pending.add(root);
+        while (!pending.isEmpty())
+        {
+            if (stopped.getAsBoolean())
+                throw new java.io.InterruptedIOException("Local source scan stopped");
+            File entry = pending.removeFirst();
+            String path = entry.getCanonicalPath();
+            if (!(path.equals(base) || path.startsWith(prefix)) || !visited.add(path))
+                continue;
+            if (visited.size() > 100000)
+                throw new IOException("Local source inventory exceeds the safe bound");
+            if (entry.isDirectory())
+            {
+                File[] children = entry.listFiles();
+                if (children == null)
+                    throw new IOException("Local source directory could not be read");
+                java.util.Collections.addAll(pending, children);
+            }
+            else if (entry.isFile())
+                paths.add(path);
+        }
+        return paths.toArray(new String[0]);
+    }
+
+    static boolean registered(Set<String> configured, Uri root)
+    {
+        String key = SupernovaLibraryPolicy.canonical(root);
+        for (String saved : configured)
+            if (SupernovaLibraryPolicy.canonical(Uri.parse(saved)).equals(key))
+                return true;
+        return false;
+    }
+
+    private static synchronized boolean stopped(Job job)
+    {
+        return job.stopped || job.ended || ACTIVE.get() != job || job.generation != NetworkScanLedger.generation();
+    }
+
+    private static void ready(Job job)
+    {
+        if (stopped(job))
+            return;
+        try
+        {
+            job.context.startService(new Intent(job.context, VideoStoreImportService.class).setAction(ACTION)
+                .setData(job.root).putExtra("source_batch", job.batch));
+        }
+        catch (RuntimeException unavailable)
+        {
+            finish(job, "failed");
+        }
+    }
+
+    static void run(Context context, VideoStoreImportImpl importer, String batch)
+    {
+        Job job;
+        synchronized (LocalSourceScan.class)
+        {
+            job = ACTIVE.get();
+            if (job == null || !job.batch.equals(batch) || stopped(job))
+                return;
+            job.running = true;
+            job.deadline.cancel(false);
+        }
+        event(job, "started");
+        try
+        {
+            VideoStoreImportImpl.SourceResult result = importer.doScopedImport(job.root,
+                (checked, total, added, removed, updated) -> {
+                    synchronized (LocalSourceScan.class)
+                    {
+                        job.checked = checked;
+                        job.total = total;
+                        job.added = added;
+                        job.removed = removed;
+                        job.updated = updated;
+                    }
+                    event(job, "indexing");
+                }, () -> stopped(job));
+            job.checked = result.checked();
+            job.total = result.checked();
+            job.added = result.added();
+            job.removed = result.removed();
+            job.updated = result.updated();
+            finish(job, stopped(job) ? "cancelled" : "complete");
+        }
+        catch (Exception unavailable)
+        {
+            finish(job, stopped(job) || Thread.currentThread().isInterrupted() ? "cancelled" : "failed");
+        }
+    }
+
+    public static synchronized void stop()
+    {
+        Job job = ACTIVE.get();
+        if (job != null)
+        {
+            job.stopped = true;
+            if (!job.running)
+                finish(job, "cancelled");
+        }
+    }
+
+    static boolean active()
+    {
+        return ACTIVE.get() != null;
+    }
+
+    private static synchronized void checkDeadline(Job job)
+    {
+        if (!job.ended && !job.running && android.os.SystemClock.elapsedRealtime() - job.lastProgress >= 60000)
+            finish(job, "failed");
+    }
+
+    private static synchronized void finish(Job job, String phase)
+    {
+        if (job.ended)
+            return;
+        job.ended = true;
+        if (job.deadline != null)
+            job.deadline.cancel(false);
+        event(job, phase);
+        ACTIVE.compareAndSet(job, null);
+    }
+
+    private static synchronized void event(Job job, String phase)
+    {
+        NetworkScannerServiceVideo.previewSourceEvent(job.context, job.root, phase, job.batch, 1,
+            job.checked, job.total, job.added, job.updated, job.removed);
+    }
+
+    private LocalSourceScan()
+    {
+    }
+}
