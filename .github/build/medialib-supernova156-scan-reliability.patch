diff --git a/src/com/archos/mediascraper/ScanMetadataHandoff.java b/src/com/archos/mediascraper/ScanMetadataHandoff.java
new file mode 100644
index 0000000..a4a0e48
--- /dev/null
+++ b/src/com/archos/mediascraper/ScanMetadataHandoff.java
@@ -0,0 +1,87 @@
+package com.archos.mediascraper;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import androidx.lifecycle.DefaultLifecycleObserver;
+import androidx.lifecycle.Lifecycle;
+import androidx.lifecycle.LifecycleOwner;
+import androidx.lifecycle.ProcessLifecycleOwner;
+import com.archos.mediaprovider.video.ScanFailure;
+import java.io.IOException;
+
+/** A completed import must not use startService from the background on Android O+. */
+public final class ScanMetadataHandoff
+{
+    private static boolean installed;
+    private static final String PENDING = "pending";
+    private static final String FORCE = "force";
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+
+    private static SharedPreferences prefs(Context context)
+    {
+        return context.getSharedPreferences("scan-metadata-handoff", Context.MODE_PRIVATE);
+    }
+
+    public static void install(Context context)
+    {
+        Context app = context.getApplicationContext();
+        MAIN.post(() -> {
+            synchronized (ScanMetadataHandoff.class)
+            {
+                if (installed)
+                    return;
+                installed = true;
+            }
+            ProcessLifecycleOwner.get().getLifecycle().addObserver(new DefaultLifecycleObserver() {
+                @Override public void onStart(LifecycleOwner owner)
+                {
+                    drain(app);
+                }
+            });
+            if (ProcessLifecycleOwner.get().getLifecycle().getCurrentState().isAtLeast(Lifecycle.State.STARTED))
+            {
+                drain(app);
+            }
+        });
+    }
+
+    static synchronized ComponentName request(Context context, Intent intent) throws IOException
+    {
+        install(context);
+        SharedPreferences prefs = prefs(context);
+        boolean forced = prefs.getBoolean(FORCE, false) || intent.getBooleanExtra("FORCE_AFTER_NETWORK_SCAN", false);
+        if (!prefs.edit().putBoolean(PENDING, true).putBoolean(FORCE, forced).commit())
+        {
+            throw new IOException("Cannot preserve metadata handoff");
+        }
+        if (!ProcessLifecycleOwner.get().getLifecycle().getCurrentState().isAtLeast(Lifecycle.State.STARTED))
+        {
+            ScanFailure.stage("metadata_deferred_until_foreground");
+            return new ComponentName(context, AutoScrapeService.class);
+        }
+        intent.putExtra("FORCE_AFTER_NETWORK_SCAN", forced);
+        ComponentName started = context.startService(intent);
+        if (started == null)
+        {
+            throw new IOException("Metadata service not resolved");
+        }
+        prefs.edit().remove(PENDING).remove(FORCE).commit();
+        return started;
+    }
+
+    private static void drain(Context context)
+    {
+        if (prefs(context).getBoolean(PENDING, false))
+        {
+            AutoScrapeService.requestService(context);
+        }
+    }
+
+    private ScanMetadataHandoff()
+    {
+    }
+}
