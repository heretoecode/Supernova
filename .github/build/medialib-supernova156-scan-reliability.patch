new file mode 100644
index 0000000..d7f6d1f
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/ScanFailure.java
@@ -0,0 +1,55 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Intent;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+
+/** Worker-local failure evidence, transported only to the app's package-scoped lifecycle recorder. */
+public final class ScanFailure
+{
+    private static final ThreadLocal<ScanFailure> CURRENT = ThreadLocal.withInitial(ScanFailure::new);
+    private String stage = "dispatch";
+    private Throwable failure;
+
+    public static void begin()
+    {
+        CURRENT.remove();
+    }
+
+    public static void stage(String stage)
+    {
+        if (CURRENT.get().failure == null)
+        {
+            CURRENT.get().stage = stage;
+        }
+    }
+
+    public static void record(String stage, Throwable failure)
+    {
+        ScanFailure current = CURRENT.get();
+        if (current.failure == null)
+        {
+            current.stage = stage;
+            current.failure = failure;
+        }
+    }
+
+    public static Intent attach(Intent event)
+    {
+        ScanFailure current = CURRENT.get();
+        event.putExtra("failure_stage", current.stage);
+        if (current.failure != null)
+        {
+            StringWriter trace = new StringWriter();
+            current.failure.printStackTrace(new PrintWriter(trace));
+            event.putExtra("failure_class", current.failure.getClass().getName());
+            event.putExtra("failure_message", current.failure.getMessage());
+            event.putExtra("failure_trace", trace.toString());
+        }
+        return event;
+    }
+
+    private ScanFailure()
+    {
+    }
+}
diff --git a/src/com/archos/mediaprovider/video/ScanProcessLock.java b/src/com/archos/mediaprovider/video/ScanProcessLock.java
new file mode 100644
index 0000000..c2c93f3
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/ScanProcessLock.java
@@ -0,0 +1,82 @@
+package com.archos.mediaprovider.video;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.io.RandomAccessFile;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.channels.OverlappingFileLockException;
+import java.util.function.BooleanSupplier;
+
+/** A kernel-owned lease: all local/network import workers, including different app processes, serialize writes. */
+public final class ScanProcessLock implements AutoCloseable
+{
+    private final RandomAccessFile owner;
+    private final FileLock lease;
+
+    private ScanProcessLock(RandomAccessFile owner, FileLock lease)
+    {
+        this.owner = owner;
+        this.lease = lease;
+    }
+
+    public static ScanProcessLock acquire(File file, BooleanSupplier cancelled) throws IOException
+    {
+        RandomAccessFile owner = new RandomAccessFile(file, "rw");
+        boolean acquired = false;
+        try
+        {
+            FileChannel channel = owner.getChannel();
+            while (true)
+            {
+                if (cancelled.getAsBoolean() || Thread.currentThread().isInterrupted())
+                {
+                    throw new InterruptedIOException("Scan lock wait cancelled");
+                }
+                FileLock lease = null;
+                try
+                {
+                    lease = channel.tryLock();
+                }
+                catch (OverlappingFileLockException busy)
+                {
+                    // Another worker in this VM owns it; the same path is locked across VMs too.
+                }
+                if (lease != null)
+                {
+                    acquired = true;
+                    return new ScanProcessLock(owner, lease);
+                }
+                try
+                {
+                    Thread.sleep(25);
+                }
+                catch (InterruptedException interrupted)
+                {
+                    Thread.currentThread().interrupt();
+                    throw new InterruptedIOException("Scan lock wait interrupted");
+                }
+            }
+        }
+        finally
+        {
+            if (!acquired)
+            {
+                owner.close();
+            }
+        }
+    }
+
+    @Override public void close() throws IOException
+    {
+        try
+        {
+            lease.release();
+        }
+        finally
+        {
+            owner.close();
+        }
+    }
+}
