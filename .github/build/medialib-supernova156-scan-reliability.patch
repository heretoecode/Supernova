+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Application;
+import android.content.Intent;
+import java.io.IOException;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class) @Config(application = Application.class, sdk = 30) public class ScanFailureTest
+{
+    @Test public void firstCauseSurvivesCleanupAndNextSourceDoesNotInheritIt()
+    {
+        ScanFailure.begin();
+        ScanFailure.record("root_resolution", new IOException("HTTP 401"));
+        ScanFailure.record("batch_completion", new IllegalStateException("later"));
+        Intent failed = ScanFailure.attach(new Intent());
+        assertEquals("root_resolution", failed.getStringExtra("failure_stage"));
+        assertEquals("java.io.IOException", failed.getStringExtra("failure_class"));
+        assertTrue(failed.getStringExtra("failure_trace").contains("HTTP 401"));
+        ScanFailure.begin();
+        ScanFailure.stage("directory_listing");
+        assertEquals("directory_listing", ScanFailure.attach(new Intent()).getStringExtra("failure_stage"));
+    }
+}
diff --git a/test/java/com/archos/mediaprovider/video/ScanProcessLockTest.java b/test/java/com/archos/mediaprovider/video/ScanProcessLockTest.java
new file mode 100644
index 0000000..fea4bdb
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/ScanProcessLockTest.java
@@ -0,0 +1,57 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.assertThrows;
+
+import java.io.File;
+import java.io.InterruptedIOException;
+import java.nio.file.Files;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import org.junit.Test;
+
+public class ScanProcessLockTest
+{
+    public static void main(String[] args) throws Exception
+    {
+        try (ScanProcessLock lease = ScanProcessLock.acquire(new File(args[0]), () -> false))
+        {
+            Files.writeString(new File(args[1]).toPath(), "acquired");
+        }
+    }
+
+    @Test public void secondProcessCannotScanUntilFirstProcessReleasesLease() throws Exception
+    {
+        File directory = Files.createTempDirectory("scan-process-lock").toFile();
+        File lock = new File(directory, "scan.lock");
+        File entered = new File(directory, "entered");
+        Process child = null;
+        try
+        {
+            try (ScanProcessLock lease = ScanProcessLock.acquire(lock, () -> false))
+            {
+                child = new ProcessBuilder(new File(System.getProperty("java.home"), "bin/java").toString(), "-cp",
+                                           System.getProperty("java.class.path"), ScanProcessLockTest.class.getName(),
+                                           lock.toString(), entered.toString())
+                            .inheritIO()
+                            .start();
+                assertFalse(child.waitFor(200, TimeUnit.MILLISECONDS));
+                assertFalse(entered.exists());
+                assertThrows(InterruptedIOException.class, () -> ScanProcessLock.acquire(lock, () -> true));
+            }
+            assertTrue(child.waitFor(5, TimeUnit.SECONDS));
+            assertEquals(0, child.exitValue());
+            assertTrue(entered.exists());
+        }
+        finally
+        {
+            if (child != null)
+                child.destroyForcibly();
+            entered.delete();
+            lock.delete();
+            directory.delete();
+        }
+    }
+}
