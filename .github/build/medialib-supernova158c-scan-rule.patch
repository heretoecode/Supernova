diff --git a/test/java/com/archos/mediaprovider/video/ForegroundImportRuleTest.java b/test/java/com/archos/mediaprovider/video/ForegroundImportRuleTest.java
new file mode 100644
index 0000000..0f7ffb7
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/ForegroundImportRuleTest.java
@@ -0,0 +1,33 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/** D14: leaving and returning within 30 minutes starts no import; a stale library (6 h) imports on return. */
+public class ForegroundImportRuleTest
+{
+    private static final long HOUR = 60L * 60 * 1000;
+
+    @Test
+    public void backWithinHalfAnHourStartsNothing()
+    {
+        long now = 100 * HOUR;
+        assertFalse(ForegroundImportRule.due(now, now - 7 * HOUR, now - 10 * 60 * 1000));
+    }
+
+    @Test
+    public void openedAfterLongerImportsOnlyWhenTheLastIsOverSixHoursOld()
+    {
+        long now = 100 * HOUR;
+        assertFalse(ForegroundImportRule.due(now, now - 2 * HOUR, now - HOUR));
+        assertTrue(ForegroundImportRule.due(now, now - 7 * HOUR, now - HOUR));
+    }
+
+    @Test
+    public void theFirstEverImportAlwaysRuns()
+    {
+        assertTrue(ForegroundImportRule.due(100 * HOUR, 0, 0));
+    }
+}
