@@ -0,0 +1,50 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/**
+ * D14 (owner approved, 26 Nov 2026: scan only when there is something to find). Coming back to Supernova re-read the
+ * whole local library every time (20 imports in 80 minutes, 4-6 minutes each, nothing new). Now:
+ * back within 30 minutes, no import; opened after longer, only when the last import is over 6 hours old. Android's
+ * own "files changed" and drive broadcasts still import at once (they arrive as their own actions).
+ */
+public final class ForegroundImportRule
+{
+    static final long BACK_WITHIN_MS = 30L * 60 * 1000;
+    static final long STALE_AFTER_MS = 6L * 60 * 60 * 1000;
+    static final String LAST_IMPORT = "supernova_foreground_import_at";
+    static final String WENT_AWAY = "supernova_went_background_at";
+
+    private ForegroundImportRule()
+    {
+    }
+
+    /** Pure rule: {@code lastImport} and {@code wentAway} are wall-clock times, 0 when never. */
+    static boolean due(long now, long lastImport, long wentAway)
+    {
+        if (lastImport <= 0 || now < lastImport)
+            return true;
+        if (wentAway > 0 && now >= wentAway && now - wentAway < BACK_WITHIN_MS)
+            return false;
+        return now - lastImport >= STALE_AFTER_MS;
+    }
+
+    /** Whether returning to the app should start a local import now; records it when it does. */
+    public static boolean dueAndRecord(Context context)
+    {
+        SharedPreferences prefs = context.getSharedPreferences("supernova_scan_rule", Context.MODE_PRIVATE);
+        long now = System.currentTimeMillis();
+        boolean due = due(now, prefs.getLong(LAST_IMPORT, 0), prefs.getLong(WENT_AWAY, 0));
+        if (due)
+            prefs.edit().putLong(LAST_IMPORT, now).apply();
+        return due;
+    }
+
+    /** Supernova left the screen. */
+    public static void wentAway(Context context)
+    {
+        context.getSharedPreferences("supernova_scan_rule", Context.MODE_PRIVATE).edit()
+            .putLong(WENT_AWAY, System.currentTimeMillis()).apply();
+    }
+}
