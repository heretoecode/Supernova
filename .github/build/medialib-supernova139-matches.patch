+                        ||!ScraperStore.AUTHORITY.equals(operation.getUri().getAuthority())
+                        &&!(i==0&&operation.isAssertQuery()&&com.archos.mediaprovider.video.VideoStore.AUTHORITY.equals(operation.getUri().getAuthority())))throw new org.json.JSONException("Unsupported canonical recovery operation");
+            }
