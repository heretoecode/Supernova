+package com.archos.mediascraper;
+
+import android.content.ContentProviderOperation;
+import android.content.ContentProviderResult;
+import android.content.ContentResolver;
+import android.content.ContentUris;
+import android.content.OperationApplicationException;
+import android.os.RemoteException;
+import com.archos.mediaprovider.video.ScraperStore;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Canonical operations prepared without application; execution requires the caller's transaction. */
+public final class OwnedCanonicalBatch {
+    public final List<ContentProviderOperation> operations;
+    public final int primaryOperation;
+    OwnedCanonicalBatch(ArrayList<ContentProviderOperation> operations, int primaryOperation) {
+        this.operations = Collections.unmodifiableList(new ArrayList<>(operations));
+        this.primaryOperation = primaryOperation;
+    }
+    /** Freeze the source identification assertion as well as file ownership before any mutation. */
+    public OwnedCanonicalBatch withReceivingState(android.content.ContentValues expected) {
+        if(primaryOperation<1||operations.isEmpty()||!operations.get(0).isAssertQuery()||expected==null)
+            throw new IllegalArgumentException("Receiving assertion requires a guarded canonical batch");
+        ArrayList<ContentProviderOperation> guarded=new ArrayList<>(operations);
+        guarded.set(0,ContentProviderOperation.newAssertQuery(operations.get(0).getUri()).withValues(expected).withExpectedCount(1).build());
+        return new OwnedCanonicalBatch(guarded,primaryOperation);
+    }
+    /** Private in-progress recovery only; never part of a portable backup payload. */
+    public org.json.JSONObject encodeRecovery() throws org.json.JSONException {
+        android.os.Parcel parcel=android.os.Parcel.obtain();
+        try {
+            parcel.writeTypedList(operations);byte[] bytes=parcel.marshall();
+            if(bytes.length>4*1024*1024)throw new org.json.JSONException("Canonical recovery batch exceeds limit");
+            return new org.json.JSONObject().put("schema",1).put("sdk",android.os.Build.VERSION.SDK_INT)
+                    .put("primary",primaryOperation).put("sha256",digest(bytes))
+                    .put("operations",android.util.Base64.encodeToString(bytes,android.util.Base64.NO_WRAP));
+        } finally {parcel.recycle();}
+    }
+    public static OwnedCanonicalBatch decodeRecovery(org.json.JSONObject record) throws org.json.JSONException {
+        if(record.length()!=5||!(record.get("schema") instanceof Integer||record.get("schema") instanceof Long)||record.getLong("schema")!=1
+                ||!(record.get("sdk") instanceof Integer||record.get("sdk") instanceof Long)||record.getLong("sdk")!=android.os.Build.VERSION.SDK_INT
+                ||!(record.get("operations") instanceof String)||record.getString("operations").length()>6*1024*1024
+                ||!(record.get("primary") instanceof Integer||record.get("primary") instanceof Long))
+            throw new org.json.JSONException("Incompatible canonical recovery batch");
+        android.os.Parcel parcel=android.os.Parcel.obtain();
+        try {
+            byte[] bytes=android.util.Base64.decode(record.getString("operations"),android.util.Base64.DEFAULT);
+            if(bytes.length==0||bytes.length>4*1024*1024||!digest(bytes).equals(record.getString("sha256")))throw new org.json.JSONException("Canonical recovery digest mismatch");
