+            int count=parcel.readInt();if(count<=0||count>10000)throw new org.json.JSONException("Invalid canonical recovery operation count");parcel.setDataPosition(0);
+            ArrayList<ContentProviderOperation> decoded=parcel.createTypedArrayList(ContentProviderOperation.CREATOR);
+            long storedPrimary=record.getLong("primary");if(storedPrimary<0||storedPrimary>=count)throw new org.json.JSONException("Invalid canonical recovery primary operation");int primary=(int)storedPrimary;
+            if(decoded==null||decoded.isEmpty()||decoded.size()>10000||parcel.dataAvail()!=0||primary<0||primary>=decoded.size())throw new org.json.JSONException("Invalid canonical recovery operations");
+            android.net.Uri owner=decoded.get(primary).getUri();
