+        if(videoId<=0||metadataId<=0||kind!=BaseTags.MOVIE&&kind!=BaseTags.TV_SHOW||providerId!=null&&providerId<=0||kind==BaseTags.MOVIE&&providerId==null)throw new IllegalArgumentException("Invalid receiving identification clear");
