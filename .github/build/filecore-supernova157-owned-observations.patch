+import java.io.InputStream;
+import java.net.SocketTimeoutException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.After;
+import org.junit.Test;
+
+public class TransportOperationTraceTest
+{
+    @After public void reset()
+    {
+        TransportOperationTrace.install(null);
+    }
+
+    @Test public void preOpenStatusRetryAndActualMinuteDeltasShareOneIdentity() throws Exception
+    {
+        List<TransportOperationTrace.Event> events = new ArrayList<>();
+        TransportOperationTrace.install(events::add);
+        AtomicLong clock = new AtomicLong();
+        InputStream input;
+        try (var operation = new TransportOperationTrace(TransportReadObserver.Protocol.WEBDAVS, clock::get))
+        {
+            TransportOperationTrace.retry();
+            TransportOperationTrace.response(206);
+            clock.set(123_000_000);
+            input = operation.observe(new ByteArrayInputStream(new byte[] {1, 2, 3}));
+        }
+        assertEquals(1, input.read());
+        clock.addAndGet(60_000_000_000L);
+        assertEquals(2, input.read());
+        clock.addAndGet(60_000_000_000L);
+        assertEquals(3, input.read());
+        assertEquals(-1, input.read());
+        assertEquals(-1, input.read());
+        input.close();
+        input.close();
+        var windows = events.stream().filter(e -> e.boundary() == TransportOperationTrace.Boundary.WINDOW).toList();
+        assertEquals(2, windows.size());
+        assertEquals(2, windows.get(0).windowBytes());
+        assertEquals(1, windows.get(1).windowBytes());
+        assertEquals(123_000_000, windows.get(0).openNanos());
+        assertEquals(206, windows.get(0).httpStatus());
+        assertEquals(1, windows.get(0).explicitRetries());
+        assertTrue(events.stream().allMatch(e -> e.id() == events.get(0).id()));
+        assertEquals(1, events.stream().filter(e -> e.boundary() == TransportOperationTrace.Boundary.EOF).count());
+        assertEquals(1, events.stream().filter(e -> e.boundary() == TransportOperationTrace.Boundary.CLOSED).count());
