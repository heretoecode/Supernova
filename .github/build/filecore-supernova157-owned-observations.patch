+    @Test public void concurrentNestedOperationsHaveIndependentSinksAndRestoreTheParentScope() throws Exception
+    {
+        List<TransportOperationTrace.Event> first = new ArrayList<>(), second = new ArrayList<>();
+        TransportOperationTrace.install(first::add);
+        try (var parent = TransportOperationTrace.begin(TransportReadObserver.Protocol.FTPS))
+        {
+            TransportOperationTrace.install(second::add);
+            Thread worker = new Thread(() -> {
+                try (var child = TransportOperationTrace.begin(TransportReadObserver.Protocol.SSHJ))
+                {
+                    TransportOperationTrace.retry();
+                    child.failed(null);
+                }
+            });
+            worker.start();
+            worker.join(1000);
+            assertFalse(worker.isAlive());
+            TransportOperationTrace.retry();
+            try (InputStream input = parent.observe(new ByteArrayInputStream(new byte[0])))
+            {
+                assertEquals(-1, input.read());
+            }
+        }
+        assertTrue(first.stream().allMatch(e -> e.protocol() == TransportReadObserver.Protocol.FTPS));
+        assertTrue(second.stream().allMatch(e -> e.protocol() == TransportReadObserver.Protocol.SSHJ));
+        assertEquals(1, first.get(first.size() - 1).explicitRetries());
+        assertEquals(1, second.get(second.size() - 1).explicitRetries());
+    }
