new file mode 100644
--- /dev/null
+++ b/src/com/archos/filecorelibrary/TransportOperationTrace.java
@@ -0,0 +1,234 @@
+package com.archos.filecorelibrary;
+
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InterruptedIOException;
+import java.net.SocketTimeoutException;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import java.util.function.Function;
+
+/** Optional numeric operation evidence, started before connect. No address or exception text is accepted. */
+public final class TransportOperationTrace implements AutoCloseable
+{
+    public enum Boundary { REQUESTED, OPENED, RESPONSE, RETRY, FIRST_BYTES, WINDOW, EOF, CLOSED, FAILED, TIMEOUT, STOPPED }
+    public record Event(long id, TransportReadObserver.Protocol protocol, Boundary boundary, long elapsedNanos,
+                        long openNanos, long bytes, long calls, long readNanos, int httpStatus, int explicitRetries,
+                        long windowNanos, long windowBytes) {}
+    private static final AtomicLong IDS = new AtomicLong();
+    private static final ThreadLocal<TransportOperationTrace> CURRENT = new ThreadLocal<>();
+    private static volatile Function<TransportReadObserver.Protocol, Consumer<Event>> installed;
+    private final Consumer<Event> sink;
+    private final TransportReadObserver.Protocol protocol;
+    private final LongSupplier clock;
+    private final TransportOperationTrace previous;
+    private final long id = IDS.incrementAndGet();
+    private final long started;
+    private long opened = -1, bytes, calls, readNanos, windowAt, windowBytes;
+    private int status = -1, retries;
+    private boolean handed, terminal, first, eof;
+
+    /** Observer changes affect future operations. A null observer avoids all stream wrapping. */
+    public static void install(Consumer<Event> observer)
+    {
+        installed = observer == null ? null : protocol -> observer;
+    }
+
+    public static void installFactory(Function<TransportReadObserver.Protocol, Consumer<Event>> observer)
+    {
+        installed = observer;
+    }
+
+    public static TransportOperationTrace begin(TransportReadObserver.Protocol protocol)
+    {
+        return new TransportOperationTrace(protocol, System::nanoTime);
+    }
+
+    TransportOperationTrace(TransportReadObserver.Protocol protocol, LongSupplier clock)
+    {
+        this.protocol = protocol;
+        this.clock = clock;
+        Function<TransportReadObserver.Protocol, Consumer<Event>> current = installed;
+        Consumer<Event> selected = null;
+        try
+        {
+            if (current != null)
+                selected = current.apply(protocol);
+        }
+        catch (RuntimeException unavailable)
+        {
+            // Diagnostics cannot prevent an open.
+        }
+        sink = selected;
+        started = clock.getAsLong();
+        previous = CURRENT.get();
+        CURRENT.set(this);
+        emit(Boundary.REQUESTED);
+    }
+
+    /** Exact HTTP response code, including unsuccessful responses; explicit retries exclude library internals. */
+    public static boolean inOperation()
+    {
+        return CURRENT.get() != null;
+    }
+
+    public static void response(int status)
+    {
+        TransportOperationTrace operation = CURRENT.get();
+        if (operation != null)
+        {
+            operation.status = status;
+            operation.emit(Boundary.RESPONSE);
+        }
+    }
+
+    public static void retry()
+    {
+        TransportOperationTrace operation = CURRENT.get();
+        if (operation != null)
+        {
+            operation.retries++;
+            operation.emit(Boundary.RETRY);
+        }
+    }
+
+    public void failed(Throwable failure)
+    {
+        if (terminal)
+            return;
+        terminal = true;
+        emit(failure instanceof SocketTimeoutException ? Boundary.TIMEOUT :
+             failure instanceof InterruptedIOException ? Boundary.STOPPED : Boundary.FAILED);
+    }
+
+    public InputStream observe(InputStream input)
+    {
+        if (input == null)
+        {
+            failed(null);
+            return null;
+        }
+        handed = true;
+        opened = Math.max(0, clock.getAsLong() - started);
+        windowAt = clock.getAsLong();
+        emit(Boundary.OPENED);
+        if (sink == null)
+            return input;
+        return new FilterInputStream(input)
+        {
+            private void result(long before, int count)
+            {
+                calls++;
+                readNanos += Math.max(0, clock.getAsLong() - before);
+                if (count > 0)
+                {
+                    bytes += count;
+                    if (!first)
+                    {
+                        first = true;
+                        emit(Boundary.FIRST_BYTES);
+                    }
+                }
+                long now = clock.getAsLong();
+                if (now - windowAt >= 60_000_000_000L)
+                {
+                    emit(Boundary.WINDOW);
+                    windowAt = now;
+                    windowBytes = bytes;
+                }
+                if (count < 0 && !eof)
+                {
+                    eof = true;
+                    emit(Boundary.EOF);
+                }
+            }
+
+            @Override public int read() throws IOException
+            {
+                long before = clock.getAsLong();
+                try
+                {
+                    int value = in.read();
+                    result(before, value < 0 ? -1 : 1);
+                    return value;
+                }
+                catch (IOException failure)
+                {
+                    calls++;
+                    readNanos += Math.max(0, clock.getAsLong() - before);
+                    failed(failure);
+                    throw failure;
+                }
+            }
+
+            @Override public int read(byte[] buffer, int offset, int length) throws IOException
+            {
+                long before = clock.getAsLong();
+                try
+                {
+                    int count = in.read(buffer, offset, length);
+                    result(before, count);
+                    return count;
+                }
+                catch (IOException failure)
+                {
+                    calls++;
+                    readNanos += Math.max(0, clock.getAsLong() - before);
+                    failed(failure);
+                    throw failure;
+                }
+            }
+
+            @Override public void reset() throws IOException
+            {
+                in.reset();
+                eof = false;
+            }
+
+            @Override public void close() throws IOException
+            {
+                try
+                {
+                    in.close();
+                    if (!terminal)
+                    {
+                        terminal = true;
+                        emit(Boundary.CLOSED);
+                    }
+                }
+                catch (IOException failure)
+                {
+                    failed(failure);
+                    throw failure;
+                }
+            }
+        };
+    }
+
+    private void emit(Boundary boundary)
+    {
+        if (sink == null)
+            return;
+        long now = clock.getAsLong();
+        try
+        {
+            sink.accept(new Event(id, protocol, boundary, Math.max(0, now - started), opened, bytes, calls,
+                                  readNanos, status, retries, opened < 0 ? -1 : Math.max(0, now - windowAt),
+                                  bytes - windowBytes));
+        }
+        catch (RuntimeException unavailable)
+        {
+            // Optional diagnostics must never change transport results.
+        }
+    }
+
+    @Override public void close()
+    {
+        if (CURRENT.get() == this)
+            CURRENT.set(previous);
+        if (!handed && !terminal)
+            failed(null);
+    }
+}
