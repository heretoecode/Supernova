+    @Test public void failedOpenAndReadTimeoutAreTerminalAndObserverFailuresDoNotChangeIo() throws Exception
+    {
+        List<TransportOperationTrace.Event> events = new ArrayList<>();
+        TransportOperationTrace.install(events::add);
+        try (var operation = TransportOperationTrace.begin(TransportReadObserver.Protocol.SFTP))
+        {
+            operation.failed(new SocketTimeoutException("secret must never cross numeric observer"));
+        }
+        assertEquals(2, events.size());
+        assertEquals(-1, events.get(1).openNanos());
+        assertEquals(TransportOperationTrace.Boundary.TIMEOUT, events.get(1).boundary());
+        InputStream failed = new InputStream()
+        {
+            @Override public int read() throws SocketTimeoutException
+            {
+                throw new SocketTimeoutException();
+            }
+        };
+        InputStream observed;
+        try (var operation = TransportOperationTrace.begin(TransportReadObserver.Protocol.SMBJ))
+        {
+            observed = operation.observe(failed);
+        }
+        assertThrows(SocketTimeoutException.class, observed::read);
+        observed.close();
+        assertEquals(1, events.get(events.size() - 1).calls());
+        assertEquals(TransportOperationTrace.Boundary.TIMEOUT, events.get(events.size() - 1).boundary());
+        TransportOperationTrace.install(e -> { throw new IllegalStateException(); });
+        try (var operation = TransportOperationTrace.begin(TransportReadObserver.Protocol.FTP);
+             InputStream safe = operation.observe(new ByteArrayInputStream(new byte[] {42})))
+        {
+            assertEquals(42, safe.read());
+        }
+    }
