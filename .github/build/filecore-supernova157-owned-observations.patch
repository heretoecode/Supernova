+++ b/test/java/com/archos/filecorelibrary/DatabaseLocator157Test.java
@@ -0,0 +1,43 @@
+package com.archos.filecorelibrary;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertTrue;
+import android.app.Application;
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class DatabaseLocator157Test
+{
+    @Test public void legacyLogicalExportNameCopiesTheCurrentStoreAndLeavesTheOriginalSnapshotIntact() throws Exception
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        File old = app.getDatabasePath("media.db");
+        File current = app.getDatabasePath("media-v64.db");
+        assertTrue(current.getParentFile().isDirectory() || current.getParentFile().mkdirs());
+        byte[] latest = "CURRENT_STORE".getBytes(StandardCharsets.US_ASCII);
+        byte[] retained = "ROLLBACK_SNAPSHOT".getBytes(StandardCharsets.US_ASCII);
+        Files.write(current.toPath(), latest);
+        Files.write(old.toPath(), retained);
+        FileUtils.installDatabaseLocator((context, name) -> name.equals("media.db") ? current
+                                                                                  : context.getDatabasePath(name));
+        try
+        {
+            FileUtils.backupDatabase(app, "media.db");
+            File exported = new File(app.getExternalFilesDir(null), app.getPackageName() + "-media.db");
+            assertArrayEquals(latest, Files.readAllBytes(exported.toPath()));
+            assertArrayEquals(retained, Files.readAllBytes(old.toPath()));
+        }
+        finally
+        {
+            FileUtils.installDatabaseLocator(null);
+        }
+    }
+}
