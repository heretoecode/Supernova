index 0000000..2818473
--- /dev/null
+++ b/src/com/archos/filecorelibrary/TransportReadObserver.java
@@ -0,0 +1,41 @@
+package com.archos.filecorelibrary;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InterruptedIOException;
+import java.net.SocketTimeoutException;
+
+/** Optional numeric read observations. Media addresses and exception text never cross this API. */
+public final class TransportReadObserver {
+    public enum Protocol { SMB, SMBJ, SFTP, SSHJ, FTP, FTPS, WEBDAV, WEBDAVS }
+    public enum Boundary { OPENED, FIRST_BYTES, END_OF_INPUT, CLOSED, FAILED, TIMEOUT, INTERRUPTED }
+    public interface Sink { void accept(Boundary boundary,long bytes,long calls,long readNanos,long elapsedNanos); }
+    public interface Factory { Sink opened(Protocol protocol); }
+    private static volatile Factory factory;
+    public static void install(Factory value){factory=value;}
+    public static InputStream observe(Protocol protocol,InputStream input){
+        Factory current=factory;if(input==null||current==null)return input;
+        try{Sink sink=current.opened(protocol);return sink==null?input:new Observed(input,sink);}catch(RuntimeException unavailable){return input;}
+    }
+    private static final class Observed extends InputStream {
+        private final InputStream input;private final Sink sink;private final long opened=System.nanoTime();
+        private long bytes,calls,readNanos;private boolean first,eof,terminal;
+        Observed(InputStream input,Sink sink){this.input=input;this.sink=sink;emit(Boundary.OPENED);}
+        private void emit(Boundary boundary){try{sink.accept(boundary,bytes,calls,readNanos,Math.max(0,System.nanoTime()-opened));}catch(RuntimeException unavailable){/* Diagnostics must never break transport. */}}
+        private void readResult(long started,int count){calls++;readNanos+=Math.max(0,System.nanoTime()-started);if(count>0){bytes+=count;if(!first){first=true;emit(Boundary.FIRST_BYTES);}}else if(count<0&&!eof){eof=true;emit(Boundary.END_OF_INPUT);}}
+        private void failed(long started,IOException failure){calls++;readNanos+=Math.max(0,System.nanoTime()-started);if(!terminal){terminal=true;emit(failure instanceof SocketTimeoutException?Boundary.TIMEOUT:failure instanceof InterruptedIOException?Boundary.INTERRUPTED:Boundary.FAILED);}}
+        @Override public int read()throws IOException{long started=System.nanoTime();try{int value=input.read();readResult(started,value<0?-1:1);return value;}catch(IOException failure){failed(started,failure);throw failure;}}
+        @Override public int read(byte[] buffer,int offset,int length)throws IOException{long started=System.nanoTime();try{int count=input.read(buffer,offset,length);readResult(started,count);return count;}catch(IOException failure){failed(started,failure);throw failure;}}
+        @Override public int read(byte[] buffer)throws IOException{return read(buffer,0,buffer.length);}
+        @Override public long skip(long count)throws IOException{return input.skip(count);}
+        @Override public int available()throws IOException{return input.available();}
+        @Override public boolean markSupported(){return input.markSupported();}
+        @Override public void mark(int limit){input.mark(limit);}
+        @Override public void reset()throws IOException{input.reset();eof=false;}
+        @Override public void close()throws IOException{
+            try{input.close();if(!terminal){terminal=true;emit(Boundary.CLOSED);}}
+            catch(IOException failure){if(!terminal){terminal=true;emit(Boundary.FAILED);}throw failure;}
+        }
+    }
+    private TransportReadObserver(){}
+}
