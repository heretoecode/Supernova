+            @Override protected void _connectAction_() throws IOException {
+                try { super._connectAction_(); }
+                catch (IOException | RuntimeException failure) {
+                    try { disconnect(); } catch (IOException ignored) { }
+                    throw failure;
+                }
+            }
+            @Override protected Socket _openDataConnection_(String command, String argument) throws IOException {
+                try {
+                Socket socket = super._openDataConnection_(command, argument);
+                if (socket == null) return null;
+                // PROT P is required by Session. Verify the original control hostname,
+                // not a PASV address or reverse-DNS name, after the data TLS handshake.
+                if (!(socket instanceof SSLSocket) || !HOSTS.verify(_hostname_, ((SSLSocket) socket).getSession())) {
