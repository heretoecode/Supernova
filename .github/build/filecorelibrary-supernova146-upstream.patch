+
+/** Verified explicit FTPS, with the same identity on its control and data channels. */
+final class FtpsTlsPolicy {
+    // Use OkHttp's public configured-verifier API; do not replace a process-global verifier.
+    private static final HostnameVerifier HOSTS = new OkHttpClient().hostnameVerifier();
+
+    static FTPSClient newClient() throws IOException { return newClient(null); }
