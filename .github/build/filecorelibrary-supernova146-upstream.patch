+        assertEquals("subfolder[1]",
+                FtpUtils.getBaseName("/download/serie/subfolder[1]/"));
+        assertEquals("/",
+                FtpUtils.getBaseName("/"));
+        assertNull(FtpUtils.getBaseName(null));
+        assertNull(FtpUtils.getBaseName(""));
+    }
