diff --git a/test/java/com/archos/medialib/AndroidRetrieverOwnershipTest.java b/test/java/com/archos/medialib/AndroidRetrieverOwnershipTest.java
new file mode 100644
index 0000000..b4157f0
--- /dev/null
+++ b/test/java/com/archos/medialib/AndroidRetrieverOwnershipTest.java
@@ -0,0 +1,31 @@
+package com.archos.medialib;
+
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import android.app.Application;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.util.ReflectionHelpers;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class AndroidRetrieverOwnershipTest
+{
+    @Test public void lateProxyAfterCancellationIsClosedAndNeverInstalled() throws Exception
+    {
+        AndroidMediaMetadataRetriever retriever = new AndroidMediaMetadataRetriever();
+        Proxy late = mock(Proxy.class);
+        retriever.release();
+        assertThrows(RuntimeException.class,
+                     ()
+                         -> ReflectionHelpers.callInstanceMethod(
+                             retriever, "replaceProxy", ReflectionHelpers.ClassParameter.from(Proxy.class, late)));
+        verify(late).stop();
+        assertThrows(IllegalStateException.class, () -> retriever.setDataSource("file:///later.mkv"));
+        retriever.release();
+    }
+}
