diff --git a/src/com/archos/mediascraper/NfoWriter.java b/src/com/archos/mediascraper/NfoWriter.java
index 792565a..94de911 100644
--- a/src/com/archos/mediascraper/NfoWriter.java
+++ b/src/com/archos/mediascraper/NfoWriter.java
@@ -106,7 +106,24 @@ public class NfoWriter
         if (state != null)
             state.cancellation.check();
         java.io.OutputStream stream = editor.getOutputStream();
-        return state == null ? stream : state.cancellation.own(stream);
+        if (state == null)
+            return stream;
+        try
+        {
+            return state.cancellation.own(stream);
+        }
+        catch (IOException stopped)
+        {
+            try
+            {
+                editor.delete();
+            }
+            catch (Exception cleanupFailed)
+            {
+                stopped.addSuppressed(cleanupFailed);
+            }
+            throw stopped;
+        }
     }
 
     private static final Logger log = LoggerFactory.getLogger(NfoWriter.class);
