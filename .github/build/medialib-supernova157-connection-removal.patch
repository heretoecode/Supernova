+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import android.app.Application;
+import android.content.Context;
+import android.net.Uri;
+import androidx.preference.PreferenceManager;
+import com.archos.mediacenter.utils.ShortcutDbAdapter;
+import org.json.JSONArray;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.annotation.SQLiteMode;
+import org.robolectric.util.ReflectionHelpers;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+@SQLiteMode(SQLiteMode.Mode.NATIVE)
+public class SavedConnectionRemovalTest
+{
+    private ShortcutDbAdapter.Shortcut source(Context context)
+    {
+        var source = new ShortcutDbAdapter.Shortcut("Films", "webdavs://server/Films");
+        assertTrue(ShortcutDbAdapter.VIDEO.addShortcut(context, source));
+        return source;
+    }
+
+    @Test public void pendingRemovalHidesTheSourceAndUndoRestoresWithoutRecreatingIt() throws Exception
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        var source = source(app);
+        var ticket = SavedConnectionRemoval.remove(app, source.getID());
+        assertTrue(SavedConnectionRemoval.pending(app, Uri.parse(source.getUri())));
+        assertTrue(ShortcutDbAdapter.VIDEO.readCopiedShortcuts(app).stream()
+            .anyMatch(row -> row.getID().equals(source.getID())));
+        assertTrue(SavedConnectionRemoval.undo(app, ticket.undoToken()));
+        assertFalse(SavedConnectionRemoval.pending(app, Uri.parse(source.getUri())));
+        assertFalse(SavedConnectionRemoval.undo(app, ticket.undoToken()));
+    }
+
+    @Test public void expiredJournalIsReapedOnRecoveryAndCannotBeUndone() throws Exception
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        var source = source(app);
+        var ticket = SavedConnectionRemoval.remove(app, source.getID());
+        var prefs = PreferenceManager.getDefaultSharedPreferences(app);
+        synchronized (SavedConnectionRemoval.class)
+        {
+            JSONArray journal = new JSONArray(prefs.getString("supernova_connection_removals_v1", "[]"));
+            journal.getJSONObject(0).put("expires", 0);
+            prefs.edit().putString("supernova_connection_removals_v1", journal.toString()).commit();
+        }
+        assertFalse(SavedConnectionRemoval.undo(app, ticket.undoToken()));
+        ReflectionHelpers.callStaticMethod(SavedConnectionRemoval.class, "reap",
+            ReflectionHelpers.ClassParameter.from(Context.class, app));
+        assertFalse(ShortcutDbAdapter.VIDEO.readCopiedShortcuts(app).stream()
+            .anyMatch(row -> row.getID().equals(source.getID())));
+        assertFalse(SavedConnectionRemoval.pending(app, Uri.parse(source.getUri())));
+    }
+
+    @Test public void compareDeleteCannotRemoveAReusedIdAtAnotherAddress()
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        var source = source(app);
+        assertFalse(ShortcutDbAdapter.VIDEO.deleteShortcut(app, source.getID(), "webdavs://different/Films"));
+        assertTrue(ShortcutDbAdapter.VIDEO.readCopiedShortcuts(app).stream()
+            .anyMatch(row -> row.getID().equals(source.getID())));
+    }
+}
