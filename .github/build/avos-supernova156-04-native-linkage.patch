diff --git a/jni/media_prebuilt.mk b/jni/media_prebuilt.mk
new file mode 100644
index 0000000000000000000000000000000000000000..bf3725a6ab6901a6294eefedf553474aa8257f29
--- /dev/null
+++ b/jni/media_prebuilt.mk
@@ -0,0 +1,53 @@
+# Copyright2026 Supernova contributors
+# SPDX-License-Identifier: Apache-2.0
+# Explicit source-built runtime modules; no APP_ALLOW_MISSING_DEPS escape hatch.
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libavutil
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libavutil.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libswresample
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libswresample.so
+LOCAL_SHARED_LIBRARIES := libavutil
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libswscale
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libswscale.so
+LOCAL_SHARED_LIBRARIES := libavutil
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libdav1d
+LOCAL_SRC_FILES := ../../prebuilt/dav1d/lib/$(TARGET_ARCH_ABI)/libdav1d.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libopus
+LOCAL_SRC_FILES := ../../prebuilt/opus/lib/$(TARGET_ARCH_ABI)/libopus.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libmysofa
+LOCAL_SRC_FILES := ../../prebuilt/libmysofa/lib/$(TARGET_ARCH_ABI)/libmysofa.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libavcodec
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libavcodec.so
+LOCAL_SHARED_LIBRARIES := libswresample libavutil libdav1d libopus
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libavformat
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libavformat.so
+LOCAL_SHARED_LIBRARIES := libavcodec libavutil
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libavfilter
+LOCAL_SRC_FILES := ../../prebuilt/ffmpeg/dist-full-$(TARGET_ARCH_ABI)/lib/libavfilter.so
+LOCAL_SHARED_LIBRARIES := libswscale libavformat libavcodec libswresample libavutil libmysofa
+include $(PREBUILT_SHARED_LIBRARY)
