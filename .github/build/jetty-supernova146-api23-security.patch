@@ -0,0 +1,20 @@
+package org.eclipse.jetty.util.thread.api23;
+import java.util.concurrent.atomic.AtomicLong;
+/** Android23 accumulator; function must be side-effect-free, as in the JDK API. */
+public final class LongAccumulator extends Number implements java.io.Serializable {
+ private static final long serialVersionUID = 1L;
+ public interface Operator extends java.io.Serializable { long apply(long left, long right); }
+ private final AtomicLong value;
+ private final Operator function;
+ private final long identity;
+ public LongAccumulator(Operator function, long identity) { this.function=function; this.identity=identity; value=new AtomicLong(identity); }
+ public void accumulate(long x) { long old,next; do { old=value.get(); next=function.apply(old,x); } while (!value.compareAndSet(old,next)); }
+ public long get() { return value.get(); }
+ public void reset() { value.set(identity); }
+ public long getThenReset() { return value.getAndSet(identity); }
+ public long longValue() { return get(); }
+ public int intValue() { return (int)get(); }
+ public float floatValue() { return get(); }
+ public double doubleValue() { return get(); }
+ public String toString() { return Long.toString(get()); }
+}
diff --git a/jetty-util/src/main/java/org/eclipse/jetty/util/thread/api23/LongAdder.java b/jetty-util/src/main/java/org/eclipse/jetty/util/thread/api23/LongAdder.java
