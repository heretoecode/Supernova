@@ -0,0 +1,18 @@
+package org.eclipse.jetty.util.thread.api23;
+import java.util.concurrent.atomic.AtomicLong;
+/** Android23 atomic counter; reset has the same no-concurrent-reset requirement as LongAdder. */
+public final class LongAdder extends Number implements java.io.Serializable {
+ private static final long serialVersionUID = 1L;
+ private final AtomicLong value = new AtomicLong();
+ public void add(long delta) { value.addAndGet(delta); }
+ public void increment() { add(1); }
+ public void decrement() { add(-1); }
+ public long sum() { return value.get(); }
+ public void reset() { value.set(0); }
+ public long sumThenReset() { return value.getAndSet(0); }
+ public long longValue() { return sum(); }
+ public int intValue() { return (int)sum(); }
+ public float floatValue() { return sum(); }
+ public double doubleValue() { return sum(); }
+ public String toString() { return Long.toString(sum()); }
+}
