+    private static String hostIdentity(String location) {
+        android.net.Uri uri=android.net.Uri.parse(location);
+        String host=uri.getHost(), authority=uri.getEncodedAuthority();
+        if(host==null||authority==null)return location;
+        int at=authority.toLowerCase(java.util.Locale.ROOT).lastIndexOf(host.toLowerCase(java.util.Locale.ROOT));
+        if(at<0)return location;
+        return uri.buildUpon().encodedAuthority(authority.substring(0,at)+host.toLowerCase(java.util.Locale.ROOT)+authority.substring(at+host.length())).build().toString();
+    }
