+jstring Java_com_archos_medialib_AvosMediaPlayer_nativeInitializedDecoder(JNIEnv *env, jobject thiz)
+{
+    avos_mp_t *mp __attribute__((cleanup(release_mp_call))) = get_mp_or_throw(env, thiz);
+    avos_frame_metrics_t metrics = {0};
+    if (!mp || avos->frame_metrics(mp, &metrics) != AVOS_ERR_OK || !metrics.initialized_decoder[0]) return NULL;
+    return (*env)->NewStringUTF(env, metrics.initialized_decoder);
+}
