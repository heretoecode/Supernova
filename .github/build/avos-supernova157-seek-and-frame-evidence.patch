@@ -0,0 +1,20 @@
+import pathlib
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+
+class SeekPictureTest(unittest.TestCase):
+    def test_generation_epoch_and_exactly_once_output(self):
+        with tempfile.TemporaryDirectory() as folder:
+            executable = pathlib.Path(folder) / 'seek-picture'
+            subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-fsanitize=undefined', '-pthread',
+                            '-I', str(ROOT / 'Include'), str(ROOT / 'test/seek_picture.c'), '-o', str(executable)],
+                           check=True)
+            subprocess.run([str(executable)], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
