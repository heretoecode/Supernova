diff --git a/Include/frame_observation.h b/Include/frame_observation.h
new file mode 100644
--- /dev/null
+++ b/Include/frame_observation.h
@@ -0,0 +1,44 @@
+#ifndef FRAME_OBSERVATION_H
+#define FRAME_OBSERVATION_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* These are output submissions and internal drops, never compositor presentation timestamps. */
+typedef struct {
+    uint64_t accepted, late, stale, early, last_submit_ns;
+    int64_t scheduled_phase_ms;
+    uint32_t coverage, decoder_revision;
+    char decoder[128];
+} FRAME_OBSERVATION;
+
+static inline void frame_observation_increment(uint64_t *counter)
+{
+    __atomic_add_fetch(counter, 1, __ATOMIC_RELAXED);
+}
+
+static inline void frame_observation_decoder(FRAME_OBSERVATION *value, const char *name)
+{
+    __atomic_add_fetch(&value->decoder_revision, 1, __ATOMIC_ACQ_REL);
+    size_t i = 0;
+    for (; i < sizeof(value->decoder) - 1 && name && name[i]; i++)
+        __atomic_store_n(&value->decoder[i], name[i], __ATOMIC_RELAXED);
+    __atomic_store_n(&value->decoder[i], 0, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&value->decoder_revision, 1, __ATOMIC_RELEASE);
+}
+
+static inline void frame_observation_name(FRAME_OBSERVATION *value, char *name, size_t capacity)
+{
+    if (!capacity) return;
+    name[0] = 0;
+    /* Bounded snapshot: a concurrent decoder replacement yields unknown, never a partial invented name. */
+    uint32_t before = __atomic_load_n(&value->decoder_revision, __ATOMIC_ACQUIRE);
+    if (before & 1) return;
+    size_t i = 0;
+    for (; i < capacity - 1 && i < sizeof(value->decoder); i++) {
+        name[i] = __atomic_load_n(&value->decoder[i], __ATOMIC_RELAXED);
+        if (!name[i]) break;
+    }
+    name[i < capacity ? i : capacity - 1] = 0;
+    if (before != __atomic_load_n(&value->decoder_revision, __ATOMIC_ACQUIRE)) name[0] = 0;
+}
+#endif
diff --git a/Include/seek_picture.h b/Include/seek_picture.h
new file mode 100644
--- /dev/null
+++ b/Include/seek_picture.h
@@ -0,0 +1,32 @@
+#ifndef SUPERNOVA_SEEK_PICTURE_H
+#define SUPERNOVA_SEEK_PICTURE_H
+#include <stdint.h>
+
+/* A token belongs to one requested seek. Only its bound output epoch may end it. */
+typedef struct seek_picture_gate {
+    uint64_t ticket;
+} SEEK_PICTURE_GATE;
+
+static inline void seek_picture_arm(SEEK_PICTURE_GATE *gate, uint32_t token)
+{
+    __atomic_store_n(&gate->ticket, token ? ((uint64_t)token << 32) | UINT32_MAX : 0, __ATOMIC_RELEASE);
+}
+
+static inline void seek_picture_bind(SEEK_PICTURE_GATE *gate, uint32_t epoch)
+{
+    uint64_t old = __atomic_load_n(&gate->ticket, __ATOMIC_ACQUIRE);
+    if (old && (uint32_t)old == UINT32_MAX) {
+        uint64_t bound = (old & UINT64_C(0xffffffff00000000)) | epoch;
+        __atomic_compare_exchange_n(&gate->ticket, &old, bound, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    }
+}
+
+static inline uint32_t seek_picture_take(SEEK_PICTURE_GATE *gate, uint32_t epoch)
+{
+    uint64_t old = __atomic_load_n(&gate->ticket, __ATOMIC_ACQUIRE);
+    if (!old || (uint32_t)old == UINT32_MAX || (uint32_t)old != epoch)
+        return 0;
+    return __atomic_compare_exchange_n(&gate->ticket, &old, 0, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)
+        ? (uint32_t)(old >> 32) : 0;
+}
+#endif
