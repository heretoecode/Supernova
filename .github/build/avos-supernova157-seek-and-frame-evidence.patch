--- /dev/null
+++ b/test/seek_picture.c
@@ -0,0 +1,61 @@
+#include "seek_picture.h"
+#include "frame_observation.h"
+#include <string.h>
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+
+static SEEK_PICTURE_GATE gate;
+static int wins;
+static FRAME_OBSERVATION observations;
+static void *output(void *unused)
+{
+    (void)unused;
+    for (int i = 0; i < 100000; i++) frame_observation_increment(&observations.late);
+    if (seek_picture_take(&gate, 12) == 99)
+        __atomic_fetch_add(&wins, 1, __ATOMIC_RELAXED);
+    return NULL;
+}
+
+int main(void)
+{
+    for (unsigned token = 1; token <= 100000; token++) {
+        seek_picture_arm(&gate, token);
+        assert(!seek_picture_take(&gate, 0));
+        assert(!seek_picture_take(&gate, 11));
+        seek_picture_bind(&gate, 12);
+        assert(!seek_picture_take(&gate, 11));
+        assert(seek_picture_take(&gate, 12) == token);
+        assert(!seek_picture_take(&gate, 12));
+    }
+    seek_picture_arm(&gate, 1);
+    seek_picture_bind(&gate, 11);
+    seek_picture_arm(&gate, 2);
+    assert(!seek_picture_take(&gate, 11));
+    seek_picture_bind(&gate, 12);
+    assert(!seek_picture_take(&gate, 11));
+    assert(seek_picture_take(&gate, 12) == 2);
+    seek_picture_arm(&gate, 99);
+    seek_picture_bind(&gate, 12);
+    pthread_t threads[16];
+    for (int i = 0; i < 16; i++) assert(!pthread_create(&threads[i], NULL, output, NULL));
+    for (int i = 0; i < 16; i++) assert(!pthread_join(threads[i], NULL));
+    assert(wins == 1);
+    assert(__atomic_load_n(&observations.late, __ATOMIC_RELAXED) == 1600000);
+    char name[128];
+    frame_observation_decoder(&observations, "confirmed.decoder");
+    frame_observation_name(&observations, name, sizeof(name));
+    assert(!strcmp(name, "confirmed.decoder"));
+    __atomic_add_fetch(&observations.decoder_revision, 1, __ATOMIC_RELEASE);
+    frame_observation_name(&observations, name, sizeof(name));
+    assert(!name[0]);
+    __atomic_add_fetch(&observations.decoder_revision, 1, __ATOMIC_RELEASE);
+    frame_observation_decoder(&observations, NULL);
+    frame_observation_name(&observations, name, sizeof(name));
+    assert(!name[0]);
+    seek_picture_arm(&gate, 0);
+    seek_picture_bind(&gate, 13);
+    assert(!seek_picture_take(&gate, 13));
+    puts("seek picture: generation, epoch and concurrent exactly-once output passed");
+    return 0;
+}
