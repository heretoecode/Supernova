new file mode 100644
index 0000000..d484bc6
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/NetworkHistoryCountersTest.java
@@ -0,0 +1,29 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+
+import android.app.Application;
+import android.net.Uri;
+import android.content.Intent;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.Shadows;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class NetworkHistoryCountersTest
+{
+    @Test public void terminalEventCarriesMeasuredRemovedCount()
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        NetworkScannerServiceVideo.previewScanEvent(app, Uri.parse("webdavs://example.test/Films"), "complete",
+                                                    "history", 1, 12, 3, 2, 4);
+        Intent event = Shadows.shadowOf(app).getBroadcastIntents().get(0);
+        assertEquals(4, event.getIntExtra("removed", -1));
+        assertEquals(3, event.getIntExtra("added", -1));
+        assertEquals(2, event.getIntExtra("updated", -1));
+    }
+}
diff --git a/test/java/com/archos/mediaprovider/video/ScanHistoryCountersTest.java b/test/java/com/archos/mediaprovider/video/ScanHistoryCountersTest.java
new file mode 100644
index 0000000..fdf5f68
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/ScanHistoryCountersTest.java
@@ -0,0 +1,33 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+
+import android.app.Application;
+import android.content.Intent;
+import java.util.List;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.Shadows;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class ScanHistoryCountersTest
+{
+    @Test public void localHistoryReportsCommittedRemovalCountsAndUnknownBeforeReconciliation()
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        PreviewLocalImportTrace.begin(app, true);
+        PreviewLocalImportTrace.reconciled(3, 2, 1);
+        PreviewLocalImportTrace.finish(true, false);
+        List<Intent> events = Shadows.shadowOf(app).getBroadcastIntents();
+        assertEquals(-1, events.get(0).getLongExtra("added", 99));
+        Intent finished = events.get(events.size() - 1);
+        assertEquals("complete", finished.getStringExtra("phase"));
+        assertEquals(3, finished.getLongExtra("added", -1));
+        assertEquals(2, finished.getLongExtra("updated", -1));
+        assertEquals(1, finished.getIntExtra("removed", -1));
+    }
+}
