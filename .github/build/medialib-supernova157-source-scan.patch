+    /** Main-thread safe: selects one registered network source without changing the saved source list. */
+    public static void forceRescan(Context context, Uri source)
+    {
+        if (source == null || !SupernovaLibraryPolicy.configured(context))
+            return;
+        Intent request = new Intent(context, NetworkAutoRefresh.class)
+            .setAction(ACTION_FORCE_RESCAN_INDEXED_FOLDERS)
+            .setPackage(context.getPackageName())
+            .putExtra(REQUEST_GENERATION, NetworkScanLedger.generation())
+            .putExtra(REQUEST_SOURCE, source.toString());
+        context.sendBroadcast(request);
+    }
+
+    static List<Uri> selectSource(List<Uri> registered, Uri selected)
+    {
+        String key = SupernovaLibraryPolicy.canonical(selected);
+        List<Uri> result = new ArrayList<>();
+        for (Uri root : registered)
+        {
+            if (SupernovaLibraryPolicy.canonical(root).equals(key))
+                result.add(root);
+        }
+        return result;
+    }
+
     public static int getLastError(Context context)
     {
         return PreferenceManager.getDefaultSharedPreferences(context).getInt(AUTO_RESCAN_ERROR, 0);
