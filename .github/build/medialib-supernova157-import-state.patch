new file mode 100644
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/LocalImportFailureStateTest.java
@@ -0,0 +1,60 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import android.app.Application;
+import android.content.Context;
+import android.content.ContentResolver;
+import android.os.Environment;
+import com.archos.mediaprovider.ImportState;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowEnvironment;
+import org.robolectric.util.ReflectionHelpers;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class LocalImportFailureStateTest
+{
+    private void failsAndResets(boolean full)
+    {
+        Context context = mock(Context.class);
+        when(context.getExternalFilesDir(null)).thenThrow(new IllegalStateException("Storage disappeared"));
+        VideoStoreImportImpl importer = mock(VideoStoreImportImpl.class, CALLS_REAL_METHODS);
+        ReflectionHelpers.setField(importer, "mContext", context);
+        ReflectionHelpers.setField(importer, "mCr", mock(ContentResolver.class));
+        ReflectionHelpers.setStaticField(VideoStoreImportImpl.class, "sdCardPath", "");
+        ShadowEnvironment.setExternalStorageState(Environment.MEDIA_MOUNTED);
+        ImportState.VIDEO.setDeleting(true);
+        ImportState.VIDEO.setNumberOfFilesRemainingToDelete(3);
+        ImportState.VIDEO.setRemainingCount(10);
+        IllegalStateException failure = assertThrows(IllegalStateException.class, () -> {
+            if (full)
+                importer.doFullImport();
+            else
+                importer.doIncrementalImport();
+        });
+        assertEquals("Storage disappeared", failure.getMessage());
+        assertFalse(ImportState.VIDEO.isInitialImport());
+        assertFalse(ImportState.VIDEO.isRegularImport());
+        assertFalse(ImportState.VIDEO.isDeleting());
+        assertEquals(0, ImportState.VIDEO.getNumberOfFilesRemainingToImport());
+        assertEquals(0, ImportState.VIDEO.getNumberOfFilesRemainingToDelete());
+    }
+
+    @Test public void fullImportFailureAlwaysReleasesTheBusyState()
+    {
+        failsAndResets(true);
+    }
+
+    @Test public void incrementalImportFailureAlwaysReleasesTheBusyState()
+    {
+        failsAndResets(false);
+    }
+}
