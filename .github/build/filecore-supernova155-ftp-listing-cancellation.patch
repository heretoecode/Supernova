+package com.archos.filecorelibrary.ftp;
+
+import static org.junit.Assert.*;
+
+import android.app.Application;
+import android.net.Uri;
+import androidx.test.core.app.ApplicationProvider;
+import com.archos.environment.ArchosUtils;
+import com.archos.filecorelibrary.ListingCancellation;
+import com.archos.filecorelibrary.RawListerFactory;
+import java.net.SocketTimeoutException;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+/** Actual factory -> Session -> FTPRawLister integration. Requires Claude's Android test workspace. */
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class FtpRawListingCancellationTest {
+    @Before public void context() {
+        ArchosUtils.setGlobalContext(ApplicationProvider.getApplicationContext());
+    }
+
+    @Test public void cancelDuringConnectGreetingDoesNotRetry() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.GREETING, false);
+    }
+    @Test public void cancelDuringLoginDoesNotRetry() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.LOGIN, false);
+    }
+    @Test public void cancelSilentListing() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.LIST, false);
+    }
+    @Test public void deadlineSilentListing() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.LIST, true);
+    }
+    @Test public void cancelTricklingListing() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.TRICKLE, false);
+    }
+    @Test public void deadlineTricklingListing() throws Exception {
+        listing(FtpListingCancellationSocketTest.Stall.TRICKLE, true);
+    }
+
+    private void listing(FtpListingCancellationSocketTest.Stall stall, boolean deadline) throws Exception {
+        try (FtpListingCancellationSocketTest.Peer peer = new FtpListingCancellationSocketTest.Peer(stall, false)) {
+            ListingCancellation token = new ListingCancellation(deadline ? 3 : 20, TimeUnit.SECONDS);
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            CountDownLatch ended = new CountDownLatch(1);
+            Future<?> running = worker.submit(() -> {
+                try (ListingCancellation.Scope scope = token.enter()) {
+                    Uri uri = Uri.parse("ftp://127.0.0.1:" + peer.control.getLocalPort() + "/fixture/");
+                    try {
+                        RawListerFactory.getRawListerForUrl(uri).getFileList();
+                        fail("Obsolete listing must not return data");
+                    } catch (Exception expected) {
+                        assertTrue("A setup/auth/parser error must not pass as cancellation", token.isCancelled());
+                    }
+                    assertThrows(CancellationException.class, ListingCancellation::checkpoint);
+                } finally { ended.countDown(); Thread.interrupted(); }
+            });
+            try {
+                assertTrue(peer.blocked.await(4, TimeUnit.SECONDS));
+                if (!deadline) token.cancel();
+                assertTrue("actual runnable must end", ended.await(5, TimeUnit.SECONDS));
+                running.get(1, TimeUnit.SECONDS);
+                peer.control.setSoTimeout(150);
+                assertThrows("No reconnect after cancellation", SocketTimeoutException.class, peer.control::accept);
+                assertEquals("No blocking logout on cancelled control channel", 0, peer.quits.get());
+            } finally {
+                token.cancel();
+                worker.shutdownNow();
+                assertTrue(worker.awaitTermination(3, TimeUnit.SECONDS));
+            }
+        }
+    }
+}
