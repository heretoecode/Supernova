@@ -0,0 +1,78 @@
+package com.archos.filecorelibrary.ftp;
+
+import com.archos.filecorelibrary.ListingCancellation;
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import javax.net.SocketFactory;
+import org.apache.commons.net.ftp.FTPClient;
+
+/** Owns only sockets allocated for one listing, including pre-connect and TLS data sockets. */
+final class ListingSocketFactory extends SocketFactory {
+    private final SocketFactory delegate;
+    private final ListingCancellation listing;
+
+    private ListingSocketFactory(SocketFactory delegate, ListingCancellation listing) {
+        this.delegate = delegate;
+        this.listing = listing;
+    }
+
+    static SocketFactory wrap(SocketFactory delegate, ListingCancellation listing) {
+        if (listing == null) return delegate;
+        if (delegate instanceof ListingSocketFactory
+                && ((ListingSocketFactory) delegate).listing == listing) return delegate;
+        return new ListingSocketFactory(delegate == null ? SocketFactory.getDefault() : delegate, listing);
+    }
+
+    static void install(FTPClient client) {
+        ListingCancellation listing = ListingCancellation.current();
+        if (listing != null) client.setSocketFactory(wrap(null, listing));
+    }
+
+    @Override public Socket createSocket() throws IOException {
+        listing.throwIfCancelled();
+        final Socket socket = delegate.createSocket();
+        ListingCancellation.Registration registration = listing.own(() -> close(socket));
+        try {
+            listing.throwIfCancelled();
+            return socket;
+        } catch (RuntimeException failure) {
+            close(socket);
+            registration.close();
+            throw failure;
+        }
+    }
+
+    private static void close(Socket socket) {
+        // Socket close only: no FTP ABOR/QUIT, TLS logout, shared client or pool teardown.
+        try { socket.close(); } catch (IOException ignored) { }
+    }
+
+    private Socket connect(InetSocketAddress remote, InetSocketAddress local) throws IOException {
+        Socket socket = createSocket();
+        try {
+            if (local != null) socket.bind(local);
+            listing.throwIfCancelled();
+            socket.connect(remote);
+            listing.throwIfCancelled();
+            return socket;
+        } catch (IOException | RuntimeException failure) {
+            close(socket);
+            throw failure;
+        }
+    }
+
+    @Override public Socket createSocket(String host, int port) throws IOException {
+        return connect(new InetSocketAddress(host, port), null);
+    }
+    @Override public Socket createSocket(InetAddress host, int port) throws IOException {
+        return connect(new InetSocketAddress(host, port), null);
+    }
+    @Override public Socket createSocket(String host, int port, InetAddress local, int localPort) throws IOException {
+        return connect(new InetSocketAddress(host, port), new InetSocketAddress(local, localPort));
+    }
+    @Override public Socket createSocket(InetAddress host, int port, InetAddress local, int localPort) throws IOException {
+        return connect(new InetSocketAddress(host, port), new InetSocketAddress(local, localPort));
+    }
+}
