+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.when;
+import com.archos.filecorelibrary.FileEditor;
+import com.archos.mediacenter.filecoreextension.upnp2.FileEditorFactoryWithUpnp;
+import java.io.OutputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+
+import android.app.Application;
+import android.net.Uri;
+import androidx.test.core.app.ApplicationProvider;
+import com.archos.filecorelibrary.FileUtilsQ;
+import java.io.File;
+import java.nio.file.Files;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 28)
+public class NfoWriterOutcomeTest
+{
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+    @Before public void setup()
+    {
+        FileUtilsQ.getInstance(ApplicationProvider.getApplicationContext());
+    }
+    @Test public void successfulCheckedExportReportsWrittenOnlyAfterCompleteXmlIsClosed() throws Exception
+    {
+        File video = new File(temporary.getRoot(), "One.mkv");
+        MovieTags tags = new MovieTags();
+        tags.setTitle("Library title");
+        assertEquals(NfoExportProgress.Outcome.WRITTEN,
+                     NfoWriter.exportChecked(Uri.fromFile(video), tags, new NfoWriter.ExportContext(),
+                                             new NfoExportCancellation()));
+        String xml = Files.readString(new File(temporary.getRoot(), "One" + NfoParser.CUSTOM_NFO_EXTENSION).toPath());
+        assertTrue(xml.contains("<title>Library title</title>"));
+        assertTrue(xml.contains("</movie>"));
+    }
+    @Test public void swallowedLegacyWriteFailureIsStillAFailedCheckedJobAndMayRetry() throws Exception
+    {
+        File parent = temporary.newFile("not-a-directory");
+        File video = new File(parent, "One.mkv");
+        MovieTags tags = new MovieTags();
+        tags.setTitle("Library title");
+        NfoWriter.ExportContext context = new NfoWriter.ExportContext();
+        assertEquals(NfoExportProgress.Outcome.FAILED,
+                     NfoWriter.exportChecked(Uri.fromFile(video), tags, context, new NfoExportCancellation()));
+        assertTrue(parent.delete());
+        assertTrue(parent.mkdir());
+        assertEquals(NfoExportProgress.Outcome.WRITTEN,
+                     NfoWriter.exportChecked(Uri.fromFile(video), tags, context, new NfoExportCancellation()));
+    }
+    @Test public void cancelledJobNeverCreatesANfoFile() throws Exception
+    {
+        File video = new File(temporary.getRoot(), "One.mkv");
+        MovieTags tags = new MovieTags();
+        tags.setTitle("Library title");
+        NfoExportCancellation cancelled = new NfoExportCancellation();
+        cancelled.cancel();
+        assertEquals(NfoExportProgress.Outcome.CANCELLED,
+                     NfoWriter.exportChecked(Uri.fromFile(video), tags, new NfoWriter.ExportContext(), cancelled));
+        assertFalse(new File(temporary.getRoot(), "One" + NfoParser.CUSTOM_NFO_EXTENSION).exists());
+    }
+    @Test public void cancellingAnActiveWriteClosesOutputBeforeRemovingItsPartialFile() throws Exception
+    {
+        File video = new File(temporary.getRoot(), "One.mkv");
+        File target = new File(temporary.getRoot(), "One" + NfoParser.CUSTOM_NFO_EXTENSION);
+        CountDownLatch writing = new CountDownLatch(1), closed = new CountDownLatch(1);
+        NfoExportCancellation cancellation = new NfoExportCancellation();
+        MovieTags tags = new MovieTags();
+        tags.setTitle("Library title");
+        FutureTask<NfoExportProgress.Outcome> task = new FutureTask<>(() -> {
+            // Static mock is confined to the actual writer thread, just like the export-check context.
+            try (var factory = mockStatic(FileEditorFactoryWithUpnp.class))
+            {
+                FileOutputStream raw = new FileOutputStream(target);
+                OutputStream blocked = new OutputStream() {
+                    @Override public void write(int value) throws IOException
+                    {
+                        raw.write(value);
+                        writing.countDown();
+                        try
+                        {
+                            if (!closed.await(5, TimeUnit.SECONDS))
+                                throw new IOException("Fixture close timed out");
+                        }
+                        catch (InterruptedException interrupted)
+                        {
+                            Thread.currentThread().interrupt();
+                        }
+                        throw new IOException("Fixture write stopped");
+                    }
+                    @Override public void close() throws IOException
+                    {
+                        raw.close();
+                        closed.countDown();
+                    }
+                };
+                FileEditor editor = mock(FileEditor.class);
+                when(editor.getOutputStream()).thenReturn(blocked);
+                when(editor.delete()).thenAnswer(call -> {
+                    assertEquals(0, closed.getCount());
+                    return target.delete();
+                });
+                factory.when(() -> FileEditorFactoryWithUpnp.getFileEditorForUrl(Uri.fromFile(target), null))
+                    .thenReturn(editor);
+                return NfoWriter.exportChecked(Uri.fromFile(video), tags, new NfoWriter.ExportContext(), cancellation);
+            }
+        });
+        Thread worker = new Thread(task, "NfoWriteCancellationFixture");
+        worker.setDaemon(true);
+        worker.start();
+        try
+        {
+            assertTrue(writing.await(5, TimeUnit.SECONDS));
+            cancellation.cancel();
+            assertEquals(NfoExportProgress.Outcome.CANCELLED, task.get(5, TimeUnit.SECONDS));
+            assertFalse(target.exists());
+        }
+        finally
+        {
+            cancellation.cancel();
+            worker.join(5000);
+        }
+    }
+}
