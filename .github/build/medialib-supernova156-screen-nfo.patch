index 0000000..11874fb
--- /dev/null
+++ b/src/com/archos/mediascraper/NfoExportCancellation.java
@@ -0,0 +1,94 @@
+package com.archos.mediascraper;
+
+import java.io.FilterOutputStream;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.io.OutputStream;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Owns only this job's streams; cancellation never closes shared protocol sessions. */
+final class NfoExportCancellation
+{
+    private volatile boolean cancelled;
+    private final Set<OutputStream> streams = new HashSet<>();
+
+    boolean cancelled()
+    {
+        return cancelled;
+    }
+    void check() throws InterruptedIOException
+    {
+        if (cancelled || Thread.currentThread().isInterrupted())
+            throw new InterruptedIOException("NFO export stopped");
+    }
+    void cancel()
+    {
+        Set<OutputStream> closing;
+        synchronized (this)
+        {
+            if (cancelled)
+                return;
+            cancelled = true;
+            closing = new HashSet<>(streams);
+        }
+        if (!closing.isEmpty())
+        {
+            Thread cleanup = new Thread(() -> {
+                for (OutputStream output : closing)
+                    try
+                    {
+                        output.close();
+                    }
+                    catch (IOException ignored)
+                    {
+                        // The writer owns outcome reporting and partial-file cleanup.
+                    }
+            }, "NfoExportCancel");
+            cleanup.setDaemon(true);
+            cleanup.start();
+        }
+    }
+    synchronized OutputStream own(OutputStream output) throws IOException
+    {
+        if (output == null)
+            throw new IOException("NFO output unavailable");
+        if (cancelled)
+        {
+            output.close();
+            check();
+        }
+        streams.add(output);
+        return new FilterOutputStream(output) {
+            @Override public void write(byte[] bytes, int offset, int count) throws IOException
+            {
+                check();
+                out.write(bytes, offset, count);
+            }
+            @Override public void write(int value) throws IOException
+            {
+                check();
+                out.write(value);
+            }
+            @Override public void flush() throws IOException
+            {
+                check();
+                out.flush();
+            }
+            @Override public void close() throws IOException
+            {
+                try
+                {
+                    out.close();
+                }
+                finally
+                {
+                    synchronized (NfoExportCancellation.this)
+                    {
+                        streams.remove(output);
+                    }
+                }
+            }
+        };
+    }
+}
diff --git a/src/com/archos/mediascraper/NfoExportJob.java b/src/com/archos/mediascraper/NfoExportJob.java
new file mode 100644
index 0000000..115b593
--- /dev/null
+++ b/src/com/archos/mediascraper/NfoExportJob.java
@@ -0,0 +1,236 @@
+package com.archos.mediascraper;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import com.archos.filecorelibrary.FileUtils;
+import com.archos.filecorelibrary.MetaFile2;
+import com.archos.filecorelibrary.webdav.ScanIoScope;
+import com.archos.mediacenter.filecoreextension.upnp2.MetaFileFactoryWithUpnp;
+import com.archos.mediaprovider.video.VideoStore;
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+
+/** Count on a worker first, then start the immutable plan. Outcomes count videos, not companion images/files. */
+public final class NfoExportJob
+{
+    static final String[] PROJECTION = {"_id",
+                                        "_data",
+                                        "title",
+                                        "ArchosMediaScraper_id",
+                                        "ArchosMediaScraper_type",
+                                        "bookmark",
+                                        "Archos_bookmark",
+                                        "Archos_lastTimePlayed",
+                                        "duration"};
+    static record Target(long id, Uri file, String title, long scraperId, int type, long resume, long bookmark,
+                         long played, long duration, String storedPath)
+    {
+        Target(long id, Uri file, String title, long scraperId, int type, long resume, long bookmark, long played,
+               long duration)
+        {
+            this(id, file, title, scraperId, type, resume, bookmark, played, duration,
+                 "file".equals(file.getScheme()) ? file.getPath() : file.toString());
+        }
+    }
+    public static final class Plan
+    {
+        public final int total;
+        public final int knownReadOnly;
+        private final List<Target> targets;
+        Plan(List<Target> targets)
+        {
+            this.targets = List.copyOf(targets);
+            total = targets.size();
+            knownReadOnly = (int)targets.stream().filter(row -> readOnlySource(row.file)).count();
+        }
+    }
+    private static final ExecutorService WORK = Executors.newSingleThreadExecutor(r -> {
+        Thread thread = new Thread(r, "NfoExportJob");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private static Job active;
+
+    /** Worker-only count/material snapshot; throws if the complete provider query is unavailable. */
+    public static Plan preflight(Context context) throws IOException
+    {
+        return fromCursor(context.getContentResolver().query(VideoStore.Video.Media.EXTERNAL_CONTENT_URI, PROJECTION,
+                                                             null, null, "_data"));
+    }
+    static Plan fromCursor(Cursor cursor) throws IOException
+    {
+        if (cursor == null)
+            throw new IOException("Library inventory is unavailable");
+        List<Target> targets = new ArrayList<>();
+        try (Cursor rows = cursor)
+        {
+            while (rows.moveToNext())
+            {
+                if (rows.isNull(0) || rows.isNull(1))
+                    throw new IOException("Library file identity is unavailable");
+                String location = rows.getString(1);
+                Uri file = location.startsWith("/") ? Uri.fromFile(new File(location)) : Uri.parse(location);
+                String title = rows.getString(2);
+                if (title == null || title.isBlank())
+                    title = file.getLastPathSegment() == null ? "Unknown title" : file.getLastPathSegment();
+                targets.add(new Target(rows.getLong(0), file, title, rows.getLong(3), rows.getInt(4), rows.getLong(5),
+                                       rows.getLong(6), rows.getLong(7), rows.getLong(8), location));
+            }
+        }
+        return new Plan(targets);
+    }
+    public static Job start(Context context, Plan plan)
+    {
+        return start(plan, new NativeBackend(context.getApplicationContext()));
+    }
+    static synchronized Job start(Plan plan, Backend backend)
+    {
+        if (active != null)
+            throw new IllegalStateException("An NFO export is already running");
+        Job job = new Job(plan, backend);
+        active = job;
+        WORK.execute(job::run);
+        return job;
+    }
+    public static synchronized void cancelActive()
+    {
+        if (active != null)
+            active.cancel();
+    }
+    interface Backend
+    {
+        boolean readOnly(Target row) throws Exception;
+        NfoExportProgress.Outcome write(Target row, NfoExportCancellation cancellation) throws Exception;
+    }
+    static final class NativeBackend implements Backend
+    {
+        final Context context;
+        final NfoWriter.ExportContext export = new NfoWriter.ExportContext();
+        NativeBackend(Context context)
+        {
+            this.context = context;
+        }
+        @Override public boolean readOnly(Target row) throws Exception
+        {
+            MetaFile2 parent = MetaFileFactoryWithUpnp.getMetaFileForUrl(FileUtils.getParentUrl(row.file));
+            if (parent == null || !parent.isDirectory())
+                throw new IOException("Export folder is unavailable");
+            return !parent.canWrite();
+        }
+        @Override
+        public NfoExportProgress.Outcome write(Target row, NfoExportCancellation cancellation) throws Exception
+        {
+            cancellation.check();
+            try (Cursor owner = context.getContentResolver().query(
+                     VideoStore.Video.Media.EXTERNAL_CONTENT_URI, new String[] {"_id"},
+                     "_id=? AND _data=? AND ArchosMediaScraper_id=? AND ArchosMediaScraper_type=?",
+                     new String[] {"" + row.id, row.storedPath, "" + row.scraperId, "" + row.type}, null))
+            {
+                if (owner == null)
+                    throw new IOException("Library identity could not be checked");
+                if (!owner.moveToFirst())
+                    return NfoExportProgress.Outcome.FAILED;
+            }
+            BaseTags tags = row.type == BaseTags.MOVIE     ? TagsFactory.buildMovieTags(context, row.scraperId)
+                            : row.type == BaseTags.TV_SHOW ? TagsFactory.buildEpisodeTags(context, row.scraperId)
+                                                           : null;
+            if (tags == null)
+                return NfoExportProgress.Outcome.FAILED;
+            tags.setFile(row.file);
+            tags.setResume(row.resume);
+            tags.setBookmark(row.bookmark);
+            tags.setLastPlayed(row.played, TimeUnit.SECONDS);
+            tags.setRuntime(row.duration, TimeUnit.MILLISECONDS);
+            return NfoWriter.exportChecked(row.file, tags, export, cancellation);
+        }
+    }
+    public static final class Job implements AutoCloseable
+    {
+        private final Plan plan;
+        private final Backend backend;
+        private final NfoExportProgress.Tracker progress;
+        private final NfoExportCancellation cancellation = new NfoExportCancellation();
+        private final CountDownLatch finished = new CountDownLatch(1);
+        private volatile ScanIoScope scope;
+
+        private Job(Plan plan, Backend backend)
+        {
+            this.plan = plan;
+            this.backend = backend;
+            progress = NfoExportProgress.begin(plan.total);
+        }
+        public void cancel()
+        {
+            cancellation.cancel();
+            ScanIoScope running = scope;
+            if (running != null)
+                running.cancel();
+        }
+        @Override public void close()
+        {
+            cancel();
+        }
+        /** Worker-only; UI observes NfoExportProgress instead of waiting. */
+        public void await() throws InterruptedException
+        {
+            finished.await();
+        }
+        private void run()
+        {
+            try (ScanIoScope owned = new ScanIoScope(24, TimeUnit.HOURS))
+            {
+                scope = owned;
+                for (Target row : plan.targets)
+                {
+                    if (cancellation.cancelled())
+                        break;
+                    NfoExportProgress.Outcome outcome;
+                    try
+                    {
+                        if (readOnlySource(row.file) || backend.readOnly(row))
+                            outcome = NfoExportProgress.Outcome.SKIPPED_READ_ONLY;
+                        else
+                            outcome = backend.write(row, cancellation);
+                    }
+                    catch (Exception failure)
+                    {
+                        outcome = cancellation.cancelled() || Thread.currentThread().isInterrupted()
+                                      ? NfoExportProgress.Outcome.CANCELLED
+                                      : NfoExportProgress.Outcome.FAILED;
+                    }
+                    progress.completed(row.title, outcome);
+                    if (outcome == NfoExportProgress.Outcome.CANCELLED)
+                        break;
+                }
+            }
+            finally
+            {
+                scope = null;
+                progress.finish(cancellation.cancelled() || Thread.currentThread().isInterrupted());
+                synchronized (NfoExportJob.class)
+                {
+                    if (active == this)
+                        active = null;
+                }
+                finished.countDown();
+            }
+        }
+    }
+    static boolean readOnlySource(Uri file)
+    {
+        String host = file.getHost() == null ? "" : file.getHost().toLowerCase(Locale.ROOT);
+        String scheme = file.getScheme() == null ? "" : file.getScheme().toLowerCase(Locale.ROOT);
+        return host.equals("put.io") || host.endsWith(".put.io") || List.of("http", "https", "upnp").contains(scheme);
+    }
+    private NfoExportJob()
+    {
+    }
+}
