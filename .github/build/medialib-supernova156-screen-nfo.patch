+        rows.addRow(new Object[] {1, "/storage/drive/One.mkv", "One", 7, 1, 45, 67, 89, 100});
+        rows.addRow(new Object[] {2, "webdavs://webdav.put.io/Films/Two.mkv", "Two", 0, 0, 0, 0, 0, 0});
+        NfoExportJob.Plan plan = NfoExportJob.fromCursor(rows);
+        assertTrue(rows.isClosed());
+        assertEquals(2, plan.total);
+        assertEquals(1, plan.knownReadOnly);
+        assertThrows(java.io.IOException.class, () -> NfoExportJob.fromCursor(null));
+    }
+    @Test public void completedWritesReadOnlyAndFailuresHaveDistinctCounts() throws Exception
+    {
+        AtomicInteger writes = new AtomicInteger(), checked = new AtomicInteger();
+        NfoExportJob.Plan plan = new NfoExportJob.Plan(List.of(target("webdavs://webdav.put.io/Films/One.mkv"),
+                                                               target("file:///readonly.mkv"), target("file:///ok.mkv"),
+                                                               target("file:///failed.mkv")));
+        NfoExportJob.Job job = NfoExportJob.start(plan, new NfoExportJob.Backend() {
+            @Override public boolean readOnly(NfoExportJob.Target row)
+            {
+                checked.incrementAndGet();
+                return row.file().getPath().equals("/readonly.mkv");
+            }
+            @Override
+            public NfoExportProgress.Outcome write(NfoExportJob.Target row, NfoExportCancellation cancellation)
+            {
+                writes.incrementAndGet();
+                return row.file().getPath().equals("/failed.mkv") ? NfoExportProgress.Outcome.FAILED
+                                                                  : NfoExportProgress.Outcome.WRITTEN;
+            }
+        });
+        job.await();
+        NfoExportProgress.Snapshot value = NfoExportProgress.current();
+        assertTrue(value.finished);
+        assertFalse(value.cancelled);
+        assertEquals(4, value.done);
+        assertEquals(1, value.written);
+        assertEquals(2, value.skippedReadOnly);
+        assertEquals(1, value.failed);
+        assertEquals(2, writes.get());
+        assertEquals(3, checked.get());
+    }
+    @Test public void progressDoesNotCountAWriteBeforeCompletionAndCancelStopsBeforeTheNextFile() throws Exception
+    {
+        CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+        AtomicInteger writes = new AtomicInteger();
+        NfoExportJob.Backend backend = new NfoExportJob.Backend() {
+            @Override public boolean readOnly(NfoExportJob.Target row)
