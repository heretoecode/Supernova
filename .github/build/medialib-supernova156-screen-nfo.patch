--- /dev/null
+++ b/test/java/com/archos/mediascraper/NfoExportCancellationTest.java
@@ -0,0 +1,34 @@
+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import org.junit.Test;
+
+public class NfoExportCancellationTest
+{
+    @Test public void cancellationClosesOwnedOutputAndBlocksLaterWritesAndRegistration() throws Exception
+    {
+        NfoExportCancellation cancellation = new NfoExportCancellation();
+        CountDownLatch closed = new CountDownLatch(1);
+        ByteArrayOutputStream raw = new ByteArrayOutputStream() {
+            @Override public void close()
+            {
+                closed.countDown();
+            }
+        };
+        OutputStream output = cancellation.own(raw);
+        output.write(new byte[] {1, 2, 3});
+        cancellation.cancel();
+        assertTrue(closed.await(5, TimeUnit.SECONDS));
+        assertThrows(IOException.class, () -> output.write(4));
+        assertThrows(IOException.class, () -> cancellation.own(new ByteArrayOutputStream()));
+        assertArrayEquals(new byte[] {1, 2, 3}, raw.toByteArray());
+    }
+}
