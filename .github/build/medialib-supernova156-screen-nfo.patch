+        NfoExportJob.Job job = NfoExportJob.start(plan, backend);
+        try
+        {
+            assertTrue(entered.await(5, TimeUnit.SECONDS));
+            assertEquals(0, NfoExportProgress.current().done);
+            assertThrows(IllegalStateException.class, () -> NfoExportJob.start(plan, backend));
+            job.cancel();
+        }
+        finally
+        {
+            release.countDown();
+            job.await();
+        }
+        assertTrue(NfoExportProgress.current().cancelled);
+        assertTrue(NfoExportProgress.current().finished);
+        assertEquals(0, NfoExportProgress.current().done);
+        assertEquals(1, writes.get());
+        NfoExportJob.Job next = NfoExportJob.start(new NfoExportJob.Plan(List.of()), backend);
+        next.await();
+        assertFalse(NfoExportProgress.current().cancelled);
+        assertTrue(NfoExportProgress.current().finished);
+    }
+    @Test public void deletedOrChangedPreflightIdentityFailsBeforeBuildingTagsOrWriting() throws Exception
+    {
+        Context context = mock(Context.class);
+        ContentResolver resolver = mock(ContentResolver.class);
+        when(context.getContentResolver()).thenReturn(resolver);
+        when(resolver.query(any(Uri.class), any(String[].class), any(String.class), any(String[].class),
+                            nullable(String.class)))
+            .thenReturn(new MatrixCursor(new String[] {"_id"}));
+        try (var writer = mockStatic(NfoWriter.class); var tags = mockStatic(TagsFactory.class))
+        {
+            NfoExportProgress.Outcome outcome =
+                new NfoExportJob.NativeBackend(context).write(target("file:///one.mkv"), new NfoExportCancellation());
+            assertEquals(NfoExportProgress.Outcome.FAILED, outcome);
+            writer.verifyNoInteractions();
+            tags.verifyNoInteractions();
+        }
+    }
+}
