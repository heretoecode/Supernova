+package com.archos.mediascraper;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.Executor;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Consumer;
+
+/** Reports completed export tasks, not rows merely dispatched to NfoWriter's queue. */
+public final class NfoExportProgress
+{
+    public static final class Snapshot
+    {
+        public final long jobId;
+        public final int done;
+        public final int total;
+        public final String currentTitle;
+        public final boolean finished;
+
+        Snapshot(long jobId, int done, int total, String currentTitle, boolean finished)
+        {
+            this.jobId = jobId;
+            this.done = done;
+            this.total = total;
+            this.currentTitle = currentTitle;
+            this.finished = finished;
+        }
+    }
+
+    public static final class Tracker
+    {
+        private final long jobId;
+        private final int total;
+        private int done;
+
+        private Tracker(int total)
+        {
+            this.total = Math.max(0, total);
+            jobId = IDS.incrementAndGet();
+            publish(new Snapshot(jobId, 0, this.total, "", this.total == 0));
+        }
+
+        public synchronized void completed(String title)
+        {
+            if (done >= total)
+                return;
+            done++;
+            publish(new Snapshot(jobId, done, total, title == null ? "" : title, done == total));
+        }
+
+        public synchronized void finish()
+        {
+            if (current.jobId == jobId)
+            {
+                publish(new Snapshot(jobId, done, total, current.currentTitle, true));
+            }
+        }
+    }
+
+    private static final AtomicLong IDS = new AtomicLong();
+    private static final CopyOnWriteArrayList<Consumer<Snapshot>> LISTENERS = new CopyOnWriteArrayList<>();
+    private static volatile Snapshot current = new Snapshot(0, 0, 0, "", true);
+
+    public static Tracker begin(int total)
+    {
+        return new Tracker(total);
+    }
+
+    public static Snapshot current()
+    {
+        return current;
+    }
+
+    public static AutoCloseable listen(Executor executor, Consumer<Snapshot> listener)
+    {
+        AtomicBoolean active = new AtomicBoolean(true);
+        Consumer<Snapshot> dispatch = snapshot -> executor.execute(() -> {
+            if (active.get())
+                listener.accept(snapshot);
+        });
+        LISTENERS.add(dispatch);
+        dispatch.accept(current);
+        return () ->
+        {
+            active.set(false);
+            LISTENERS.remove(dispatch);
+        };
+    }
+
+    private static synchronized void publish(Snapshot snapshot)
+    {
+        if (snapshot.jobId < current.jobId)
+            return;
+        current = snapshot;
+        for (Consumer<Snapshot> listener : LISTENERS)
+        {
+            try
+            {
+                listener.accept(snapshot);
+            }
+            catch (RuntimeException ignored)
+            {
+                // A detached/rejected UI executor must never abort an export.
+            }
+        }
+    }
+
+    private NfoExportProgress()
+    {
+    }
+}
