diff --git a/test/java/com/archos/mediascraper/NfoExportProgressTest.java b/test/java/com/archos/mediascraper/NfoExportProgressTest.java
new file mode 100644
index 0000000..1b7e3fd
--- /dev/null
+++ b/test/java/com/archos/mediascraper/NfoExportProgressTest.java
@@ -0,0 +1,43 @@
+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+
+public class NfoExportProgressTest
+{
+    @Test public void reportsCompletedTasksAndCannotBeOverwrittenByAnOlderJob() throws Exception
+    {
+        List<NfoExportProgress.Snapshot> events = new ArrayList<>();
+        try (AutoCloseable listener = NfoExportProgress.listen(Runnable::run, events::add))
+        {
+            NfoExportProgress.Tracker first = NfoExportProgress.begin(2);
+            assertEquals(0, NfoExportProgress.current().done);
+            first.completed("Film one");
+            assertEquals(1, NfoExportProgress.current().done);
+            assertEquals("Film one", NfoExportProgress.current().currentTitle);
+            assertFalse(NfoExportProgress.current().finished);
+            first.completed("Film two");
+            assertTrue(NfoExportProgress.current().finished);
+            NfoExportProgress.begin(3);
+            first.finish();
+            assertEquals(3, NfoExportProgress.current().total);
+            assertEquals(0, NfoExportProgress.current().done);
+        }
+    }
+
+    @Test public void unsubscribingFencesAlreadyQueuedCallbacks() throws Exception
+    {
+        List<Runnable> queued = new ArrayList<>();
+        List<NfoExportProgress.Snapshot> events = new ArrayList<>();
+        AutoCloseable listener = NfoExportProgress.listen(queued::add, events::add);
+        NfoExportProgress.begin(1).completed("Example");
+        listener.close();
+        queued.forEach(Runnable::run);
+        assertTrue(events.isEmpty());
+    }
+}
