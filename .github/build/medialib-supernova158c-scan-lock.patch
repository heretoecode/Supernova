new file mode 100644
index 0000000..9576534
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/DeferredScans.java
@@ -0,0 +1,75 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+
+import java.io.InterruptedIOException;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.CancellationException;
+
+/**
+ * D2 (0.158.8): a scan whose wait for the scan lock was cut short (the service closing, the app leaving the screen,
+ * the scheduler's own wake-up ending) is not a failed scan. It waits here and runs again when the app is next in
+ * front, instead of being reported as {@code scan_failed} at stage {@code process_lock}.
+ */
+public final class DeferredScans
+{
+    static final String PREFS = "supernova_deferred_scans";
+    static final String KEY = "uris";
+    static final int MAX = 64;
+
+    private DeferredScans()
+    {
+    }
+
+    /** True when the failure only means "your turn did not come yet", not that the source failed. */
+    public static boolean isWaitCutShort(Throwable failure)
+    {
+        return failure instanceof InterruptedIOException || failure instanceof CancellationException;
+    }
+
+    public static synchronized void remember(Context context, Uri uri)
+    {
+        if (context == null || uri == null)
+        {
+            return;
+        }
+        SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        Set<String> uris = new HashSet<>(prefs.getStringSet(KEY, new HashSet<>()));
+        if (uris.size() >= MAX)
+        {
+            return;
+        }
+        uris.add(uri.toString());
+        prefs.edit().putStringSet(KEY, uris).apply();
+    }
+
+    public static synchronized List<Uri> takeAll(Context context)
+    {
+        List<Uri> taken = new ArrayList<>();
+        if (context == null)
+        {
+            return taken;
+        }
+        SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        for (String uri : prefs.getStringSet(KEY, new HashSet<>()))
+        {
+            taken.add(Uri.parse(uri));
+        }
+        prefs.edit().remove(KEY).apply();
+        return taken;
+    }
+
+    public static synchronized int count(Context context)
+    {
+        if (context == null)
+        {
+            return 0;
+        }
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getStringSet(KEY, new HashSet<>()).size();
+    }
+}
