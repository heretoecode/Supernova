+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Application;
+import android.content.Context;
+import android.net.Uri;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.util.List;
+import java.util.concurrent.CancellationException;
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+/** D1 and D2 (0.158.8): a wait for the scan lock that is cut short never crashes and never counts as a failure. */
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class ScanLockDeferralTest
+{
+    @After public void clearInterrupt()
+    {
+        Thread.interrupted();
+    }
+
+    @Test public void anInterruptedMatchingSaveIsDeferredNotThrown()
+    {
+        Context context = RuntimeEnvironment.getApplication();
