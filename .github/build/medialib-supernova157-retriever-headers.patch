+    /**
+     * Android's URL form dereferences the headers map, and its path form is the only one that opens a plain file.
+     * Callers (the streaming proxies, the path overload) pass no headers, which made every seek preview fail with
+     * "Map.size() on a null object reference".
+     */
+    private void setPlatformSource(String uri, Map<String, String> headers)
+    {
+        if (headers != null)
+        {
+            mRetriever.setDataSource(uri, headers);
+            return;
+        }
+        String scheme = Uri.parse(uri).getScheme();
+        if (scheme == null || "file".equalsIgnoreCase(scheme))
+        {
+            mRetriever.setDataSource("file".equalsIgnoreCase(scheme) ? Uri.parse(uri).getPath() : uri);
+            return;
+        }
+        mRetriever.setDataSource(uri, Collections.<String, String>emptyMap());
+    }
