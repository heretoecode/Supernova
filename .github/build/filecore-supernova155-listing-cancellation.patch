+package com.archos.filecorelibrary.webdav;
+
+import static org.junit.Assert.*;
+
+import android.app.Application;
+import android.net.Uri;
+import androidx.test.core.app.ApplicationProvider;
+import com.archos.environment.ArchosUtils;
+import com.archos.filecorelibrary.ListingCancellation;
+import com.archos.filecorelibrary.RawListerFactory;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import okhttp3.mockwebserver.Dispatcher;
+import okhttp3.mockwebserver.MockResponse;
+import okhttp3.mockwebserver.MockWebServer;
+import okhttp3.mockwebserver.RecordedRequest;
+import okhttp3.mockwebserver.SocketPolicy;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+/** Real production lister/factory and redirect probe; no fake transport or warm-up bypass. */
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 28)
+public class WebdavListingCancellationTest {
+    @Before public void setUp() {
+        Application app = ApplicationProvider.getApplicationContext();
+        ArchosUtils.setGlobalContext(app);
+        WebdavUtils.getInstance(app);
+    }
+
+    @Test public void actualSilentPropfindStopsOnExplicitCancel() throws Exception { listing(false, false); }
+    @Test public void actualTricklingPropfindStopsOnExplicitCancel() throws Exception { listing(true, false); }
+    @Test public void actualSilentPropfindStopsOnDeadline() throws Exception { listing(false, true); }
+    @Test public void actualTricklingPropfindStopsOnDeadline() throws Exception { listing(true, true); }
+
+    private void listing(boolean trickle, boolean deadline) throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            CountDownLatch propfind = new CountDownLatch(1);
+            server.setDispatcher(new Dispatcher() {
+                @Override public MockResponse dispatch(RecordedRequest request) {
+                    if ("OPTIONS".equals(request.getMethod())) return new MockResponse().setHeader("DAV", "1, 2");
+                    assertEquals("PROPFIND", request.getMethod());
+                    propfind.countDown();
+                    if (!trickle) return new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE);
+                    return new MockResponse().setResponseCode(207).setHeader("Content-Type", "application/xml")
+                            .setBody("<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\"><d:response>"
+                                    + "<d:href>/TV/a.mkv</d:href><d:propstat><d:prop><d:displayname>"
+                                    + "a".repeat(4096) + "</d:displayname><d:resourcetype/>"
+                                    + "<d:getcontentlength>123</d:getcontentlength></d:prop>"
+                                    + "<d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response></d:multistatus>")
+                            .throttleBody(1, 20, TimeUnit.MILLISECONDS);
+                }
+            });
+            server.start();
+            Uri uri = Uri.parse(server.url("/TV/").toString()).buildUpon().scheme("webdav").build();
+            // The token exists before the worker, scope and lister factory.
+            ListingCancellation token = new ListingCancellation(deadline ? 5 : 30, TimeUnit.SECONDS);
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            try {
+                Future<Boolean> done = worker.submit(() -> {
+                    try (ListingCancellation.Scope scope = token.enter()) {
+                        try {
+                            RawListerFactory.getRawListerForUrl(uri).getFileList();
+                            fail("Raw listing must not complete normally");
+                        } catch (java.io.IOException | CancellationException expected) {
+                            assertTrue("Actual cancellation, not an unrelated failure", token.isCancelled());
+                        }
+                        try { ListingCancellation.checkpoint(); fail("No traversal after cancellation"); }
+                        catch (CancellationException expected) { return true; }
+                        return false;
+                    } finally { Thread.interrupted(); }
+                });
+                assertTrue("Actual PROPFIND must start", propfind.await(4, TimeUnit.SECONDS));
+                if (!deadline) token.cancel();
+                assertTrue(done.get(7, TimeUnit.SECONDS));
+            } finally {
+                token.cancel();
+                worker.shutdownNow();
+                assertTrue("Actual worker exit", worker.awaitTermination(2, TimeUnit.SECONDS));
+            }
+        }
+    }
+}
