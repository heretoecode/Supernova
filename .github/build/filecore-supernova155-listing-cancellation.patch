+++ b/src/com/archos/filecorelibrary/ListingCancellation.java
@@ -0,0 +1,162 @@
+package com.archos.filecorelibrary;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * A single listing's lifetime, allocated before submitting its worker. Enter before
+ * constructing the lister and keep the scope through filtering and traversal.
+ * Resources registered here MUST be operation-owned and have a nonblocking abort;
+ * never register a shared session, client pool, or a protocol logout operation.
+ */
+public final class ListingCancellation {
+    private static final ThreadLocal<ListingCancellation> CURRENT = new ThreadLocal<>();
+    private static final ScheduledExecutorService CLOCK = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread thread = new Thread(r, "ListingDeadline");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    @FunctionalInterface
+    public interface Abort {
+        void abort();
+    }
+
+    private final long timeout;
+    private final TimeUnit unit;
+    private final Set<Registration> resources = new HashSet<>();
+    private ScheduledFuture<?> deadline;
+    private Thread owner;
+    private boolean entered;
+    private boolean cancelled;
+    private boolean closed;
+
+    public ListingCancellation(long timeout, TimeUnit unit) {
+        if (timeout <= 0) throw new IllegalArgumentException("Positive listing deadline required");
+        if (unit == null) throw new NullPointerException("unit");
+        this.timeout = timeout;
+        this.unit = unit;
+    }
+
+    public static ListingCancellation current() {
+        return CURRENT.get();
+    }
+
+    /** Single use; cancellation before entry starts neither a timer nor I/O. */
+    public synchronized Scope enter() {
+        throwIfCancelled();
+        if (entered || closed) throw new IllegalStateException("Listing scope is single use");
+        if (CURRENT.get() != null) throw new IllegalStateException("Nested listing scope");
+        owner = Thread.currentThread();
+        entered = true;
+        CURRENT.set(this);
+        deadline = CLOCK.schedule(this::cancel, timeout, unit);
+        return new Scope();
+    }
+
+    /**
+     * Registers before starting I/O. A late registration is aborted immediately,
+     * including after normal close. No client code runs while holding our lock.
+     * The caller must still checkpoint before starting a reconnectable resource.
+     */
+    public Registration own(Abort abort) {
+        if (abort == null) throw new NullPointerException("abort");
+        Registration registration = new Registration(abort);
+        boolean reject;
+        synchronized (this) {
+            reject = cancelled || closed;
+            if (!reject) resources.add(registration);
+        }
+        if (reject) registration.abortOnce();
+        return registration;
+    }
+
+    public void cancel() {
+        ArrayList<Registration> owned;
+        synchronized (this) {
+            if (closed || cancelled) return;
+            cancelled = true;
+            owned = new ArrayList<>(resources);
+            resources.clear();
+            // Serialize interrupt with scope close so a late deadline cannot
+            // interrupt an unrelated task that reuses the worker thread.
+            if (owner != null) owner.interrupt();
+        }
+        abortAll(owned);
+    }
+
+    public synchronized boolean isCancelled() {
+        return cancelled;
+    }
+
+    public synchronized void throwIfCancelled() {
+        if (cancelled || closed) throw new CancellationException("Listing cancelled or closed");
+    }
+
+    public static void checkpoint() {
+        ListingCancellation listing = CURRENT.get();
+        if (listing != null) {
+            listing.throwIfCancelled();
+            if (Thread.currentThread().isInterrupted()) {
+                throw new CancellationException("Listing interrupted");
+            }
+        }
+    }
+
+    private static void abortAll(ArrayList<Registration> owned) {
+        for (Registration registration : owned) registration.abortOnce();
+    }
+
+    public final class Registration implements AutoCloseable {
+        private final Abort abort;
+        private boolean finished;
+
+        private Registration(Abort abort) {
+            this.abort = abort;
+        }
+
+        private void abortOnce() {
+            synchronized (ListingCancellation.this) {
+                if (finished) return;
+                finished = true;
+                resources.remove(this);
+            }
+            // One broken transport must not strand the remaining owned calls.
+            try { abort.abort(); }
+            catch (RuntimeException ignored) { /* state remains cancelled/closed */ }
+        }
+
+        /** Unregister only after the resource has finished or been closed. */
+        @Override public void close() {
+            synchronized (ListingCancellation.this) {
+                finished = true;
+                resources.remove(this);
+            }
+        }
+    }
+
+    public final class Scope implements AutoCloseable {
+        private Scope() {}
+
+        @Override public void close() {
+            ArrayList<Registration> owned;
+            synchronized (ListingCancellation.this) {
+                if (closed) return;
+                if (Thread.currentThread() != owner) throw new IllegalStateException("Wrong listing owner");
+                closed = true;
+                deadline.cancel(false);
+                owner = null;
+                owned = new ArrayList<>(resources);
+                resources.clear();
+                CURRENT.remove();
+            }
+            abortAll(owned);
+        }
+    }
+}
