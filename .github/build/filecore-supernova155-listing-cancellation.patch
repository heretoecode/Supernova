@@ -0,0 +1,172 @@
+package com.archos.filecorelibrary.webdav;
+
+import static org.junit.Assert.*;
+
+import com.archos.filecorelibrary.ListingCancellation;
+import java.io.IOException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import okhttp3.Call;
+import okhttp3.EventListener;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.mockwebserver.Dispatcher;
+import okhttp3.mockwebserver.MockResponse;
+import okhttp3.mockwebserver.MockWebServer;
+import okhttp3.mockwebserver.RecordedRequest;
+import okhttp3.mockwebserver.SocketPolicy;
+import org.junit.After;
+import org.junit.Test;
+
+/** Actual socket I/O; never cancel a Future to infer that the worker exited. */
+public class ListingCancellationSocketTest {
+    @After public void clearInterrupt() { Thread.interrupted(); }
+
+    @Test public void explicitCancellationStopsSilentListingWorker() throws Exception {
+        failure(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE), false);
+    }
+
+    @Test public void explicitCancellationStopsTricklingListingWorker() throws Exception {
+        failure(trickle(), false);
+    }
+
+    @Test public void deadlineStopsSilentListingWorker() throws Exception {
+        failure(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE), true);
+    }
+
+    @Test public void deadlineStopsTricklingListingWorker() throws Exception {
+        failure(trickle(), true);
+    }
+
+    private MockResponse trickle() {
+        // Syntactically valid multistatus; slow enough to stay active past cancellation.
+        return new MockResponse().setResponseCode(207).setHeader("Content-Type", "application/xml")
+                .setBody("<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\"><d:response>"
+                        + "<d:href>/TV/a.mkv</d:href><d:propstat><d:prop><d:displayname>"
+                        + "a".repeat(4096) + "</d:displayname></d:prop></d:propstat></d:response></d:multistatus>")
+                .throttleBody(1, 20, TimeUnit.MILLISECONDS);
+    }
+
+    private void failure(MockResponse response, boolean deadline) throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(response);
+            server.start();
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            ListingCancellation token = new ListingCancellation(deadline ? 300 : 10_000, TimeUnit.MILLISECONDS);
+            try {
+                Future<Boolean> done = worker.submit(() -> {
+                    try (ListingCancellation.Scope scope = token.enter()) {
+                        OkHttpClient base = new OkHttpClient.Builder().readTimeout(30, TimeUnit.SECONDS).build();
+                        Call call = ScanIoScope.client(base).newCall(new Request.Builder()
+                                .url(server.url("/TV")).method("PROPFIND", null).build());
+                        try (Response received = call.execute()) {
+                            received.body().string();
+                            fail("Listing must not finish normally");
+                        } catch (IOException expected) {
+                            assertTrue(token.isCancelled());
+                            assertTrue(call.isCanceled());
+                        }
+                        return true;
+                    } finally { Thread.interrupted(); }
+                });
+                RecordedRequest request = server.takeRequest(2, TimeUnit.SECONDS);
+                assertNotNull(request);
+                assertEquals("PROPFIND", request.getMethod());
+                if (!deadline) token.cancel(); // same owned abort regardless of Future interrupt flag
+                assertTrue(done.get(3, TimeUnit.SECONDS));
+            } finally {
+                token.cancel();
+                worker.shutdownNow();
+                assertTrue("Actual executor termination", worker.awaitTermination(2, TimeUnit.SECONDS));
+            }
+        }
+    }
+
+    @Test public void repeatedReplacementTerminatesAllActualWorkers() throws Exception {
+        for (int i = 0; i < 8; i++) {
+            failure(i % 2 == 0 ? trickle() : new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE), false);
+        }
+    }
+
+    @Test public void callCreatedBeforeCancelButStartedLaterIsStillOwned() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.start();
+            ListingCancellation token = new ListingCancellation(1, TimeUnit.MINUTES);
+            try (ListingCancellation.Scope scope = token.enter()) {
+                Call late = ScanIoScope.client(new OkHttpClient()).newCall(
+                        new Request.Builder().url(server.url("/late")).build());
+                token.cancel();
+                Thread.interrupted();
+                try (Response received = late.execute()) { fail("Late execution must fail"); }
+                catch (IOException expected) { assertTrue(late.isCanceled()); }
+                assertEquals(0, server.getRequestCount());
+            }
+        }
+    }
+
+    @Test public void callStartingAfterOwnerCloseIsCancelledBeforeNetwork() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.start();
+            OkHttpClient scoped;
+            ListingCancellation token = new ListingCancellation(1, TimeUnit.MINUTES);
+            try (ListingCancellation.Scope scope = token.enter()) {
+                scoped = ScanIoScope.client(new OkHttpClient());
+            }
+            Call late = scoped.newCall(new Request.Builder().url(server.url("/late")).build());
+            try (Response received = late.execute()) { fail("Closed listing must reject a late call"); }
+            catch (IOException expected) { assertTrue(late.isCanceled()); }
+            assertEquals(0, server.getRequestCount());
+        }
+    }
+
+    @Test public void sameBaseClientConcurrentPlaybackSurvivesListingCancellation() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            CountDownLatch playbackBody = new CountDownLatch(1);
+            server.setDispatcher(new Dispatcher() {
+                @Override public MockResponse dispatch(RecordedRequest request) {
+                    if ("/listing".equals(request.getPath())) return new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE);
+                    return new MockResponse().setBody("playback").throttleBody(1, 20, TimeUnit.MILLISECONDS);
+                }
+            });
+            server.start();
+            OkHttpClient base = new OkHttpClient.Builder().eventListener(new EventListener() {
+                @Override public void responseBodyStart(Call call) {
+                    if (call.request().url().encodedPath().equals("/playback")) playbackBody.countDown();
+                }
+            }).build();
+            ExecutorService workers = Executors.newFixedThreadPool(2);
+            ListingCancellation token = new ListingCancellation(10, TimeUnit.SECONDS);
+            try {
+                Future<String> playback = workers.submit(() -> {
+                    try (Response received = base.newCall(new Request.Builder().url(server.url("/playback")).build()).execute()) {
+                        return received.body().string();
+                    }
+                });
+                assertTrue(playbackBody.await(2, TimeUnit.SECONDS));
+                Future<Boolean> listing = workers.submit(() -> {
+                    try (ListingCancellation.Scope scope = token.enter()) {
+                        Call call = ScanIoScope.client(base).newCall(new Request.Builder().url(server.url("/listing")).build());
+                        try (Response received = call.execute()) { fail("Cancelled listing must fail"); }
+                        catch (IOException expected) { return token.isCancelled() && call.isCanceled(); }
+                        return false;
+                    } finally { Thread.interrupted(); }
+                });
+                // Both requests have reached this same server using the same original client.
+                assertNotNull(server.takeRequest(2, TimeUnit.SECONDS));
+                assertNotNull(server.takeRequest(2, TimeUnit.SECONDS));
+                token.cancel();
+                assertTrue(listing.get(2, TimeUnit.SECONDS));
+                assertEquals("playback", playback.get(2, TimeUnit.SECONDS));
+                assertSame(base, ScanIoScope.client(base));
+            } finally {
+                token.cancel();
+                workers.shutdownNow();
+                assertTrue(workers.awaitTermination(2, TimeUnit.SECONDS));
+            }
+        }
+    }
+}
