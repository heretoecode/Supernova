diff --git a/test/java/com/archos/filecorelibrary/ListingCancellationTest.java b/test/java/com/archos/filecorelibrary/ListingCancellationTest.java
new file mode 100644
index 0000000..91d4a4b
--- /dev/null
+++ b/test/java/com/archos/filecorelibrary/ListingCancellationTest.java
@@ -0,0 +1,199 @@
+package com.archos.filecorelibrary;
+
+import static org.junit.Assert.*;
+
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.CyclicBarrier;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.After;
+import org.junit.Test;
+
+public class ListingCancellationTest {
+    @After public void clearInterrupt() { Thread.interrupted(); }
+
+    private ListingCancellation listing() {
+        return new ListingCancellation(1, TimeUnit.MINUTES);
+    }
+
+    @Test public void cancelBeforeEnterDoesNotStartWork() {
+        ListingCancellation token = listing();
+        token.cancel();
+        try { token.enter(); fail("No entry after cancellation"); }
+        catch (CancellationException expected) { /* before factory or network setup */ }
+        assertNull(ListingCancellation.current());
+        assertFalse(Thread.currentThread().isInterrupted());
+    }
+
+    @Test public void cancellationBeforeRegistrationAbortsLateResourceExactlyOnce() {
+        ListingCancellation token = listing();
+        AtomicInteger aborted = new AtomicInteger();
+        token.cancel();
+        ListingCancellation.Registration registration = token.own(aborted::incrementAndGet);
+        token.cancel();
+        registration.close();
+        assertEquals(1, aborted.get());
+    }
+
+    @Test public void cancellationAfterRegistrationAbortsExactlyOnce() {
+        ListingCancellation token = listing();
+        AtomicInteger aborted = new AtomicInteger();
+        token.own(aborted::incrementAndGet);
+        token.cancel();
+        token.cancel();
+        assertEquals(1, aborted.get());
+    }
+
+    @Test public void completedResourcesAreUnregistered() {
+        ListingCancellation token = listing();
+        AtomicInteger aborted = new AtomicInteger();
+        token.own(aborted::incrementAndGet).close();
+        token.cancel();
+        assertEquals(0, aborted.get());
+    }
+
+    @Test public void closeAbortsRemainingAndLateResourcesAndClearsThreadBinding() {
+        ListingCancellation token = listing();
+        AtomicInteger aborted = new AtomicInteger();
+        try (ListingCancellation.Scope scope = token.enter()) {
+            assertSame(token, ListingCancellation.current());
+            token.own(aborted::incrementAndGet);
+        }
+        assertNull(ListingCancellation.current());
+        token.own(aborted::incrementAndGet);
+        token.cancel();
+        assertEquals(2, aborted.get());
+        assertFalse(Thread.currentThread().isInterrupted());
+        try { token.enter(); fail("Single use"); }
+        catch (CancellationException expected) { /* closed */ }
+    }
+
+    @Test public void abortRunsOutsideStateLockAndBrokenAbortDoesNotStrandPeers() throws Exception {
+        ListingCancellation token = listing();
+        AtomicInteger aborted = new AtomicInteger();
+        token.own(() -> { throw new IllegalStateException("broken vendor abort"); });
+        ExecutorService observer = Executors.newSingleThreadExecutor();
+        try {
+            token.own(() -> {
+                try {
+                    assertTrue(observer.submit(token::isCancelled).get(1, TimeUnit.SECONDS));
+                    aborted.incrementAndGet();
+                } catch (Exception failure) { throw new AssertionError(failure); }
+            });
+            token.cancel();
+            assertEquals(1, aborted.get());
+        } finally { observer.shutdownNow(); }
+    }
+
+    @Test public void cancelFencesCooperativeTraversalEvenIfInterruptWasCleared() {
+        ListingCancellation token = listing();
+        try (ListingCancellation.Scope scope = token.enter()) {
+            token.cancel();
+            Thread.interrupted();
+            try { ListingCancellation.checkpoint(); fail("No traversal after cancellation"); }
+            catch (CancellationException expected) { /* state, not only interrupt */ }
+        }
+    }
+
+    @Test public void lateDeadlineCannotInterruptReusedWorker() throws Exception {
+        ExecutorService worker = Executors.newSingleThreadExecutor();
+        CountDownLatch reused = new CountDownLatch(1);
+        try {
+            worker.submit(() -> {
+                ListingCancellation token = new ListingCancellation(30, TimeUnit.MILLISECONDS);
+                try (ListingCancellation.Scope scope = token.enter()) { /* finishes before deadline */ }
+                return null;
+            }).get(1, TimeUnit.SECONDS);
+            Future<Boolean> next = worker.submit(() -> {
+                reused.countDown();
+                return !new CountDownLatch(1).await(100, TimeUnit.MILLISECONDS)
+                        && !Thread.currentThread().isInterrupted();
+            });
+            assertTrue(reused.await(1, TimeUnit.SECONDS));
+            assertTrue(next.get(1, TimeUnit.SECONDS));
+        } finally {
+            worker.shutdownNow();
+            assertTrue(worker.awaitTermination(1, TimeUnit.SECONDS));
+        }
+    }
+
+    @Test public void cancelRacingOwnerCloseNeverAbortsTwiceOrLeaksInterrupt() throws Exception {
+        ExecutorService worker = Executors.newSingleThreadExecutor();
+        try {
+            for (int i = 0; i < 100; i++) {
+                ListingCancellation token = listing();
+                AtomicInteger aborted = new AtomicInteger();
+                CyclicBarrier race = new CyclicBarrier(2);
+                Future<?> done = worker.submit(() -> {
+                    try (ListingCancellation.Scope scope = token.enter()) {
+                        token.own(aborted::incrementAndGet);
+                        race.await(1, TimeUnit.SECONDS);
+                    } catch (InterruptedException expected) { assertTrue(token.isCancelled()); }
+                    catch (Exception failure) { throw new AssertionError(failure); }
+                    finally { Thread.interrupted(); }
+                });
+                race.await(1, TimeUnit.SECONDS);
+                token.cancel();
+                done.get(1, TimeUnit.SECONDS); // actual runnable exit, not a cancelled Future
+                assertEquals(1, aborted.get());
+                assertFalse(worker.submit(() -> Thread.currentThread().isInterrupted()).get(1, TimeUnit.SECONDS));
+            }
+        } finally {
+            worker.shutdownNow();
+            assertTrue(worker.awaitTermination(1, TimeUnit.SECONDS));
+        }
+    }
+
+    @Test public void registrationRacingCancellationAlwaysAbortsOnce() throws Exception {
+        ExecutorService creator = Executors.newSingleThreadExecutor();
+        try {
+            for (int i = 0; i < 100; i++) {
+                ListingCancellation token = listing();
+                AtomicInteger aborted = new AtomicInteger();
+                CyclicBarrier race = new CyclicBarrier(2);
+                Future<?> done = creator.submit(() -> {
+                    try { race.await(1, TimeUnit.SECONDS); }
+                    catch (Exception failure) { throw new AssertionError(failure); }
+                    token.own(aborted::incrementAndGet);
+                });
+                race.await(1, TimeUnit.SECONDS);
+                token.cancel();
+                done.get(1, TimeUnit.SECONDS);
+                assertEquals(1, aborted.get());
+            }
+        } finally { creator.shutdownNow(); }
+    }
+
+    @Test public void wrongOwnerCannotCloseAndOwnerCloseIsIdempotent() throws Exception {
+        ListingCancellation token = listing();
+        ExecutorService foreign = Executors.newSingleThreadExecutor();
+        ListingCancellation.Scope scope = token.enter();
+        try {
+            assertTrue(foreign.submit(() -> {
+                try { scope.close(); return false; }
+                catch (IllegalStateException expected) { return true; }
+            }).get(1, TimeUnit.SECONDS));
+            assertSame(token, ListingCancellation.current());
+            scope.close();
+            scope.close();
+            assertNull(ListingCancellation.current());
+        } finally {
+            scope.close();
+            foreign.shutdownNow();
+        }
+    }
+
+    @Test public void nestedEntryIsRejectedWithoutLosingOuterBinding() {
+        ListingCancellation outer = listing();
+        try (ListingCancellation.Scope scope = outer.enter()) {
+            try { listing().enter(); fail("No nested binding"); }
+            catch (IllegalStateException expected) { /* still outer */ }
+            assertSame(outer, ListingCancellation.current());
+        }
+        assertNull(ListingCancellation.current());
+    }
+}
diff --git a/test/java/com/archos/filecorelibrary/webdav/ListingCancellationSocketTest.java b/test/java/com/archos/filecorelibrary/webdav/ListingCancellationSocketTest.java
