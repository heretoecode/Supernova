diff --git a/Source/stream_filter_audio_sonic.c b/Source/stream_filter_audio_sonic.c
new file mode 100644
index 0000000..99aeaa9
--- /dev/null
+++ b/Source/stream_filter_audio_sonic.c
@@ -0,0 +1,608 @@
+/*
