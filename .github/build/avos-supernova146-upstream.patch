+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/* Reference from Source/codec_sfdec2.c at 0ab00c6, Apache-2.0.
+ * Frozen for differential testing; do not regenerate from the implementation. */
+static void advance_reference(priv_t *p, STREAM *s, VIDEO_FRAME *f, int mode2_dynamic_active)
+{
+int mode2_new_slew_frame = p->mode2_dynamic_slew &&
+				(f->android_handle != p->mode2_slew_frame_handle ||
+				 f->time != p->mode2_slew_frame_time ||
+				 f->epoch != p->mode2_slew_frame_epoch);
+int pcm_startup_new_slew_frame = (p->pcm_startup_slew || p->mode1_resume_slew) &&
+				(f->android_handle != p->pcm_startup_slew_frame_handle ||
+				 f->time != p->pcm_startup_slew_frame_time ||
+				 f->epoch != p->pcm_startup_slew_frame_epoch);
+if (p->slew_active &&
+				(!p->pcm_resume_slew || (!p->pause_armed && (!s || !s->paused))) &&
+				(!p->mode2_dynamic_slew || mode2_new_slew_frame) &&
+				(!(p->pcm_startup_slew || p->mode1_resume_slew) || pcm_startup_new_slew_frame)) {
+				INT64 delta = p->target_offset_ns - p->render_offset_ns;
+				// A Mode 2 clock transition can correct hundreds of milliseconds, so
+				// converge it at 5ms/frame. PCM startup uses 1ms per distinct frame to
+				// remove its bounded residual without a snap. Once established, track
+				// ordinary clock drift at 0.2ms/frame: compressed presentation samples
+				// can move by a whole codec frame and then hold, and chasing that
+				// temporary phase at 5ms/frame produces visible cadence reversals.
+				INT64 step = p->mode2_dynamic_fast_slew ? 5000000 :
+					(p->pcm_startup_slew ? 1000000 : 200000);
+				if( (p->pcm_startup_slew && p->pcm_resume_slew) || p->mode1_resume_slew ) {
+					// Rapid pauses can accumulate a phase that takes seconds to
+					// remove at the startup rate. Limit resume correction to 10%
+					// of the speed-adjusted frame interval, capped at 4ms, so
+					// high frame rates/speeds do not get large cadence changes.
+					step = f->duration > 0 ? MIN(4000000LL,
+						(INT64)f->duration * 100000LL) : 1000000LL;
+				}
+				if (delta > step) {
+					delta = step;
+				} else if (delta < -step) {
+					delta = -step;
+				}
+				p->render_offset_ns += delta;
+				INT64 remaining = llabs(p->target_offset_ns - p->render_offset_ns);
+				// Bounded per-frame slews must carry the remainder to the next
+				// frame. Snapping here can double the Mode 2 correction to 10ms.
+				if (remaining == 0 || (!(p->pcm_startup_slew || p->mode1_resume_slew ||
+					p->mode2_dynamic_slew) && remaining <= step)) {
+					p->render_offset_ns = p->target_offset_ns;
+					p->slew_active = 0;
+					if (!p->mode2_dynamic_fast_slew) {
+						p->mode2_dynamic_settle_frames = 0;
+					}
+					if( !mode2_dynamic_active ) {
+						p->mode2_dynamic_slew = 0;
+						p->mode2_slew_frame_handle = NULL;
+						p->mode2_slew_frame_time = INT_MIN;
+						p->mode2_slew_frame_epoch = INT_MIN;
+					}
+					if( p->mode1_resume_slew ) {
+						DBGSI serprintf("android_sync: mode1 phase slew complete offset=%lld\n",
+							(long long)p->render_offset_ns);
+						p->mode1_resume_slew = 0;
+					}
+					if( p->pcm_startup_slew ) {
+						if( p->pcm_resume_slew ) {
+							DBGSI serprintf("android_sync: PCM resume slew complete offset=%lld\n",
+								(long long)p->render_offset_ns);
+						}
+						p->pcm_startup_slew = 0;
+						p->pcm_resume_slew = 0;
+						if( !p->pcm_resume_calibration_active ) {
+							p->pcm_startup_slew_frame_handle = NULL;
+							p->pcm_startup_slew_frame_time = INT_MIN;
+							p->pcm_startup_slew_frame_epoch = INT_MIN;
+						}
+					}
+				}
+			}
+if( p->mode2_dynamic_slew && mode2_new_slew_frame ) {
+				p->mode2_slew_frame_handle = f->android_handle;
+				p->mode2_slew_frame_time = f->time;
+				p->mode2_slew_frame_epoch = f->epoch;
+			}
+if( (p->pcm_startup_slew || p->pcm_resume_calibration_active || p->mode1_resume_slew) && pcm_startup_new_slew_frame ) {
+				p->pcm_startup_slew_frame_handle = f->android_handle;
+				p->pcm_startup_slew_frame_time = f->time;
+				p->pcm_startup_slew_frame_epoch = f->epoch;
+			}
+}
diff --git a/test/host/close_open_parsing_test.c b/test/host/close_open_parsing_test.c
new file mode 100644
index 0000000..9158f8f
--- /dev/null
+++ b/test/host/close_open_parsing_test.c
@@ -0,0 +1,171 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Close one video and immediately open another while subtitle parsing is still active, with the
+ * Java side rebuilding the SubtitleEngine underneath.
+ *
+ * Each "video" mirrors avos_mp_video_open()/close(): acquire the published engine from the
+ * registry, start the clock, open a track and start a parse worker feeding a large cue list with
+ * the track's generation token; close = stop the clock, stop and join the worker, close the track,
+ * release the engine. Two close orders are exercised:
+ *
+ *   orderly  : stop worker, join, close_track, release      (what stream_delete() guarantees)
+ *   hostile  : close_track while the worker is still mid-list, join afterwards; proves that even a
+ *              worker that has not noticed the cancellation yet cannot leak cues into whatever
+ *              is opened next (the token check) and cannot touch freed memory.
+ *
+ * A "Java" thread meanwhile rebuilds the engine (create+publish new, retract old, in either
+ * order). A video that still holds the old engine keeps it alive; the next video gets the new one.
+ * Checks: every engine created is destroyed exactly once, never while a video holds it; no cue from
+ * a closed video reaches the next video's backend; no backend leaks. Run it under AddressSanitizer
+ * (use-after-free on a destroyed engine) and ThreadSanitizer (see test_host_native.py).
+ */
+#include "sub_engine.h"
+#include "sub_engine_registry.h"
+#include "fake_backend.h"
+#include "host_test_util.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define BIG_CUES 30000
+
+static atomic_int g_created, g_destroyed, g_stop_java, g_destroyed_while_held;
+
+/* How many videos currently hold each engine, so destroy can assert it never runs under a holder.
+ * (ASan would catch the resulting use-after-free too, but only when it is built in.) */
+typedef struct { SUB_ENGINE *e; atomic_int holders; } SLOT;
+static SLOT g_slots[1024];
+static int g_nslots;
+static pthread_mutex_t g_slots_m = PTHREAD_MUTEX_INITIALIZER;
+static atomic_int *holders_of(SUB_ENGINE *e) {
+    pthread_mutex_lock(&g_slots_m);
+    atomic_int *h = NULL;
+    for (int i = 0; i < g_nslots && !h; i++) if (g_slots[i].e == e) h = &g_slots[i].holders;
+    if (!h && g_nslots < 1024) { g_slots[g_nslots].e = e; h = &g_slots[g_nslots++].holders; }
+    pthread_mutex_unlock(&g_slots_m);
+    return h;
+}
+static void destroy_cb(SUB_ENGINE *e) {
+    atomic_int *h = holders_of(e);
+    if (h && atomic_load(h) != 0) atomic_fetch_add(&g_destroyed_while_held, 1);
+    sub_engine_destroy(e);
+    atomic_fetch_add(&g_destroyed, 1);
+}
+static SUB_ENGINE *new_engine(void) { SUB_ENGINE *e = sub_engine_create(); atomic_fetch_add(&g_created, 1); return e; }
+
+/* ---- the Java side: rebuilds the engine at random times ---- */
+static void *java_thread(void *arg) {
+    SUB_ENGINE *cur = arg;
+    while (!atomic_load(&g_stop_java)) {
+        usleep((unsigned)(500 + rand() % 3000));
+        SUB_ENGINE *next = new_engine();
+        if (rand() & 1) {                         /* new first: both engines exist, newest is published */
+            sub_engine_registry_publish(next);
+            sub_engine_registry_retract(cur, destroy_cb);
+        } else {                                  /* old first: a stream opening now may see no engine at all */
+            sub_engine_registry_retract(cur, destroy_cb);
+            usleep((unsigned)(rand() % 300));
+            sub_engine_registry_publish(next);
+        }
+        cur = next;
+    }
+    return cur;                                   /* the engine that is still published */
+}
+
+/* ---- one "video" ---- */
+typedef struct { SUB_ENGINE *e; uint64_t tok; char label; int accepted, stopped_early; atomic_int stop; pthread_t th; } VIDEO;
+
+static void *parse_worker(void *arg) {
+    VIDEO *v = arg;
+    char buf[24];
+    for (int i = 0; i < BIG_CUES && !atomic_load(&v->stop); i++) {
+        int n = snprintf(buf, sizeof buf, "%c%d", v->label, i);
+        if (!sub_engine_feed_gen(v->e, v->tok, (const uint8_t *)buf, n, (int64_t)i * 40, 2000)) { v->stopped_early = 1; break; }
+        v->accepted++;
+    }
+    return NULL;
+}
+
+static VIDEO *video_open(char label) {
+    SUB_ENGINE *e = sub_engine_registry_acquire();
+    if (!e) return NULL;                          /* Java is between engines: this video has no subtitles */
+    VIDEO *v = calloc(1, sizeof *v);
+    v->e = e; v->label = label;
+    atomic_fetch_add(holders_of(e), 1);
+    sub_engine_start(e, fake_clock, NULL);
+    sub_engine_open_track(e, SUB_FMT_SRT, 1920, 1080, NULL, 0, NULL, 0, &v->tok);
+    pthread_create(&v->th, NULL, parse_worker, v);
+    return v;
+}
+
+/* Returns how many cues this video's worker had accepted. */
+static int video_close(VIDEO *v, int hostile) {
+    sub_engine_stop(v->e);
+    if (hostile) {
+        sub_engine_close_track(v->e);             /* worker still mid-list */
+        pthread_join(v->th, NULL);
+    } else {
+        atomic_store(&v->stop, 1);
+        pthread_join(v->th, NULL);
+        sub_engine_close_track(v->e);
+    }
+    int accepted = v->accepted;
+    atomic_fetch_sub(holders_of(v->e), 1);
+    sub_engine_registry_release(v->e);            /* after the last use of v->e */
+    free(v);
+    return accepted;
+}
+
+int main(int argc, char **argv) {
+    t_watchdog(150, "close_open_parsing");
+    int iters = argc > 1 ? atoi(argv[1]) : 150;
+    fake_backend_set_mode(FAKE_EMIT_ON_DEMAND);
+    fake_backend_reset_counters();
+
+    SUB_ENGINE *first = new_engine();
+    sub_engine_registry_publish(first);
+    pthread_t jt;
+    pthread_create(&jt, NULL, java_thread, first);
+
+    long accepted_total = 0; int no_engine = 0, videos = 0;
+    for (int i = 0; i < iters; i++) {
+        VIDEO *v = video_open((i & 1) ? 'B' : 'A');
+        if (!v) { no_engine++; usleep(200); continue; }
+        videos++;
+        usleep((unsigned)(rand() % 1500));        /* parsing is active when we close */
+        /* close, then loop straight into the next open: no pause between the two */
+        accepted_total += video_close(v, (i % 3) == 2);
+    }
+
+    atomic_store(&g_stop_java, 1);
+    void *cur_ret = NULL;
+    pthread_join(jt, &cur_ret);
+    SUB_ENGINE *cur = cur_ret;
+
+    CHECK(videos > iters / 2, "most videos found an engine (%d of %d; %d hit a rebuild gap)", videos, iters, no_engine);
+    CHECK(fake_backend_foreign() == 0, "no cue from a closed video reached another video's backend (foreign=%d)", fake_backend_foreign());
+    CHECK(fake_backend_feeds() == accepted_total,
+          "every cue a worker saw accepted reached exactly one backend, none were duplicated or lost (%ld vs %d)", accepted_total, fake_backend_feeds());
+    CHECK(fake_backend_live() == 0, "every track backend was closed (%d live)", fake_backend_live());
+
+    int r = sub_engine_registry_retract(cur, destroy_cb);
+    CHECK(r == 1, "the last engine had no holders left: destroyed immediately");
+    CHECK(atomic_load(&g_destroyed_while_held) == 0, "no engine was destroyed while a video still held it");
+    CHECK(atomic_load(&g_destroyed) == atomic_load(&g_created),
+          "every engine created was destroyed exactly once (%d created, %d destroyed)", atomic_load(&g_created), atomic_load(&g_destroyed));
+    return t_finish();
+}
diff --git a/test/host/fake_backend.c b/test/host/fake_backend.c
new file mode 100644
index 0000000..51ede2e
--- /dev/null
+++ b/test/host/fake_backend.c
@@ -0,0 +1,152 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/* See fake_backend.h for what this stands in for and why. */
+#include "fake_backend.h"
+#include "sub_engine.h"
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <pthread.h>
+
+static volatile int  g_emit = 0;
+static volatile int  g_mode = FAKE_EMIT_ON_DEMAND;
+
+typedef struct { int label; int feeds; int since_flush; } FAKE_CTX;
+static int g_live, g_feeds, g_flushes, g_renders, g_resizes, g_boxes, g_foreign;
+static int64_t g_last_pts = -1;
+static int g_cw, g_ch, g_bx, g_by, g_bw, g_bh;
+static FAKE_CTX *g_latest;
+static pthread_mutex_t g_m = PTHREAD_MUTEX_INITIALIZER;
+#define INC(v) __atomic_fetch_add(&(v), 1, __ATOMIC_RELAXED)
+#define GET(v) __atomic_load_n(&(v), __ATOMIC_RELAXED)
+
+void fake_backend_reset_counters(void) {
+    __atomic_store_n(&g_feeds, 0, __ATOMIC_RELAXED);  __atomic_store_n(&g_flushes, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_renders, 0, __ATOMIC_RELAXED); __atomic_store_n(&g_resizes, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_boxes, 0, __ATOMIC_RELAXED);  __atomic_store_n(&g_foreign, 0, __ATOMIC_RELAXED);
+    pthread_mutex_lock(&g_m); g_last_pts = -1; g_cw = g_ch = g_bx = g_by = g_bw = g_bh = 0; pthread_mutex_unlock(&g_m);
+}
+int fake_backend_live(void)     { return GET(g_live); }
+int fake_backend_feeds(void)    { return GET(g_feeds); }
+int fake_backend_flushes(void)  { return GET(g_flushes); }
+int fake_backend_renders(void)  { return GET(g_renders); }
+int fake_backend_resizes(void)  { return GET(g_resizes); }
+int fake_backend_box_sets(void) { return GET(g_boxes); }
+int fake_backend_foreign(void)  { return GET(g_foreign); }
+void fake_backend_last_canvas(int *w, int *h) { pthread_mutex_lock(&g_m); *w = g_cw; *h = g_ch; pthread_mutex_unlock(&g_m); }
+void fake_backend_last_box(int *x, int *y, int *w, int *h) {
+    pthread_mutex_lock(&g_m); *x = g_bx; *y = g_by; *w = g_bw; *h = g_bh; pthread_mutex_unlock(&g_m);
+}
+int64_t fake_backend_last_pts(void) { pthread_mutex_lock(&g_m); int64_t p = g_last_pts; pthread_mutex_unlock(&g_m); return p; }
+int fake_backend_active_since_flush(void) {
+    pthread_mutex_lock(&g_m);
+    int n = g_latest ? __atomic_load_n(&g_latest->since_flush, __ATOMIC_RELAXED) : -1;
+    pthread_mutex_unlock(&g_m);
+    return n;
+}
+
+void fake_backend_set_mode(FAKE_MODE m) { __atomic_store_n(&g_mode, (int)m, __ATOMIC_RELEASE); }
+void fake_backend_emit(void)            { __atomic_store_n(&g_emit, 1, __ATOMIC_RELEASE); }
+int64_t fake_clock(void *ctx)           { (void)ctx; return 1000; }
+
+SUB_FRAME *fake_frame_new(int with_events) {
+    SUB_FRAME *f = calloc(1, sizeof(*f));
+    f->refcount = 1;
+    f->video_w = f->video_h = 8;
+    if (with_events) {
+        SUB_EVENT *e = calloc(1, sizeof(*e));
+        e->kind = SUB_EVENT_BITMAP; e->w = e->h = 2;
+        uint8_t *px = malloc(16); memset(px, 255, 16);
+        e->data.bitmap.rgba = px; e->data.bitmap.stride = 8;
+        f->events = e;
+    }
+    return f;
+}
+
+static SUB_FRAME *fake_render_at(SUB_FORMAT_BACKEND *be, int64_t pts) {
+    (void)be;
+    INC(g_renders);
+    pthread_mutex_lock(&g_m); g_last_pts = pts; pthread_mutex_unlock(&g_m);
+    if (__atomic_load_n(&g_mode, __ATOMIC_ACQUIRE) == FAKE_EMIT_ALWAYS_SLOW) {
+        usleep(300);                                   /* widens the poll->publish window */
+    } else if (!__atomic_exchange_n(&g_emit, 0, __ATOMIC_ACQ_REL)) {
+        return NULL;                                   /* NULL == "unchanged" (as ssa/gfx do) */
+    }
+    return fake_frame_new(1);
+}
+static int fake_open(SUB_FORMAT_BACKEND *be, const SUB_FORMAT_OPEN_PARAMS *p) {
+    (void)p;
+    FAKE_CTX *ctx = calloc(1, sizeof(*ctx));
+    be->priv = ctx;
+    pthread_mutex_lock(&g_m); g_latest = ctx; pthread_mutex_unlock(&g_m);
+    INC(g_live);
+    return 0;
+}
+static int fake_close(SUB_FORMAT_BACKEND *be) {
+    FAKE_CTX *ctx = (FAKE_CTX *)be->priv;
+    if (!ctx) return 0;            /* open() never ran (engine's failed-open path calls close too) */
+    pthread_mutex_lock(&g_m); if (g_latest == ctx) g_latest = NULL; pthread_mutex_unlock(&g_m);
+    free(ctx); be->priv = NULL;
+    __atomic_fetch_sub(&g_live, 1, __ATOMIC_RELAXED);
+    return 0;
+}
+static int fake_feed(SUB_FORMAT_BACKEND *be, const uint8_t *data, int size, int64_t pts, int64_t dur) {
+    (void)pts; (void)dur;
+    FAKE_CTX *ctx = (FAKE_CTX *)be->priv;
+    int label = size > 0 ? data[0] : 0;
+    if (!ctx->label) ctx->label = label;
+    else if (ctx->label != label) INC(g_foreign);
+    ctx->feeds++;
+    __atomic_fetch_add(&ctx->since_flush, 1, __ATOMIC_RELAXED);
+    INC(g_feeds);
+    return 1;
+}
+static int fake_flush(SUB_FORMAT_BACKEND *be) {
+    FAKE_CTX *ctx = (FAKE_CTX *)be->priv;
+    __atomic_store_n(&ctx->since_flush, 0, __ATOMIC_RELAXED);
+    INC(g_flushes);
+    return 0;
+}
+static int fake_resize(SUB_FORMAT_BACKEND *be, int w, int h) {
+    (void)be; INC(g_resizes);
+    pthread_mutex_lock(&g_m); g_cw = w; g_ch = h; pthread_mutex_unlock(&g_m);
+    return 0;
+}
+static int fake_set_box(SUB_FORMAT_BACKEND *be, int x, int y, int w, int h) {
+    (void)be; INC(g_boxes);
+    pthread_mutex_lock(&g_m); g_bx = x; g_by = y; g_bw = w; g_bh = h; pthread_mutex_unlock(&g_m);
+    return 0;
+}
+/* RST timing contract (get_schedule replaced the old get_timeout_ms, which this returned 1 from).
+ * A deadline that is already due (next_rst_ms <= now) makes the engine's schedule_to_wall_ms()
+ * wait the minimum, 1 ms, then re-poll -- the same cadence as the old 1 ms timeout, which is
+ * what race_harness relies on (a poll loop that never goes idle). The tests drive their own
+ * wake-ups too (fake_backend_emit() + sub_engine_force_wake()). */
+static void fake_schedule(SUB_FORMAT_BACKEND *be, int64_t pts_rst_ms, SUB_SCHEDULE *out) {
+    (void)be; (void)pts_rst_ms;
+    out->next_rst_ms = 0;
+    out->animating   = 0;
+}
+
+SUB_FORMAT_BACKEND *sub_format_ssa_create(void) {
+    SUB_FORMAT_BACKEND *b = calloc(1, sizeof(*b));
+    b->open = fake_open; b->close = fake_close;
+    b->render_at = fake_render_at; b->get_schedule = fake_schedule;
+    b->feed = fake_feed; b->flush = fake_flush; b->resize = fake_resize; b->set_video_box = fake_set_box;
+    return b;
+}
+SUB_FORMAT_BACKEND *sub_format_srt_create(void) { return sub_format_ssa_create(); }
+SUB_FORMAT_BACKEND *sub_format_gfx_create(void) { return sub_format_ssa_create(); }
diff --git a/test/host/fake_backend.h b/test/host/fake_backend.h
new file mode 100644
index 0000000..d2f9b0b
--- /dev/null
+++ b/test/host/fake_backend.h
@@ -0,0 +1,56 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#pragma once
+/*
+ * A controllable stand-in for the SSA/SRT/GFX backends (sub_format_ssa/srt/gfx_create(),
+ * which sub_engine.c calls directly -- see its open_track()). The tests in this directory
+ * link the REAL sub_engine.c/sub_render_gl.c and need a backend that can be told exactly
+ * when to answer "unchanged" (NULL) versus a new frame, and one whose render_at() can be
+ * made deliberately slow -- neither of which the real SSA/SRT/GFX backends offer control
+ * over from a test. This is that backend, plus a couple of frame-construction helpers.
+ */
+#include <stdint.h>
+#include "sub_types.h"
+
+typedef enum {
+    FAKE_EMIT_ON_DEMAND,    /* render_at() returns NULL ("unchanged") until fake_backend_emit() */
+    FAKE_EMIT_ALWAYS_SLOW   /* render_at() sleeps ~300us and returns a NEW frame every call */
+} FAKE_MODE;
+
+void     fake_backend_set_mode(FAKE_MODE mode);
+void     fake_backend_emit(void);              /* ON_DEMAND: next render_at() yields one new frame */
+int64_t  fake_clock(void *ctx);                /* pass to sub_engine_start() */
+SUB_FRAME *fake_frame_new(int with_events);    /* refcount 1; with_events=0 is an empty ("clear") frame */
+
+/* ---- observation hooks (added for the lifetime / loading / pause tests) ----------------------
+ * Counters are process-wide and updated with atomics; reset them with fake_backend_reset_counters()
+ * at the start of a scenario. "live" is deliberately NOT reset: it is opened-minus-closed backend
+ * instances, i.e. a leak detector that must read 0 after the engine is destroyed. */
+void    fake_backend_reset_counters(void);
+int     fake_backend_live(void);                 /* backends opened and not yet closed */
+int     fake_backend_feeds(void);                /* feed() calls that reached a backend */
+int     fake_backend_flushes(void);
+int     fake_backend_renders(void);              /* render_at() calls */
+int     fake_backend_resizes(void);              /* backend->resize() calls */
+int     fake_backend_box_sets(void);             /* backend->set_video_box() calls */
+void    fake_backend_last_canvas(int *w, int *h);
+void    fake_backend_last_box(int *x, int *y, int *w, int *h);
+int64_t fake_backend_last_pts(void);             /* pts of the last render_at(); -1 if none */
+/* A backend remembers the first byte of the first cue it was fed as its "label". A later cue with
+ * a different first byte means a cue from another track reached it: counted here. */
+int     fake_backend_foreign(void);
+/* Feeds the MOST RECENTLY OPENED backend has accepted since its last flush (or since open). */
+int     fake_backend_active_since_flush(void);
+
diff --git a/test/host/fill_contract_test.c b/test/host/fill_contract_test.c
new file mode 100644
index 0000000..b806347
--- /dev/null
+++ b/test/host/fill_contract_test.c
@@ -0,0 +1,60 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * The renderer's publish/clear/fill contract: which of UNCHANGED / CLEAR / FRAME / ERROR a pull
+ * answers, and that the generation moves exactly when what is on screen changes.
+ */
+#include "sub_engine.h"
+#include "sub_render_gl.h"
+#include "fake_backend.h"
+#include <stdio.h>
+#include <string.h>
+
+static int fails = 0;
+#define CHECK(c, msg) do { if (!(c)) { printf("FAIL: %s\n", msg); fails++; } else printf("ok:   %s\n", msg); } while (0)
+
+int main(void) {
+    SUB_RENDERER *r = sub_render_gl_create(NULL);
+    uint8_t px[8 * 8 * 4]; uint64_t g; SUB_FILL_RESULT rc; const uint64_t NONE = (uint64_t)-1;
+
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, NONE, 0, &g);
+    CHECK(rc == SUB_FILL_CLEAR && g == 0, "start: nothing posted yet -> CLEAR, gen 0");
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, g, 0, &g);
+    CHECK(rc == SUB_FILL_UNCHANGED, "same gen, still nothing -> UNCHANGED");
+    CHECK(sub_render_gl_publish(r, NULL) == 0, "backend says NULL -> unchanged");
+    CHECK(sub_render_gl_publish(r, fake_frame_new(0)) == 0, "empty frame over empty screen -> unchanged (no gen bump)");
+    CHECK(sub_render_gl_publish(r, fake_frame_new(1)) == 1, "new frame -> changed");
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, 0, 0, &g);
+    CHECK(rc == SUB_FILL_FRAME && g == 1 && px[3] == 255, "gen moved 0->1 -> FRAME, pixels blended, gen 1 reported with them");
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, g, 0, &g);
+    CHECK(rc == SUB_FILL_UNCHANGED && g == 1, "same gen -> UNCHANGED");
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, g, 1, &g);
+    CHECK(rc == SUB_FILL_FRAME, "force=1 never answers UNCHANGED");
+    CHECK(sub_render_gl_publish(r, fake_frame_new(0)) == 1, "empty frame over visible content -> CLEAR, changed");
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, 1, 0, &g);
+    CHECK(rc == SUB_FILL_CLEAR && g == 2, "-> CLEAR, gen 2 (a clear is a real change, not 'unchanged')");
+    sub_render_gl_publish(r, fake_frame_new(1));
+    sub_render_gl_clear_nowake(r);
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, 3, 0, &g);
+    CHECK(rc == SUB_FILL_CLEAR && g == 4, "track close/open clear of visible content bumps gen -> CLEAR");
+    sub_render_gl_clear_nowake(r);
+    rc = sub_render_gl_fill_bitmap(r, px, 8, 8, 32, g, 0, &g);
+    CHECK(rc == SUB_FILL_UNCHANGED && g == 4, "clear of already-clear screen -> no bump");
+    rc = sub_render_gl_fill_bitmap(r, NULL, 8, 8, 32, NONE, 0, &g);
+    CHECK(rc == SUB_FILL_ERROR, "bad args -> ERROR (distinct from CLEAR)");
+
+    printf("%s\n", fails ? "FAILED" : "ALL PASSED");
+    return fails;
+}
