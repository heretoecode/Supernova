+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#pragma once
+/*
+ * Font selection shared by the libass-based tests. No font is bundled and none is assumed: the
+ * harness (test_host_native.py) finds a real TrueType/OpenType file on the machine (an explicit
+ * override, a well-known system font, or fontconfig's sans-serif) and passes it through
+ *
+ *   HOST_TEST_FONT          path of the font file
+ *   HOST_TEST_FONT_FAMILY   its family name, as ASS styles must spell it
+ *   HOST_TEST_FONT_DIR      a folder holding just that file (for the backend's fonts_dir)
+ *
+ * Every check in these tests compares text rendered with the SAME font against itself (a reference
+ * render, a control ordering, a ratio), so which font it is does not matter -- only that real glyphs
+ * render. Test scripts therefore carry the placeholder "@FONT@" where a family name goes, and
+ * with_font() fills it in.
+ */
+#include <stdlib.h>
+#include <string.h>
+
+#define FONT_PLACEHOLDER "@FONT@"
+
+/* Family to use in styles; "DejaVu Sans" only when a test is run by hand without the harness. */
+static inline const char *test_font_family(void) {
+    const char *f = getenv("HOST_TEST_FONT_FAMILY");
+    return (f && f[0]) ? f : "DejaVu Sans";
+}
+
+/* Returns a malloc'd copy of `tmpl` with every "@FONT@" replaced by the test font family. */
+static inline char *with_font(const char *tmpl) {
+    const char *fam = test_font_family();
+    size_t flen = strlen(fam), plen = strlen(FONT_PLACEHOLDER), n = 0;
+    for (const char *p = tmpl; (p = strstr(p, FONT_PLACEHOLDER)); p += plen) n++;
+    char *out = malloc(strlen(tmpl) + n * flen + 1), *w = out;
+    const char *p = tmpl, *hit;
+    while ((hit = strstr(p, FONT_PLACEHOLDER))) {
+        memcpy(w, p, (size_t)(hit - p)); w += hit - p;
+        memcpy(w, fam, flen); w += flen;
+        p = hit + plen;
+    }
+    strcpy(w, p);
+    return out;
+}
diff --git a/test/host/host_test_util.h b/test/host/host_test_util.h
new file mode 100644
index 0000000..96e0cd0
--- /dev/null
+++ b/test/host/host_test_util.h
@@ -0,0 +1,46 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#pragma once
+/*
+ * Small helpers shared by the concurrency tests in this directory: a CHECK macro that keeps going
+ * (so one run reports every failure), and a watchdog that turns a deadlock into a readable FAIL
+ * line instead of a silent timeout in the Python runner.
+ */
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static int t_fails = 0;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); t_fails++; } \
+                           else { printf("ok:   "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static const char *t_watchdog_name = "test";
+static void t_watchdog_fired(int sig) {
+    (void)sig;
+    static const char msg[] = "FAIL: watchdog expired -- deadlock or lost wake-up\n";
+    if (write(1, msg, sizeof msg - 1) < 0) { /* nothing useful to do */ }
+    _exit(2);
+}
+/* Call first thing in main(). `secs` should be several times a normal run's length. */
+static inline void t_watchdog(int secs, const char *name) {
+    t_watchdog_name = name;
+    signal(SIGALRM, t_watchdog_fired);
+    alarm((unsigned)secs);
+}
+static inline int t_finish(void) {
+    printf("%s: %s\n", t_watchdog_name, t_fails ? "FAILED" : "ALL PASSED");
+    return t_fails != 0;
+}
diff --git a/test/host/jni_listener_test.c b/test/host/jni_listener_test.c
new file mode 100644
index 0000000..04e629c
--- /dev/null
+++ b/test/host/jni_listener_test.c
@@ -0,0 +1,164 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Lifecycle of jni_sub_engine.c's native->Java "content changed" listener, run against a MOCK
+ * JavaVM/JNIEnv that counts attaches and detaches, tracks live global refs, and flags any Java
+ * call made on a deleted global ref, from a detached thread, or on the wrong object.
+ *
+ * Checks: one global ref per engine; the render thread attaches once (named), stays attached,
+ * and detaches when it exits; nativeDestroy() frees the ref only after the render thread is
+ * joined; a missing Java method leaves the engine working with the push disabled; and 200
+ * create / announce / destroy races leak nothing and never touch a freed ref. Run 4 covers the
+ * deferred destroy: when a STREAM still holds the engine, nativeDestroy() must not free the engine
+ * or its listener ref; the last registry release does, on the releasing thread.
+ *
+ * This validates OUR use of the JNI contract, not the JVM's behaviour -- see the notes in test_host_native.py.
+ */
+#include "sub_engine.h"
+#include "sub_engine_registry.h"
+#include "fake_backend.h"
+#include <jni.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// ---- mock JVM: counts attaches/detaches, tracks live global refs, flags use-after-free ----
+static __thread int t_attached = 0;
+static int g_attach=0, g_detach=0, g_live_refs=0, g_calls=0, g_uaf=0, g_no_method=0, g_wrong_obj=0, g_named_ok=0;
+static char g_thread_name[32];
+static volatile int g_ref_freed = 0; static char g_obj_token, g_gref_token;
+static JNIEnv g_env_obj; static JavaVM g_vm_obj;
+static jint m_GetEnv(JavaVM*vm,void**pe,jint v){ if(!t_attached) return JNI_EDETACHED; *pe=&g_env_obj; return JNI_OK; }
+static jint m_Attach(JavaVM*vm,JNIEnv**pe,void*args){ t_attached=1; __atomic_fetch_add(&g_attach,1,__ATOMIC_RELAXED);
+    if(args && ((JavaVMAttachArgs*)args)->name){ strncpy(g_thread_name,((JavaVMAttachArgs*)args)->name,31); __atomic_store_n(&g_named_ok,1,__ATOMIC_RELEASE); }
+    *pe=&g_env_obj; return JNI_OK; }
+static jint m_Detach(JavaVM*vm){ t_attached=0; __atomic_fetch_add(&g_detach,1,__ATOMIC_RELAXED); return JNI_OK; }
+static const struct JNIInvokeInterface_ vm_tbl = { m_GetEnv, m_Attach, m_Detach };
+static jint m_GetJavaVM(JNIEnv*e,JavaVM**pv){ *pv=&g_vm_obj; return JNI_OK; }
+static jclass m_GetObjectClass(JNIEnv*e,jobject o){ return (jclass)0x77; }
+static jmethodID m_GetMethodID(JNIEnv*e,jclass c,const char*n,const char*s){
+    if(__atomic_load_n(&g_no_method,__ATOMIC_ACQUIRE)) return NULL;
+    return (strcmp(n,"onNativeSubtitleContentChanged")==0 && strcmp(s,"()V")==0) ? (jmethodID)0x1 : NULL; }
+static void m_DeleteLocalRef(JNIEnv*e,jobject o){}
+static jobject m_NewGlobalRef(JNIEnv*e,jobject o){ __atomic_fetch_add(&g_live_refs,1,__ATOMIC_RELAXED); __atomic_store_n(&g_ref_freed,0,__ATOMIC_RELEASE); return &g_gref_token; }
+static void m_DeleteGlobalRef(JNIEnv*e,jobject o){ __atomic_fetch_sub(&g_live_refs,1,__ATOMIC_RELAXED); __atomic_store_n(&g_ref_freed,1,__ATOMIC_RELEASE); }
+static void m_CallVoid(JNIEnv*e,jobject o,jmethodID m,...){
+    if(__atomic_load_n(&g_ref_freed,__ATOMIC_ACQUIRE)) __atomic_fetch_add(&g_uaf,1,__ATOMIC_RELAXED);      // call on a deleted global ref
+    if(o!=&g_gref_token) __atomic_fetch_add(&g_wrong_obj,1,__ATOMIC_RELAXED);
+    if(!t_attached) __atomic_fetch_add(&g_uaf,1,__ATOMIC_RELAXED);      // JNI call from a detached thread
+    __atomic_fetch_add(&g_calls,1,__ATOMIC_RELAXED); }
+static jboolean m_ExcCheck(JNIEnv*e){return 0;} static void m_ExcDesc(JNIEnv*e){} static void m_ExcClear(JNIEnv*e){}
+static const struct JNINativeInterface_ env_tbl = { NULL,NULL,NULL,NULL, m_GetJavaVM,m_GetObjectClass,m_GetMethodID,m_DeleteLocalRef,
+    m_NewGlobalRef,m_DeleteGlobalRef,m_CallVoid,m_ExcCheck,m_ExcDesc,m_ExcClear };
+
+jlong Java_com_archos_mediacenter_video_player_SubtitleEngine_nativeCreate(JNIEnv*,jobject);
+void  Java_com_archos_mediacenter_video_player_SubtitleEngine_nativeDestroy(JNIEnv*,jobject,jlong);
+void  Java_com_archos_mediacenter_video_player_SubtitleEngine_nativeSetUIMode(JNIEnv*,jobject,jlong,jint);
+#define J(n) Java_com_archos_mediacenter_video_player_SubtitleEngine_##n
+
+static int fails=0;
+#define CHECK(c,msg) do{ if(!(c)){printf("FAIL: %s\n",msg);fails++;} else printf("ok:   %s\n",msg);}while(0)
+static int calls(void){return __atomic_load_n(&g_calls,__ATOMIC_RELAXED);}
+static void settle(void){ usleep(100000); }
+// A native (non-JVM) thread, like the avos thread that closes a video: it releases the engine.
+static void *release_thread(void *p){ sub_engine_registry_release((SUB_ENGINE*)p); return NULL; }
+int main(void){
+    fake_backend_set_mode(FAKE_EMIT_ON_DEMAND);
+    g_env_obj=&env_tbl; g_vm_obj=&vm_tbl; JNIEnv *env=&g_env_obj; jobject thiz=&g_obj_token;
+    // The main thread plays the Java thread that calls nativeCreate/nativeDestroy: already attached,
+    // so GetEnv() succeeds there and the engine teardown must NOT attach it again. (Before the
+    // deferred-destroy change the env was passed in; the destroy callback now asks the JVM itself,
+    // because the last release may happen on a native thread that is not attached.)
+    t_attached=1;
+
+    // ---- run 1: normal life cycle ----
+    jlong h=J(nativeCreate)(env,thiz); SUB_ENGINE *eng=(SUB_ENGINE*)(intptr_t)h;
+    CHECK(eng!=NULL && __atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==1,"nativeCreate: engine created, exactly one global ref held for the listener");
+    J(nativeSetUIMode)(env,thiz,h,1);
+    sub_engine_start(eng,fake_clock,NULL);
+    sub_engine_open_track(eng,SUB_FMT_SSA,100,100,NULL,0,NULL,0,NULL);
+    sub_engine_set_paused(eng,1);  settle();
+    CHECK(calls()==1 && __atomic_load_n(&g_attach,__ATOMIC_ACQUIRE)==1,"pause with unannounced state: one Java call, thread attached once");
+    CHECK(__atomic_load_n(&g_named_ok,__ATOMIC_ACQUIRE) && !strcmp(g_thread_name,"SubRender"),"render thread attached with a name");
+    fake_backend_emit(); sub_engine_force_wake(eng); settle();
+    CHECK(calls()==2 && __atomic_load_n(&g_attach,__ATOMIC_ACQUIRE)==1,"second paused change: another call, NO re-attach");
+    sub_engine_close_track(eng); settle();
+    CHECK(calls()==3,"paused track close announced to Java");
+    CHECK(__atomic_load_n(&g_detach,__ATOMIC_ACQUIRE)==0,"still attached while the render thread lives");
+    J(nativeDestroy)(env,thiz,h);
+    CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0,"nativeDestroy: global ref released");
+    CHECK(__atomic_load_n(&g_detach,__ATOMIC_ACQUIRE)==1,"render thread detached from the JVM when it exited (pthread-key destructor)");
+    int after=calls(); settle();
+    CHECK(calls()==after && __atomic_load_n(&g_uaf,__ATOMIC_ACQUIRE)==0 && __atomic_load_n(&g_wrong_obj,__ATOMIC_ACQUIRE)==0,"no Java call after destroy; none on a freed ref, detached thread or wrong object");
+
+    // ---- run 2: Java method missing (e.g. stripped by the shrinker) ----
+    __atomic_store_n(&g_no_method,1,__ATOMIC_RELEASE); int c0=calls();
+    h=J(nativeCreate)(env,thiz); eng=(SUB_ENGINE*)(intptr_t)h;
+    CHECK(eng!=NULL && __atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0,"method missing: engine still created, no global ref leaked");
+    J(nativeSetUIMode)(env,thiz,h,1); sub_engine_start(eng,fake_clock,NULL);
+    sub_engine_open_track(eng,SUB_FMT_SSA,100,100,NULL,0,NULL,0,NULL);
+    sub_engine_set_paused(eng,1); fake_backend_emit(); sub_engine_force_wake(eng); settle();
+    CHECK(calls()==c0,"method missing: push disabled, no Java calls");
+    J(nativeDestroy)(env,thiz,h);
+    CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0 && __atomic_load_n(&g_uaf,__ATOMIC_ACQUIRE)==0,"method missing: clean destroy");
+
+    // ---- run 3: destroy while announcements are flowing ----
+    __atomic_store_n(&g_no_method,0,__ATOMIC_RELEASE);
+    for(int i=0;i<200;i++){
+        h=J(nativeCreate)(env,thiz); eng=(SUB_ENGINE*)(intptr_t)h;
+        J(nativeSetUIMode)(env,thiz,h,1); sub_engine_start(eng,fake_clock,NULL);
+        sub_engine_open_track(eng,SUB_FMT_SSA,100,100,NULL,0,NULL,0,NULL);
+        sub_engine_set_paused(eng,1);
+        for(int k=0;k<5;k++){ fake_backend_emit(); sub_engine_force_wake(eng); }
+        usleep(i%300);
+        J(nativeDestroy)(env,thiz,h);
+    }
+    CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0 && __atomic_load_n(&g_uaf,__ATOMIC_ACQUIRE)==0 && __atomic_load_n(&g_wrong_obj,__ATOMIC_ACQUIRE)==0,"200 create/announce/destroy races: no leaked ref, no call on a freed ref");
+    CHECK(__atomic_load_n(&g_attach,__ATOMIC_ACQUIRE)==g_detach,"every attached render thread detached (attaches == detaches)");
+
+    // ---- run 4: Java destroys the engine while a STREAM still holds it (deferred destroy) ----
+    {
+        int a0=__atomic_load_n(&g_attach,__ATOMIC_ACQUIRE), d0=__atomic_load_n(&g_detach,__ATOMIC_ACQUIRE);
+        h=J(nativeCreate)(env,thiz); eng=(SUB_ENGINE*)(intptr_t)h;
+        SUB_ENGINE *held=sub_engine_registry_acquire();       // what avos_mp_video_open() does
+        CHECK(held==eng && __atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==1,"deferred: stream acquired the published engine");
+        J(nativeSetUIMode)(env,thiz,h,1); sub_engine_start(eng,fake_clock,NULL);
+        sub_engine_open_track(eng,SUB_FMT_SSA,100,100,NULL,0,NULL,0,NULL);
+        sub_engine_set_paused(eng,1); settle();
+        J(nativeDestroy)(env,thiz,h);                          // must return without freeing anything
+        CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==1,"deferred: nativeDestroy with a holder keeps the engine and the listener's global ref");
+        CHECK(sub_engine_registry_acquire()==NULL,"deferred: a retracted engine cannot be acquired by a new stream");
+        int c=calls(); fake_backend_emit(); sub_engine_force_wake(eng); settle();
+        CHECK(calls()>c && __atomic_load_n(&g_uaf,__ATOMIC_ACQUIRE)==0,"deferred: the holder can still use the engine and pushes keep reaching Java");
+        sub_engine_stop(held); sub_engine_close_track(held);   // avos_mp_video_close() order
+        pthread_t rt; pthread_create(&rt,NULL,release_thread,held); pthread_join(rt,NULL);   // last holder: destroy runs THERE
+        CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0,"deferred: the last release frees the listener's global ref");
+        CHECK((__atomic_load_n(&g_attach,__ATOMIC_ACQUIRE)-a0)==2 && (__atomic_load_n(&g_detach,__ATOMIC_ACQUIRE)-d0)==2,
+              "deferred: render thread + the un-attached releasing thread each attached once and detached once");
+        int after=calls(); settle();
+        CHECK(calls()==after && __atomic_load_n(&g_uaf,__ATOMIC_ACQUIRE)==0 && __atomic_load_n(&g_wrong_obj,__ATOMIC_ACQUIRE)==0,
+              "deferred: no Java call after the deferred destroy");
+        // The next stream gets the NEW engine, never the retracted one.
+        jlong h2=J(nativeCreate)(env,thiz); SUB_ENGINE *next=sub_engine_registry_acquire();
+        CHECK(next==(SUB_ENGINE*)(intptr_t)h2,"deferred: after a rebuild, acquire() returns the new engine");
+        sub_engine_registry_release(next);
+        J(nativeDestroy)(env,thiz,h2);
+        CHECK(__atomic_load_n(&g_live_refs,__ATOMIC_ACQUIRE)==0,"deferred: replacement engine destroyed cleanly");
+    }
+    printf("%s\n",fails?"FAILED":"ALL PASSED"); return fails;
+}
diff --git a/test/host/push_policy_test.c b/test/host/push_policy_test.c
new file mode 100644
index 0000000..5e6ffff
--- /dev/null
+++ b/test/host/push_policy_test.c
@@ -0,0 +1,76 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * When the native render thread announces "subtitle content changed" (the 3D-path push):
+ * only while PAUSED, only in a 3D UI mode, once per generation -- and never with an engine or
+ * renderer lock held (the callback calls back into both; a held lock would self-deadlock).
+ */
+#include "sub_engine.h"
+#include "sub_render_gl.h"
+#include "fake_backend.h"
+#include <stdio.h>
+#include <unistd.h>
+
+static SUB_ENGINE *g_eng; static SUB_RENDERER *g_r;
+static volatile int g_cb = 0, g_bad = 0;
+
+static void on_change(void *ctx) {
+    (void)sub_engine_is_paused(g_eng);           /* takes the engine lock */
+    (void)sub_engine_get_generation(g_eng);
+    sub_engine_force_wake(g_eng);
+    (void)sub_render_gl_get_frame_generation(g_r); /* takes the renderer lock */
+    if (ctx != (void *)0x1234) __atomic_fetch_add(&g_bad, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_cb, 1, __ATOMIC_RELAXED);
+}
+
+static int fails = 0;
+#define EXPECT(n, msg) do { usleep(80000); int v = __atomic_load_n(&g_cb, __ATOMIC_RELAXED); \
+    if (v != (n)) { printf("FAIL: %s (callbacks=%d, want %d)\n", msg, v, n); fails++; } \
+    else printf("ok:   %s (callbacks=%d)\n", msg, v); } while (0)
+static void emit(void) { fake_backend_emit(); sub_engine_force_wake(g_eng); }
+
+int main(void) {
+    fake_backend_set_mode(FAKE_EMIT_ON_DEMAND);
+    g_eng = sub_engine_create();
+    g_r = *(SUB_RENDERER **)g_eng;   /* renderer is SUB_ENGINE's first member; test-only peek */
+    sub_engine_set_change_callback(g_eng, on_change, (void *)0x1234);
+    if (sub_engine_get_change_ctx(g_eng) != (void *)0x1234) { printf("FAIL: get_change_ctx\n"); fails++; }
+    sub_render_gl_set_ui_mode(g_r, 1);                       /* a 3D mode */
+    sub_engine_start(g_eng, fake_clock, NULL);
+    sub_engine_open_track(g_eng, SUB_FMT_SSA, 100, 100, NULL, 0, NULL, 0, NULL);
+
+    emit();                           EXPECT(0, "PLAYING: content changes, nothing announced (per-video-frame pull covers it)");
+    sub_engine_set_paused(g_eng, 1);  EXPECT(1, "PAUSE: a change that landed before the pause is announced once");
+    emit();                           EXPECT(2, "PAUSED: new frame is announced");
+    sub_engine_force_wake(g_eng);     EXPECT(2, "PAUSED: spurious wake with no change -> no repeat announce");
+    sub_engine_close_track(g_eng);    EXPECT(3, "PAUSED: track close clears visible content -> announced");
+    sub_engine_close_track(g_eng);    EXPECT(3, "PAUSED: closing again (nothing showing) -> silent");
+    sub_engine_open_track(g_eng, SUB_FMT_SSA, 100, 100, NULL, 0, NULL, 0, NULL);
+    emit();                           EXPECT(4, "PAUSED: new track's first cue arrives -> announced");
+    sub_render_gl_set_ui_mode(g_r, 0);
+    emit();                           EXPECT(4, "2D mode: never announced (native GL thread draws it itself)");
+    sub_render_gl_set_ui_mode(g_r, 1); sub_engine_force_wake(g_eng);
+                                      EXPECT(5, "ENTER 3D while paused with an unannounced change: announced once");
+    sub_engine_set_paused(g_eng, 0);  EXPECT(5, "UNPAUSE: silent");
+    emit();                           EXPECT(5, "PLAYING again: content changes stay silent");
+
+    sub_engine_destroy(g_eng);
+    int at_destroy = __atomic_load_n(&g_cb, __ATOMIC_RELAXED); usleep(100000);
+    if (__atomic_load_n(&g_cb, __ATOMIC_RELAXED) != at_destroy) { printf("FAIL: callback ran after destroy returned\n"); fails++; }
+    else printf("ok:   no callback after sub_engine_destroy() returned\n");
+    if (__atomic_load_n(&g_bad, __ATOMIC_RELAXED)) { printf("FAIL: ctx mismatch\n"); fails++; }
+    printf("%s\n", fails ? "FAILED" : "ALL PASSED");
+    return fails;
+}
diff --git a/test/host/race_harness_test.c b/test/host/race_harness_test.c
new file mode 100644
index 0000000..2871e43
--- /dev/null
+++ b/test/host/race_harness_test.c
@@ -0,0 +1,51 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Stale-frame-after-close race.
+ *
+ * A real render thread polls a deliberately slow backend while the main thread opens and closes
+ * tracks. Once close_track() has RETURNED there is no open track, so nothing may be on screen --
+ * not immediately, and not a moment later. Before poll+publish became one engine-lock hold, the
+ * render thread could poll a frame from the old backend, lose the race to close_track()'s clear,
+ * and then install that frame: a cue from a closed track left on screen.
+ */
+#include "sub_engine.h"
+#include "fake_backend.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static int something_visible(SUB_ENGINE *e) {
+    uint64_t gen; uint8_t px[64];
+    return sub_engine_fill_bitmap(e, px, 4, 4, 16, (uint64_t)-1, /*force=*/1, &gen) == SUB_FILL_FRAME;
+}
+
+int main(int argc, char **argv) {
+    int iters = argc > 1 ? atoi(argv[1]) : 1500, stale = 0;
+    fake_backend_set_mode(FAKE_EMIT_ALWAYS_SLOW);
+    SUB_ENGINE *e = sub_engine_create();
+    sub_engine_start(e, fake_clock, NULL);
+    for (int i = 0; i < iters; i++) {
+        sub_engine_open_track(e, SUB_FMT_SSA, 100, 100, NULL, 0, NULL, 0, NULL);
+        usleep(100 + rand() % 700);          /* let the render thread be mid-poll when we close */
+        sub_engine_close_track(e);
+        if (something_visible(e)) stale++;   /* anything showing with NO track open is the bug */
+        usleep(rand() % 200);
+        if (something_visible(e)) stale++;   /* ...and it must stay clear */
+    }
+    sub_engine_destroy(e);
+    printf("iterations=%d stale-frame-after-close=%d\n", iters, stale);
+    return stale ? 1 : 0;
+}
diff --git a/test/host/registry_lifetime_test.c b/test/host/registry_lifetime_test.c
new file mode 100644
index 0000000..80cb52b
--- /dev/null
+++ b/test/host/registry_lifetime_test.c
@@ -0,0 +1,190 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Engine lifetime in sub_engine_registry.c, with no real engine: the registry only ever treats a
+ * SUB_ENGINE* as an opaque key, so heap blocks stand in for engines and a counting destroy
+ * callback records what was destroyed, when, and on which thread.
+ *
+ * The rules under test: an engine is destroyed exactly once; never while any acquire() is
+ * un-released; immediately when nothing holds it, otherwise by the LAST release; retract() never
+ * blocks; publishing a replacement never loses older references; the destroy callback runs
+ * outside the registry lock; stray releases are ignored.
+ */
+#include "sub_engine.h"
+#include "sub_engine_registry.h"
+#include "host_test_util.h"
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { atomic_int holders; atomic_int destroyed; pthread_t destroyer; } DUMMY;
+#define ENG(d) ((SUB_ENGINE *)(d))
+static atomic_int g_destroy_while_held;   /* destroy ran with a live holder: lifetime violation */
+static atomic_int g_destroy_calls;
+
+static void destroy_cb(SUB_ENGINE *e) {
+    DUMMY *d = (DUMMY *)e;
+    if (atomic_load(&d->holders) != 0) atomic_fetch_add(&g_destroy_while_held, 1);
+    atomic_fetch_add(&d->destroyed, 1);
+    d->destroyer = pthread_self();
+    atomic_fetch_add(&g_destroy_calls, 1);
+}
+static DUMMY *g_all[1024];   /* every dummy, freed at the end so ASan's leak check is meaningful */
+static int g_nall;
+static DUMMY *mk(void) { DUMMY *d = calloc(1, sizeof(DUMMY)); g_all[g_nall++] = d; return d; }
+
+/* A destroy callback that re-enters the registry: proves it is not run under the registry lock. */
+static DUMMY *g_reentry_next;
+static atomic_int g_reentry_ran;
+static void destroy_reentrant_cb(SUB_ENGINE *e) {
+    destroy_cb(e);
+    SUB_ENGINE *cur = sub_engine_registry_acquire();      /* would self-deadlock if the lock were held */
+    if (cur) sub_engine_registry_release(cur);
+    sub_engine_registry_publish(ENG(g_reentry_next));     /* ditto */
+    atomic_fetch_add(&g_reentry_ran, 1);
+}
+
+/* ---- stress: Java thread publishes/retracts engines while stream threads acquire/release ---- */
+#define N_ENGINES 400
+static DUMMY *g_eng[N_ENGINES];
+static atomic_int g_stop;
+static atomic_long g_acquires;
+static void *stream_thread(void *arg) {
+    unsigned seed = (unsigned)(uintptr_t)arg;
+    while (!atomic_load(&g_stop)) {
+        SUB_ENGINE *e = sub_engine_registry_acquire();
+        if (!e) { sched_yield(); continue; }
+        DUMMY *d = (DUMMY *)e;
+        atomic_fetch_add(&d->holders, 1);
+        atomic_fetch_add(&g_acquires, 1);
+        if (rand_r(&seed) % 4 == 0) usleep(rand_r(&seed) % 50);
+        atomic_fetch_sub(&d->holders, 1);
+        sub_engine_registry_release(e);
+    }
+    return NULL;
+}
+
+int main(void) {
+    t_watchdog(60, "registry_lifetime");
+
+    /* 1. Held engine: retract defers, last release destroys, no new acquires once retracted. */
+    DUMMY *a = mk();
+    sub_engine_registry_publish(ENG(a));
+    SUB_ENGINE *got = sub_engine_registry_acquire();
+    CHECK(got == ENG(a), "acquire returns the published engine");
+    int r = sub_engine_registry_retract(ENG(a), destroy_cb);
+    CHECK(r == 0 && atomic_load(&a->destroyed) == 0, "retract with a holder: deferred (returned %d), not destroyed", r);
+    CHECK(sub_engine_registry_acquire() == NULL, "retracted engine can no longer be acquired");
+    sub_engine_registry_release(got);
+    CHECK(atomic_load(&a->destroyed) == 1 && pthread_equal(a->destroyer, pthread_self()),
+          "last release destroys it, on the releasing thread");
+    sub_engine_registry_release(got);   /* stray: engine already destroyed */
+    CHECK(atomic_load(&a->destroyed) == 1, "stray release after destroy is ignored");
+
+    /* 2. Not held: retract destroys immediately. */
+    DUMMY *b = mk();
+    sub_engine_registry_publish(ENG(b));
+    r = sub_engine_registry_retract(ENG(b), destroy_cb);
+    CHECK(r == 1 && atomic_load(&b->destroyed) == 1, "retract with no holders destroys immediately (returned %d)", r);
+    CHECK(sub_engine_registry_acquire() == NULL, "nothing published after the only engine was retracted");
+
+    /* 3. Replacement: older references survive a newer publish (this is the old "s_refcount = 0" bug). */
+    DUMMY *c = mk(), *d = mk(), *e = mk();
+    sub_engine_registry_publish(ENG(c));
+    SUB_ENGINE *c1 = sub_engine_registry_acquire(), *c2 = sub_engine_registry_acquire();
+    sub_engine_registry_publish(ENG(d));
+    SUB_ENGINE *dh = sub_engine_registry_acquire();
+    sub_engine_registry_publish(ENG(e));
+    CHECK(dh == ENG(d) && sub_engine_registry_acquire() == ENG(e), "newest publish becomes the current engine");
+    sub_engine_registry_release(ENG(e));   /* balance the probe acquire above */
+    r = sub_engine_registry_retract(ENG(c), destroy_cb);
+    CHECK(r == 0 && atomic_load(&c->destroyed) == 0, "superseded engine with 2 holders: retract defers");
+    sub_engine_registry_release(c1);
+    CHECK(atomic_load(&c->destroyed) == 0, "one of two holders released: still alive");
+    sub_engine_registry_release(c2);
+    CHECK(atomic_load(&c->destroyed) == 1, "second holder released: destroyed exactly once");
+    CHECK(atomic_load(&d->destroyed) == 0, "the other superseded engine (1 holder, never retracted) is untouched");
+    r = sub_engine_registry_retract(ENG(d), destroy_cb);
+    CHECK(r == 0, "retracting the engine that still has a holder defers");
+    sub_engine_registry_release(dh);
+    CHECK(atomic_load(&d->destroyed) == 1, "and its release destroys it");
+    CHECK(sub_engine_registry_retract(ENG(e), destroy_cb) == 1 && atomic_load(&e->destroyed) == 1,
+          "current engine, no holders: retract destroys immediately");
+
+    /* 4. Idempotent retract, stray releases, publish(NULL). */
+    DUMMY *f = mk();
+    sub_engine_registry_publish(ENG(f));
+    SUB_ENGINE *fh = sub_engine_registry_acquire();
+    sub_engine_registry_retract(ENG(f), destroy_cb);
+    r = sub_engine_registry_retract(ENG(f), destroy_cb);
+    CHECK(r == 0 && atomic_load(&f->destroyed) == 0, "second retract of a deferred engine is a no-op");
+    sub_engine_registry_release(fh);
+    sub_engine_registry_release(fh);   /* more releases than acquires */
+    CHECK(atomic_load(&f->destroyed) == 1, "extra release cannot trigger a second destroy");
+    DUMMY *never = mk();
+    sub_engine_registry_release(ENG(never));   /* never published */
+    sub_engine_registry_release(NULL);
+    CHECK(atomic_load(&never->destroyed) == 0, "release of an unknown pointer / NULL is ignored");
+    DUMMY *g = mk();
+    sub_engine_registry_publish(ENG(g));
+    sub_engine_registry_publish(NULL);
+    CHECK(sub_engine_registry_acquire() == NULL, "publish(NULL) clears the current engine");
+    CHECK(sub_engine_registry_retract(ENG(g), destroy_cb) == 1, "engine unpublished by publish(NULL) can still be retracted");
+    DUMMY *unreg = mk();
+    CHECK(sub_engine_registry_retract(ENG(unreg), destroy_cb) == 1 && atomic_load(&unreg->destroyed) == 1,
+          "retract of an engine that was never published destroys it (nothing can hold it)");
+
+    /* 5. destroy callback runs outside the registry lock. */
+    DUMMY *h = mk(), *next = mk();
+    g_reentry_next = next;
+    sub_engine_registry_publish(ENG(h));
+    SUB_ENGINE *hh = sub_engine_registry_acquire();
+    sub_engine_registry_retract(ENG(h), destroy_reentrant_cb);
+    sub_engine_registry_release(hh);      /* destroy runs here and calls back into the registry */
+    CHECK(atomic_load(&g_reentry_ran) == 1 && sub_engine_registry_acquire() == ENG(next),
+          "destroy callback may call acquire/publish (not run under the registry lock)");
+    sub_engine_registry_release(ENG(next));
+    sub_engine_registry_retract(ENG(next), destroy_cb);
+
+    /* 6. Concurrent stress. */
+    atomic_store(&g_destroy_calls, 0);
+    atomic_store(&g_destroy_while_held, 0);
+    pthread_t th[6];
+    for (int i = 0; i < 6; i++) pthread_create(&th[i], NULL, stream_thread, (void *)(uintptr_t)(i + 1));
+    for (int i = 0; i < N_ENGINES; i++) {
+        g_eng[i] = mk();
+        sub_engine_registry_publish(ENG(g_eng[i]));
+        usleep(rand() % 200);
+        if (i > 0) sub_engine_registry_retract(ENG(g_eng[i - 1]), destroy_cb);   /* retract the previous one */
+    }
+    sub_engine_registry_retract(ENG(g_eng[N_ENGINES - 1]), destroy_cb);
+    atomic_store(&g_stop, 1);
+    for (int i = 0; i < 6; i++) pthread_join(th[i], NULL);
+    int bad_count = 0, leaked = 0;
+    for (int i = 0; i < N_ENGINES; i++) {
+        int n = atomic_load(&g_eng[i]->destroyed);
+        if (n > 1) bad_count++;
+        if (n == 0) leaked++;
+    }
+    CHECK(atomic_load(&g_destroy_while_held) == 0, "stress: no engine destroyed while a stream still held it (%ld acquires)", (long)atomic_load(&g_acquires));
+    CHECK(bad_count == 0, "stress: no engine destroyed twice");
+    CHECK(leaked == 0, "stress: every retracted engine was destroyed once its holders were gone (leaked %d)", leaked);
+
+    for (int i = 0; i < g_nall; i++) free(g_all[i]);
+    return t_finish();
+}
diff --git a/test/host/seek_pause_feed_test.c b/test/host/seek_pause_feed_test.c
new file mode 100644
index 0000000..49703cb
--- /dev/null
+++ b/test/host/seek_pause_feed_test.c
@@ -0,0 +1,143 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Seek and pause during the initial external-subtitle feed.
+ *
+ * The first bulk feed of an external track runs on a worker and can take a while. While it runs the
+ * user may pause, resume and seek. A seek (stream_video.c _seek_init) flushes the engine and raises
+ * subtitle_ext_needs_refeed AFTER the flush; the decode thread then re-runs the feed from the
+ * start. This test models that protocol with a worker thread and drives it from another thread:
+ *
+ *   1. feed the whole list while PAUSED: feed() must not depend on the engine running;
+ *   2. 600 random pause / resume / seek operations racing the feed;
+ *   3. a final seek, then resume: the worker's last complete pass must leave the engine holding
+ *      exactly one full copy of the list (no cues lost to a flush, none duplicated by a pass that
+ *      kept feeding across the seek), and the engine's pause state must be what the user set.
+ *
+ * Any lost wake-up or lock-order problem between pause/seek and feed shows as the watchdog firing;
+ * data races show under ThreadSanitizer.
+ */
+#include "sub_engine.h"
+#include "fake_backend.h"
+#include "host_test_util.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define N_CUES 6000
+
+static SUB_ENGINE *g_e;
+static uint64_t g_tok;
+static atomic_int g_refeed;        /* models s->subtitle_ext_needs_refeed */
+static atomic_int g_stop, g_busy, g_passes;
+
+/* The decode/parse worker: one pass = flush, then feed every cue; abandon the pass as soon as the
+ * refeed flag is raised again (what _sub_feed_should_stop() does) and start over. */
+static void *worker(void *arg) {
+    (void)arg;
+    char buf[24];
+    while (!atomic_load(&g_stop)) {
+        atomic_store(&g_busy, 1);
+        if (!atomic_exchange(&g_refeed, 0)) { atomic_store(&g_busy, 0); usleep(100); continue; }
+        sub_engine_flush_gen(g_e, g_tok);
+        int interrupted = 0;
+        for (int i = 0; i < N_CUES; i++) {
+            if (atomic_load(&g_refeed)) { interrupted = 1; break; }
+            int n = snprintf(buf, sizeof buf, "S%d", i);
+            sub_engine_feed_gen(g_e, g_tok, (const uint8_t *)buf, n, (int64_t)i * 40, 2000);
+        }
+        if (!interrupted) atomic_fetch_add(&g_passes, 1);
+        atomic_store(&g_busy, 0);
+    }
+    return NULL;
+}
+
+/* Same order as _seek_init(): flush first, THEN raise the flag. */
+static void seek(void) { sub_engine_flush(g_e); atomic_store(&g_refeed, 1); }
+
+/* "Nothing pending and nothing running". Read the flag BEFORE busy: the worker raises busy before it
+ * consumes the flag, so if the flag is already clear the worker's busy=1 is guaranteed visible. */
+static int idle(void) {
+    int flag = atomic_load(&g_refeed);
+    int busy = atomic_load(&g_busy);
+    return !flag && !busy;
+}
+static int wait_for(int (*cond)(void), int ms) {
+    for (int t = 0; t < ms; t++) { if (cond()) return 1; usleep(1000); }
+    return cond();
+}
+static int g_passes_target;
+static int passes_reached(void) { return atomic_load(&g_passes) >= g_passes_target; }
+static int idle_and_done(void)  { return passes_reached() && idle(); }
+
+static int something_visible(SUB_ENGINE *e) {
+    uint64_t gen; uint8_t px[64];
+    return sub_engine_fill_bitmap(e, px, 4, 4, 16, (uint64_t)-1, /*force=*/1, &gen) == SUB_FILL_FRAME;
+}
+
+int main(void) {
+    t_watchdog(120, "seek_pause_feed");
+    fake_backend_set_mode(FAKE_EMIT_ON_DEMAND);
+    fake_backend_reset_counters();
+    g_e = sub_engine_create();
+    sub_engine_start(g_e, fake_clock, NULL);
+    sub_engine_open_track(g_e, SUB_FMT_SRT, 1920, 1080, NULL, 0, NULL, 0, &g_tok);
+
+    pthread_t wt;
+    pthread_create(&wt, NULL, worker, NULL);
+
+    /* ---- 1. initial feed while paused ---- */
+    sub_engine_set_paused(g_e, 1);
+    g_passes_target = 1;
+    atomic_store(&g_refeed, 1);
+    CHECK(wait_for(idle_and_done, 20000), "initial feed finished while the engine was paused");
+    CHECK(fake_backend_active_since_flush() == N_CUES, "paused feed delivered the whole list (%d of %d)",
+          fake_backend_active_since_flush(), N_CUES);
+    CHECK(sub_engine_is_paused(g_e) == 1, "feeding did not change the pause state");
+
+    /* ---- 2. random pause / resume / seek racing a re-feed ---- */
+    int paused = 1, seeks = 0, pause_mismatch = 0;
+    for (int i = 0; i < 600; i++) {
+        switch (rand() % 4) {
+        case 0: sub_engine_set_paused(g_e, 1); paused = 1; break;
+        case 1: sub_engine_set_paused(g_e, 0); paused = 0; break;
+        case 2: seek(); seeks++; break;
+        default: usleep((unsigned)(rand() % 600)); break;
+        }
+        if (sub_engine_is_paused(g_e) != paused) pause_mismatch++;
+        if (rand() % 8 == 0) usleep((unsigned)(rand() % 2000));
+    }
+    CHECK(pause_mismatch == 0, "pause state always matched the last request (%d mismatches over %d seeks)", pause_mismatch, seeks);
+
+    /* ---- 3. final seek, then resume: exactly one complete copy of the list ---- */
+    int base = atomic_load(&g_passes);
+    seek();
+    g_passes_target = base + 1;
+    sub_engine_set_paused(g_e, 0);
+    CHECK(wait_for(idle_and_done, 30000), "after the last seek the worker completed a pass and went idle");
+    int held = fake_backend_active_since_flush();
+    CHECK(held == N_CUES, "engine holds exactly one full copy of the list after the storm (%d of %d)", held, N_CUES);
+    CHECK(sub_engine_is_paused(g_e) == 0, "resumed");
+
+    fake_backend_emit(); sub_engine_force_wake(g_e); usleep(60000);
+    CHECK(something_visible(g_e), "after resume the renderer produces content again");
+
+    atomic_store(&g_stop, 1);
+    pthread_join(wt, NULL);
+    sub_engine_destroy(g_e);
+    CHECK(fake_backend_live() == 0, "no backend leaked (%d live)", fake_backend_live());
+    return t_finish();
+}
diff --git a/test/host/smi_parse_error_test.c b/test/host/smi_parse_error_test.c
new file mode 100644
index 0000000..4c2ab98
--- /dev/null
+++ b/test/host/smi_parse_error_test.c
@@ -0,0 +1,162 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * smi_parse_error_test.c -- the two "no cues" exits of parse_SMI() must close the file
+ * and free the record without reading it after free. parse_SMI() is static, so the real
+ * source is included; its out-of-file dependencies are stubbed below.
+ *
+ * Run under AddressSanitizer (Linux also gives LeakSanitizer) to catch a future return to
+ * the old order: subtitle_clean_error() first, afree() afterwards.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include "subtitle_format.h"
+#include "i18n.h"
+#include "astdlib.h"
+
+/* Same contract as Source/util.c's case-insensitive finder. */
+char *strstrNC(char *string, char *tofind)
+{
+	size_t len = strlen(tofind);
+	for (; *string; ++string) {
+		if (!strncasecmp(string, tofind, len))
+			return string;
+	}
+	return NULL;
+}
+
+int strncmpNC(const char *s1, const char *s2, int length)
+{
+	return strncasecmp(s1, s2, length);
+}
+
+/* Only reached for cues with legacy codepages; neither file below has a cue. */
+int I18N_codepage_to_unicode(const unsigned char *t, wchar *uc)
+{
+	(void)t;
+	(void)uc;
+	return 0;
+}
+
+void utf16_to_utf8(unsigned char *utf8, const unsigned short *utf16, int utf8_max)
+{
+	(void)utf8;
+	(void)utf16;
+	(void)utf8_max;
+}
+
+/* The real registry lives in subtitle_formats.c; the format's constructor calls this. */
+int subtitle_register_format(SUBTITLE_REG_FORMAT *reg)
+{
+	(void)reg;
+	return 0;
+}
+
+/* The real cleanup helper, with the identifier free outside the list walk. */
+void subtitle_clean_error(uni_sub *subs)
+{
+	if (!subs)
+		return;
+	sub_line *line = subs->first;
+	while (line) {
+		sub_line *next = line->next;
+		afree(line->top);
+		afree(line->bottom);
+		afree(line);
+		line = next;
+	}
+	afree(subs->identifier);
+}
+
+/* Only reached when a cue is parsed; neither file below contains one. */
+char *subtitle_clean_formatter(char *line, int clean_tags)
+{
+	(void)clean_tags;
+	return line;
+}
+
+#include "../../Source/subtitle_smi.c"
+
+/* One SMI language declaration, so set_SMI_code() succeeds. */
+static const char *HEADER =
+	"<SAMI>\n"
+	"<HEAD>\n"
+	"<TITLE>t</TITLE>\n"
+	".ENCC {Name:English; lang:en-US;}\n"
+	"</HEAD>\n"
+	"<BODY>\n";
+
+static void free_header(subt_orig *subs)
+{
+	for (unsigned int i = 0; i < subs->lan_count; ++i) {
+		sub_coding_style *style = subs->title_langs[i];
+		afree(style->id);
+		afree(style->name);
+		afree(style->lang);
+		afree(style->type);
+		afree(style);
+	}
+	afree(subs->title_langs);
+	afree(subs->default_language);
+}
+
+static int parse_file(const char *tail, const char *what)
+{
+	char path[] = "/tmp/avos-smi-XXXXXX";
+	int fd = mkstemp(path);
+	if (fd < 0) {
+		perror("mkstemp");
+		return 0;
+	}
+	FILE *file = fdopen(fd, "w");
+	if (!file) {
+		perror("fdopen");
+		close(fd);
+		remove(path);
+		return 0;
+	}
+	fputs(HEADER, file);
+	fputs(tail, file);
+	fclose(file);
+
+	subt_orig subs;
+	memset(&subs, 0, sizeof(subs));
+	subs.filename = path;
+	uni_sub *parsed = parse_SMI(&subs, 0);
+	remove(path);
+
+	int ok = parsed == NULL;
+	if (parsed) {
+		fprintf(stderr, "FAIL: %s returned a record\n", what);
+		subtitle_clean_error(parsed);
+		afree(parsed);
+	}
+	free_header(&subs);
+	return ok;
+}
+
+int main(void)
+{
+	int ok = 1;
+	ok &= parse_file("", "EOF after <BODY>");            /* CLEAN_ERROR */
+	ok &= parse_file("</BODY>\n", "empty <BODY></BODY>"); /* success, no cues */
+	if (ok)
+		printf("ok parse_SMI frees the empty record on both exits\n");
+	return ok ? 0 : 1;
+}
diff --git a/test/host/ssa_geometry_test.c b/test/host/ssa_geometry_test.c
new file mode 100644
index 0000000..795265a
--- /dev/null
+++ b/test/host/ssa_geometry_test.c
@@ -0,0 +1,138 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "ssa_geometry.h"
+#include "host_font.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Text is rendered with the font file the harness found on this machine (HOST_TEST_FONT, see
+ * host_font.h): registered with libass directly and with NO system font provider, so the same file
+ * is used on Linux and macOS whether or not fontconfig exists. Run by hand without the variable it
+ * falls back to the system's "DejaVu Sans" through libass's own font discovery. */
+static int g_have_font_file;
+static void use_test_font(ASS_Library *lib) {
+    const char *path = getenv("HOST_TEST_FONT");
+    if (!path || !path[0]) return;
+    FILE *f = fopen(path, "rb");
+    if (!f) { fprintf(stderr, "cannot open test font %s\n", path); exit(2); }
+    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+    char *buf = malloc((size_t)n);
+    if (!buf || fread(buf, 1, (size_t)n, f) != (size_t)n) { fprintf(stderr, "cannot read %s\n", path); exit(2); }
+    fclose(f);
+    ass_add_font(lib, "hosttestfont", buf, (size_t)n);   /* libass copies the data */
+    free(buf);
+    g_have_font_file = 1;
+}
+
+static void cb(int l, const char *f, va_list v, void *d) { (void)l; (void)f; (void)v; (void)d; }
+typedef struct { int x0, y0, x1, y1, n; } BB;
+
+static BB render(const SSA_GEOM *g, const char *script) {
+    ASS_Library *lib = ass_library_init(); ass_set_message_cb(lib, cb, NULL);
+    ASS_Renderer *r = ass_renderer_init(lib);
+    use_test_font(lib);                                   /* before ass_set_fonts() */
+    ass_set_fonts(r, NULL, test_font_family(), g_have_font_file ? ASS_FONTPROVIDER_NONE : ASS_FONTPROVIDER_AUTODETECT, NULL, 0);
+    ssa_geom_apply(r, g);
+    char *filled = with_font(script);
+    ASS_Track *t = ass_read_memory(lib, filled, strlen(filled), NULL);
+    int ch; ASS_Image *im = ass_render_frame(r, t, 1000, &ch);
+    BB b = { 1 << 30, 1 << 30, -1, -1, 0 };
+    for (; im; im = im->next)
+        for (int y = 0; y < im->h; y++)
+            for (int x = 0; x < im->w; x++)
+                if (im->bitmap[y * im->stride + x]) {
+                    int X = im->dst_x + x, Y = im->dst_y + y;
+                    if (X < b.x0) b.x0 = X;
+                    if (Y < b.y0) b.y0 = Y;
+                    if (X > b.x1) b.x1 = X;
+                    if (Y > b.y1) b.y1 = Y;
+                    b.n++;
+                }
+    ass_free_track(t); ass_renderer_done(r); ass_library_done(lib);
+    free(filled);
+    return b;
+}
+
+#define HDR(px, py, sbas, outl) \
+ "[Script Info]\nScriptType: v4.00+\nPlayResX: " #px "\nPlayResY: " #py "\nScaledBorderAndShadow: " sbas "\n\n" \
+ "[V4+ Styles]\nFormat: Name,Fontname,Fontsize,PrimaryColour,SecondaryColour,OutlineColour,BackColour,Bold,Italic,Underline,StrikeOut,ScaleX,ScaleY,Spacing,Angle,BorderStyle,Outline,Shadow,Alignment,MarginL,MarginR,MarginV,Encoding\n" \
+ "Style: Default," FONT_PLACEHOLDER ",48,&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1," #outl ",0,2,10,10,30,1\n\n" \
+ "[Events]\nFormat: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text\n"
+#define EV(txt) "Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,," txt "\n"
+
+static int fails = 0;
+static void check(const char *what, int got, int want) {
+    if (got != want) { printf("      FAIL %-34s got %d, want %d\n", what, got, want); fails++; }
+}
+
+// scenario: canvas + box + coded size. Every check compares against the same script rendered
+// on a frame that IS the video box (no bars), shifted by the box origin.
+static void scenario(const char *name, int cw, int ch, int bx, int by, int bw, int bh, int rw, int rh) {
+    printf("\n== %s   canvas %dx%d  box (%d,%d) %dx%d  coded %dx%d\n", name, cw, ch, bx, by, bw, bh, rw, rh);
+    SSA_GEOM g   = ssa_geom_compute(cw, ch, bx, by, bw, bh, rw, rh);
+    SSA_GEOM ref = ssa_geom_compute(g.content_w, g.content_h, 0, 0, g.content_w, g.content_h, rw, rh);
+    printf("   -> margins t=%d b=%d l=%d r=%d  content %dx%d  storage %dx%d\n",
+           g.margin_t, g.margin_b, g.margin_l, g.margin_r, g.content_w, g.content_h, g.storage_w, g.storage_h);
+
+    struct { const char *n; const char *s; int dy_bottom; } T[] = {
+        { "1920x1080  regular bottom", HDR(1920,1080,"yes",0) EV("HHHH"), 1 },
+        { "1280x720   regular bottom", HDR(1280,720,"yes",0)  EV("HHHH"), 1 },
+        { "384x288    regular bottom", HDR(384,288,"no",0)    EV("HHHH"), 1 },
+        { "1920x1080  \\an7\\pos(0,0)",  HDR(1920,1080,"yes",0) EV("{\\an7\\pos(0,0)}HHHH"), 0 },
+        { "1920x1080  \\an3\\pos(W,H)",  HDR(1920,1080,"yes",0) EV("{\\an3\\pos(1920,1080)}HHHH"), 0 },
+        { "384x288 SBAS=no outline=6",   HDR(384,288,"no",6)    EV("HHHH"), 1 },
+    };
+    for (unsigned i = 0; i < sizeof T / sizeof *T; i++) {
+        BB a = render(&g, T[i].s), r = render(&ref, T[i].s);
+        // Regular bottom-aligned text is deliberately placed against the FRAME bottom (use_margins),
+        // so vs. a bars-free reference it shifts down by the total bar height; positioned text is
+        // placed against the video box, so it shifts by the box origin only.
+        int want_y0 = r.y0 + (T[i].dy_bottom ? g.margin_t + g.margin_b : g.margin_t);
+        int want_y1 = r.y1 + (T[i].dy_bottom ? g.margin_t + g.margin_b : g.margin_t);
+        printf("   %-28s ink %3dx%-3d @(%4d,%4d)   ref %3dx%-3d\n", T[i].n,
+               a.x1 - a.x0 + 1, a.y1 - a.y0 + 1, a.x0, a.y0, r.x1 - r.x0 + 1, r.y1 - r.y0 + 1);
+        check("ink width  == ref", a.x1 - a.x0 + 1, r.x1 - r.x0 + 1);
+        check("ink height == ref", a.y1 - a.y0 + 1, r.y1 - r.y0 + 1);
+        check("x offset   == ref + box_x", a.x0, r.x0 + g.margin_l);
+        check("y top      as expected", a.y0, want_y0);
+        check("y bottom   as expected", a.y1, want_y1);
+    }
+}
+
+int main(void) {
+    // Font sanity: every comparison below is "ink == reference ink", which two EMPTY renders also
+    // satisfy. Prove the font works first so a missing font fails loudly instead of passing vacuously.
+    {
+        SSA_GEOM g = ssa_geom_compute(1920, 1080, 0, 0, 1920, 1080, 1920, 1080);
+        BB b = render(&g, HDR(1920,1080,"yes",0) EV("HHHH"));
+        check("test font renders glyphs (is a usable font available? see HOST_TEST_FONT in TEST.md)", b.n > 0, 1);
+        if (fails) { printf("\nSOME CHECKS FAILED (%d failed checks)\n", fails); return 1; }
+    }
+    // NOTE on "regular bottom" expectation: with use_margins the text sits against the FRAME
+    // bottom, so relative to a video-only reference it moves down by (top bar + bottom bar).
+    // For box-only frames (no bars) that shift is 0.
+    scenario("portrait phone, 16:9 video, bars used", 1080, 2400, 0, 896, 1080, 608, 1920, 1080);
+    scenario("landscape, video fills canvas",          1920, 1080, 0, 0, 1920, 1080, 1920, 1080);
+    scenario("4:3 video on 16:9 TV (pillarbox only)",  1440, 1080, 0, 0, 1440, 1080, 1440, 1080);
+    scenario("tablet portrait, 21:9 video",            1600, 2560, 0, 1015, 1600, 686, 2560, 1080);
+    printf("\n-- degenerate / transient inputs (must not produce negative margins or crash) --\n");
+    scenario("transient: landscape box in old portrait canvas", 1080, 2400, 0, 0, 2400, 1080, 1920, 1080);
+    scenario("box not known yet (all zero)",           1080, 2400, 0, 0, 0, 0, 1920, 1080);
+    scenario("canvas not known yet",                   0, 0, 0, 0, 0, 0, 0, 0);
+    scenario("rotated video reported un-rotated",      1080, 2400, 0, 896, 1080, 608, 1080, 1920);
+    printf("\n%s (%d failed checks)\n", fails ? "SOME CHECKS FAILED" : "ALL CHECKS PASSED", fails);
+    return fails != 0;
+}
diff --git a/test/host/ssa_late_script_test.c b/test/host/ssa_late_script_test.c
new file mode 100644
index 0000000..1a611f4
--- /dev/null
+++ b/test/host/ssa_late_script_test.c
@@ -0,0 +1,125 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * External ASS script that arrives AFTER the first render (the ordering that left "Custom"
+ * settings ignored until the user touched a setting).
+ *
+ * An external .ass track is opened empty, the render thread starts polling immediately, and the
+ * file is fed a moment later. sync_styles() caches its baseline against the (empty) track on that
+ * first render; the late [Script Info] feed must invalidate that cache. The check is behavioural,
+ * so it needs no knowledge of the cache's internals: render the same script and the same Custom
+ * (forced font size) settings in two orderings and compare the ink.
+ *
+ *   control : open -> feed script -> first render
+ *   late    : open -> first render (nothing to draw) -> feed script -> render
+ *
+ * With the bug, "late" keeps drawing with the script's own style, so its height differs from
+ * "control". The unforced run proves the forced size is visibly different from the script's own,
+ * i.e. the comparison can actually fail.
+ */
+#include "sub_engine.h"
+#include "host_font.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+SUB_FORMAT_BACKEND *sub_format_ssa_create(void);
+
+static const char *SCRIPT_TMPL =
+    "[Script Info]\n"
+    "ScriptType: v4.00+\n"
+    "PlayResX: 384\n"
+    "PlayResY: 288\n"
+    "ScaledBorderAndShadow: yes\n"
+    "\n"
+    "[V4+ Styles]\n"
+    "Format: Name,Fontname,Fontsize,PrimaryColour,SecondaryColour,OutlineColour,BackColour,Bold,Italic,Underline,StrikeOut,ScaleX,ScaleY,Spacing,Angle,BorderStyle,Outline,Shadow,Alignment,MarginL,MarginR,MarginV,Encoding\n"
+    "Style: Default," FONT_PLACEHOLDER ",18,&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,30,1\n"
+    "\n"
+    "[Events]\n"
+    "Format: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text\n"
+    "Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,HHHH\n";
+
+static const char *SCRIPT;   /* SCRIPT_TMPL with the harness-selected font family filled in */
+static int fails = 0;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); fails++; } \
+                           else { printf("ok:   "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* Ink bounding-box height of everything rendered at pts_ms; -1 if nothing was drawn. */
+static int ink_height(SUB_FORMAT_BACKEND *be, int64_t pts_ms) {
+    SUB_FRAME *frame = be->render_at(be, pts_ms);
+    if (!frame) frame = be->render_at(be, pts_ms + 1);   /* "unchanged" is about content; nudge once */
+    if (!frame) return -1;
+    int y0 = 1 << 30, y1 = -1;
+    for (SUB_EVENT *ev = frame->events; ev; ev = ev->next) {
+        if (ev->kind != SUB_EVENT_BITMAP) continue;
+        if (ev->y < y0) y0 = ev->y;
+        if (ev->y + ev->h > y1) y1 = ev->y + ev->h;
+    }
+    be->free_frame(be, frame);
+    return y1 < 0 ? -1 : y1 - y0;
+}
+
+/* One scenario: Custom settings = forced font size `font` with override mode `override_mode`. */
+static int scenario(int render_before_script, int override_mode, float font) {
+    SUB_USER_STYLE *style = sub_style_create();
+    sub_style_set_font_size(style, font);
+    sub_style_set_override_mode(style, override_mode);
+    sub_style_set_font_family(style, test_font_family());   /* forced runs use the user's family: pin it to the harness font */
+
+    SUB_FORMAT_BACKEND *be = sub_format_ssa_create();
+    SUB_FORMAT_OPEN_PARAMS params;
+    memset(&params, 0, sizeof(params));
+    params.video_w = 1280;  params.video_h = 720;
+    params.user_style = style;
+    params.is_plain_text_format = 0;               /* a real ASS script, like an external .ass file */
+    params.fonts_dir = getenv("HOST_TEST_FONT_DIR");   /* harness-selected font: no fontconfig needed */
+    if (be->open(be, &params) != 0) { fprintf(stderr, "open failed\n"); exit(1); }
+
+    if (render_before_script) {
+        /* The render thread's first poll: the track has no script yet. */
+        SUB_FRAME *f = be->render_at(be, 0);
+        if (f) be->free_frame(be, f);
+    }
+    be->feed(be, (const uint8_t *)SCRIPT, (int)strlen(SCRIPT), 0, 5000);   /* the file arrives */
+    int h = ink_height(be, 1000);
+
+    be->close(be);
+    free(be);
+    sub_style_destroy(style);
+    return h;
+}
+
+int main(void) {
+    SCRIPT = with_font(SCRIPT_TMPL);
+    const float CUSTOM = 90.0f;
+    const int FORCE = 1;                            /* ASS_OVERRIDE_FORCE, as in ssa_style_cache_test */
+
+    int control  = scenario(0, FORCE, CUSTOM);
+    int late     = scenario(1, FORCE, CUSTOM);
+    int unforced = scenario(0, 0, CUSTOM);
+    printf("   ink height: control %d, late %d, unforced %d\n", control, late, unforced);
+
+    CHECK(control > 0 && late > 0 && unforced > 0, "every ordering drew text (control %d, late %d, unforced %d)", control, late, unforced);
+    CHECK(abs(control - unforced) > 1,
+          "forced Custom size is visibly different from the script's own (%d vs %d) -- the comparison below can fail", control, unforced);
+    CHECK(abs(late - control) <= 1,
+          "script loaded after the first render: Custom settings applied without touching a setting (late %d, control %d)", late, control);
+    CHECK(abs(late - unforced) > 1,
+          "late-loaded script is NOT stuck on the script's own style (late %d, unforced %d)", late, unforced);
+
+    printf("%s\n", fails ? "FAILED" : "ALL PASSED");
+    return fails != 0;
+}
diff --git a/test/host/ssa_style_cache_test.c b/test/host/ssa_style_cache_test.c
new file mode 100644
index 0000000..54ab0c8
--- /dev/null
+++ b/test/host/ssa_style_cache_test.c
@@ -0,0 +1,221 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Regression test for ssa_apply_geometry()'s style-cache invalidation.
+ *
+ * sync_styles() bakes forced FontSize (and Outline/Shadow) from
+ * ssa_geom_short_side(canvas_w, canvas_h) / ctx->content_h, but only
+ * re-runs when the style serial changes. ssa_apply_geometry() is
+ * responsible for bumping that serial (via last_serial = 0) whenever
+ * EITHER input moves, since a resize/box change can move one without
+ * the other:
+ *
+ *   - toggling "render in black bars" off keeps the video's displayed
+ *     height steady (content_h unchanged) while the canvas shrinks to
+ *     match the video -- changing short_side alone.
+ *   - a resize that keeps the video's aspect fit while growing the
+ *     window can move content_h without changing which side is
+ *     shorter.
+ *
+ * This test drives the REAL production path -- sub_format_ssa_create()'s
+ * open()/resize()/render_at() -- across exactly that first transition
+ * (bar-extended canvas -> video-only canvas, content_h held fixed) and
+ * measures the rendered glyph bounding box, the same way
+ * ssa_geometry_test.c measures ass_render_frame() output directly. If
+ * the cache invalidation regresses, the forced FontSize from the OLD
+ * short_side stays in effect and the measured text height won't move
+ * even though geometry says it must.
+ */
+#include "sub_engine.h"
+#include "host_font.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Defined in sub_format_ssa.c; not forward-declared in sub_format.h
+ * (each backend .c is expected to be wired up via sub_format_register()
+ * from init code we don't link here) -- declare it ourselves so the
+ * test can drive the backend directly without pulling in sub_engine.c's
+ * registration machinery. */
+SUB_FORMAT_BACKEND *sub_format_ssa_create(void);
+
+static const char *SCRIPT_TMPL =
+    "[Script Info]\n"
+    "ScriptType: v4.00+\n"
+    "PlayResX: 384\n"
+    "PlayResY: 288\n"
+    "ScaledBorderAndShadow: yes\n"
+    "\n"
+    "[V4+ Styles]\n"
+    "Format: Name,Fontname,Fontsize,PrimaryColour,SecondaryColour,OutlineColour,BackColour,Bold,Italic,Underline,StrikeOut,ScaleX,ScaleY,Spacing,Angle,BorderStyle,Outline,Shadow,Alignment,MarginL,MarginR,MarginV,Encoding\n"
+    "Style: Default," FONT_PLACEHOLDER ",18,&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,30,1\n"
+    "\n"
+    "[Events]\n"
+    "Format: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text\n"
+    "Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,HHHH\n";
+
+static const char *SCRIPT;   /* SCRIPT_TMPL with the harness-selected font family filled in */
+static int fails = 0;
+static void check(const char *what, int got, int want, int tol) {
+    if (got < want - tol || got > want + tol) {
+        printf("   FAIL %-40s got %d, want %d (+/-%d)\n", what, got, want, tol);
+        fails++;
+    } else {
+        printf("   ok   %-40s got %d (want %d +/-%d)\n", what, got, want, tol);
+    }
+}
+
+/* Render at pts_ms and return the ink bounding-box height across every
+ * SUB_EVENT_BITMAP event in the frame, 0 if nothing rendered. Mirrors
+ * ssa_geometry_test.c's render()/BB approach, just measured off the
+ * backend's own SUB_FRAME output instead of raw ASS_Image. */
+static int rendered_ink_height(SUB_FORMAT_BACKEND *be, int64_t pts_ms) {
+    SUB_FRAME *frame = be->render_at(be, pts_ms);
+    if (!frame) {
+        /* No change vs. the previous render at this backend. Force a
+         * fresh measurement by nudging the pts slightly -- libass's
+         * "change" flag is about content, and a resize alone doesn't
+         * always trip it even though the CALLER (sub_engine.c) always
+         * re-renders on the next poll anyway. */
+        frame = be->render_at(be, pts_ms + 1);
+    }
+    if (!frame) return -1; /* genuinely nothing to measure */
+
+    int y0 = 1 << 30, y1 = -1;
+    for (SUB_EVENT *ev = frame->events; ev; ev = ev->next) {
+        if (ev->kind != SUB_EVENT_BITMAP) continue;
+        if (ev->y < y0) y0 = ev->y;
+        if (ev->y + ev->h > y1) y1 = ev->y + ev->h;
+    }
+    be->free_frame(be, frame);
+    if (y1 < 0) return -1;
+    return y1 - y0;
+}
+
+int main(void) {
+    SCRIPT = with_font(SCRIPT_TMPL);
+    /* --- Portrait phone, 16:9 video letterboxed into a taller canvas,
+     * same geometry as ssa_geometry_test.c's first scenario: canvas
+     * 1080x2400, video box (0,896) 1080x608 -- content_h = 608. --- */
+    const int canvas_w = 1080, box_x = 0, box_y = 896, box_w = 1080, box_h = 608;
+    const int bars_canvas_h = 2400;     /* bars included: short_side = 1080 (=canvas_w) */
+    const int video_only_canvas_h = box_h; /* bars removed: canvas == box, short_side = 608 */
+
+    SUB_USER_STYLE *style = sub_style_create();
+    if (!style) { fprintf(stderr, "sub_style_create failed\n"); return 1; }
+    /* is_plain_text_format below already forces force_all=1 regardless of
+     * override_mode, but set an explicit font size so the forced value
+     * (and therefore the bug, if reintroduced) is unambiguous. */
+    sub_style_set_font_size(style, 55.0f);
+    /* Forced styles use the USER's font family, not the script's. Name the harness-selected face
+     * explicitly so the forced style resolves to it on every platform. */
+    sub_style_set_font_family(style, test_font_family());
+
+    SUB_FORMAT_BACKEND *be = sub_format_ssa_create();
+    if (!be) { fprintf(stderr, "sub_format_ssa_create failed\n"); return 1; }
+
+    SUB_FORMAT_OPEN_PARAMS params;
+    memset(&params, 0, sizeof(params));
+    params.video_w = canvas_w;
+    params.video_h = bars_canvas_h;
+    params.video_box_x = box_x;
+    params.video_box_y = box_y;
+    params.video_box_w = box_w;
+    params.video_box_h = box_h;
+    params.codec_private = (const uint8_t *)SCRIPT;
+    params.codec_private_size = (int)strlen(SCRIPT);
+    params.user_style = style;
+    params.is_plain_text_format = 0; /* real SSA script; force_all comes from override_mode==1 below */
+    /* The harness-selected font, registered through the backend's own fonts-folder path, so text renders
+     * on every platform without fontconfig. NULL (variable unset) = system fonts, as before. */
+    params.fonts_dir = getenv("HOST_TEST_FONT_DIR");
+
+    sub_style_set_override_mode(style, 1); /* ASS_OVERRIDE_FORCE -- exercise the force_all path */
+
+    if (be->open(be, &params) != 0) { fprintf(stderr, "open failed\n"); return 1; }
+    be->feed(be, (const uint8_t *)SCRIPT, (int)strlen(SCRIPT), 0, 5000);
+
+    printf("== bar-extended canvas: %dx%d, box %dx%d @ (%d,%d)  content_h=%d short_side=%d\n",
+           canvas_w, bars_canvas_h, box_w, box_h, box_x, box_y, box_h, canvas_w /* w < h here */);
+    int h_before = rendered_ink_height(be, 0);
+    check("ink height, bars-extended canvas", h_before, h_before, 0); /* just records it */
+
+    /* --- The transition under test: canvas shrinks to exactly the video
+     * box (bars removed), content_h held FIXED. This is the "toggle
+     * render-in-black-bars off" case from the comment: content_h is
+     * unchanged (still 608) but short_side moves from 1080 to 608. --- */
+    be->resize(be, box_w, video_only_canvas_h);
+    be->set_video_box(be, 0, 0, box_w, video_only_canvas_h);
+
+    int h_after = rendered_ink_height(be, 0);
+
+    printf("== video-only canvas:   %dx%d, box %dx%d @ (0,0)          content_h=%d short_side=%d\n",
+           box_w, video_only_canvas_h, box_w, video_only_canvas_h, video_only_canvas_h, video_only_canvas_h);
+
+    if (h_before <= 0 || h_after <= 0) {
+        fprintf(stderr, "FAIL: expected on-screen text both before (%d) and after (%d) resize\n",
+                h_before, h_after);
+        return 1;
+    }
+
+    /* short_side went from 1080 -> 608, a ~1.776x shrink, so the forced
+     * FontSize (which scales by short_side/content_h) must shrink by
+     * roughly the same factor. Assert directional + rough magnitude
+     * rather than an exact pixel count, to stay robust to font metrics:
+     * the bug this guards against left h_after == h_before (no change
+     * at all), which a >5% tolerance will not mask. */
+    double ratio = (double)h_after / (double)h_before;
+    double expected_ratio = (double)video_only_canvas_h / (double)canvas_w; /* 608/1080 */
+    printf("   ink height: %d -> %d  (ratio %.3f, expected ~%.3f)\n",
+           h_before, h_after, ratio, expected_ratio);
+
+    if (h_after >= h_before) {
+        printf("   FAIL ink height did not shrink after short_side changed "
+               "(stale forced FontSize -- cache not invalidated)\n");
+        fails++;
+    } else {
+        printf("   ok   ink height shrank after short_side changed\n");
+    }
+    check("ink height ratio tracks short_side ratio",
+          (int)(ratio * 1000), (int)(expected_ratio * 1000), 250 /* generous: hinting/rounding */);
+
+    /* --- Sanity check on the OTHER half of the fix: content_h moving
+     * while short_side stays put must also invalidate. Grow the canvas
+     * height (bars come back) while holding width -- and therefore
+     * short_side, since width is still the shorter side -- fixed, but
+     * change the box height so content_h moves. --- */
+    be->resize(be, box_w, box_w * 3); /* short_side stays == box_w */
+    be->set_video_box(be, 0, 0, box_w, box_w * 2); /* content_h changes: box_h -> box_w*2 */
+    int h_content_only = rendered_ink_height(be, 0);
+    printf("== content_h-only change: box_h %d -> %d, short_side fixed at %d\n",
+           video_only_canvas_h, box_w * 2, box_w);
+    if (h_content_only <= 0) {
+        printf("   FAIL expected on-screen text after content_h-only change\n");
+        fails++;
+    } else if (h_content_only == h_after) {
+        printf("   FAIL ink height unchanged when content_h moved alone "
+               "(stale forced FontSize -- cache not invalidated)\n");
+        fails++;
+    } else {
+        printf("   ok   ink height changed (%d -> %d) when content_h moved alone\n", h_after, h_content_only);
+    }
+
+    be->close(be);
+    free(be);
+    sub_style_destroy(style);
+
+    printf("\n%s (%d failed checks)\n", fails ? "SOME CHECKS FAILED" : "ALL CHECKS PASSED", fails);
+    return fails != 0;
+}
diff --git a/test/host/stubs.c b/test/host/stubs.c
new file mode 100644
index 0000000..d9e0e43
--- /dev/null
+++ b/test/host/stubs.c
@@ -0,0 +1,95 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * stubs.c -- link-time stand-ins for the few symbols the subtitle engine pulls in from
+ * elsewhere in the AVOS tree. Every definition here is WEAK: when a test also links the real
+ * thing (sub_engine.c's sub_frame_unref(), debug.c's Debug[]), the real, strong definition
+ * wins and nothing needs an #ifdef or a duplicate-symbol workaround.
+ *
+ * All of these are diagnostic logging or plain-free fallbacks and never affect the control
+ * flow of the code under test, so a no-op is a behaviourally faithful stand-in, not just a
+ * convenient one.
+ *
+ *   - Debug[]: real debug.c is normally linked (it is in the test tables). This copy is only
+ *     a safety net; it is sized by debug.h's own DBG_* enum so it cannot drift out of sync.
+ *
+ *   - serprintf(): log.c is platform-split (log_avos.c wants a real TTY/console behind it,
+ *     log_android.c needs the NDK), so neither is host-buildable. Always a no-op here.
+ *
+ *   - font_name_resolve_family(): the real one (font_name_parser.c) is FreeType-backed. It is
+ *     only reached when SUB_FORMAT_OPEN_PARAMS::fonts_dir is set; the tests leave it NULL, so
+ *     this exists purely to satisfy the linker and answers "not resolved", which is the right
+ *     answer if it ever did run with no font folder behind it. Revisit if a test needs real
+ *     font resolution.
+ *
+ *   - rst_to_ts_delta(): sub_engine.c's schedule_to_wall_ms() converts a backend's rst-time
+ *     deadline into a wall-clock wait through the app's playback-speed mapping (util.h). The
+ *     tests never change speed, so the identity (speed 1.0) is the right answer here; the
+ *     speed conversion itself is NOT exercised. util.h is included so the compiler checks
+ *     this definition against the real prototype.
+ *
+ *   - sub_frame_unref(): the real one lives in sub_engine.c and also knows the shared
+ *     pixel_refs refcounting used by the GFX backend. The SSA backend never sets pixel_refs
+ *     (plain malloc'd bitmaps per sub_types.h), so a plain free is faithful for the
+ *     SSA-only test, which deliberately does not link sub_engine.c. This copy aborts if it is
+ *     ever handed a pixel_refs-owned event instead of silently mishandling it; if SSA starts
+ *     using pixel_refs, link the real sub_engine.c in that test.
+ */
+#include "sub_types.h"
+#include "debug.h"
+#include "util.h"   // rst_to_ts_delta()
+#include <stdio.h>
+#include <stdlib.h>
+
+#define WEAK __attribute__((weak))
+
+WEAK double rst_to_ts_delta(double rst_delta) {
+    return rst_delta;
+}
+
+WEAK int Debug[DBG_MAX_ENTRIES];
+
+WEAK int serprintf(const char *fmt, ...) {
+    (void)fmt;
+    return 0;
+}
+
+WEAK int font_name_resolve_family(const char *fonts_dir, const char *file_name,
+                                  char *out_family, int out_family_size) {
+    (void)fonts_dir; (void)file_name;
+    if (out_family && out_family_size > 0) out_family[0] = '\0';
+    return 0;
+}
+
+WEAK void sub_frame_unref(SUB_FRAME *frame) {
+    if (!frame) return;
+    for (SUB_EVENT *ev = frame->events; ev; ) {
+        SUB_EVENT *next = ev->next;
+        if (ev->kind == SUB_EVENT_BITMAP) {
+            if (ev->pixel_refs) {
+                fprintf(stderr,
+                        "stubs.c: sub_frame_unref got a pixel_refs-owned event; this stand-in only "
+                        "handles SSA's plain-malloc bitmaps. Link the real sub_engine.c instead.\n");
+                abort();
+            }
+            free((void *)ev->data.bitmap.rgba);
+        } else if (ev->kind == SUB_EVENT_TEXT) {
+            free((void *)ev->data.text.utf8_text);
+        }
+        free(ev);
+        ev = next;
+    }
+    free(frame);
+}
diff --git a/test/host/style_resize_paused_test.c b/test/host/style_resize_paused_test.c
new file mode 100644
index 0000000..7718e01
--- /dev/null
+++ b/test/host/style_resize_paused_test.c
@@ -0,0 +1,158 @@
+// Copyright 2026 Courville Software
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/*
+ * Change subtitle style and resize the surface while PAUSED.
+ *
+ * While paused the render thread only wakes on an explicit broadcast (a style/resize setter, a
+ * pause toggle, a feed). Each such change must still produce one fresh render at the frozen clock
+ * -- otherwise a font-size change or a rotation is invisible until the user resumes -- without
+ * moving the clock, un-pausing, or inventing content the backend did not produce.
+ *
+ *   1. a style change renders once, at the paused pts, and publishes nothing the backend did not emit;
+ *   2. a surface resize + video box reach the backend (canvas once, box with it) and are applied
+ *      as one pair, at the frozen pts;
+ *   3. 100 rapid resize/box pairs coalesce: the backend ends on exactly the last pair;
+ *   4. style setters and resize storms on two threads at once, still paused: no deadlock (watchdog),
+ *      no data race (TSan), final geometry == last request, pause state untouched.
+ */
+#include "sub_engine.h"
+#include "fake_backend.h"
+#include "host_test_util.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static SUB_ENGINE *g_e;
+static atomic_int g_stop;
+
+static void settle(void) { usleep(120000); }
+static int fill(uint64_t last, uint64_t *gen, int force) {
+    uint8_t px[64];
+    return (int)sub_engine_fill_bitmap(g_e, px, 4, 4, 16, last, force, gen);
+}
+
+/* thread S: user dragging style sliders */
+static void *style_thread(void *arg) {
+    (void)arg;
+    SUB_USER_STYLE *st = sub_engine_get_style(g_e);
+    for (int i = 0; i < 3000; i++) {
+        switch (i % 5) {
+        case 0: sub_style_set_font_size(st, 20.0f + (float)(i % 40)); break;
+        case 1: sub_style_set_outline_width(st, (float)(i % 9)); break;
+        case 2: sub_style_set_text_color(st, 0xFF000000u | (uint32_t)(i * 2654435761u)); break;
+        case 3: sub_style_set_bg_opacity(st, (uint8_t)(i % 256)); break;
+        default: sub_style_set_margin_bottom(st, i % 200); break;
+        }
+        sub_engine_force_wake(g_e);
+        if (i % 64 == 0) usleep(100);
+    }
+    return NULL;
+}
+
+/* thread R: window being resized / rotated; the box always matches the canvas width */
+static int g_last_w, g_last_h;
+static void *resize_thread(void *arg) {
+    (void)arg;
+    for (int i = 0; i < 3000; i++) {
+        int w = 800 + (i % 50) * 16, h = 480 + (i % 37) * 9;
+        sub_engine_surface_resized(g_e, w, h);
+        sub_engine_set_video_box(g_e, 0, h / 8, w, h * 3 / 4);
+        g_last_w = w; g_last_h = h;
+        if (i % 64 == 0) usleep(100);
+    }
+    return NULL;
+}
+
+int main(void) {
+    t_watchdog(120, "style_resize_paused");
+    fake_backend_set_mode(FAKE_EMIT_ON_DEMAND);
+    fake_backend_reset_counters();
+    g_e = sub_engine_create();
+    sub_engine_start(g_e, fake_clock, NULL);                    /* fake_clock is frozen at 1000 ms */
+    sub_engine_open_track(g_e, SUB_FMT_SSA, 1920, 1080, NULL, 0, NULL, 0, NULL);
+    sub_engine_surface_resized(g_e, 1280, 720);
+    sub_engine_set_video_box(g_e, 0, 90, 1280, 540);
+    fake_backend_emit(); sub_engine_force_wake(g_e); settle();
+
+    uint64_t gen = 0;
+    CHECK(fill((uint64_t)-1, &gen, 1) == SUB_FILL_FRAME, "setup: a cue is on screen");
+    sub_engine_set_paused(g_e, 1);
+    settle();
+
+    /* ---- 1. style change while paused ---- */
+    int r0 = fake_backend_renders();
+    sub_style_set_font_size(sub_engine_get_style(g_e), 48.0f);
+    sub_engine_force_wake(g_e);
+    settle();
+    CHECK(fake_backend_renders() > r0, "style change while paused triggers a fresh render (%d -> %d)", r0, fake_backend_renders());
+    CHECK(fake_backend_last_pts() == 1000, "...at the frozen clock (pts %lld)", (long long)fake_backend_last_pts());
+    CHECK(sub_engine_is_paused(g_e) == 1, "...and the engine is still paused");
+    CHECK(fill(gen, &gen, 0) == SUB_FILL_UNCHANGED, "backend answered 'unchanged': nothing new was published");
+
+    /* ---- 2. surface resize + video box while paused ---- */
+    int rs0 = fake_backend_resizes(), bx0 = fake_backend_box_sets();
+    sub_engine_surface_resized(g_e, 1920, 1080);
+    sub_engine_set_video_box(g_e, 0, 0, 1920, 1080);
+    settle();
+    int cw, ch, bx, by, bw, bh;
+    fake_backend_last_canvas(&cw, &ch);
+    fake_backend_last_box(&bx, &by, &bw, &bh);
+    CHECK(cw == 1920 && ch == 1080, "paused resize reached the backend (canvas %dx%d)", cw, ch);
+    CHECK(bx == 0 && by == 0 && bw == 1920 && bh == 1080, "paused video box reached the backend (%d,%d %dx%d)", bx, by, bw, bh);
+    CHECK(fake_backend_resizes() == rs0 + 1, "the canvas was applied once (%d -> %d)", rs0, fake_backend_resizes());
+    CHECK(fake_backend_box_sets() >= bx0 + 1, "the box was applied (%d -> %d)", bx0, fake_backend_box_sets());
+    CHECK(fake_backend_last_pts() == 1000 && sub_engine_is_paused(g_e) == 1, "...at the frozen clock, still paused");
+
+    /* ---- 3. rapid pairs coalesce onto the last one ---- */
+    int rs1 = fake_backend_resizes();
+    for (int i = 0; i < 100; i++) {
+        int w = 1000 + i * 7, h = 600 + i * 3;
+        sub_engine_surface_resized(g_e, w, h);
+        sub_engine_set_video_box(g_e, 0, h / 10, w, h * 4 / 5);
+    }
+    settle();
+    int lw = 1000 + 99 * 7, lh = 600 + 99 * 3;
+    fake_backend_last_canvas(&cw, &ch);
+    fake_backend_last_box(&bx, &by, &bw, &bh);
+    CHECK(cw == lw && ch == lh, "after 100 rapid resizes the backend is on the last canvas (%dx%d, want %dx%d)", cw, ch, lw, lh);
+    CHECK(bx == 0 && by == lh / 10 && bw == lw && bh == lh * 4 / 5, "...and the last box (%d,%d %dx%d)", bx, by, bw, bh);
+    CHECK(fake_backend_resizes() - rs1 <= 100, "never more backend resizes than requests (%d for 100)", fake_backend_resizes() - rs1);
+
+    /* ---- 4. style + resize storms at once, still paused ---- */
+    pthread_t st, rt;
+    pthread_create(&st, NULL, style_thread, NULL);
+    pthread_create(&rt, NULL, resize_thread, NULL);
+    pthread_join(st, NULL);
+    pthread_join(rt, NULL);
+    sub_engine_force_wake(g_e);
+    settle();
+    fake_backend_last_canvas(&cw, &ch);
+    fake_backend_last_box(&bx, &by, &bw, &bh);
+    CHECK(cw == g_last_w && ch == g_last_h, "storm: backend ended on the last requested canvas (%dx%d, want %dx%d)", cw, ch, g_last_w, g_last_h);
+    CHECK(bw == g_last_w && bh == g_last_h * 3 / 4 && by == g_last_h / 8,
+          "storm: ...and the matching box (%d,%d %dx%d)", bx, by, bw, bh);
+    CHECK(sub_engine_is_paused(g_e) == 1 && fake_backend_last_pts() == 1000, "storm: still paused, clock never moved");
+
+    /* ---- resume: the engine still works and picks up new content ---- */
+    sub_engine_set_paused(g_e, 0);
+    fake_backend_emit(); sub_engine_force_wake(g_e); settle();
+    CHECK(fill(gen, &gen, 0) == SUB_FILL_FRAME, "after resume a new cue is published normally");
+
+    atomic_store(&g_stop, 1);
+    sub_engine_destroy(g_e);
+    CHECK(fake_backend_live() == 0, "no backend leaked (%d live)", fake_backend_live());
+    return t_finish();
+}
