+        self.assertEqual(len(result['cadence']), 3)
+        self.assertIsNone(result['segments'][1]['baseline_delay_change_ms'])
+        result = analyze([snapshot(rows[:2]), snapshot(rows[2:], refresh=20_000_000)], log)
+        self.assertEqual(len(result['cadence']), 3)
