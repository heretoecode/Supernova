+    assert(calls == 1 && s->pcm_clock_ref_ts == 100140 && !s->anchor_mutex);
+    s->video_sink_mutex = 0;
+    assert(!_stream_sync_anchor_publish(s, 100050, 100020, 1, 0, 75000, 100150, 1));
+    assert(calls == 1 && s->pcm_clock_ref_ts == 100140);
