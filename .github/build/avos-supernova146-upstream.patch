diff --git a/test/fixtures/slew_before_refactor.c b/test/fixtures/slew_before_refactor.c
new file mode 100644
index 0000000..46f4b8a
--- /dev/null
+++ b/test/fixtures/slew_before_refactor.c
@@ -0,0 +1,102 @@
+/*
