+JNIEXPORT void JNICALL Java_com_archos_mediacenter_video_player_SubtitleEngine_nativeSetShadowWidth(JNIEnv *env, jobject thiz, jlong handle, jfloat px) {
+    SUB_ENGINE *eng = get_engine(handle);
+    if (!eng) return;
