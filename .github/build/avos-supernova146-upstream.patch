+    def test_deferred_seek_preview_keeps_presentation_but_excludes_phase(self):
+        rows, log = playback()
+        log = log.replace('phase_ms=-80', 'phase_ms=-482643', 1)
+        log = ('_stream_play_n_frames(n=1)\n'
