-
-    /**
-     * Standard camera high-quality still capture with 3A and flash on auto.
-     */
-    CAMERA3_TEMPLATE_STILL_CAPTURE = 2,
-
-    /**
-     * Standard video recording plus preview with 3A on auto, torch off.
-     */
