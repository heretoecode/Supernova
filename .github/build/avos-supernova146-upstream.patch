+++ b/test/test_ac3_pcm_fallback.py
@@ -0,0 +1,151 @@
+"""Replay recoding preference and PCM recovery using production functions."""
+import unittest
+
+from native_replay import extract, run_c, source
+
+
+POLICY = r'''
+#include <assert.h>
+#include <string.h>
+#define CONFIG_SPDIF
