-void DumpLine( unsigned char *buf, int size, int max)
-{
-	char printable[] = "abcdefghijklmnopqrstuvwxyz!/\\\"#$%&'()*?+,-=|[]ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:^._<>{} ";
-	char *c;
-	int j;
-	for ( j = 0; j < max; j++ ) {
-		if ( j < size )
-			printf("%02X", buf[j] );		
-		else
-			printf("  ");		
-		if ( ( ( j - 3 ) % 4 ) == 0 ) {
-			printf("|");
-		} else {
-			printf(" ");
-		}
-	}
-	printf(" |");
-
-	for ( j = 0; j < max; j++ ) {
-		c = printable;
-		while ( *c != ' ' ) {
-			if (*c == buf[j] ) {
-				break;
-			}
-			c++;
-		}
-		if ( j < size )
-			printf("%c", *c );
-		else
-			printf(" ");
-	}
-	printf("|\r\n");
-}
