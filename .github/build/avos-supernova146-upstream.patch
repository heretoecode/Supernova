+static int memoryBufferPos = 0;
+
+/* Allocate elements from a static memory buffer. */
+static void* sonicCalloc(int num, int size) {
+  int len = num * size;
+
+  if (memoryBufferPos + len > SONIC_MAX_MEMORY) {
+    return 0;
+  }
+  unsigned char* p = memoryBuffer + memoryBufferPos;
+  memoryBufferPos += len;
+  memset(p, 0, len);
+  return p;
+}
