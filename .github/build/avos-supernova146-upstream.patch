+        with_pending = rows[:2] + [(rows[2][0], PENDING, rows[2][2])] + rows[3:]
+        self.assertEqual(len(analyze([snapshot(with_pending)], log)['cadence']), 2)
+        lines = log.splitlines()
+        lines.insert(2, 'WALLCLOCK_RESET: by pause resume')
