-        Elm *buffer;
-
-        buffer = TAILQ_FIRST(&this->queue);
-        if (buffer)
-            TAILQ_REMOVE(&this->queue, buffer, next);
-
-        return buffer;
-    }
-private:
-    typedef TAILQ_HEAD(, Elm) BUFFER_Q;
-    BUFFER_Q queue;
-};
