+    @Test public void silentServerHasOneBoundedResultAndCancellationCanStartAnotherProbe() throws Exception
+    {
+        try (MockWebServer server = new MockWebServer())
+        {
+            server.enqueue(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE));
+            server.enqueue(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE));
+            server.start();
+            try (Draft draft = new Draft(Type.WEBDAV, server.getHostName(), server.getPort(), "/Films", "", null))
+            {
+                ArrayBlockingQueue<Result> completed = new ArrayBlockingQueue<>(4);
+                DraftConnectionTest.start(RuntimeEnvironment.getApplication(), draft, Runnable::run, completed::add,
+                                          200);
+                Result timeout = completed.poll(5, TimeUnit.SECONDS);
+                assertEquals("Connection timed out", timeout.reason);
+                DraftConnectionTest.Job second = DraftConnectionTest.start(RuntimeEnvironment.getApplication(), draft,
+                                                                           Runnable::run, completed::add);
+                second.close();
+                Result stopped = completed.poll(5, TimeUnit.SECONDS);
+                assertTrue(stopped.cancelled);
