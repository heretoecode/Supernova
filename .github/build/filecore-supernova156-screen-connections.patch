+            server.start();
+            for (Field expected : new Field[] {Field.SIGN_IN, Field.FOLDER})
+                try (Draft draft = new Draft(Type.WEBDAV, server.getHostName(), server.getPort(), "/Films", "", null))
+                {
+                    ArrayBlockingQueue<Result> completed = new ArrayBlockingQueue<>(1);
