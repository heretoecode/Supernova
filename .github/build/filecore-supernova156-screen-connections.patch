+@RunWith(RobolectricTestRunner.class) @Config(application = Application.class, sdk = 30) public class DraftFtpProbeTest
+{
+    @Test public void privateFtpSessionAuthenticatesChangesFolderAndCountsActualListResponse() throws Exception
+    {
+        exercise(false);
+    }
+    @Test public void rejectedFtpSignInReturnsOnlyTheSignInField() throws Exception
+    {
+        exercise(true);
+    }
+    private void exercise(boolean reject) throws Exception
+    {
+        try (ServerSocket control = new ServerSocket(0); ServerSocket data = new ServerSocket(0))
+        {
+            control.setSoTimeout(5000);
+            data.setSoTimeout(5000);
+            FutureTask<String> serve = new FutureTask<>(() -> {
+                try (Socket socket = control.accept())
+                {
+                    socket.setSoTimeout(5000);
+                    BufferedReader input =
+                        new BufferedReader(new InputStreamReader(socket.getInputStream(), StandardCharsets.UTF_8));
+                    PrintWriter output = new PrintWriter(socket.getOutputStream(), true, StandardCharsets.UTF_8);
+                    output.print("220 fixture\r\n");
+                    output.flush();
+                    String folder = "";
+                    for (String line; (line = input.readLine()) != null;)
+                    {
+                        if (line.startsWith("USER"))
+                            output.print("331 password\r\n");
+                        else if (line.startsWith("PASS"))
+                        {
+                            output.print(reject ? "530 rejected\r\n" : "230 signed in\r\n");
+                            if (reject)
+                            {
+                                output.flush();
+                                return "rejected";
+                            }
+                        }
+                        else if (line.startsWith("SYST"))
+                            output.print("215 UNIX Type: L8\r\n");
+                        else if (line.startsWith("CWD"))
+                        {
+                            folder = line.substring(4);
+                            output.print("250 folder\r\n");
+                        }
+                        else if (line.startsWith("PASV"))
+                            output.print("227 Passive (127,0,0,1," + data.getLocalPort() / 256 + "," +
+                                         data.getLocalPort() % 256 + ")\r\n");
+                        else if (line.startsWith("LIST"))
+                        {
+                            output.print("150 listing\r\n");
+                            output.flush();
+                            try (Socket transfer = data.accept())
+                            {
+                                transfer.getOutputStream().write(
+                                    ("drwxr-xr-x 1 owner group 0 Nov 05 2026 Shows\r\n"
+                                     + "-rw-r--r-- 1 owner group 123 Nov 05 2026 One.mkv\r\n"
+                                     + "-rw-r--r-- 1 owner group 10 Nov 05 2026 note.txt\r\n")
+                                        .getBytes(StandardCharsets.UTF_8));
+                            }
+                            output.print("226 complete\r\n");
+                        }
+                        else
+                            output.print("200 OK\r\n");
+                        output.flush();
+                    }
+                    return folder;
+                }
+            });
+            Thread server = new Thread(serve, "FtpDraftFixture");
+            server.setDaemon(true);
+            server.start();
+            try (Draft draft =
+                     new Draft(Type.FTP, "127.0.0.1", control.getLocalPort(), "/Films", "viewer", new char[] {'x'}))
+            {
+                ArrayBlockingQueue<Result> completed = new ArrayBlockingQueue<>(1);
+                DraftConnectionTest.start(RuntimeEnvironment.getApplication(), draft, Runnable::run, completed::add);
+                Result value = completed.poll(5, TimeUnit.SECONDS);
+                assertTrue(value != null);
+                if (reject)
+                    assertEquals(Field.SIGN_IN, value.field);
+                else
+                {
+                    assertTrue(value.succeeded());
+                    assertEquals(1, value.folders);
+                    assertEquals(1, value.videos);
+                }
+                assertEquals(reject ? "rejected" : "/Films", serve.get(5, TimeUnit.SECONDS));
+            }
+        }
+    }
