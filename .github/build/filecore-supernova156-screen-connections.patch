+package com.archos.filecorelibrary.ftp;
+
+import java.io.IOException;
+import org.apache.commons.net.ftp.FTPSClient;
+
+/** Reuses the verified control/data-channel policy without a saved credential/session. */
+public final class DraftTlsClientFactory
+{
+    public static FTPSClient create() throws IOException
+    {
+        return FtpsTlsPolicy.newClient();
+    }
+
+    private DraftTlsClientFactory()
+    {
+    }
+}
