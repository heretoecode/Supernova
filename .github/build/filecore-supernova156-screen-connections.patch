+
+/** Private unsaved transports only. Lists immediate children; never touches source or credential stores. */
+public final class DraftConnectionTest
+{
+    public enum Type
+    {
+        SMB,
+        FTP,
+        FTPS,
+        SFTP,
+        WEBDAV,
+        WEBDAVS
+    }
+    public enum Field
+    {
+        NONE,
+        ADDRESS,
+        PORT,
+        SIGN_IN,
+        FOLDER,
+        CERTIFICATE
+    }
+    public static final class Result
+    {
+        public final Field field;
+        public final String reason;
+        public final int folders;
+        public final int videos;
+        public final boolean cancelled;
+
+        private Result(Field field, String reason, int folders, int videos, boolean cancelled)
+        {
+            this.field = field;
+            this.reason = reason;
+            this.folders = folders;
+            this.videos = videos;
+            this.cancelled = cancelled;
+        }
+        public boolean succeeded()
+        {
+            return field == Field.NONE && !cancelled;
+        }
+    }
+    public static final class Draft implements AutoCloseable
+    {
+        final Type type;
+        final String host, folder, user;
+        final int port;
+        private final char[] password;
+
+        public Draft(Type type, String host, int port, String folder, String user, char[] password)
+        {
+            this.type = type;
+            this.host = host == null ? "" : host.trim();
+            this.port = port;
+            this.folder = folder == null || folder.isEmpty() ? "/" : folder;
+            this.user = user == null ? "" : user;
+            this.password = password == null ? new char[0] : password.clone();
+        }
+        synchronized char[] password()
+        {
+            return password.clone();
+        }
+        @Override public synchronized void close()
+        {
+            Arrays.fill(password, '\0');
+        }
+    }
+
+    private static final ThreadPoolExecutor WORK = new ThreadPoolExecutor(
+        2, 2, 0, TimeUnit.SECONDS, new ArrayBlockingQueue<>(4), r -> daemon(r, "DraftConnection"));
+    private static final ScheduledExecutorService DEADLINES =
+        Executors.newSingleThreadScheduledExecutor(r -> daemon(r, "DraftConnectionDeadline"));
+    private static Thread daemon(Runnable task, String name)
+    {
+        Thread thread = new Thread(task, name);
+        thread.setDaemon(true);
+        return thread;
+    }
+
+    public static Job start(Context context, Draft draft, Executor callbacks, Consumer<Result> result)
+    {
+        return start(context, draft, callbacks, result, 25000);
+    }
+    static Job start(Context context, Draft draft, Executor callbacks, Consumer<Result> result, long timeoutMs)
+    {
+        Job job = new Job(context.getApplicationContext(), draft, callbacks, result);
+        job.deadline = DEADLINES.schedule(
+            () -> job.finish(failure(Field.ADDRESS, "Connection timed out")), timeoutMs, TimeUnit.MILLISECONDS);
+        try
+        {
+            WORK.execute(job::run);
+        }
+        catch (RejectedExecutionException busy)
+        {
+            job.finish(failure(Field.ADDRESS, "Connection tests are busy; try again shortly"));
+        }
+        return job;
+    }
+
+    public static final class Job implements AutoCloseable
+    {
+        private final Context context;
+        private final Draft draft;
+        private char[] password;
+        private final Executor callbacks;
+        private final Consumer<Result> result;
+        private final List<AutoCloseable> resources = new ArrayList<>();
+        private ScheduledFuture<?> deadline;
+        private boolean done;
+        private Thread worker;
+        private volatile Field stage = Field.ADDRESS;
+
+        private Job(Context context, Draft draft, Executor callbacks, Consumer<Result> result)
+        {
+            this.context = context;
+            this.draft = draft;
+            password = draft.password();
+            this.callbacks = callbacks;
+            this.result = result;
+        }
+        private synchronized void own(AutoCloseable resource) throws IOException
+        {
+            if (done)
+            {
+                release(resource);
+                throw new IOException("Test stopped");
+            }
+            resources.add(resource);
+        }
+        private synchronized void checkpoint() throws IOException
+        {
+            if (done || Thread.currentThread().isInterrupted())
+                throw new IOException("Test stopped");
+        }
+        private void run()
+        {
+            synchronized (this)
+            {
+                if (done)
+                    return;
+                worker = Thread.currentThread();
+            }
+            try
+            {
+                validate(draft);
+                Result value = switch (draft.type)
+                {
+                    case WEBDAV, WEBDAVS -> webdav();
+                    case FTP, FTPS -> ftp();
+                    case SFTP -> sftp();
+                    case SMB -> smb();
+                };
+                checkpoint();
+                finish(value);
+            }
+            catch (Invalid invalid)
+            {
+                finish(failure(invalid.field, invalid.getMessage()));
+            }
+            catch (Exception error)
+            {
+                Field field = stage;
+                if (hasCause(error, SSLException.class) ||
+                    hasCause(error, java.security.cert.CertificateException.class))
+                    field = Field.CERTIFICATE;
+                else if (hasCause(error, java.net.ConnectException.class) && draft.port != -1)
+                    field = Field.PORT;
+                finish(failure(field, reason(field)));
+            }
+        }
+        private void finish(Result value)
+        {
+            List<AutoCloseable> closing;
+            synchronized (this)
+            {
+                if (done)
+                    return;
+                done = true;
+                if (deadline != null)
+                    deadline.cancel(false);
+                closing = new ArrayList<>(resources);
+                resources.clear();
+                if (worker != null && worker != Thread.currentThread())
+                    worker.interrupt();
+            }
+            // Report the bounded result before potentially slow protocol cleanup.
+            try
+            {
+                callbacks.execute(() -> result.accept(value));
+            }
+            finally
+            {
+                synchronized (this)
+                {
+                    Arrays.fill(password, '\0');
+                }
+                if (!closing.isEmpty())
+                    daemon(() -> {
+                        Collections.reverse(closing);
+                        for (AutoCloseable resource : closing)
+                            release(resource);
+                    }, "DraftConnectionClose").start();
+            }
+        }
+        @Override public void close()
+        {
+            finish(new Result(Field.NONE, "Connection test stopped", 0, 0, true));
+        }
+        private String passwordText() throws IOException
+        {
+            checkpoint();
+            synchronized (this)
+            {
+                return new String(password);
+            }
+        }
+        private int port(int standard)
+        {
+            return draft.port == -1 ? standard : draft.port;
+        }
+        private Result ftp() throws Exception
+        {
+            FTPClient client = draft.type == Type.FTPS ? DraftTlsClientFactory.create() : new FTPClient();
+            own(() -> client.disconnect());
+            client.setConnectTimeout(5000);
+            client.setDefaultTimeout(5000);
+            client.setDataTimeout(java.time.Duration.ofSeconds(5));
+            client.setAutodetectUTF8(true);
+            client.connect(draft.host, port(21));
+            checkpoint();
+            stage = Field.SIGN_IN;
+            if (!client.login(draft.user.isEmpty() ? "anonymous" : draft.user, passwordText()))
+                throw new Invalid(Field.SIGN_IN, reason(Field.SIGN_IN));
+            if (client instanceof FTPSClient tls)
+            {
+                tls.execPBSZ(0);
+                tls.execPROT("P");
+            }
+            client.enterLocalPassiveMode();
+            stage = Field.FOLDER;
+            if (!client.changeWorkingDirectory(draft.folder))
+                throw new Invalid(Field.FOLDER, reason(Field.FOLDER));
+            FTPFile[] files = client.listFiles();
+            if (files == null || client.getReplyCode() >= 400)
+                throw new Invalid(Field.FOLDER, reason(Field.FOLDER));
+            int folders = 0, videos = 0;
+            for (FTPFile file : files)
+            {
+                checkpoint();
+                if (dot(file.getName()))
+                    continue;
+                if (file.isDirectory())
+                    folders++;
+                else if (file.isFile() && video(file.getName()))
+                    videos++;
+            }
+            return success(folders, videos);
+        }
+        private Result sftp() throws Exception
+        {
+            SSHClient ssh = new SSHClient();
+            own(ssh);
+            ssh.setConnectTimeout(5000);
+            ssh.setTimeout(5000);
+            ssh.addHostKeyVerifier(new HostKeyVerifier() {
+                @Override public boolean verify(String host, int port, java.security.PublicKey key)
+                {
+                    try
+                    {
+                        byte[] wire = new Buffer.PlainBuffer().putPublicKey(key).getCompactData();
+                        File pinsFile = new File(context.getFilesDir(), "sftp-trust.properties");
+                        Properties pins = new Properties();
+                        if (pinsFile.exists())
+                            try (InputStream input = new FileInputStream(pinsFile))
+                            {
+                                pins.load(input);
+                            }
+                        String known = pins.getProperty(host.toLowerCase(Locale.ROOT) + ":" + port);
+                        String fingerprint = android.util.Base64.encodeToString(
+                            MessageDigest.getInstance("SHA-256").digest(wire), android.util.Base64.NO_WRAP);
+                        boolean valid = known == null || known.equals(fingerprint);
+                        if (!valid)
+                            stage = Field.CERTIFICATE;
+                        return valid;
+                    }
+                    catch (Exception unavailable)
+                    {
+                        stage = Field.CERTIFICATE;
+                        return false;
+                    }
+                }
+                @Override public List<String> findExistingAlgorithms(String hostname, int port)
+                {
+                    return List.of();
+                }
+            });
+            ssh.connect(draft.host, port(22));
+            checkpoint();
+            stage = Field.SIGN_IN;
+            ssh.authPassword(draft.user, passwordText());
+            stage = Field.FOLDER;
+            SFTPClient sftp = ssh.newSFTPClient();
+            own(sftp);
+            int folders = 0, videos = 0;
+            for (RemoteResourceInfo file : sftp.ls(draft.folder))
+            {
+                checkpoint();
+                if (dot(file.getName()))
+                    continue;
+                if (file.isDirectory())
+                    folders++;
+                else if (file.isRegularFile() && video(file.getName()))
+                    videos++;
+            }
+            return success(folders, videos);
+        }
+        private Result smb() throws Exception
+        {
+            String path = draft.folder.replace('/', '\\').replaceAll("^\\\\+", "");
+            int slash = path.indexOf('\\');
+            String shareName = slash < 0 ? path : path.substring(0, slash);
+            if (shareName.isEmpty())
+                throw new Invalid(Field.FOLDER, "Enter a share and folder");
+            SMBClient client =
+                new SMBClient(SmbConfig.builder().withTimeout(5, TimeUnit.SECONDS).withSoTimeout(5000).build());
+            own(client);
+            Connection connection = client.connect(draft.host, port(445));
+            own(connection);
+            stage = Field.SIGN_IN;
+            String user = draft.user, domain = "";
+            int separator = user.indexOf('\\');
+            if (separator >= 0)
+            {
+                domain = user.substring(0, separator);
+                user = user.substring(separator + 1);
+            }
+            else if (user.contains("@"))
+            {
+                int at = user.lastIndexOf('@');
+                domain = user.substring(at + 1);
+                user = user.substring(0, at);
+            }
+            AuthenticationContext auth = user.isEmpty() && password.length == 0
+                                             ? AuthenticationContext.guest()
+                                             : new AuthenticationContext(user, passwordText().toCharArray(), domain);
+            Session session = connection.authenticate(auth);
+            own(session);
+            stage = Field.FOLDER;
+            if (!(session.connectShare(shareName) instanceof DiskShare share))
+                throw new Invalid(Field.FOLDER, reason(Field.FOLDER));
+            own(share);
+            int folders = 0, videos = 0;
+            for (FileIdBothDirectoryInformation file : share.list(slash < 0 ? "" : path.substring(slash + 1)))
+            {
+                checkpoint();
+                if (dot(file.getFileName()))
+                    continue;
+                if ((file.getFileAttributes() & FileAttributes.FILE_ATTRIBUTE_DIRECTORY.getValue()) != 0)
+                    folders++;
+                else if (video(file.getFileName()))
+                    videos++;
+            }
+            return success(folders, videos);
+        }
+        private Result webdav() throws Exception
+        {
+            String scheme = draft.type == Type.WEBDAVS ? "https" : "http";
+            URI uri = new URI(scheme, null, draft.host, draft.port, draft.folder, null, null);
+            OkHttpClient client = new OkHttpClient.Builder()
+                                      .connectTimeout(5, TimeUnit.SECONDS)
+                                      .readTimeout(5, TimeUnit.SECONDS)
+                                      .callTimeout(20, TimeUnit.SECONDS)
+                                      .followRedirects(false)
+                                      .followSslRedirects(false)
+                                      .build();
+            own(() -> client.connectionPool().evictAll());
+            Request.Builder request =
+                new Request.Builder()
+                    .url(uri.toASCIIString())
+                    .header("Depth", "1")
+                    .method("PROPFIND",
+                            RequestBody.create(
+                                MediaType.parse("application/xml"),
+                                "<d:propfind xmlns:d=\"DAV:\"><d:prop><d:resourcetype/></d:prop></d:propfind>"));
+            if (!draft.user.isEmpty())
+                request.header("Authorization", Credentials.basic(draft.user, passwordText()));
+            Call call = client.newCall(request.build());
+            own(call::cancel);
+            try (Response response = call.execute())
+            {
+                if (response.code() == 401 || response.code() == 403)
+                    throw new Invalid(Field.SIGN_IN, reason(Field.SIGN_IN));
+                stage = Field.FOLDER;
+                if (response.code() != 207 || response.body() == null)
+                    throw new Invalid(Field.FOLDER, reason(Field.FOLDER));
+                ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                InputStream input = response.body().byteStream();
+                byte[] buffer = new byte[8192];
+                for (int read; (read = input.read(buffer)) != -1;)
+                {
+                    checkpoint();
+                    if (bytes.size() + read > 2 * 1024 * 1024)
+                        throw new Invalid(Field.FOLDER, "Folder listing is too large to test");
+                    bytes.write(buffer, 0, read);
+                }
+                return parseWebdav(bytes.toByteArray(), uri);
+            }
+        }
+    }
+
+    static Result parseWebdav(byte[] xml, URI root) throws Exception
+    {
+        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+        factory.setNamespaceAware(true);
+        factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
+        factory.setFeature("http://xml.org/sax/features/external-general-entities", false);
+        factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false);
+        factory.setXIncludeAware(false);
+        factory.setExpandEntityReferences(false);
+        Element document = factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml)).getDocumentElement();
+        if (!"DAV:".equals(document.getNamespaceURI()) || !"multistatus".equals(document.getLocalName()))
+            throw new IOException("Invalid folder listing");
+        NodeList rows = document.getElementsByTagNameNS("DAV:", "response");
+        String base = root.getPath().replaceAll("/+$", "");
+        boolean rootFound = false;
+        int folders = 0, videos = 0;
+        java.util.Set<String> seen = new java.util.HashSet<>();
+        for (int i = 0; i < rows.getLength(); i++)
+        {
+            Element row = (Element)rows.item(i);
+            NodeList hrefs = row.getElementsByTagNameNS("DAV:", "href");
+            if (hrefs.getLength() != 1)
+                throw new IOException("Invalid folder listing");
+            URI child = root.resolve(hrefs.item(0).getTextContent());
+            if (!java.util.Objects.equals(root.getHost(), child.getHost()) || root.getPort() != child.getPort() ||
+                !java.util.Objects.equals(root.getScheme(), child.getScheme()))
+                throw new IOException("Folder listing changed source");
+            String path = child.getPath().replaceAll("/+$", "");
+            if (!seen.add(path))
+                throw new IOException("Repeated folder entry");
+            NodeList properties = row.getElementsByTagNameNS("DAV:", "propstat");
+            Element good = null;
+            for (int n = 0; n < properties.getLength(); n++)
+            {
+                Element prop = (Element)properties.item(n);
+                String status = prop.getElementsByTagNameNS("DAV:", "status").item(0).getTextContent();
+                if (status.matches("HTTP/\\S+ 200(?: .*)?"))
+                    good = prop;
+            }
+            if (good == null)
+                throw new IOException("Folder entry could not be read");
+            boolean directory = good.getElementsByTagNameNS("DAV:", "collection").getLength() > 0;
+            if (path.equals(base))
+            {
+                rootFound = directory;
+                continue;
+            }
+            if (!path.startsWith(base + "/") || path.substring(base.length() + 1).contains("/"))
+                throw new IOException("Folder entry is outside the selected folder");
+            if (directory)
+                folders++;
+            else if (video(path.substring(base.length() + 1)))
+                videos++;
+        }
+        if (!rootFound)
+            throw new IOException("Selected folder was not listed");
+        return success(folders, videos);
+    }
+    static void validate(Draft draft) throws Invalid
+    {
+        if (draft.type == null || draft.host.isEmpty() || draft.host.matches(".*[\\s/@?#].*") ||
+            draft.host.contains("://"))
+            throw new Invalid(Field.ADDRESS, reason(Field.ADDRESS));
+        if (draft.port != -1 && (draft.port < 1 || draft.port > 65535))
+            throw new Invalid(Field.PORT, reason(Field.PORT));
+        if (!draft.folder.startsWith("/") || draft.folder.indexOf('\0') >= 0 || draft.folder.contains("\\") ||
+            Arrays.asList(draft.folder.split("/", -1)).contains(".."))
+            throw new Invalid(Field.FOLDER, reason(Field.FOLDER));
+    }
+    static boolean video(String name)
+    {
+        return name.toLowerCase(Locale.ROOT).matches(".*\\.(mkv|mp4|m4v|avi|mov|ts|m2ts|mpeg|mpg|webm|wmv|vob|iso)$");
+    }
+    private static boolean dot(String name)
+    {
+        return name.equals(".") || name.equals("..");
+    }
+    private static Result success(int folders, int videos)
+    {
+        return new Result(Field.NONE, "", folders, videos, false);
+    }
+    private static Result failure(Field field, String reason)
+    {
+        return new Result(field, reason, 0, 0, false);
+    }
+    private static String reason(Field field)
+    {
+        return switch (field)
+        {
+            case ADDRESS -> "Check the server address and network connection";
+            case PORT -> "Enter a port between 1 and 65535";
+            case SIGN_IN -> "Check the user name and password";
+            case FOLDER -> "Check the folder and permission to list it";
+            case CERTIFICATE -> "The server identity could not be verified";
+            default -> "Connection could not be tested";
+        };
+    }
+    private static boolean hasCause(Throwable error, Class<? extends Throwable> type)
+    {
+        java.util.Set<Throwable> seen = Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+        java.util.ArrayDeque<Throwable> pending = new java.util.ArrayDeque<>();
+        pending.add(error);
+        while (!pending.isEmpty() && seen.size() < 128)
+        {
+            Throwable item = pending.remove();
+            if (!seen.add(item))
+                continue;
+            if (type.isInstance(item))
+                return true;
+            if (item.getCause() != null)
+                pending.add(item.getCause());
+            pending.addAll(Arrays.asList(item.getSuppressed()));
+        }
+        return false;
+    }
+    private static void release(AutoCloseable resource)
+    {
+        try
+        {
+            resource.close();
+        }
+        catch (Exception ignored)
+        {
+            // The caller receives the operation outcome; cleanup never exposes credentials.
+        }
+    }
+    static final class Invalid extends Exception
+    {
+        final Field field;
+        Invalid(Field field, String reason)
+        {
+            super(reason);
+            this.field = field;
+        }
+    }
+    private DraftConnectionTest()
+    {
+    }
+}
