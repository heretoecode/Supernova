diff --git a/src/com/archos/mediascraper/GenreUtils.java b/src/com/archos/mediascraper/GenreUtils.java
new file mode 100644
index 0000000..7da3778
--- /dev/null
+++ b/src/com/archos/mediascraper/GenreUtils.java
@@ -0,0 +1,368 @@
+// Copyright 2017 Archos SA
+//
