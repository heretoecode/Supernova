new file mode 100644
index 0000000..d6fde48
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/PreviewLocalImportTrace.java
@@ -0,0 +1,48 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.SystemClock;
+import java.util.UUID;
+
+/** Worker-local, bounded telemetry; never changes import decisions or records media paths. */
+public final class PreviewLocalImportTrace {
+    private static final ThreadLocal<PreviewLocalImportTrace> CURRENT=new ThreadLocal<>();
+    private static final java.util.Map<android.os.Message,PreviewLocalImportTrace> QUEUED=new java.util.IdentityHashMap<>();
+    private android.os.Handler owner;
+    private String trigger="native_import";
+    private final Context context;
+    private final String batch=UUID.randomUUID().toString(),mode;
+    private final long started=SystemClock.elapsedRealtime();
+    private long checked,added,updated,lastProgress;
+    private boolean partial,countsKnown;
+    private PreviewLocalImportTrace(Context context,boolean full){this.context=context;mode=full?"full":"incremental";}
+    public static void begin(Context context,boolean full){
+        PreviewLocalImportTrace trace=CURRENT.get();if(trace==null)trace=new PreviewLocalImportTrace(context,full);CURRENT.set(trace);trace.emit("started");
+    }
+    public static synchronized void queued(Context context,android.os.Handler owner,android.os.Message message,boolean full){
+        PreviewLocalImportTrace trace=new PreviewLocalImportTrace(context,full);trace.owner=owner;
+        String trigger=message.getData().getString("preview_trigger");if(java.util.Arrays.asList("startup","resume","content_change","android_scan").contains(trigger))trace.trigger=trigger;
+        QUEUED.put(message,trace);trace.emit("requested");trace.emit("queued");
+    }
+    public static synchronized void starting(android.os.Message message){PreviewLocalImportTrace trace=QUEUED.remove(message);if(trace!=null)CURRENT.set(trace);}
+    public static synchronized void rejected(android.os.Message message){PreviewLocalImportTrace trace=QUEUED.remove(message);if(trace!=null)trace.emit("cancelled");}
+    public static synchronized void cancelQueued(android.os.Handler owner){
+        java.util.Iterator<PreviewLocalImportTrace> iterator=QUEUED.values().iterator();while(iterator.hasNext()){PreviewLocalImportTrace trace=iterator.next();if(trace.owner==owner){iterator.remove();trace.emit("cancelled");}}
+    }
+    public static void checked(){PreviewLocalImportTrace t=CURRENT.get();if(t!=null){t.checked++;long now=SystemClock.elapsedRealtime();if(now-t.lastProgress>=1000){t.lastProgress=now;t.emit("indexing");}}}
+    public static void reconciled(int added,int updated){PreviewLocalImportTrace t=CURRENT.get();if(t!=null){t.added=Math.max(0,added);t.updated=Math.max(0,updated);t.countsKnown=added>=0&&updated>=0;t.emit("reconciled");}}
+    public static void problem(){PreviewLocalImportTrace t=CURRENT.get();if(t!=null)t.partial=true;}
+    public static void phase(String phase){PreviewLocalImportTrace t=CURRENT.get();if(t!=null&&java.util.Arrays.asList("metadata_queued","metadata_failed","metadata_skipped").contains(phase)){if("metadata_failed".equals(phase))t.partial=true;t.emit(phase);}}
+    public static void finish(boolean returned,boolean interrupted){
+        PreviewLocalImportTrace t=CURRENT.get();if(t==null)return;
+        try{t.emit(interrupted?"cancelled":!returned?"failed":t.partial?"partial":"complete");}finally{CURRENT.remove();}
+    }
+    private void emit(String phase){
+        try{context.sendBroadcast(new Intent(context.getPackageName()+".LOCAL_IMPORT_LIFECYCLE").setPackage(context.getPackageName())
+            .putExtra("batch_id",batch).putExtra("phase",phase).putExtra("mode",mode).putExtra("trigger",trigger)
+            .putExtra("checked",checked).putExtra("added",added).putExtra("updated",updated).putExtra("counts_known",countsKnown)
+            .putExtra("elapsed_ms",Math.max(0,SystemClock.elapsedRealtime()-started)));}catch(RuntimeException ignored){/* Telemetry must not interrupt indexing. */}
+    }
+    private PreviewLocalImportTrace(){throw new AssertionError();}
+}
