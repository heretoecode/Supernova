+import androidx.lifecycle.ProcessLifecycleOwner;
+import androidx.preference.PreferenceManager;
+import com.archos.filecorelibrary.webdav.ScanIoScope;
+import com.archos.mediaprovider.ArchosMediaIntent;
+import com.archos.mediascraper.AutoScrapeService;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.Shadows;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 28)
+public class NetworkScanLedgerTest {
+    private Context context;
+    private ScheduledExecutorService savedClock;
+    private ScheduledExecutorService clock;
+    private final List<Runnable> deadlines = new ArrayList<>();
+    private final List<NetworkScanLedger.Member> members = new ArrayList<>();
+
+    @Before public void setUp() throws Exception {
+        context = RuntimeEnvironment.getApplication();
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putBoolean("supernova_onboarding_complete", true).putBoolean("enable_auto_scrape", false).commit();
+        AutoScrapeService.resetNetworkScanCount();
+        savedClock = NetworkScanLedger.clock;
+        clock = mock(ScheduledExecutorService.class);
+        when(clock.schedule(any(Runnable.class), anyLong(), eq(TimeUnit.MILLISECONDS))).thenAnswer(invocation -> {
+            deadlines.add(invocation.getArgument(0));
+            return mock(ScheduledFuture.class);
+        });
+        NetworkScanLedger.clock = clock;
+        field(VideoStoreImportReceiver.class, "sLastExecutionTime").setLong(null, 0L);
+        field(VideoStoreImportReceiver.class, "sLastUri").set(null, null);
+    }
+
+    @After public void tearDown() {
+        for (NetworkScanLedger.Member member : members) NetworkScanLedger.reject(member);
+        NetworkScanLedger.clock = savedClock;
+        Thread.interrupted();
+        AutoScrapeService.resetNetworkScanCount();
+    }
+
+    private List<NetworkScanLedger.Member> batch(String... roots) {
+        List<Uri> uris = new ArrayList<>();
+        for (String root : roots) uris.add(Uri.parse(root));
+        List<NetworkScanLedger.Member> result = NetworkScanLedger.register(context, uris);
+        members.addAll(result);
+        return result;
+    }
+
+    private Intent intent(NetworkScanLedger.Member member) {
+        return new Intent(ArchosMediaIntent.ACTION_VIDEO_SCANNER_SCAN_FILE, member.uri)
+                .putExtra(NetworkScannerServiceVideo.EXTRA_SCAN_BATCH_ID, member.batch)
+                .putExtra(NetworkScanLedger.EXTRA_MEMBER, member.id);
+    }
+
+    @Test public void stoppedBetweenQueuedAndDeliveryReleasesBothAndAllowsRetry() {
+        LifecycleRegistry lifecycle = (LifecycleRegistry) ProcessLifecycleOwner.get().getLifecycle();
+        lifecycle.setCurrentState(Lifecycle.State.STARTED);
+        List<NetworkScanLedger.Member> pair = batch("webdav://server/TV", "webdav://server/Movies");
+        lifecycle.setCurrentState(Lifecycle.State.CREATED);
+        VideoStoreImportReceiver receiver = new VideoStoreImportReceiver();
+        for (NetworkScanLedger.Member member : pair) receiver.onReceive(context, intent(member));
+        lifecycle.setCurrentState(Lifecycle.State.STARTED);
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(2, phaseCount("not_started"));
+        assertEquals(1, phaseCount("batch_failed"));
+        assertFalse(NetworkScannerServiceVideo.isScannerAlive());
+        assertEquals(1, batch("webdav://server/TV").size());
+    }
+
+    @Test public void throttleRejectsNewMemberButCannotFinishOneTwice() throws Exception {
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        field(VideoStoreImportReceiver.class, "sLastExecutionTime").setLong(null, System.currentTimeMillis());
+        field(VideoStoreImportReceiver.class, "sLastUri").set(null, member.uri.toString());
+        VideoStoreImportReceiver receiver = new VideoStoreImportReceiver();
+        receiver.onReceive(context, intent(member));
+        receiver.onReceive(context, intent(member));
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(1, phaseCount("not_started"));
+        assertEquals(1, phaseCount("batch_failed"));
+    }
+
+    @Test public void serviceStartThrowAndNullAndUnsupportedUriTerminate() {
+        for (boolean throwsFailure : new boolean[] {true, false}) {
+            NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+            Context rejecting = new ContextWrapper(context) {
+                @Override public ComponentName startService(Intent service) {
+                    if (throwsFailure) throw new IllegalStateException("background restriction");
+                    return null;
+                }
+            };
+            assertTrue(NetworkScannerServiceVideo.startIfHandles(rejecting, intent(member)));
+            assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        }
+        NetworkScanLedger.Member unsupported = batch("not-supported://server/TV").get(0);
+        assertFalse(NetworkScannerServiceVideo.startIfHandles(context, intent(unsupported)));
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+    }
+
+    @Test public void lostBroadcastExpiresAndLateDeliveryCannotStartAServiceOrAffectRetry() {
+        NetworkScanLedger.Member old = batch("webdav://server/TV").get(0);
+        deadlines.get(0).run();
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        NetworkScanLedger.Member next = batch("webdav://server/TV").get(0);
+        Context noStart = new ContextWrapper(context) {
+            @Override public ComponentName startService(Intent service) {
+                fail("Expired delivery must not start a service"); return null;
+            }
+        };
+        NetworkScannerServiceVideo.startIfHandles(noStart, intent(old));
+        NetworkScanLedger.finish(old, false, true);
+        assertEquals(1, AutoScrapeService.getNetworkScanCount());
+        assertTrue(NetworkScanLedger.pending(next));
+    }
+
+    @Test public void rejectedMessageReleasesMemberAndRequestMapEntry() throws Exception {
+        NetworkScannerServiceVideo service = Robolectric.buildService(NetworkScannerServiceVideo.class).get();
+        // Handler.sendMessage is final; use a real looper whose queue is quitting instead.
+        android.os.HandlerThread thread = new android.os.HandlerThread("rejected-scan-message");
+        thread.start();
+        Handler handler = new Handler(thread.getLooper());
+        thread.quit();
+        thread.join(2000L);
+        field(NetworkScannerServiceVideo.class, "mHandler").set(service, handler);
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        service.onStartCommand(intent(member), 0, 1);
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertTrue(requests(service).isEmpty());
+    }
+
+    @Test public void executorRejectionReleasesMemberAndRequestMapEntry() throws Exception {
+        NetworkScannerServiceVideo service = Robolectric.buildService(NetworkScannerServiceVideo.class).get();
+        field(NetworkScannerServiceVideo.class, "mHandler").set(service, new Handler(Looper.getMainLooper()));
+        ExecutorService executor = (ExecutorService) field(NetworkScannerServiceVideo.class, "mScanExecutor").get(service);
+        executor.shutdownNow();
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        service.onStartCommand(intent(member), 0, 1);
+        Message message = Message.obtain();
+        message.what = field(NetworkScannerServiceVideo.class, "MESSAGE_DO_SCAN").getInt(null);
+        message.obj = member.uri;
+        Bundle extras = new Bundle();
+        extras.putLong(NetworkScannerServiceVideo.EXTRA_SCAN_BATCH_ID, member.batch);
+        extras.putString(NetworkScanLedger.EXTRA_MEMBER, member.id);
+        message.setData(extras);
+        service.handleMessage(message);
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertTrue(requests(service).isEmpty());
+    }
+
+    @Test public void ownerTeardownReleasesQueuedButKeepsCancelledWorkerUntilUnwind() {
+        List<NetworkScanLedger.Member> pair = batch("webdav://server/TV", "webdav://server/Movies");
+        Object service = new Object();
+        assertTrue(NetworkScanLedger.accept(pair.get(0), service));
+        assertTrue(NetworkScanLedger.accept(pair.get(1), service));
+        try (ScanIoScope io = new ScanIoScope(1, TimeUnit.MINUTES)) {
+            assertTrue(NetworkScanLedger.begin(pair.get(0), io));
+            NetworkScanLedger.cancelOwner(service);
+            assertTrue(io.isCancelled());
+            assertEquals(1, AutoScrapeService.getNetworkScanCount());
+            assertTrue(batch("webdav://server/retry").isEmpty());
+            assertFalse(NetworkScanLedger.begin(pair.get(1), io));
+            try { ScanIoScope.checkpoint(); fail("Old worker must be fenced"); }
+            catch (java.util.concurrent.CancellationException expected) { /* no late write */ }
+            NetworkScanLedger.finish(pair.get(0), false, true);
+        }
+        Thread.interrupted();
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(1, phaseCount("batch_failed"));
+        assertEquals(0, phaseCount("metadata_queued"));
+    }
+
+    @Test public void acknowledgementAndSourceDeadlinesHaveSeparateOwnership() {
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        assertTrue(NetworkScanLedger.accept(member, this));
+        deadlines.get(0).run(); // already acknowledged: stale timer cannot cancel it
+        assertEquals(1, AutoScrapeService.getNetworkScanCount());
+        deadlines.get(1).run(); // accepted but never run by executor
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(1, phaseCount("not_started"));
+    }
+
+    @Test public void runningDeadlineCancelsWithoutFalseSuccessOrDoubleCompletion() {
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        assertTrue(NetworkScanLedger.accept(member, this));
+        try (ScanIoScope io = new ScanIoScope(1, TimeUnit.MINUTES)) {
+            assertTrue(NetworkScanLedger.begin(member, io));
+            deadlines.get(1).run();
+            assertTrue(io.isCancelled());
+            assertEquals(1, AutoScrapeService.getNetworkScanCount());
+            NetworkScanLedger.finish(member, false, true);
+            NetworkScanLedger.finish(member, false, true);
+        }
+        Thread.interrupted();
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(1, phaseCount("failed"));
+        assertEquals(1, phaseCount("batch_failed"));
+        assertEquals(0, phaseCount("batch_complete"));
+    }
+
+    @Test public void duplicateIntentCannotClaimMemberTwice() {
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        assertTrue(NetworkScanLedger.accept(member, this));
+        assertFalse(NetworkScanLedger.accept(member, new Object()));
+        assertEquals(1, AutoScrapeService.getNetworkScanCount());
+        NetworkScanLedger.finish(member, true, false);
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+    }
+
+    @Test public void cancelledWorkerWaitingForProviderGateCannotPerformLateScan() throws Exception {
+        java.util.concurrent.atomic.AtomicInteger writes = new java.util.concurrent.atomic.AtomicInteger();
+        NetworkScannerServiceVideo service = new NetworkScannerServiceVideo() {
+            @Override ScanResult performScan(Uri uri) {
+                writes.incrementAndGet();
+                return new ScanResult(true, false);
+            }
+        };
+        field(NetworkScannerServiceVideo.class, "mHandler").set(service, new Handler(Looper.getMainLooper()));
+        ExecutorService executor = (ExecutorService) field(NetworkScannerServiceVideo.class, "mScanExecutor").get(service);
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        NetworkScanLedger.accept(member, service);
+        Message message = Message.obtain();
+        message.what = field(NetworkScannerServiceVideo.class, "MESSAGE_DO_SCAN").getInt(null);
+        message.obj = member.uri;
+        Bundle extras = new Bundle();
+        extras.putLong(NetworkScannerServiceVideo.EXTRA_SCAN_BATCH_ID, member.batch);
+        extras.putString(NetworkScanLedger.EXTRA_MEMBER, member.id);
+        message.setData(extras);
+        try {
+            synchronized (ProviderDiscoveryGate.LOCK) {
+                service.handleMessage(message);
+                long until = System.nanoTime() + TimeUnit.SECONDS.toNanos(3);
+                boolean running = false;
+                while (System.nanoTime() < until) {
+                    synchronized (NetworkScanLedger.class) { running = member.running; }
+                    if (running) break;
+                    Thread.sleep(1L);
+                }
+                assertTrue("Worker must have reached the provider gate", running);
+                NetworkScanLedger.reject(member);
+                assertEquals(1, AutoScrapeService.getNetworkScanCount());
+                assertEquals(0, writes.get());
+            }
+            executor.shutdown();
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));
+            assertEquals(0, writes.get());
+            assertEquals(0, AutoScrapeService.getNetworkScanCount());
+            assertEquals(1, phaseCount("batch_failed"));
+        } finally { executor.shutdownNow(); }
+    }
+
+    @Test public void duplicateUriHasDistinctMembersAndRejectsOnlyNewSlot() throws Exception {
+        NetworkScannerServiceVideo service = Robolectric.buildService(NetworkScannerServiceVideo.class).get();
+        List<NetworkScanLedger.Member> pair = batch("webdav://server/TV", "webdav://server/TV");
+        requests(service).put(pair.get(0).uri.toString(), new Object());
+        service.onStartCommand(intent(pair.get(1)), 0, 1);
+        assertEquals(1, AutoScrapeService.getNetworkScanCount());
+        assertTrue(NetworkScanLedger.pending(pair.get(0)));
+        assertFalse(NetworkScanLedger.pending(pair.get(1)));
+        NetworkScanLedger.reject(pair.get(0));
+        assertEquals(1, phaseCount("batch_failed"));
+    }
+
+    @Test public void timerRejectionCompensatesEveryRegisteredSlot() {
+        when(clock.schedule(any(Runnable.class), anyLong(), eq(TimeUnit.MILLISECONDS)))
+                .thenThrow(new java.util.concurrent.RejectedExecutionException());
+        batch("webdav://server/TV", "webdav://server/Movies");
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        assertEquals(2, phaseCount("not_started"));
+        assertEquals(1, phaseCount("batch_failed"));
+    }
+
+    @Test public void bareBatchIdCannotConsumeLedgerMember() {
+        NetworkScanLedger.Member member = batch("webdav://server/TV").get(0);
+        Intent forged = new Intent(ArchosMediaIntent.ACTION_VIDEO_SCANNER_SCAN_FILE, member.uri)
+                .putExtra(NetworkScannerServiceVideo.EXTRA_SCAN_BATCH_ID, member.batch);
+        Context noStart = new ContextWrapper(context) {
+            @Override public ComponentName startService(Intent service) { fail("Missing member identity"); return null; }
+        };
+        NetworkScannerServiceVideo.startIfHandles(noStart, forged);
+        assertEquals(1, AutoScrapeService.getNetworkScanCount());
+    }
+
+    private long phaseCount(String phase) {
+        return Shadows.shadowOf((Application) context).getBroadcastIntents().stream()
+                .filter(i -> (context.getPackageName() + ".SCAN_LIFECYCLE").equals(i.getAction()))
+                .filter(i -> phase.equals(i.getStringExtra("phase"))).count();
+    }
+
+    private static Field field(Class<?> type, String name) throws Exception {
+        Field field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        return field;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ConcurrentHashMap<String, Object> requests(NetworkScannerServiceVideo service) throws Exception {
+        return (ConcurrentHashMap<String, Object>) field(NetworkScannerServiceVideo.class, "mScanRequests").get(service);
+    }
+}
