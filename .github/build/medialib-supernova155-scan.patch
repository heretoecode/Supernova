+/** End-to-end ledger cancellation -> raw DAV call -> scanner finally, with real sockets. */
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 28)
+public class NetworkScanTransportTest {
+    @Test public void silentRawListingReleasesBatchOnlyAfterCancellationUnwinds() throws Exception {
+        exercise(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE), true);
+    }
+
+    @Test public void tricklingRawListingCannotOutliveSourceDeadline() throws Exception {
+        exercise(new MockResponse().setResponseCode(207).setBody("<" + "x".repeat(16_384))
+                .throttleBody(1, 20, TimeUnit.MILLISECONDS), true);
+    }
+
+    @Test public void disconnectTerminatesWithoutSuccessHandoff() throws Exception {
+        exercise(new MockResponse().setResponseCode(207).setBody("<" + "x".repeat(16_384))
+                .setSocketPolicy(SocketPolicy.DISCONNECT_DURING_RESPONSE_BODY), false);
+    }
+
+    private void exercise(MockResponse response, boolean expire) throws Exception {
+        Context context = RuntimeEnvironment.getApplication();
+        ArchosUtils.setGlobalContext(context);
+        WebdavUtils.getInstance(context);
+        AutoScrapeService.resetNetworkScanCount();
+        ScheduledExecutorService savedClock = NetworkScanLedger.clock;
+        ScheduledExecutorService clock = mock(ScheduledExecutorService.class);
+        List<Runnable> deadlines = new ArrayList<>();
+        when(clock.schedule(any(Runnable.class), anyLong(), eq(TimeUnit.MILLISECONDS))).thenAnswer(call -> {
+            deadlines.add(call.getArgument(0)); return mock(ScheduledFuture.class);
+        });
+        NetworkScanLedger.clock = clock;
+        AtomicInteger writesAfterListing = new AtomicInteger();
+        NetworkScannerServiceVideo service = new NetworkScannerServiceVideo() {
+            @Override ScanResult performScan(Uri uri) {
+                try {
+                    new WebdavRawLister(uri).getFileList();
+                    com.archos.filecorelibrary.webdav.ScanIoScope.checkpoint();
+                    writesAfterListing.incrementAndGet();
+                    return new ScanResult(true, false);
+                } catch (Exception failure) { return new ScanResult(false, false); }
+            }
+        };
+        ExecutorService worker = (ExecutorService) field("mScanExecutor").get(service);
+        NetworkScanLedger.Member member = null;
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(new MockResponse().setHeader("DAV", "1").setResponseCode(200));
+            server.start();
+            Uri uri = Uri.parse(server.url("/TV").toString()).buildUpon().scheme("webdav").build();
+            WebdavUtils.peekInstance().getSardine(uri);
+            WebdavFile2.uriToHttp(uri); // warm credential lookup/redirect probe before timed traversal
+            assertNotNull(server.takeRequest(1, TimeUnit.SECONDS));
+            server.enqueue(response);
+            member = NetworkScanLedger.register(context, List.of(uri)).get(0);
+            assertTrue(NetworkScanLedger.accept(member, service));
+            field("mHandler").set(service, new Handler(Looper.getMainLooper()));
+            Message message = Message.obtain();
+            message.what = field("MESSAGE_DO_SCAN").getInt(null);
+            message.obj = uri;
