diff --git a/src/com/archos/mediaprovider/video/NetworkScanLedger.java b/src/com/archos/mediaprovider/video/NetworkScanLedger.java
new file mode 100644
index 0000000..18c1c60
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/NetworkScanLedger.java
@@ -0,0 +1,172 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import com.archos.filecorelibrary.webdav.ScanIoScope;
+import com.archos.mediascraper.AutoScrapeService;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+/** Exact ownership for counted scheduler work; all transitions use the same monitor. */
+final class NetworkScanLedger {
+    static final String EXTRA_MEMBER = "scan_member_extra";
+    static final long START_ACK_MS = 15_000L;
+    static final long SOURCE_MS = 300_000L;
+    static ScheduledExecutorService clock = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread thread = new Thread(r, "ScanStartDeadline");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private static final Map<String, Member> MEMBERS = new HashMap<>();
+
+    static final class Member {
+        final Context context;
+        final Uri uri;
+        final long batch;
+        final String id;
+        final int total;
+        Object service;
+        boolean accepted;
+        boolean running;
+        boolean terminal;
+        ScanIoScope io;
+        ScheduledFuture<?> acknowledgement;
+        ScheduledFuture<?> sourceDeadline;
+
+        Member(Context context, Uri uri, long batch, int total) {
+            this.context = context.getApplicationContext();
+            this.uri = uri;
+            this.batch = batch;
+            this.id = batch + ":" + java.util.UUID.randomUUID();
+            this.total = total;
+        }
+    }
+
+    static synchronized List<Member> register(Context context, List<Uri> roots) {
+        long batch = AutoScrapeService.startNetworkScanBatch(roots.size());
+        List<Member> result = new ArrayList<>();
+        if (batch == AutoScrapeService.STANDALONE_SCAN_BATCH_ID) return result;
+        for (int i = 0; i < roots.size(); i++) {
+            Member member = new Member(context, roots.get(i), batch, roots.size());
+            MEMBERS.put(member.id, member);
+            result.add(member);
+        }
+        for (int i = 0; i < result.size(); i++) queued(result.get(i), 100L + i * 2000L);
+        return result;
+    }
+
+    static synchronized Member from(Intent intent) {
+        if (intent == null) return null;
+        Member member = MEMBERS.get(intent.getStringExtra(EXTRA_MEMBER));
+        return member != null && member.batch == intent.getLongExtra(
+                NetworkScannerServiceVideo.EXTRA_SCAN_BATCH_ID, 0L)
+                && member.uri.equals(intent.getData()) ? member : null;
+    }
+
+    static synchronized boolean ownsBatch(long batch) {
+        for (Member member : MEMBERS.values()) if (member.batch == batch) return true;
+        return false;
+    }
+
+    static synchronized void queued(Member member, long dispatchDelay) {
+        if (member.terminal) return;
+        NetworkScannerServiceVideo.previewScanEvent(member.context, member.uri, "queued",
+                Long.toString(member.batch), member.total, 0, 0, 0);
+        try {
+            member.acknowledgement = clock.schedule(() -> expireStart(member),
+                    dispatchDelay + START_ACK_MS, TimeUnit.MILLISECONDS);
+        } catch (RuntimeException failure) {
+            finish(member, true, false);
+        }
+    }
+
+    static synchronized void expireStart(Member member) {
+        if (pending(member) && !member.accepted) reject(member);
+    }
+
+    static synchronized boolean pending(Member member) {
+        return member != null && !member.terminal;
+    }
+
+    static synchronized boolean accept(Member member, Object service) {
+        if (!pending(member) || member.accepted) return false;
+        member.accepted = true;
+        member.service = service;
+        if (member.acknowledgement != null) member.acknowledgement.cancel(false);
+        try {
+            // Includes time waiting for the serial executor, so accepted queued work is bounded too.
+            member.sourceDeadline = clock.schedule(() -> reject(member), SOURCE_MS, TimeUnit.MILLISECONDS);
+        } catch (RuntimeException failure) {
+            reject(member);
+            return false;
+        }
+        return true;
+    }
+
+    /** Called by the executor, not by the receiver/handler that merely queued it. */
+    static synchronized boolean begin(Member member, ScanIoScope io) {
+        if (!pending(member) || member.running) return false;
+        member.running = true;
+        member.io = io;
+        if (member.acknowledgement != null) member.acknowledgement.cancel(false);
+        return true;
+    }
+
+    static synchronized void reject(Intent intent) {
+        reject(from(intent));
+    }
+
+    static synchronized void reject(Member member) {
+        if (!pending(member)) return;
+        if (member.running) {
+            // Keep the batch busy until the worker's finally, including any in-flight DB call.
+            member.io.cancel();
+        } else {
+            finish(member, true, false);
+        }
+    }
+
+    static synchronized void cancelOwner(Object service) {
+        for (Member member : new ArrayList<>(MEMBERS.values())) {
+            if (member.service == service) reject(member);
+        }
+    }
+
+    static synchronized void finish(Member member, boolean failed, boolean success) {
+        finish(member, failed, success, 0, 0, 0);
+    }
+
+    static synchronized void finish(Member member, boolean failed, boolean success,
+            int checked, int added, int updated) {
+        if (!pending(member)) return;
+        member.terminal = true;
+        if (member.acknowledgement != null) member.acknowledgement.cancel(false);
+        if (member.sourceDeadline != null) member.sourceDeadline.cancel(false);
+        MEMBERS.remove(member.id);
+        boolean cancelled = member.io != null && member.io.isCancelled();
+        failed |= cancelled;
+        success &= !failed;
+        String phase = !member.running ? "not_started" : success ? "complete" : "failed";
+        AutoScrapeService.NetworkScanCompletion completion = AutoScrapeService.completeNetworkScan(
+                member.batch, failed, success);
+        NetworkScannerServiceVideo.previewScanEvent(member.context, member.uri, phase,
+                Long.toString(member.batch), -1, checked, added, updated);
+        try {
+            NetworkScannerServiceVideo.previewFinish(member.context, member.uri,
+                    Long.toString(member.batch), completion, checked, added, updated);
+        } catch (RuntimeException failure) {
+            // Accounting is committed. Failure to enqueue metadata must not strand other members.
+            org.slf4j.LoggerFactory.getLogger(NetworkScanLedger.class)
+                    .warn("Could not deliver scan completion", failure);
+        }
+    }
+
+    private NetworkScanLedger() {}
+}
