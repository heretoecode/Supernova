diff --git a/src/com/archos/filecorelibrary/sftp/SftpHostTrust.java b/src/com/archos/filecorelibrary/sftp/SftpHostTrust.java
new file mode 100644
index 0000000..b55eaef
--- /dev/null
+++ b/src/com/archos/filecorelibrary/sftp/SftpHostTrust.java
@@ -0,0 +1,33 @@
+package com.archos.filecorelibrary.sftp;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Base64;
+import java.security.MessageDigest;
+import java.util.Locale;
+
+/** Persist first-use SSH wire keys; never accept a changed identity automatically. */
+public final class SftpHostTrust {
+    private static SharedPreferences pins;
+    public static synchronized void initialise(Context context) {
+        pins=context.getApplicationContext().getSharedPreferences("sftp_host_trust",Context.MODE_PRIVATE);
+    }
+    private static String identity(String host,int port) {
+        return host.toLowerCase(Locale.ROOT)+":"+(port<0?22:port);
+    }
+    public static synchronized boolean verify(String host,int port,byte[] wireKey) {
+        if(pins==null||host==null||wireKey==null||wireKey.length==0)return false;
+        try {
+            String id=identity(host,port);
+            String fingerprint=Base64.encodeToString(MessageDigest.getInstance("SHA-256").digest(wireKey),Base64.NO_WRAP);
+            String known=pins.getString(id,null);
+            if(known!=null)return known.equals(fingerprint);
+            // Compatibility migration: first use after upgrade establishes the pin.
+            // A failed durable write is a verification failure, not permission to proceed.
+            return pins.edit().putString(id,fingerprint).commit();
+        } catch(java.security.NoSuchAlgorithmException | RuntimeException failure){return false;}
+    }
+    public static synchronized String[] hosts(){return pins==null?new String[0]:pins.getAll().keySet().toArray(new String[0]);}
+    public static synchronized boolean forget(String identity){return pins!=null&&pins.edit().remove(identity).commit();}
+    private SftpHostTrust(){}
+}
