diff --git a/src/com/archos/mediaprovider/video/ScanSchedulePolicy.java b/src/com/archos/mediaprovider/video/ScanSchedulePolicy.java
new file mode 100644
index 0000000..aa4e97d
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/ScanSchedulePolicy.java
@@ -0,0 +1,32 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import androidx.preference.PreferenceManager;
+
+/** Successful completion time is distinct from the old request/service-stop timestamp. */
+public final class ScanSchedulePolicy
+{
+    public static final int HOUR_MS = 60 * 60 * 1000;
+    public static final String LAST_COMPLETED = "supernova_last_completed_scan_utc";
+
+    public static boolean dueOnOpen(SharedPreferences preferences, long now)
+    {
+        if (!preferences.getBoolean("auto_rescan_on_app_restart", false))
+            return false;
+        long completed = preferences.getLong(LAST_COMPLETED, 0);
+        return completed <= 0 || now > completed && now - completed > HOUR_MS;
+    }
+
+    public static void completed(Context context)
+    {
+        PreferenceManager.getDefaultSharedPreferences(context)
+            .edit()
+            .putLong(LAST_COMPLETED, System.currentTimeMillis())
+            .apply();
+    }
+
+    private ScanSchedulePolicy()
+    {
+    }
+}
diff --git a/test/java/com/archos/mediaprovider/video/ScanSchedulePolicyTest.java b/test/java/com/archos/mediaprovider/video/ScanSchedulePolicyTest.java
new file mode 100644
index 0000000..b742fb4
--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/ScanSchedulePolicyTest.java
@@ -0,0 +1,49 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.assertEquals;
+
+import android.app.Application;
+import android.content.SharedPreferences;
+import androidx.preference.PreferenceManager;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class ScanSchedulePolicyTest
+{
+    @Test public void restartGateHonoursExplicitOffAndStrictlyMoreThanAnHour()
+    {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(RuntimeEnvironment.getApplication());
+        long completed = 10000000;
+        assertFalse(ScanSchedulePolicy.dueOnOpen(prefs, completed));
+        prefs.edit().putBoolean("auto_rescan_on_app_restart", true).commit();
+        assertTrue(ScanSchedulePolicy.dueOnOpen(prefs, completed));
+        prefs.edit().putLong(ScanSchedulePolicy.LAST_COMPLETED, completed).commit();
+        assertFalse(ScanSchedulePolicy.dueOnOpen(prefs, completed - 1));
+        assertFalse(ScanSchedulePolicy.dueOnOpen(prefs, completed + ScanSchedulePolicy.HOUR_MS));
+        assertTrue(ScanSchedulePolicy.dueOnOpen(prefs, completed + ScanSchedulePolicy.HOUR_MS + 1));
+        prefs.edit().putBoolean("auto_rescan_on_app_restart", false).commit();
+        assertFalse(ScanSchedulePolicy.dueOnOpen(prefs, completed + 2L * ScanSchedulePolicy.HOUR_MS));
+    }
+
+    @Test public void failedAndCancelledImportsDoNotAdvanceTheCompletedScanTime()
+    {
+        Application app = RuntimeEnvironment.getApplication();
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(app);
+        prefs.edit().putLong(ScanSchedulePolicy.LAST_COMPLETED, 123).commit();
+        PreviewLocalImportTrace.begin(app, true);
+        PreviewLocalImportTrace.finish(false, false);
+        PreviewLocalImportTrace.begin(app, true);
+        PreviewLocalImportTrace.finish(true, true);
+        assertEquals(123, prefs.getLong(ScanSchedulePolicy.LAST_COMPLETED, 0));
+        PreviewLocalImportTrace.begin(app, true);
+        PreviewLocalImportTrace.finish(true, false);
+        assertTrue(prefs.getLong(ScanSchedulePolicy.LAST_COMPLETED, 0) > 123);
+    }
+}
