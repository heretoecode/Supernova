 DBGP2 serprintf("SUBTITLE   dts/pts %8lld/%8lld  ", GET_SUB_TS( packet.dts ), GET_SUB_TS( packet.pts ) );
 DBGP2 DumpLine( packet.data, 16, 16 );
 		// add subtitle packet
