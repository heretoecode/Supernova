diff --git a/Source/stream_parser_ffmpeg.c b/Source/stream_parser_ffmpeg.c
index 81864fe..02e5d67 100644
--- a/Source/stream_parser_ffmpeg.c
+++ b/Source/stream_parser_ffmpeg.c
@@ -1763,6 +1763,12 @@ static int _get_subtitle_cdata( STREAM *s, CLEVER_BUFFER *sub_buffer, STREAM_CDA
 
 	AVPacket _packet;
 	AVPacket *packet = _get_packet( &ff_p->sq, &_packet );
+	// Buffered packets can belong to the previous subtitle stream. Drop only
+	// those packets; audio/video queues and demux position are untouched.
+	while( packet && packet->stream_index != s->subtitle->stream ) {
+		_dispose_packet( packet );
+		packet = _get_packet( &ff_p->sq, &_packet );
+	}
 	if( !packet ) {
 		return 1;
 	}
diff --git a/Source/stream_subtitle.c b/Source/stream_subtitle.c
