+// Retain active/recent and prefetched cues for every known internal track.
+// Four MiB / 4096 packets bounds bitmap-subtitle memory as well as text cues.
+// Parser and subtitle workers share only this queue mutex; video/audio are untouched.
+static int _subtitle_packet_time( STREAM *s, AVPacket *packet, int duration )
+{
+	AVStream *st = ff_p->fmt->streams[packet->stream_index];
+	int64_t value = duration ? packet->duration : packet->pts;
+	if( value == AV_NOPTS_VALUE ) return -1;
+	int64_t millis = av_rescale_q( value, st->time_base, (AVRational){1,1000} );
+	return duration ? RST_TO_TS_DELTA(millis, int) : RST_TO_TS_TIME(millis - ff_p->start_time, int);
+}
+
+static int _known_subtitle_stream( STREAM *s, int stream )
+{
+	int i;
+	for( i = 0; i < s->av.subs_max; i++ )
+		if( !s->av.sub[i].ext && s->av.sub[i].valid && s->av.sub[i].stream == stream ) return 1;
+	return 0;
+}
+
+static void _remember_subtitle_packet( STREAM *s, AVPacket *packet )
+{
+	AVQueue *q = &ff_p->sub_history;
+	pthread_mutex_lock( &q->mutex );
+	PacketNode *copy = acalloc(1, sizeof(PacketNode));
+	LinkedListNode_init((LinkedListNode*)copy);
+	av_packet_ref(&copy->packet, packet);
+	LinkedList_append(&q->list, (LinkedListNode*)copy);
+	q->mem_used += sizeof(PacketNode) + copy->packet.size;
+	q->packets++;
+	if( ff_p->subtitle == s->subtitle && ff_p->subtitle_generation == s->subtitle_generation && packet->stream_index == s->subtitle->stream ) _add_packet(&ff_p->sq, packet);
+	LinkedListNode *entry = q->list.first;
+	while( entry ) {
+		PacketNode *node = (PacketNode*)entry;
+		entry = entry->next;
+		int start = _subtitle_packet_time( s, &node->packet, 0 );
+		int duration = _subtitle_packet_time( s, &node->packet, 1 );
+		// Unknown-duration bitmap events retain one minute of decoder history.
+		int clock = s->video_time - RST_TO_TS_DELTA(s->subtitle_offset, int);
+		int expired = start >= 0 && start + (duration > 0 ? duration : 60000) < clock;
+		if( expired || q->mem_used > 4 * 1024 * 1024 || q->packets > 4096 ) {
+			LinkedList_remove( &q->list, (LinkedListNode*)node );
+			q->mem_used -= sizeof(PacketNode) + node->packet.size;
+			q->packets--;
+			_dispose_packet( &node->packet );
+			afree( node );
+		}
+	}
+	pthread_mutex_unlock( &q->mutex );
+}
+
+static void _restore_selected_subtitles( STREAM *s )
+{
+	if( ff_p->subtitle == s->subtitle && ff_p->subtitle_generation == s->subtitle_generation ) return;
+	AVQueue *q = &ff_p->sub_history;
+	pthread_mutex_lock( &q->mutex );
+	_flush_packets( &ff_p->sq, "SUB_SWITCH" );
+	LinkedListNode *entry;
+	for( entry = q->list.first; entry; entry = entry->next ) {
+		AVPacket *packet = &((PacketNode*)entry)->packet;
+		if( packet->stream_index == s->subtitle->stream ) _add_packet( &ff_p->sq, packet );
+	}
+	ff_p->subtitle = s->subtitle;
+	ff_p->subtitle_generation = s->subtitle_generation;
+	pthread_mutex_unlock( &q->mutex );
+}
+
