 	_flush_packets( &ff_p->aq, "AUD" );
 	_flush_packets( &ff_p->sq, "SUB" );
+		_flush_packets( &ff_p->sub_history, "SUB_HISTORY" );
+		ff_p->subtitle = NULL;
 
 	ff_p->sleeping = 0;
 	
@@ -1762,7 +1839,14 @@ static int _get_subtitle_cdata( STREAM *s, CLEVER_BUFFER *sub_buffer, STREAM_CDA
 	}
 
 	AVPacket _packet;
+	_restore_selected_subtitles( s );
 	AVPacket *packet = _get_packet( &ff_p->sq, &_packet );
+	// Buffered packets can belong to the previous subtitle stream. Drop only
+	// those packets; audio/video queues and demux position are untouched.
+	while( packet && packet->stream_index != s->subtitle->stream ) {
