+package com.archos.medialib;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.Test;
+
+public class MetadataRequestDiagnosticsTest
+{
+    @Test public void resultAndFailureKeepRequestIdentityAndExactStageWithoutGlobalLastQueryState()
+    {
+        long[] now = {10};
+        List<Map<String, Object>> rows = new ArrayList<>();
+        List<Throwable> failures = new ArrayList<>();
+        MetadataRequestDiagnostics request =
+            new MetadataRequestDiagnostics("introdb_org", "media", () -> now[0], (event, failure, fields) -> {
+                Map<String, Object> row = new LinkedHashMap<>();
+                for (int i = 0; i < fields.length; i += 2)
+                    row.put((String)fields[i], fields[i + 1]);
+                rows.add(row);
+                failures.add(failure);
+            });
+        request.response(200);
+        request.body(24);
+        IOException failure = new IOException("Malformed response");
+        now[0] = 50;
+        request.failed(failure, "parse");
+        request.close();
+        request.close();
+        assertEquals(2, rows.size());
+        assertSame(failure, failures.get(0));
+        assertEquals(rows.get(0).get("operation_id"), rows.get(1).get("operation_id"));
+        assertEquals("parse", rows.get(1).get("outcome"));
+        assertEquals(40L, rows.get(1).get("duration_ms"));
+        assertEquals(true, rows.get(1).get("suspicious_small_body"));
+    }
+
+    @Test public void throwingObserverCannotChangeAProviderOutcome()
+    {
+        MetadataRequestDiagnostics request =
+            new MetadataRequestDiagnostics("introdb_app", "segments", () -> 0, (event, failure, fields) -> {
+                throw new IllegalStateException("Sink unavailable");
+            });
+        request.response(404);
+        request.failed(new IOException("Unavailable"), "transport");
+        request.close();
+    }
+}
