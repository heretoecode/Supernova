+++ b/src/com/archos/medialib/MetadataRequestDiagnostics.java
@@ -0,0 +1,99 @@
+package com.archos.medialib;
+
+import java.util.UUID;
+import java.util.function.LongSupplier;
+
+/** Optional app-owned evidence sink; no URL, credentials or response text crosses this contract. */
+public final class MetadataRequestDiagnostics implements AutoCloseable
+{
+    public interface Sink
+    {
+        void accept(String event, Throwable failure, Object[] fields);
+    }
+    private static volatile Sink sink;
+    private final Sink owner;
+    private final String service, endpoint, operation = UUID.randomUUID().toString();
+    private final LongSupplier clock;
+    private final long started;
+    private int status;
+    private long bytes = -1;
+    private String outcome = "transport_incomplete";
+    private boolean closed;
+
+    public static void install(Sink value)
+    {
+        sink = value;
+    }
+
+    public static MetadataRequestDiagnostics open(String service, String endpoint)
+    {
+        return new MetadataRequestDiagnostics(service, endpoint, () -> System.nanoTime() / 1_000_000, sink);
+    }
+
+    MetadataRequestDiagnostics(String service, String endpoint, LongSupplier clock, Sink owner)
+    {
+        this.service = service;
+        this.endpoint = endpoint;
+        this.clock = clock;
+        this.owner = owner;
+        started = clock.getAsLong();
+    }
+
+    public void response(int status)
+    {
+        this.status = status;
+        outcome = status >= 200 && status < 300 ? "success" : "http_error";
+    }
+
+    public void body(long bytes)
+    {
+        this.bytes = bytes;
+    }
+
+    public void failed(Throwable failure, String stage)
+    {
+        outcome = stage;
+        emit("metadata_request_failed", failure);
+    }
+
+    private void emit(String event, Throwable failure)
+    {
+        if (owner == null)
+            return;
+        try
+        {
+            owner.accept(event, failure,
+                         new Object[] {"operation_id",
+                                       operation,
+                                       "service",
+                                       service,
+                                       "endpoint_category",
+                                       endpoint,
+                                       "status",
+                                       status,
+                                       "body_bytes",
+                                       bytes,
+                                       "body_bytes_known",
+                                       bytes >= 0,
+                                       "body_byte_quality",
+                                       "decoded_utf8_length",
+                                       "duration_ms",
+                                       Math.max(0, clock.getAsLong() - started),
+                                       "outcome",
+                                       outcome,
+                                       "suspicious_small_body",
+                                       bytes >= 0 && bytes <= 24});
+        }
+        catch (RuntimeException ignored)
+        { /* Observability never changes a provider result. */
+        }
+    }
+
+    @Override public void close()
+    {
+        if (closed)
+            return;
+        closed = true;
+        emit("metadata_request_result", null);
+    }
+}
