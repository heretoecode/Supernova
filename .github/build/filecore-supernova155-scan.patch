@@ -0,0 +1,91 @@
+package com.archos.filecorelibrary.webdav;
+
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import android.app.Application;
+import android.net.Uri;
+import androidx.test.core.app.ApplicationProvider;
+import com.archos.environment.ArchosUtils;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import okhttp3.mockwebserver.MockResponse;
+import okhttp3.mockwebserver.MockWebServer;
+import okhttp3.mockwebserver.SocketPolicy;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 28)
+public class WebdavScanDeadlineTest {
+    @Before public void setUp() {
+        Application app = ApplicationProvider.getApplicationContext();
+        ArchosUtils.setGlobalContext(app);
+        WebdavUtils.getInstance(app);
+    }
+
+    @Test public void actualRawListingSilentServerIsCancelled() throws Exception {
+        rawListingFailure(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE));
+    }
+
+    @Test public void actualRawListingTrickleIsCancelled() throws Exception {
+        rawListingFailure(new MockResponse().setResponseCode(207).setBody("<" + "x".repeat(16_384))
+                .throttleBody(1, 20, TimeUnit.MILLISECONDS));
+    }
+
+    private void rawListingFailure(MockResponse response) throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(response);
+            server.start();
+            Uri uri = Uri.parse(server.url("/TV").toString()).buildUpon().scheme("webdav").build();
+            // Bypass redirect probing in this case; separate test below covers that path.
+            WebdavUtils.setRedirectClientForTesting(new okhttp3.OkHttpClient.Builder()
+                    .addInterceptor(chain -> new okhttp3.Response.Builder().request(chain.request())
+                            .protocol(okhttp3.Protocol.HTTP_1_1).code(200).message("OK")
+                            .body(okhttp3.ResponseBody.create("", okhttp3.MediaType.get("text/plain"))).build()).build());
+            WebdavUtils.peekInstance().getSardine(uri); // initialise credential lookup before timing I/O
+            WebdavFile2.uriToHttp(uri);
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            try {
+                Future<Boolean> result = worker.submit(() -> {
+                    try (ScanIoScope scope = new ScanIoScope(250, TimeUnit.MILLISECONDS)) {
+                        try { new WebdavRawLister(uri).getFileList(); }
+                        catch (Exception expected) { /* transport may translate cancellation */ }
+                        assertTrue(scope.isCancelled());
+                        try { ScanIoScope.checkpoint(); fail("No late scan writes"); }
+                        catch (CancellationException expected) { return true; }
+                        return false;
+                    } finally { Thread.interrupted(); }
+                });
+                assertTrue(result.get(5, TimeUnit.SECONDS));
+                assertTrue(server.takeRequest(1, TimeUnit.SECONDS) != null);
+            } finally {
+                worker.shutdownNow();
+                WebdavUtils.setRedirectClientForTesting(null);
+            }
+        }
+    }
+
+    @Test public void actualRedirectProbeIsAlsoOwnedByScanScope() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE));
+            server.start();
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            try {
+                Future<Boolean> result = worker.submit(() -> {
+                    try (ScanIoScope scope = new ScanIoScope(250, TimeUnit.MILLISECONDS)) {
+                        WebdavUtils.peekInstance().resolveRedirect(Uri.parse(server.url("/TV").toString()));
+                        return scope.isCancelled();
+                    } finally { Thread.interrupted(); }
+                });
+                assertTrue(result.get(5, TimeUnit.SECONDS));
+            } finally { worker.shutdownNow(); }
+        }
+    }
+}
