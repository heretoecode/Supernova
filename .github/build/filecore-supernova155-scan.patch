+package com.archos.filecorelibrary.webdav;
+
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+import okhttp3.Call;
+import okhttp3.EventListener;
+import okhttp3.OkHttpClient;
+
+/** Thread-confined scanner scope. Never cancels a shared client's other consumers. */
+public final class ScanIoScope implements AutoCloseable {
+    private static final ThreadLocal<ScanIoScope> CURRENT = new ThreadLocal<>();
+    private static final ScheduledExecutorService CLOCK = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread t = new Thread(r, "ScanIoDeadline");
+        t.setDaemon(true);
+        return t;
+    });
+    private final Set<Call> calls = new HashSet<>();
+    private final Thread owner = Thread.currentThread();
+    private final ScheduledFuture<?> deadline;
+    private boolean cancelled;
+    private boolean closed;
+
+    public ScanIoScope(long timeout, TimeUnit unit) {
+        if (CURRENT.get() != null) throw new IllegalStateException("Nested scan scope");
+        if (timeout <= 0) throw new IllegalArgumentException("Positive deadline required");
+        deadline = CLOCK.schedule(this::cancel, timeout, unit);
+        CURRENT.set(this);
+    }
+
+    public void cancel() {
+        Set<Call> owned;
+        synchronized (this) {
+            if (closed || cancelled) return;
+            cancelled = true;
+            owned = new HashSet<>(calls);
+            // Deliver the interrupt before close can let this thread move to its next task.
+            owner.interrupt();
+        }
+        for (Call call : owned) call.cancel();
+    }
+
+    public synchronized boolean isCancelled() {
+        return cancelled;
+    }
+
+    public static void checkpoint() {
+        ScanIoScope scope = CURRENT.get();
+        if (scope != null && (scope.isCancelled() || Thread.currentThread().isInterrupted())) {
+            throw new CancellationException("Scan cancelled");
+        }
+    }
+
+    /** Called only while constructing a scanner's Sardine or redirect client. */
+    static OkHttpClient client(OkHttpClient base) {
+        ScanIoScope scope = CURRENT.get();
+        if (scope == null || base == null) return base;
+        checkpoint();
+        return base.newBuilder().eventListenerFactory(call -> {
+            EventListener delegate = base.eventListenerFactory().create(call);
+            return new EventListener() {
+                @Override public void callStart(Call call) {
+                    synchronized (scope) {
+                        if (scope.cancelled || scope.closed) call.cancel();
+                        else scope.calls.add(call);
+                    }
+                    delegate.callStart(call);
+                }
+                @Override public void callEnd(Call call) {
+                    synchronized (scope) { scope.calls.remove(call); }
+                    delegate.callEnd(call);
+                }
+                @Override public void callFailed(Call call, IOException failure) {
+                    synchronized (scope) { scope.calls.remove(call); }
+                    delegate.callFailed(call, failure);
+                }
+            };
+        }).build();
+    }
+
+    @Override public void close() {
+        if (Thread.currentThread() != owner) throw new IllegalStateException("Wrong scan owner");
+        Set<Call> owned;
+        synchronized (this) {
+            closed = true;
+            deadline.cancel(false);
+            owned = new HashSet<>(calls);
+            calls.clear();
+        }
+        CURRENT.remove();
+        for (Call call : owned) call.cancel();
+    }
+}
