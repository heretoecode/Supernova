@@ -0,0 +1,119 @@
+package com.archos.filecorelibrary.webdav;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.io.IOException;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import okhttp3.Call;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.mockwebserver.MockResponse;
+import okhttp3.mockwebserver.MockWebServer;
+import okhttp3.mockwebserver.SocketPolicy;
+import org.junit.After;
+import org.junit.Test;
+
+/** Real sockets exercise cancellation before headers and while consuming a response body. */
+public class ScanIoScopeTest {
+    @After public void clearInterrupt() { Thread.interrupted(); }
+
+    @Test public void silentServerIsCancelledByWholeSourceDeadline() throws Exception {
+        deadlineFailure(new MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE));
+    }
+
+    @Test public void tricklingBodyCannotKeepSourceAliveBeyondDeadline() throws Exception {
+        deadlineFailure(new MockResponse().setBody("x".repeat(16_384))
+                .throttleBody(1, 20, TimeUnit.MILLISECONDS));
+    }
+
+    private void deadlineFailure(MockResponse response) throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(response);
+            server.start();
+            ExecutorService worker = Executors.newSingleThreadExecutor();
+            try {
+                Future<Boolean> result = worker.submit(() -> {
+                    OkHttpClient base = new OkHttpClient.Builder().readTimeout(30, TimeUnit.SECONDS).build();
+                    try (ScanIoScope scope = new ScanIoScope(250, TimeUnit.MILLISECONDS)) {
+                        Call call = ScanIoScope.client(base).newCall(new Request.Builder().url(server.url("/TV")).build());
+                        try (Response received = call.execute()) {
+                            received.body().string();
+                            fail("Source should be cancelled");
+                        } catch (IOException expected) {
+                            assertTrue("Deadline must own the failure", scope.isCancelled());
+                            assertTrue(call.isCanceled());
+                        } finally {
+                            Thread.interrupted();
+                        }
+                        try { ScanIoScope.checkpoint(); fail("Cancelled scan must be fenced"); }
+                        catch (CancellationException expected) { /* no late reconciliation */ }
+                        return true;
+                    } finally { Thread.interrupted(); }
+                });
+                assertTrue(result.get(5, TimeUnit.SECONDS));
+                assertTrue(server.takeRequest(1, TimeUnit.SECONDS) != null);
+            } finally {
+                worker.shutdownNow();
+            }
+        }
+    }
+
+    @Test public void disconnectFailsWithoutPretendingDeadlineExpiredAndNextScopeWorks() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(new MockResponse().setBody("x".repeat(16_384))
+                    .setSocketPolicy(SocketPolicy.DISCONNECT_DURING_RESPONSE_BODY));
+            server.enqueue(new MockResponse().setBody("next"));
+            server.start();
+            OkHttpClient base = new OkHttpClient();
+            try (ScanIoScope scope = new ScanIoScope(10, TimeUnit.SECONDS)) {
+                try (Response received = ScanIoScope.client(base).newCall(
+                        new Request.Builder().url(server.url("/TV")).build()).execute()) {
+                    received.body().string();
+                    fail("Truncated body must fail");
+                } catch (IOException expected) { assertFalse(scope.isCancelled()); }
+            }
+            assertSame(base, ScanIoScope.client(base));
+            try (ScanIoScope scope = new ScanIoScope(10, TimeUnit.SECONDS);
+                 Response received = ScanIoScope.client(base).newCall(
+                         new Request.Builder().url(server.url("/Movies")).build()).execute()) {
+                assertEquals("next", received.body().string());
+            }
+        }
+    }
+
+    @Test public void cancellingScannerDoesNotCancelOtherCallOnSharedClient() throws Exception {
+        try (MockWebServer server = new MockWebServer()) {
+            server.enqueue(new MockResponse().setBody("playback"));
+            server.start();
+            OkHttpClient base = new OkHttpClient();
+            Call playback = base.newCall(new Request.Builder().url(server.url("/playback")).build());
+            try (ScanIoScope scope = new ScanIoScope(1, TimeUnit.MINUTES)) {
+                scope.cancel();
+                assertFalse(playback.isCanceled());
+            }
+            Thread.interrupted();
+            try (Response response = playback.execute()) { assertEquals("playback", response.body().string()); }
+            assertSame(base, ScanIoScope.client(base));
+        }
+    }
+
+    @Test public void cancellationBeforeExecuteAlsoCancelsCallCreatedEarlier() throws Exception {
+        OkHttpClient base = new OkHttpClient();
+        try (ScanIoScope scope = new ScanIoScope(1, TimeUnit.MINUTES)) {
+            Call call = ScanIoScope.client(base).newCall(new Request.Builder().url("http://localhost:1/").build());
+            scope.cancel();
+            Thread.interrupted();
+            try (Response response = call.execute()) { fail("Cancelled before execute"); }
+            catch (IOException expected) { assertTrue(call.isCanceled()); }
+        }
+    }
+}
