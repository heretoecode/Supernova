+    /** X4 (0.158): a scan that already holds the lease (waiting its turn) takes it again without waiting on itself. */
+    @Test public void theHolderTakesTheLeaseAgainWithoutWaiting() throws Exception
+    {
+        File lock = File.createTempFile("scan", ".lock");
+        try (ScanProcessLock outer = ScanProcessLock.acquire(lock, () -> false))
+        {
+            try (ScanProcessLock inner = ScanProcessLock.acquire(lock, () -> false))
+            {
+                assertTrue(lock.exists());
+            }
+            // Still held after the inner one closes: another holder would still have to wait.
+            assertThrows(InterruptedIOException.class, () -> ScanProcessLock.acquire(lock, () -> true));
+        }
+        try (ScanProcessLock again = ScanProcessLock.acquire(lock, () -> false))
+        {
+            assertTrue(lock.exists());
+        }
+        finally
+        {
+            lock.delete();
+        }
+    }
