diff --git a/src/com/archos/mediaprovider/video/ProviderDiscoveryGate.java b/src/com/archos/mediaprovider/video/ProviderDiscoveryGate.java
new file mode 100644
index 0000000..d696a3b
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/ProviderDiscoveryGate.java
@@ -0,0 +1,34 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import java.util.*;
+
+/** Same-process scanner/provider hand-off. Both services run in the application process. */
+public final class ProviderDiscoveryGate {
+    public static final Object LOCK=new Object();
+    private static SharedPreferences prefs(Context c){return c.getSharedPreferences("provider-discovery-ownership-v1",Context.MODE_PRIVATE);}
+    public static void exclude(Context c,String scope,Uri source){
+        if(scope==null||!scope.matches("putio(?:-retired)?:[0-9]+:[a-f0-9]+")||source==null||source.getUserInfo()!=null||source.getQuery()!=null||source.getFragment()!=null||source.getHost()==null)throw new IllegalArgumentException("Invalid provider source");
+        synchronized(LOCK){if(!prefs(c).edit().putString(scope,source.toString()).commit())throw new IllegalStateException("Unable to preserve scanner ownership");}
+    }
+    public static void release(Context c,String scope){synchronized(LOCK){if(!prefs(c).edit().remove(scope).commit())throw new IllegalStateException("Unable to restore scanner ownership");}}
+    public static boolean excludes(Context c,Uri candidate){
+        if(candidate==null)return false;
+        synchronized(LOCK){for(Object value:prefs(c).getAll().values())if(value instanceof String&&contains(Uri.parse((String)value),candidate))return true;return false;}
+    }
+    public static boolean contains(Uri root,Uri candidate){
+        if(root==null||candidate==null||root.getHost()==null||candidate.getHost()==null||!root.getHost().equalsIgnoreCase(candidate.getHost())||!scheme(root).equals(scheme(candidate))||port(root)!=port(candidate))return false;
+        List<String> a=root.getPathSegments(),b=candidate.getPathSegments();if(a.size()>b.size())return false;
+        for(int i=0;i<a.size();i++)if(!a.get(i).equals(b.get(i)))return false;
+        return true;
+    }
+    public static boolean protects(Context c,Uri candidate){
+        if(candidate==null)return false;
+        synchronized(LOCK){for(Object value:prefs(c).getAll().values())if(value instanceof String){Uri root=Uri.parse((String)value);if(contains(root,candidate)||contains(candidate,root))return true;}return false;}
+    }
+    private static String scheme(Uri uri){String s=uri.getScheme();if(s==null)return "";s=s.toLowerCase(Locale.ROOT);return s.equals("webdavs")||s.equals("davs")?"https":s.equals("webdav")||s.equals("dav")?"http":s;}
+    private static int port(Uri uri){return uri.getPort()>=0?uri.getPort():scheme(uri).equals("https")?443:scheme(uri).equals("http")?80:-1;}
+    private ProviderDiscoveryGate(){}
+}
