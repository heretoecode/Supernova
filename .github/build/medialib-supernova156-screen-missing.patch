new file mode 100644
index 0000000..9915603
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/MissingMediaActions.java
@@ -0,0 +1,146 @@
+package com.archos.mediaprovider.video;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.net.Uri;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Worker-only guarded library mutations. No filesystem delete or watched/bookmark update exists here. */
+public final class MissingMediaActions
+{
+    public record StoredFile(long id, String path, long size)
+    {
+    }
+
+    public static List<StoredFile> read(Context context) throws IOException
+    {
+        java.io.File file = VideoOpenHelper.getDatabaseFile(context);
+        if (!file.isFile())
+            throw new IOException("Library inventory is unavailable");
+        try (SQLiteDatabase database = SQLiteDatabase.openDatabase(file.getPath(), null, SQLiteDatabase.OPEN_READONLY))
+        {
+            List<StoredFile> rows = new ArrayList<>();
+            try (Cursor cursor =
+                     database.query("files", new String[] {"_id", "_data", "_size"}, null, null, null, null, "_id"))
+            {
+                while (cursor.moveToNext())
+                    if (!cursor.isNull(0) && !cursor.isNull(1))
+                        rows.add(new StoredFile(cursor.getLong(0), cursor.getString(1),
+                                                cursor.isNull(2) ? -1 : cursor.getLong(2)));
+            }
+            return List.copyOf(rows);
+        }
+    }
+
+    public static boolean relink(Context context, StoredFile expected, Uri root, String replacement) throws IOException
+    {
+        if (expected.size < 0 || replacement == null || root == null)
+            throw new IOException("File identity is unavailable");
+        String scope = SupernovaLibraryPolicy.canonical(root);
+        if (!SupernovaLibraryPolicy.contains(scope, SupernovaLibraryPolicy.canonical(Uri.parse(expected.path))) ||
+            !SupernovaLibraryPolicy.contains(scope, SupernovaLibraryPolicy.canonical(Uri.parse(replacement))))
+            throw new IOException("Replacement is outside the source");
+        if (!name(expected.path).equals(name(replacement)))
+            throw new IOException("Replacement file name differs");
+        return mutate(context, expected, replacement);
+    }
+
+    public static boolean remove(Context context, StoredFile expected) throws IOException
+    {
+        return mutate(context, expected, null);
+    }
+
+    private static boolean mutate(Context context, StoredFile expected, String replacement) throws IOException
+    {
+        boolean changed;
+        try (ScanProcessLock lock =
+                 ScanProcessLock.acquire(new java.io.File(context.getFilesDir(), "supernova-scan.lock"),
+                                         () -> Thread.currentThread().isInterrupted());
+             VideoOpenHelper helper = new VideoOpenHelper(context))
+        {
+            changed = change(helper.getWritableDatabase(), expected, replacement);
+        }
+        if (changed)
+        {
+            android.content.SharedPreferences health = context.getSharedPreferences(SupernovaLibraryPolicy.HEALTH, 0);
+            String key = "media:" + expected.id;
+            if (SupernovaLibraryPolicy.canonical(Uri.parse(expected.path)).equals(health.getAll().get(key)))
+                if (!health.edit().remove(key).remove("missing_since:" + expected.id).commit())
+                    throw new IOException("Library changed; health state could not be saved");
+            context.getContentResolver().notifyChange(VideoStore.Video.Media.EXTERNAL_CONTENT_URI, null);
+        }
+        return changed;
+    }
+
+    static boolean change(SQLiteDatabase database, StoredFile expected, String replacement) throws IOException
+    {
+        database.beginTransaction();
+        try
+        {
+            String guard = "_id=? AND _data=? AND " + (expected.size < 0 ? "(_size IS NULL OR _size<0)" : "_size=?");
+            String[] args = expected.size < 0 ? new String[] {"" + expected.id, expected.path}
+                                              : new String[] {"" + expected.id, expected.path, "" + expected.size};
+            long remote;
+            try (Cursor row = database.query("files", new String[] {"remote_id"}, guard, args, null, null, null))
+            {
+                if (!row.moveToFirst() || row.isNull(0))
+                    return false;
+                remote = row.getLong(0);
+            }
+            boolean scanned = expected.id >= VideoOpenHelper.SCANNED_ID_OFFSET;
+            if (remote != expected.id)
+                throw new IOException("Library identity changed");
+            long raw = scanned ? remote - VideoOpenHelper.SCANNED_ID_OFFSET : remote;
+            String table = scanned ? "files_scanned" : "files_import";
+            String[] physical = expected.size < 0 ? new String[] {"" + raw, expected.path}
+                                                  : new String[] {"" + raw, expected.path, "" + expected.size};
+            if (replacement == null)
+            {
+                if (database.delete(table, guard, physical) != 1)
+                    return false;
+                database.delete("files", guard, args);
+            }
+            else
+            {
+                for (String check : new String[] {"files", table})
+                    try (Cursor conflict = database.query(check, new String[] {"_id"}, "_data=?",
+                                                          new String[] {replacement}, null, null, null))
+                    {
+                        if (conflict.moveToFirst())
+                            return false;
+                    }
+                ContentValues physicalValues = new ContentValues();
+                physicalValues.put("_data", replacement);
+                physicalValues.put("_display_name", name(replacement));
+                if (database.updateWithOnConflict(table, physicalValues, guard, physical,
+                                                  SQLiteDatabase.CONFLICT_ABORT) != 1)
+                    return false;
+                ContentValues libraryValues = new ContentValues(physicalValues);
+                libraryValues.put("volume_hidden", 0);
+                // Scanned-path triggers may already have forwarded _data; assert the stable public identity instead.
+                if (database.updateWithOnConflict("files", libraryValues, "_id=? AND remote_id=?",
+                                                  new String[] {"" + expected.id, "" + remote},
+                                                  SQLiteDatabase.CONFLICT_ABORT) != 1)
+                    throw new IOException("Library row disappeared");
+            }
+            database.setTransactionSuccessful();
+            return true;
+        }
+        finally
+        {
+            database.endTransaction();
+        }
+    }
+
+    private static String name(String path)
+    {
+        return path.startsWith("/") ? new java.io.File(path).getName() : Uri.parse(path).getLastPathSegment();
+    }
+    private MissingMediaActions()
+    {
+    }
+}
