+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Application;
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import java.io.File;
+import java.nio.file.Files;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class MissingMediaActionsTest
+{
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+    private SQLiteDatabase database;
+    @Before public void setup()
+    {
+        database = SQLiteDatabase.create(null);
+        database.execSQL(
+            "CREATE TABLE files (_id INTEGER PRIMARY KEY,_data TEXT UNIQUE,_size INTEGER,remote_id INTEGER,"
+            + "_display_name TEXT,volume_hidden INTEGER,bookmark INTEGER,Archos_bookmark INTEGER,"
+            + "Archos_lastTimePlayed INTEGER,Archos_traktSeen INTEGER,Archos_hiddenByUser INTEGER,metadata TEXT)");
+        for (String table : new String[] {"files_import", "files_scanned"})
+            database.execSQL("CREATE TABLE " + table +
+                             " (_id INTEGER PRIMARY KEY,_data TEXT UNIQUE,_size INTEGER,_display_name TEXT)");
+        database.execSQL("CREATE TRIGGER forward_scanned_path AFTER UPDATE OF _data ON files_scanned BEGIN "
+                         + "UPDATE files SET _data=NEW._data WHERE remote_id=OLD._id+2000000000; END");
+    }
+    @After public void close()
+    {
+        database.close();
+    }
+    private void row(long id, String path)
+    {
+        database.execSQL("INSERT INTO files VALUES (?,?,123,?,'Old.mkv',1,45,67,89,1,1,'metadata')",
+                         new Object[] {id, path, id});
+        database.execSQL("INSERT INTO " + (id >= 2000000000L ? "files_scanned" : "files_import") +
+                             " VALUES (?,?,123,'Old.mkv')",
+                         new Object[] {id >= 2000000000L ? id - 2000000000L : id, path});
+    }
+    private void preserved(long id, String path)
+    {
+        try (Cursor row =
+                 database.rawQuery("SELECT _data,bookmark,Archos_bookmark,Archos_lastTimePlayed,"
+                                       + "Archos_traktSeen,Archos_hiddenByUser,metadata FROM files WHERE _id=?",
+                                   new String[] {"" + id}))
+        {
+            assertTrue(row.moveToFirst());
+            assertEquals(path, row.getString(0));
+            assertEquals(45, row.getLong(1));
+            assertEquals(67, row.getLong(2));
+            assertEquals(89, row.getLong(3));
+            assertEquals(1, row.getLong(4));
+            assertEquals(1, row.getLong(5));
+            assertEquals("metadata", row.getString(6));
+        }
+    }
+    @Test public void localAndScannedRelinkKeepPublicIdentityMetadataWatchedAndBothProgressColumns() throws Exception
+    {
+        row(44, "/storage/drive/Old.mkv");
+        row(2000000044L, "smb://nas/Films/Old.mkv");
+        assertTrue(MissingMediaActions.change(database,
+                                              new MissingMediaActions.StoredFile(44, "/storage/drive/Old.mkv", 123),
+                                              "/storage/drive/Moved/Old.mkv"));
+        assertTrue(MissingMediaActions.change(
+            database, new MissingMediaActions.StoredFile(2000000044L, "smb://nas/Films/Old.mkv", 123),
+            "smb://nas/Films/Moved/Old.mkv"));
+        preserved(44, "/storage/drive/Moved/Old.mkv");
+        preserved(2000000044L, "smb://nas/Films/Moved/Old.mkv");
+    }
+    @Test public void staleIdentityAndConflictingDestinationLeaveEveryRowUnchanged() throws Exception
+    {
+        row(44, "/Old.mkv");
+        row(45, "/Moved/Old.mkv");
+        assertFalse(MissingMediaActions.change(database, new MissingMediaActions.StoredFile(44, "/Wrong.mkv", 123),
+                                               "/New.mkv"));
+        assertFalse(
+            MissingMediaActions.change(database, new MissingMediaActions.StoredFile(44, "/Old.mkv", 124), "/New.mkv"));
+        assertFalse(MissingMediaActions.change(database, new MissingMediaActions.StoredFile(44, "/Old.mkv", 123),
+                                               "/Moved/Old.mkv"));
+        preserved(44, "/Old.mkv");
