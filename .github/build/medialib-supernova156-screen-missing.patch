+    @Test public void missingSinceIsFirstObservationForTheSameIdentityAndClearsOnRecovery()
+    {
+        Context context = new ContextWrapper(RuntimeEnvironment.getApplication()) {
+            @Override public String getPackageName()
+            {
+                return "app.supernova.player";
+            }
+        };
+        var health = context.getSharedPreferences(SupernovaLibraryPolicy.HEALTH, 0);
+        android.net.Uri file = android.net.Uri.parse("smb://nas/Films/Old.mkv");
+        SupernovaLibraryPolicy.availability(context, 44, file, true);
+        assertTrue(health.getLong("missing_since:44", 0) > 0);
+        health.edit().putLong("missing_since:44", 123).commit();
+        SupernovaLibraryPolicy.availability(context, 44, file, true);
+        assertEquals(123, health.getLong("missing_since:44", 0));
+        SupernovaLibraryPolicy.availability(context, 44, file, false);
+        assertFalse(health.contains("media:44"));
+        assertFalse(health.contains("missing_since:44"));
+    }
