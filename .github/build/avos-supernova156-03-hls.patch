--- /dev/null
+++ b/Include/stream_hls_compat.h
@@ -0,0 +1,12 @@
+// Copyright 2026 Supernova contributors
+// SPDX-License-Identifier: Apache-2.0
+#ifndef SUPERNOVA_STREAM_HLS_COMPAT_H
+#define SUPERNOVA_STREAM_HLS_COMPAT_H
+#include <string.h>
+/* FFmpeg9 retired the hls+ protocol alias. Preserve the source URI/bookmark;
+ * strip only the backend transport alias and force the maintained HLS demuxer. */
+static inline int stream_hls_compat_url(const char **url) {
+    if (url && *url && !strncmp(*url, "hls+", 4)) { *url += 4; return 1; }
+    return 0;
+}
+#endif
