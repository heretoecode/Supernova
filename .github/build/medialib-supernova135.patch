diff --git a/src/com/archos/mediaprovider/video/SupernovaLibraryPolicy.java b/src/com/archos/mediaprovider/video/SupernovaLibraryPolicy.java
new file mode 100644
index 0000000..e41d5cf
--- /dev/null
+++ b/src/com/archos/mediaprovider/video/SupernovaLibraryPolicy.java
@@ -0,0 +1,67 @@
+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import androidx.preference.PreferenceManager;
+import java.util.*;
+
+/** Foundation policy only: storage failures never imply destructive library reconciliation. */
+public final class SupernovaLibraryPolicy {
+    public static final String HEALTH="supernova_library_health_v1";
+    public static boolean retainsRecords(Context c){return c!=null&&"app.supernova.player".equals(c.getPackageName());}
+    public static String canonical(Uri uri){
+        List<String> segments=new ArrayList<>();for(String segment:uri.getPathSegments()){
+            if(segment.equals(".")||segment.isEmpty())continue;
+            if(segment.equals("..")){if(!segments.isEmpty())segments.remove(segments.size()-1);}else segments.add(segment);
+        }
+        String path="/"+android.text.TextUtils.join("/",segments);
+        Uri.Builder builder=uri.buildUpon().scheme(uri.getScheme()==null?"file":uri.getScheme().toLowerCase(Locale.ROOT)).clearQuery().fragment(null).path(path);
+        if(uri.getScheme()==null||"file".equalsIgnoreCase(uri.getScheme()))builder.encodedAuthority("");
+        if(uri.getHost()!=null)builder.encodedAuthority(uri.getHost().toLowerCase(Locale.ROOT)+(uri.getPort()<0?"":":"+uri.getPort()));
+        return builder.build().toString();
+    }
+    public static boolean contains(String parent,String child){return parent.equals(child)||child.startsWith(parent.endsWith("/")?parent:parent+"/");}
+    /** Includes offline removable volumes already represented by the installed library. */
+    public static Set<Uri> historicalLocalRoots(Context context){
+        Set<Uri> roots=new LinkedHashSet<>();
+        try(android.database.Cursor cursor=context.getContentResolver().query(VideoStoreInternal.FILES_IMPORT,new String[]{VideoStore.MediaColumns.DATA},"_data LIKE '/%' OR _data LIKE 'file:%'",null,null)){
+            if(cursor==null)throw new IllegalStateException("Existing library locations could not be read");
+            while(cursor.moveToNext()){String location=cursor.getString(0);if(location!=null)roots.add(localRoot(Uri.parse(location)));}
+        }
+        return roots;
+    }
+    public static Uri localRoot(Uri location){
+        List<String> path=location.getPathSegments();int length=0;
+        if(path.size()>=2&&path.get(0).equals("storage"))length=path.get(1).equals("emulated")&&path.size()>=3?3:2;
+        else if(path.size()>=3&&path.get(0).equals("mnt")&&(path.get(1).equals("media_rw")||path.get(1).equals("expand")))length=3;
+        else if(!path.isEmpty()&&path.get(0).equals("sdcard"))length=1;
+        else length=Math.max(0,path.size()-1);
+        return Uri.parse("file:///").buildUpon().path("/"+android.text.TextUtils.join("/",path.subList(0,length))).build();
+    }
+    public static boolean excluded(Context c,Uri uri){
+        if(!retainsRecords(c)||uri==null)return false;
+        SharedPreferences p=PreferenceManager.getDefaultSharedPreferences(c);String key=canonical(uri);
+        for(String excluded:p.getStringSet("supernova_library_exclusions",Collections.emptySet()))if(contains(excluded,key))return true;
+        if(p.getBoolean("supernova_library_policy_initialized",false)){
+            for(String root:p.getStringSet("supernova_library_roots",Collections.emptySet()))if(contains(root,key))return false;
+            return true;
+        }
+        return false;
+    }
+    public static void availability(Context c,long id,Uri uri,boolean missing){
+        if(!retainsRecords(c))return;
+        SharedPreferences.Editor editor=c.getSharedPreferences(HEALTH,Context.MODE_PRIVATE).edit();
+        if(!missing&&!c.getSharedPreferences(HEALTH,Context.MODE_PRIVATE).contains("media:"+id))return;
+        if(missing)editor.putString("media:"+id,canonical(uri));else editor.remove("media:"+id);
+        editor.apply();
+    }
+    public static void sourceAvailable(Context c,Uri root,boolean available){
+        if(!retainsRecords(c)||root==null)return;
+        SharedPreferences.Editor editor=c.getSharedPreferences(HEALTH,Context.MODE_PRIVATE).edit();
+        if(available){for(String key:c.getSharedPreferences(HEALTH,Context.MODE_PRIVATE).getAll().keySet())if(key.startsWith("offline:")&&contains(canonical(root),key.substring(8))||key.startsWith("problem:")&&contains(canonical(root),key.substring(8)))editor.remove(key);}else editor.putLong("offline:"+canonical(root),System.currentTimeMillis());
+        editor.apply();
