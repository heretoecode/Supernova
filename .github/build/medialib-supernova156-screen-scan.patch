@@ -0,0 +1,93 @@
+package com.archos.mediacenter.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Application;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import java.util.List;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class ShortcutSourceSnapshotTest
+{
+    private Context context;
+
+    @Before public void setup()
+    {
+        context = RuntimeEnvironment.getApplication();
+        ShortcutDbAdapter.VIDEO.close();
+        context.deleteDatabase("shortcuts_db");
+    }
+
+    @After public void close()
+    {
+        ShortcutDbAdapter.VIDEO.close();
+    }
+
+    @Test public void readingAnAbsentSourceStoreDoesNotCreateIt()
+    {
+        assertTrue(ShortcutDbAdapter.VIDEO.readCopiedShortcuts(context).isEmpty());
+        assertFalse(context.getDatabasePath("shortcuts_db").exists());
+        assertFalse(ShortcutDbAdapter.VIDEO.isDbOpen());
+    }
+
+    @Test public void copiedNamesRemainValidAfterClosingTheSingletonConnection()
+    {
+        assertTrue(ShortcutDbAdapter.VIDEO.addShortcut(
+            context, new ShortcutDbAdapter.Shortcut("Films", "webdavs://webdav.put.io/Films")));
+        ShortcutDbAdapter.VIDEO.close();
+        List<ShortcutDbAdapter.Shortcut> sources = ShortcutDbAdapter.VIDEO.readCopiedShortcuts(context);
+        assertNotNull(sources);
+        assertEquals(1, sources.size());
+        assertEquals("Films", sources.get(0).getName());
+        assertEquals("webdavs://webdav.put.io/Films", sources.get(0).getUri());
+        assertFalse(ShortcutDbAdapter.VIDEO.isDbOpen());
+    }
+
+    @Test public void readerDoesNotCloseTheOpenSingletonAndReturnsDetachedRows()
+    {
+        assertTrue(ShortcutDbAdapter.VIDEO.addShortcut(
+            context, new ShortcutDbAdapter.Shortcut("Films", "webdavs://server/Films")));
+        try (Cursor owner = ShortcutDbAdapter.VIDEO.queryAllShortcuts(context))
+        {
+            assertTrue(ShortcutDbAdapter.VIDEO.isDbOpen());
+            List<ShortcutDbAdapter.Shortcut> before = ShortcutDbAdapter.VIDEO.readCopiedShortcuts(context);
+            assertTrue(ShortcutDbAdapter.VIDEO.isDbOpen());
+            assertTrue(owner.moveToFirst());
+            assertEquals("Films", owner.getString(owner.getColumnIndexOrThrow(ShortcutDbAdapter.KEY_NAME)));
+            assertTrue(ShortcutDbAdapter.VIDEO.addShortcut(
+                context, new ShortcutDbAdapter.Shortcut("Series", "webdavs://server/Series")));
+            assertEquals(1, before.size());
+            assertEquals(2, ShortcutDbAdapter.VIDEO.readCopiedShortcuts(context).size());
+        }
+    }
+
+    @Test public void readerDoesNotRunSchemaUpgrades()
+    {
+        assertTrue(ShortcutDbAdapter.VIDEO.addShortcut(
+            context, new ShortcutDbAdapter.Shortcut("Films", "webdavs://server/Films")));
+        ShortcutDbAdapter.VIDEO.close();
+        String path = context.getDatabasePath("shortcuts_db").getPath();
+        try (SQLiteDatabase database = SQLiteDatabase.openDatabase(path, null, SQLiteDatabase.OPEN_READWRITE))
+        {
+            database.setVersion(4);
+        }
+        assertEquals(1, ShortcutDbAdapter.VIDEO.readCopiedShortcuts(context).size());
+        try (SQLiteDatabase database = SQLiteDatabase.openDatabase(path, null, SQLiteDatabase.OPEN_READONLY))
+        {
+            assertEquals(4, database.getVersion());
+        }
+    }
+}
