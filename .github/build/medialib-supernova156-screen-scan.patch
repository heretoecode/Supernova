+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.Intent;
+import com.archos.mediascraper.AutoScrapeService;
+import com.archos.mediascraper.ScanMetadataHandoff;
+
+/** Worker-only cancellation entry. Never removes library rows or marks an active worker complete early. */
+public final class LibraryScanControl
+{
+    public static void stop(Context context)
+    {
+        NetworkScanLedger.cancelAll();
+        ScanMetadataHandoff.cancelPending(context);
+        try
+        {
+            context.stopService(new Intent(context, NetworkScannerServiceVideo.class));
+        }
+        finally
+        {
+            try
+            {
+                context.stopService(new Intent(context, VideoStoreImportService.class));
+            }
+            finally
+            {
+                context.stopService(new Intent(context, AutoScrapeService.class));
+            }
+        }
+    }
+
+    private LibraryScanControl()
+    {
+    }
+}
