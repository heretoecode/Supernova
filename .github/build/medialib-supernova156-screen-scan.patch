--- /dev/null
+++ b/test/java/com/archos/mediaprovider/video/LibraryScanControlTest.java
@@ -0,0 +1,134 @@
+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Application;
+import android.content.Context;
+import android.net.Uri;
+import com.archos.filecorelibrary.webdav.ScanIoScope;
+import com.archos.mediascraper.AutoScrapeService;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.util.ReflectionHelpers;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class LibraryScanControlTest
+{
+    @Test public void stopRejectsQueuedSourcesButRetainsRunningOwnershipUntilFinallyAndNextBatchWorks() throws Exception
+    {
+        Context app = RuntimeEnvironment.getApplication();
+        AutoScrapeService.resetNetworkScanCount();
+        List<NetworkScanLedger.Member> members = NetworkScanLedger.register(
+            app, List.of(Uri.parse("webdav://server/one"), Uri.parse("webdav://server/two")));
+        NetworkScanLedger.Member running = members.get(0);
+        assertTrue(NetworkScanLedger.accept(running, new Object()));
+        ExecutorService worker = Executors.newSingleThreadExecutor();
+        CountDownLatch entered = new CountDownLatch(1);
+        CountDownLatch cancelled = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        try
+        {
+            Future<?> task = worker.submit(() -> {
+                try (ScanIoScope scope = new ScanIoScope(1, TimeUnit.MINUTES))
+                {
+                    assertTrue(NetworkScanLedger.begin(running, scope));
+                    entered.countDown();
+                    boolean done = false;
+                    while (!done)
+                    {
+                        try
+                        {
+                            done = release.await(5, TimeUnit.SECONDS);
+                            assertTrue("Test gate did not release", done);
+                        }
+                        catch (InterruptedException stopped)
+                        {
+                            assertTrue(scope.isCancelled());
+                            cancelled.countDown();
+                        }
+                    }
+                }
+                finally
+                {
+                    NetworkScanLedger.finish(running, false, true);
+                    Thread.interrupted();
+                }
+            });
+            assertTrue(entered.await(5, TimeUnit.SECONDS));
+            NetworkScanLedger.cancelAll();
+            assertTrue(cancelled.await(5, TimeUnit.SECONDS));
+            assertEquals(1, AutoScrapeService.getNetworkScanCount());
+            assertTrue(NetworkScanLedger.pending(running));
+            assertFalse(NetworkScanLedger.pending(members.get(1)));
+            release.countDown();
+            task.get(5, TimeUnit.SECONDS);
+            assertEquals(0, AutoScrapeService.getNetworkScanCount());
+            NetworkScanLedger.Member next =
+                NetworkScanLedger.register(app, List.of(Uri.parse("webdav://server/new"))).get(0);
+            assertTrue(NetworkScanLedger.accept(next, new Object()));
+            NetworkScanLedger.reject(next);
+            assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        }
+        finally
+        {
+            release.countDown();
+            worker.shutdownNow();
+            NetworkScanLedger.cancelAll();
+            AutoScrapeService.resetNetworkScanCount();
+        }
+    }
+
+    @Test public void laterImportsCannotClearAnInterruptedOlderWorkersCancellation() throws Exception
+    {
+        ReflectionHelpers.setStaticField(VideoStoreImportImpl.class, "mIsImportInterrupted", false);
+        ExecutorService worker = Executors.newSingleThreadExecutor();
+        try
+        {
+            assertTrue(worker
+                           .submit(() -> {
+                               Thread.currentThread().interrupt();
+                               try
+                               {
+                                   return VideoStoreImportImpl.previewImportInterrupted();
+                               }
+                               finally
+                               {
+                                   Thread.interrupted();
+                               }
+                           })
+                           .get(5, TimeUnit.SECONDS));
+            assertFalse(worker.submit(VideoStoreImportImpl::previewImportInterrupted).get(5, TimeUnit.SECONDS));
+        }
+        finally
+        {
+            worker.shutdownNow();
+        }
+    }
+
+    @Test public void stoppedPreparationCannotRegisterAfterStopAndAFreshGenerationCanRegister()
+    {
+        Context app = RuntimeEnvironment.getApplication();
+        AutoScrapeService.resetNetworkScanCount();
+        long old = NetworkScanLedger.generation();
+        NetworkScanLedger.cancelAll();
+        List<Uri> roots = List.of(Uri.parse("webdav://server/Films"));
+        assertTrue(NetworkScanLedger.register(app, roots, old).isEmpty());
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+        List<NetworkScanLedger.Member> next = NetworkScanLedger.register(app, roots, NetworkScanLedger.generation());
+        assertEquals(1, next.size());
+        NetworkScanLedger.reject(next.get(0));
+        assertEquals(0, AutoScrapeService.getNetworkScanCount());
+    }
+}
