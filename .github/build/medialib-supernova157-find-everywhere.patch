+
+    /** Separate old/new source guards; mutation still compares the exact old ID, path and size under the scan lock. */
+    public static boolean relinkAcrossSources(Context context, StoredFile expected, Uri oldRoot, Uri newRoot,
+                                              String replacement) throws IOException
+    {
+        if (expected.size < 0 || oldRoot == null || newRoot == null || replacement == null)
+            throw new IOException("File identity is unavailable");
+        if (!SupernovaLibraryPolicy.contains(SupernovaLibraryPolicy.canonical(oldRoot),
+                                             SupernovaLibraryPolicy.canonical(Uri.parse(expected.path))) ||
+            !SupernovaLibraryPolicy.contains(SupernovaLibraryPolicy.canonical(newRoot),
+                                             SupernovaLibraryPolicy.canonical(Uri.parse(replacement))) ||
+            !name(expected.path).equals(name(replacement)))
+            throw new IOException("Replacement is outside the selected sources");
+        String oldScheme = Uri.parse(expected.path).getScheme();
+        String newScheme = Uri.parse(replacement).getScheme();
+        boolean oldLocal = oldScheme == null || oldScheme.equals("file") || oldScheme.equals("content");
+        boolean newLocal = newScheme == null || newScheme.equals("file") || newScheme.equals("content");
+        if (oldLocal != newLocal)
+            throw new IOException("Replacement needs a different physical index owner");
         return mutate(context, expected, replacement);
     }
 
