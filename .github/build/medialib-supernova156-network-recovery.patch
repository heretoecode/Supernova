+++ b/test/java/com/archos/filecorelibrary/RecoverablePlaybackStreamTest.java
@@ -0,0 +1,90 @@
+package com.archos.filecorelibrary;
+
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.any;
+import static org.mockito.Mockito.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.app.Application;
+import android.net.Uri;
+import com.archos.medialib.PlaybackReadGuard;
+import com.archos.filecorelibrary.jcifs.JcifsFileEditor;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.MockedStatic;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(application = Application.class, sdk = 30)
+public class RecoverablePlaybackStreamTest
+{
+    @Test public void primaryReadFailurePoisonsFurtherOpensWhileSidecarsRemainOutsidePlaybackGuard() throws Exception
+    {
+        Uri uri = Uri.parse("smb://host/video.mkv"), subtitle = Uri.parse("smb://host/video.srt");
+        FileEditor primary = mock(FileEditor.class), sidecar = mock(FileEditor.class);
+        InputStream broken = new InputStream() {
+            @Override public int read() throws IOException
+            {
+                throw new IOException("Idle connection dropped");
+            }
+        };
+        when(primary.getInputStream(eq(0L), any(ReadOptions.class))).thenReturn(broken);
+        AtomicInteger failures = new AtomicInteger();
+        try (MockedStatic<FileEditorFactory> factory = mockStatic(FileEditorFactory.class);
+             PlaybackReadGuard guard = new PlaybackReadGuard(failure -> failures.incrementAndGet()))
+        {
+            factory.when(() -> FileEditorFactory.getFileEditorForUrl(eq(uri), any())).thenReturn(primary);
+            factory.when(() -> FileEditorFactory.getFileEditorForUrl(eq(subtitle), any())).thenReturn(sidecar);
+            RecoverablePlaybackStream stream = new RecoverablePlaybackStream(uri, "video/x-matroska", guard);
+            try
+            {
+                assertSame(sidecar, stream.getFileEditor(subtitle));
+                FileEditor wrapped = stream.getFileEditor(uri);
+                InputStream input =
+                    wrapped.getInputStream(0, new ReadOptions(ReadOptions.Purpose.PLAYBACK, 100, false));
+                assertThrows(IOException.class, input::read);
+                assertThrows(IOException.class, () -> wrapped.getInputStream(0, ReadOptions.DEFAULT));
+                verify(primary, times(1)).getInputStream(eq(0L), any(ReadOptions.class));
+                assertEquals(1, failures.get());
+                input.close();
+            }
+            finally
+            {
+                stream.close();
+            }
+        }
+    }
+
+    @Test public void wrappingDoesNotChangeJcifsNormalPlaybackRefillPolicy() throws Exception
+    {
+        Uri uri = Uri.parse("smb://host/video.mkv");
+        JcifsFileEditor primary = mock(JcifsFileEditor.class);
+        try (MockedStatic<FileEditorFactory> factory = mockStatic(FileEditorFactory.class);
+             PlaybackReadGuard guard = new PlaybackReadGuard(failure -> {}))
+        {
+            factory.when(() -> FileEditorFactory.getFileEditorForUrl(eq(uri), any())).thenReturn(primary);
+            RecoverablePlaybackStream stream = new RecoverablePlaybackStream(uri, "video/x-matroska", guard);
+            StreamOverHttp base = new StreamOverHttp(uri, "video/x-matroska", StreamOverHttp.ReadMode.PLAYBACK);
+            try
+            {
+                assertEquals(base.upstreamBufferSize(primary, true),
+                             stream.upstreamBufferSize(stream.getFileEditor(uri), true));
+            }
+            finally
+            {
+                stream.close();
+                base.close();
+            }
+        }
+    }
+}
