new file mode 100644
index 0000000..f394c79
--- /dev/null
+++ b/src/com/archos/medialib/PlaybackReadEvents.java
@@ -0,0 +1,55 @@
+package com.archos.medialib;
+
+import java.io.IOException;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/** Recovery is independent of diagnostic logging. Owner identity fences metadata and obsolete backend reads. */
+public final class PlaybackReadEvents
+{
+    public interface Listener
+    {
+        void failed(Object owner, IOException cause);
+    }
+    private static volatile Listener listener;
+    private static final Map<Object, PlaybackReadGuard> GUARDS = new WeakHashMap<>();
+    private static final Map<Object, Boolean> PAUSED = new WeakHashMap<>();
+
+    public static void install(Listener value)
+    {
+        listener = value;
+    }
+    public static synchronized void register(Object owner, PlaybackReadGuard guard)
+    {
+        GUARDS.put(owner, guard);
+        guard.paused(Boolean.TRUE.equals(PAUSED.get(owner)));
+    }
+    public static synchronized void unregister(Object owner, PlaybackReadGuard guard)
+    {
+        if (GUARDS.get(owner) == guard)
+        {
+            GUARDS.remove(owner);
+            PAUSED.remove(owner);
+        }
+    }
+    public static synchronized boolean paused(Object owner, boolean paused)
+    {
+        if (owner == null)
+            return false;
+        PAUSED.put(owner, paused);
+        PlaybackReadGuard guard = GUARDS.get(owner);
+        if (guard == null)
+            return false;
+        guard.paused(paused);
+        return true;
+    }
+    public static void failed(Object owner, IOException cause)
+    {
+        Listener sink = listener;
+        if (sink != null)
+            sink.failed(owner, cause);
+    }
+    private PlaybackReadEvents()
+    {
+    }
+}
diff --git a/src/com/archos/medialib/PlaybackReadGuard.java b/src/com/archos/medialib/PlaybackReadGuard.java
new file mode 100644
index 0000000..4c06876
--- /dev/null
+++ b/src/com/archos/medialib/PlaybackReadGuard.java
@@ -0,0 +1,189 @@
+package com.archos.medialib;
+
+import java.io.EOFException;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InterruptedIOException;
+import java.util.function.Consumer;
+
+/** One playback byte-stream generation. A failed generation can never be resumed or reopened. */
+public final class PlaybackReadGuard implements AutoCloseable
+{
+    public static final long PAUSED_READ_BUDGET = 64 * 1024;
+    private final Consumer<IOException> failure;
+    private boolean paused, closed, failed;
+    private long remaining = PAUSED_READ_BUDGET;
+    private long epoch;
+
+    public PlaybackReadGuard(Consumer<IOException> failure)
+    {
+        this.failure = failure;
+    }
+
+    public synchronized void paused(boolean value)
+    {
+        if (value && !paused)
+        {
+            remaining = PAUSED_READ_BUDGET;
+            epoch++;
+        }
+        paused = value;
+        notifyAll();
+    }
+
+    public synchronized void check() throws IOException
+    {
+        if (closed || failed)
+            throw new IOException("Playback stream generation abandoned");
+    }
+
+    public void failed(IOException cause)
+    {
+        synchronized (this)
+        {
+            if (closed || failed || Thread.currentThread().isInterrupted())
+                return;
+            failed = true;
+            notifyAll();
+        }
+        try
+        {
+            failure.accept(cause);
+        }
+        catch (RuntimeException ignored)
+        { /* The old generation remains poisoned even if notification fails. */
+        }
+    }
+
+    public InputStream wrap(InputStream input, long expected) throws IOException
+    {
+        try
+        {
+            check();
+        }
+        catch (IOException abandoned)
+        {
+            try
+            {
+                input.close();
+            }
+            catch (IOException closeFailure)
+            {
+                abandoned.addSuppressed(closeFailure);
+            }
+            throw abandoned;
+        }
+        return new FilterInputStream(input) {
+            private volatile boolean inputClosed;
+            private long left = expected;
+            @Override public int read() throws IOException
+            {
+                byte[] one = new byte[1];
+                return read(one, 0, 1) < 0 ? -1 : one[0] & 255;
+            }
+            @Override public int read(byte[] bytes, int offset, int length) throws IOException
+            {
+                java.util.Objects.checkFromIndexSize(offset, length, bytes.length);
+                if (length == 0)
+                    return 0;
+                long reservedEpoch;
+                boolean reserved;
+                synchronized (PlaybackReadGuard.this)
+                {
+                    while (paused && remaining == 0 && !closed && !failed && !inputClosed)
+                    {
+                        try
+                        {
+                            PlaybackReadGuard.this.wait();
+                        }
+                        catch (InterruptedException cancelled)
+                        {
+                            Thread.currentThread().interrupt();
+                            throw new InterruptedIOException("Paused playback read cancelled");
+                        }
+                    }
+                    check();
+                    if (inputClosed)
+                        throw new IOException("Playback read closed");
+                    reserved = paused;
+                    reservedEpoch = epoch;
+                    if (reserved)
+                    {
+                        length = (int)Math.min(length, remaining);
+                        remaining -= length;
+                    }
+                }
+                int count = -1;
+                try
+                {
+                    count = in.read(bytes, offset, length);
+                    check();
+                    if (inputClosed)
+                        throw new IOException("Playback read closed");
+                    if (count < 0 && left > 0)
+                        throw new EOFException("Playback source ended before promised bytes");
+                    if (count > 0 && left >= 0)
+                        left -= count;
+                    return count;
+                }
+                catch (IOException cause)
+                {
+                    if (!inputClosed)
+                        failed(cause);
+                    throw cause;
+                }
+                finally
+                {
+                    synchronized (PlaybackReadGuard.this)
+                    {
+                        if (reserved && paused && epoch == reservedEpoch)
+                        {
+                            remaining += length - Math.max(0, count);
+                            PlaybackReadGuard.this.notifyAll();
+                        }
+                    }
+                }
+            }
+            @Override public long skip(long count) throws IOException
+            {
+                byte[] discard = new byte[(int)Math.min(8192, Math.max(0, count))];
+                long skipped = 0;
+                while (skipped < count)
+                {
+                    int n = read(discard, 0, (int)Math.min(discard.length, count - skipped));
+                    if (n < 0)
+                        break;
+                    skipped += n;
+                }
+                return skipped;
+            }
+            @Override public void close() throws IOException
+            {
+                inputClosed = true;
+                synchronized (PlaybackReadGuard.this)
+                {
+                    PlaybackReadGuard.this.notifyAll();
+                }
+                in.close();
+            }
+            @Override public boolean markSupported()
+            {
+                return false;
+            }
+            @Override public void mark(int limit)
+            {
+            }
+            @Override public void reset() throws IOException
+            {
+                throw new IOException("Playback mark/reset unsupported");
+            }
+        };
+    }
+
+    @Override public synchronized void close()
+    {
+        closed = true;
+        notifyAll();
+    }
+}
