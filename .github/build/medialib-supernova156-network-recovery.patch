+    @Test public void intentionalCloseDoesNotReportReadFailureAndLateInputsAreClosed() throws Exception
+    {
+        AtomicInteger failures = new AtomicInteger(), closes = new AtomicInteger();
+        PlaybackReadGuard guard = new PlaybackReadGuard(failure -> failures.incrementAndGet());
+        guard.close();
+        InputStream late = new ByteArrayInputStream(new byte[4]) {
+            @Override public void close()
+            {
+                closes.incrementAndGet();
+            }
+        };
+        assertThrows(IOException.class, () -> guard.wrap(late, 4));
+        assertEquals(1, closes.get());
+        assertEquals(0, failures.get());
+    }
