+import org.junit.Test;
+
+public class PlaybackReadGuardTest
+{
+    @Test(timeout = 5000)
+    public void fakeServerDropsIdleConnectionOldBytesArePoisonedAndFreshGenerationSucceeds() throws Exception
+    {
+        AtomicInteger failures = new AtomicInteger();
+        CountDownLatch paused = new CountDownLatch(1);
+        try (ServerSocket server = new ServerSocket(0))
+        {
+            server.setSoTimeout(3000);
+            CompletableFuture<Void> serving = CompletableFuture.runAsync(() -> {
+                try
+                {
+                    try (Socket first = server.accept())
+                    {
+                        first.getOutputStream().write(new byte[] {1, 2, 3, 4});
+                        first.getOutputStream().flush();
+                        if (!paused.await(2, TimeUnit.SECONDS))
+                            throw new IOException("Pause not reached");
+                        // An idle server drops a response whose Content-Length promised eight bytes.
+                    }
+                    try (Socket second = server.accept())
+                    {
+                        second.getOutputStream().write(new byte[] {5, 6, 7, 8, 9, 10, 11, 12});
+                    }
+                }
+                catch (Exception failure)
+                {
+                    throw new RuntimeException(failure);
+                }
+            });
+            try (PlaybackReadGuard old = new PlaybackReadGuard(failure -> failures.incrementAndGet());
+                 Socket first = new Socket("127.0.0.1", server.getLocalPort()))
+            {
+                InputStream input = old.wrap(first.getInputStream(), 8);
+                assertEquals(4, input.readNBytes(4).length);
+                old.paused(true);
+                paused.countDown();
+                old.paused(false);
+                assertThrows(EOFException.class, input::read);
+                assertThrows(IOException.class, input::read);
+                assertEquals(1, failures.get());
+            }
+            try (PlaybackReadGuard fresh = new PlaybackReadGuard(failure -> failures.incrementAndGet());
+                 Socket second = new Socket("127.0.0.1", server.getLocalPort()))
+            {
+                InputStream input = fresh.wrap(second.getInputStream(), 8);
+                assertEquals(8, input.readNBytes(8).length);
+                assertEquals(-1, input.read());
+            }
+            serving.get(2, TimeUnit.SECONDS);
+            assertEquals(1, failures.get());
+        }
+    }
