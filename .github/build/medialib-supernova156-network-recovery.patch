diff --git a/src/com/archos/filecorelibrary/RecoverablePlaybackStream.java b/src/com/archos/filecorelibrary/RecoverablePlaybackStream.java
new file mode 100644
index 0000000..76f64ba
--- /dev/null
+++ b/src/com/archos/filecorelibrary/RecoverablePlaybackStream.java
@@ -0,0 +1,94 @@
+package com.archos.filecorelibrary;
+
+import android.net.Uri;
+import com.archos.medialib.PlaybackReadGuard;
+import java.io.IOException;
+import java.io.InputStream;
+
+/** MediaLib extension using FileCore's existing package editor seam; no FileCore source/build change. */
+public final class RecoverablePlaybackStream extends StreamOverHttp
+{
+    private final Uri primary;
+    private final PlaybackReadGuard guard;
+
+    public RecoverablePlaybackStream(MetaFile2 file, String mime, PlaybackReadGuard guard) throws IOException
+    {
+        super(file, mime, ReadMode.PLAYBACK);
+        primary = file.getUri();
+        this.guard = guard;
+    }
+
+    public RecoverablePlaybackStream(Uri uri, String mime, PlaybackReadGuard guard) throws IOException
+    {
+        super(uri, mime, ReadMode.PLAYBACK);
+        primary = uri;
+        this.guard = guard;
+    }
+
+    @Override FileEditor getFileEditor(Uri uri)
+    {
+        FileEditor delegate = super.getFileEditor(uri);
+        // Subtitle/poster failures cannot trigger playback recovery.
+        return FileUtils.encodeUri(primary).equals(FileUtils.encodeUri(uri)) ? new GuardedEditor(uri, delegate, guard)
+                                                                             : delegate;
+    }
+
+    @Override int upstreamBufferSize(FileEditor editor, boolean primaryMedia)
+    {
+        // Preserve FileCore's normal per-backend throughput policy outside the pause budget.
+        return super.upstreamBufferSize(editor instanceof GuardedEditor ? ((GuardedEditor)editor).delegate : editor,
+                                        primaryMedia);
+    }
+
+    private static final class GuardedEditor extends FileEditor
+    {
+        private final FileEditor delegate;
+        private final PlaybackReadGuard guard;
+        GuardedEditor(Uri uri, FileEditor delegate, PlaybackReadGuard guard)
+        {
+            super(uri);
+            this.delegate = delegate;
+            this.guard = guard;
+        }
+        @Override public boolean exists()
+        {
+            return delegate.exists();
+        }
+        @Override public long length() throws Exception
+        {
+            return delegate.length();
+        }
+        @Override public InputStream getInputStream() throws Exception
+        {
+            return open(0, ReadOptions.DEFAULT, false);
+        }
+        @Override public InputStream getInputStream(long from) throws Exception
+        {
+            return open(from, ReadOptions.DEFAULT, true);
+        }
+        @Override public InputStream getInputStream(ReadOptions options) throws Exception
+        {
+            return open(0, options, false);
+        }
+        @Override public InputStream getInputStream(long from, ReadOptions options) throws Exception
+        {
+            return open(from, options, true);
+        }
+        private InputStream open(long from, ReadOptions options, boolean range) throws Exception
+        {
+            guard.check();
+            try
+            {
+                InputStream input = range ? delegate.getInputStream(from, options) : delegate.getInputStream(options);
+                return guard.wrap(input, options.maxBytes);
+            }
+            catch (IOException failure)
+            {
+                // FileCore deliberately retries non-seekable providers from zero for this sentinel.
+                if (!"Illegal seek".equals(failure.getMessage()))
+                    guard.failed(failure);
+                throw failure;
+            }
+        }
+    }
+}
