+    @Test(timeout = 5000) public void pauseBudgetIsSharedAndLateGuardRegistrationHonorsPause() throws Exception
+    {
+        Object owner = new Object();
+        assertFalse(PlaybackReadEvents.paused(owner, true));
+        PlaybackReadGuard guard = new PlaybackReadGuard(failure -> { throw new AssertionError(failure); });
+        PlaybackReadEvents.register(owner, guard);
+        try
+        {
+            InputStream input = guard.wrap(new ByteArrayInputStream(new byte[70000]), 70000);
+            assertEquals(65536, input.readNBytes(65536).length);
+            CompletableFuture<Integer> blocked = CompletableFuture.supplyAsync(() -> {
+                try
+                {
+                    return input.read();
+                }
+                catch (IOException failure)
+                {
+                    throw new RuntimeException(failure);
+                }
+            });
+            assertThrows(TimeoutException.class, () -> blocked.get(50, TimeUnit.MILLISECONDS));
+            assertTrue(PlaybackReadEvents.paused(owner, false));
+            assertEquals(Integer.valueOf(0), blocked.get(2, TimeUnit.SECONDS));
+        }
+        finally
+        {
+            guard.close();
+            PlaybackReadEvents.unregister(owner, guard);
+        }
+    }
